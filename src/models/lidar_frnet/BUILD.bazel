load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")

package(default_visibility = ["//visibility:public"])

MODEL_FILES = ['README.md', 'deploy_metadata.yaml', 'frnet_ot128.onnx', 'frnet_qt128.onnx', 'ml_package_frnet_ot128.param.yaml', 'ml_package_frnet_qt128.param.yaml']

filegroup(name = "models", srcs = MODEL_FILES)

register_ament_files(
    name = "model_files",
    files = MODEL_FILES + ["SHA256SUMS", "MODEL_PROVENANCE.md"],
    prefix = "share/autoware_lidar_frnet_models",
)

ament_index(package_xml = "package.xml", data = [":model_files"])
