load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")

package(default_visibility = ["//visibility:public"])

MODEL_FILES = ['README.md', 'deploy_metadata.yaml', 'lamp_labels.txt', 'lamp_labels_ped.txt', 'lamp_recognizer_ml.param.yaml', 'ped_traffic_light_classifier_mobilenetv2_batch_1.onnx', 'ped_traffic_light_classifier_mobilenetv2_batch_4.onnx', 'ped_traffic_light_classifier_mobilenetv2_batch_6.onnx', 'traffic_light_classifier_mobilenetv2_batch_1.onnx', 'traffic_light_classifier_mobilenetv2_batch_4.onnx', 'traffic_light_classifier_mobilenetv2_batch_6.onnx', 'traffic_light_lamp_recognizer_comlops.onnx']

filegroup(name = "models", srcs = MODEL_FILES)

register_ament_files(
    name = "model_files",
    files = MODEL_FILES + ["SHA256SUMS", "MODEL_PROVENANCE.md"],
    prefix = "share/autoware_traffic_light_classifier_models",
)

ament_index(package_xml = "package.xml", data = [":model_files"])
