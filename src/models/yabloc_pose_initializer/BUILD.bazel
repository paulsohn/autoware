load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")

package(default_visibility = ["//visibility:public"])

MODEL_FILES = glob(["saved_model/**"]) + ["deploy_metadata.yaml"]

filegroup(name = "models", srcs = MODEL_FILES)

exports_files(["SHA256SUMS"])

register_ament_files(
    name = "model_files",
    files = MODEL_FILES + ["MODEL_PROVENANCE.md", "SHA256SUMS"],
    prefix = "share/autoware_yabloc_pose_initializer_models",
)

ament_index(package_xml = "package.xml", data = [":model_files"])
