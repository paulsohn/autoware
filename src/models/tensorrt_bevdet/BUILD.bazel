load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")

package(default_visibility = ["//visibility:public"])

MODEL_FILES = [
    "README.md",
    "bevdet_one_lt_d.onnx",
    "deploy_metadata.yaml",
]

filegroup(
    name = "models",
    srcs = MODEL_FILES,
)

register_ament_files(
    name = "model_files",
    files = MODEL_FILES + [
        "MODEL_PROVENANCE.md",
        "SHA256SUMS",
    ],
    prefix = "share/autoware_tensorrt_bevdet_models",
)

ament_index(
    data = [":model_files"],
    package_xml = "package.xml",
)
