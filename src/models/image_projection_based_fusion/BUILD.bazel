load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")

package(default_visibility = ["//visibility:public"])

MODEL_FILES = [
    "README.md",
    "deploy_metadata.yaml",
    "detection_class_remapper.param.yaml",
    "pointpainting_ml_package.param.yaml",
    "pts_backbone_neck_head_pointpainting.onnx",
    "pts_voxel_encoder_pointpainting.onnx",
]

filegroup(name = "models", srcs = MODEL_FILES)

register_ament_files(
    name = "model_files",
    files = MODEL_FILES + ["SHA256SUMS", "MODEL_PROVENANCE.md"],
    prefix = "share/autoware_image_projection_based_fusion_models",
)

ament_index(package_xml = "package.xml", data = [":model_files"])
