load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")

package(default_visibility = ["//visibility:public"])

MODEL_FILES = glob([
    "*.onnx",
    "*.txt",
    "*.csv",
    "*.yaml",
    "*.table",
])

filegroup(
    name = "models",
    srcs = MODEL_FILES,
)

exports_files(["SHA256SUMS"])

register_ament_files(
    name = "model_files",
    files = MODEL_FILES + [
        "MODEL_PROVENANCE.md",
        "SHA256SUMS",
    ],
    prefix = "share/autoware_tensorrt_yolox_models",
)

ament_index(
    data = [":model_files"],
    package_xml = "package.xml",
)
