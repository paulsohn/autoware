load("@rosdistro//ament:defs.bzl", "ament_index")

package(default_visibility = ["//visibility:public"])

# Resource closure for the default rule-based planning simulator profile.
ament_index(
    package_xml = "package.xml",
    data = glob(["launch/**"]),
    deps = [
        "@autoware_agnocast_wrapper//:ament_package",
        "@autoware_autonomous_emergency_braking//:ament_index",
        "@autoware_collision_detector//:ament_index",
        "@autoware_control_config//:ament_index",
        "@autoware_control_evaluator//:ament_index",
        "@autoware_control_validator//:ament_index",
        "@autoware_external_cmd_converter//:ament_index",
        "@autoware_external_cmd_selector//:ament_index",
        "@autoware_lane_departure_checker//:ament_index",
        "@autoware_operation_mode_transition_manager//:ament_index",
        "@autoware_shift_decider//:ament_index",
        "@autoware_trajectory_follower_node//:ament_index",
        "@autoware_vehicle_cmd_gate//:ament_index",
        "@rclcpp_components//:ament_package",
    ],
)
