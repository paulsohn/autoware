load("@rosidl_default_generators//:defs.bzl", "default_generators", "rosidl_ament_package")

package(default_visibility = ["//visibility:public"])

default_generators(
    dependencies = [
        "@builtin_interfaces",
        "@std_msgs",
    ],
    package_xml = "package.xml",
    deps = [
        "//msg:BoolStamped",
        "//msg:Float32MultiArrayStamped",
        "//msg:Float32Stamped",
        "//msg:Float64MultiArrayStamped",
        "//msg:Float64Stamped",
        "//msg:Int32MultiArrayStamped",
        "//msg:Int32Stamped",
        "//msg:Int64MultiArrayStamped",
        "//msg:Int64Stamped",
        "//msg:ProcessingTimeNode",
        "//msg:ProcessingTimeTree",
        "//msg:ServiceLog",
        "//msg:StringStamped",
        "//srv:String",
    ],
)

# Installable package (P4): the generated message libraries and the package.xml dependencies.
rosidl_ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    deps = [
        "@builtin_interfaces//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_default_runtime//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
