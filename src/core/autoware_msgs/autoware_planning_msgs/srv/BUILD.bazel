load("@rosidl_default_generators//:defs.bzl", "ros_service")

package(default_visibility = ["//visibility:public"])

ros_service(
    name = "ClearRoute",
    src = "ClearRoute.srv",
    deps = [
        "@autoware_common_msgs//msg:ResponseStatus",
    ],
)

ros_service(
    name = "SetLaneletRoute",
    src = "SetLaneletRoute.srv",
    deps = [
        "//msg:LaneletSegment",
        "@autoware_common_msgs//msg:ResponseStatus",
        "@geometry_msgs//msg:Pose",
        "@std_msgs//msg:Header",
        "@unique_identifier_msgs//msg:UUID",
    ],
)

ros_service(
    name = "SetPreferredPrimitive",
    src = "SetPreferredPrimitive.srv",
    deps = [
        "//msg:LaneletPrimitive",
        "@autoware_common_msgs//msg:ResponseStatus",
        "@unique_identifier_msgs//msg:UUID",
    ],
)

ros_service(
    name = "SetWaypointRoute",
    src = "SetWaypointRoute.srv",
    deps = [
        "@autoware_common_msgs//msg:ResponseStatus",
        "@geometry_msgs//msg:Pose",
        "@std_msgs//msg:Header",
        "@unique_identifier_msgs//msg:UUID",
    ],
)
