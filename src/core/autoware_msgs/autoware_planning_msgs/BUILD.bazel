load("@rosidl_default_generators//:defs.bzl", "default_generators", "rosidl_ament_package")

package(default_visibility = ["//visibility:public"])

default_generators(
    dependencies = [
        "@autoware_common_msgs",
        "@builtin_interfaces",
        "@geometry_msgs",
        "@std_msgs",
        "@unique_identifier_msgs",
    ],
    package_xml = "package.xml",
    deps = [
        "//msg:LaneletPrimitive",
        "//msg:LaneletRoute",
        "//msg:LaneletSegment",
        "//msg:Path",
        "//msg:PathPoint",
        "//msg:PoseWithUuidStamped",
        "//msg:RouteState",
        "//msg:Trajectory",
        "//msg:TrajectoryPoint",
        "//srv:ClearRoute",
        "//srv:SetLaneletRoute",
        "//srv:SetPreferredPrimitive",
        "//srv:SetWaypointRoute",
    ],
)

# Installable package (P4): the generated message libraries and the package.xml dependencies.
rosidl_ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    deps = [
        "@autoware_common_msgs//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@geometry_msgs//:ament_package",
        "@nav_msgs//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_default_runtime//:ament_package",
        "@std_msgs//:ament_package",
        "@unique_identifier_msgs//:ament_package",
    ],
)
