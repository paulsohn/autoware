load("@rosidl_default_generators//:defs.bzl", "default_generators", "rosidl_ament_package")

package(default_visibility = ["//visibility:public"])

default_generators(
    dependencies = [
        "@builtin_interfaces",
        "@std_msgs",
    ],
    package_xml = "package.xml",
    deps = [
        "//msg:ActuationCommand",
        "//msg:ActuationCommandStamped",
        "//msg:ActuationReport",
        "//msg:ActuationReportStamped",
        "//msg:ControlModeReport",
        "//msg:Engage",
        "//msg:GearCommand",
        "//msg:GearReport",
        "//msg:HazardLightsCommand",
        "//msg:HazardLightsReport",
        "//msg:SteeringReport",
        "//msg:TurnIndicatorsCommand",
        "//msg:TurnIndicatorsReport",
        "//msg:VelocityReport",
        "//srv:ControlModeCommand",
    ],
)

# Installable package (P4): the generated message libraries and the package.xml dependencies.
rosidl_ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    deps = [
        "@autoware_planning_msgs//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_default_runtime//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
