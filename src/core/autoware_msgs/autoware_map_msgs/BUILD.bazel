load("@rosidl_default_generators//:defs.bzl", "default_generators", "rosidl_ament_package")

package(default_visibility = ["//visibility:public"])

default_generators(
    dependencies = [
        "@geographic_msgs",
        "@sensor_msgs",
        "@std_msgs",
    ],
    package_xml = "package.xml",
    deps = [
        "//msg:AreaInfo",
        "//msg:LaneletMapBin",
        "//msg:LaneletMapCellMetaData",
        "//msg:LaneletMapMetaData",
        "//msg:MapProjectorInfo",
        "//msg:PointCloudMapCellMetaData",
        "//msg:PointCloudMapCellMetaDataWithID",
        "//msg:PointCloudMapCellWithID",
        "//msg:PointCloudMapMetaData",
        "//srv:GetDifferentialPointCloudMap",
        "//srv:GetPartialPointCloudMap",
        "//srv:GetSelectedLanelet2Map",
        "//srv:GetSelectedPointCloudMap",
    ],
)

# Installable package (P4): the generated message libraries and the package.xml dependencies.
rosidl_ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    deps = [
        "@geographic_msgs//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_default_runtime//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
