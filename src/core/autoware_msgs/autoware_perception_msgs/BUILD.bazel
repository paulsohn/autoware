load("@rosidl_default_generators//:defs.bzl", "default_generators", "rosidl_ament_package")

package(default_visibility = ["//visibility:public"])

default_generators(
    dependencies = [
        "@builtin_interfaces",
        "@geometry_msgs",
        "@std_msgs",
        "@unique_identifier_msgs",
    ],
    package_xml = "package.xml",
    deps = [
        "//msg:DetectedObject",
        "//msg:DetectedObjectKinematics",
        "//msg:DetectedObjects",
        "//msg:ObjectClassification",
        "//msg:PredictedObject",
        "//msg:PredictedObjectKinematics",
        "//msg:PredictedObjects",
        "//msg:PredictedPath",
        "//msg:PredictedTrafficLightState",
        "//msg:Shape",
        "//msg:TrackedObject",
        "//msg:TrackedObjectKinematics",
        "//msg:TrackedObjects",
        "//msg:TrafficLightElement",
        "//msg:TrafficLightGroup",
        "//msg:TrafficLightGroupArray",
        "//msg:TrafficSignal",
        "//msg:TrafficSignalArray",
        "//msg:TrafficSignalElement",
    ],
)

# Installable package (P4): the generated message libraries and the package.xml dependencies.
rosidl_ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    deps = [
        "@builtin_interfaces//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_default_runtime//:ament_package",
        "@std_msgs//:ament_package",
        "@unique_identifier_msgs//:ament_package",
    ],
)
