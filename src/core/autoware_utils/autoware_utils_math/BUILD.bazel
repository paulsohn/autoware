load("@autoware_cmake//:defs.bzl", "AUTOWARE_CXXOPTS", "AUTOWARE_DEFINES", "autoware_copts")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

DEPENDENCIES = {}

cc_library(
    name = "autoware_utils_math_library",
    srcs = [
        "src/sin_table.cpp",
        "src/trigonometry.cpp",
    ],
    hdrs = glob([
        "include/**/*.hpp",
    ]),
    includes = ["include"],
    copts = autoware_copts(),
    cxxopts = AUTOWARE_CXXOPTS,
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "autoware_utils_math",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":autoware_utils_math_library"],
    deps = [":autoware_utils_math_library"],
)

TEST_DEPENDENCIES = {}

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [":autoware_utils_math"] + TEST_DEPENDENCIES.keys(),
    visibility = ["//visibility:private"],
)

cc_test(
    name = "test_autoware_utils_math",
    srcs = [
        "test/cases/accumulator.cpp",
        "test/cases/constants.cpp",
        "test/cases/normalization.cpp",
        "test/cases/range.cpp",
        "test/cases/range_arange.cpp",
        "test/cases/range_linspace.cpp",
        "test/cases/trigonometry.cpp",
        "test/cases/unit_conversion.cpp",
        "test/main.cpp",
    ],
    data = [
        "@@//bazel/config:cyclonedds.xml",
    ],
    copts = autoware_copts(),
    cxxopts = AUTOWARE_CXXOPTS,
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    dynamic_deps = [":test_dynamic_deps"],
    deps = [":autoware_utils_math_library"] + DEPENDENCIES.values() + TEST_DEPENDENCIES.values() + [
        "@googletest//:gtest",
    ],
)
