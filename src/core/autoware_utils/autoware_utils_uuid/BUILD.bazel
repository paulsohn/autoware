load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_utils_uuid",
    hdrs = glob(["include/**/*.hpp"]),
    strip_include_prefix = "include",
    deps = [
        "@rosdistro//cc:boost.uuid",
        "@unique_identifier_msgs//:cc",
    ],
)

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = ["@unique_identifier_msgs//:cc_shared"],
)

cc_test(
    name = "test_autoware_utils_uuid",
    srcs = glob(["test/**/*.cpp"]),
    dynamic_deps = [":test_dynamic_deps"],
    deps = [
        ":autoware_utils_uuid",
        "@googletest//:gtest",
    ],
)
