load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

DEPENDENCIES = {
    "@unique_identifier_msgs//:cc_shared": "@unique_identifier_msgs//:cc",
}

cc_library(
    name = "autoware_utils_uuid_library",
    hdrs = glob([
        "include/**/*.hpp",
    ]),
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        "@rosdistro//cc:boost.uuid",
    ],
)

cc_shared_library(
    name = "autoware_utils_uuid",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":autoware_utils_uuid_library"],
    deps = [":autoware_utils_uuid_library"],
)

TEST_DEPENDENCIES = {}

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [":autoware_utils_uuid"] + TEST_DEPENDENCIES.keys(),
    visibility = ["//visibility:private"],
)

cc_test(
    name = "test_autoware_utils_uuid",
    srcs = [
        "test/cases/uuid_helper.cpp",
        "test/main.cpp",
    ],
    data = [
        "@@//bazel/config:cyclonedds.xml",
    ],
    dynamic_deps = [":test_dynamic_deps"],
    deps = [":autoware_utils_uuid_library"] + DEPENDENCIES.values() + TEST_DEPENDENCIES.values() + [
        "@googletest//:gtest",
    ],
)
