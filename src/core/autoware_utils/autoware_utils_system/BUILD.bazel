load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

collect_transitive_dynamic_deps(
    name = "dynamic_deps",
    dynamic_deps = ["@rclcpp//:rclcpp"],
)

cc_library(
    name = "autoware_utils_system",
    srcs = ["src/backtrace.cpp"],
    hdrs = glob(["include/**/*.hpp"]),
    strip_include_prefix = "include",
    deps = ["@rclcpp//:rclcpp_library"],
)

cc_test(
    name = "test_autoware_utils_system",
    srcs = glob(["test/**/*.cpp"]),
    dynamic_deps = [":dynamic_deps"],
    deps = [
        ":autoware_utils_system",
        "@googletest//:gtest",
    ],
)
