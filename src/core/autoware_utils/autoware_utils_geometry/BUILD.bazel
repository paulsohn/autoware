load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_utils_geometry",
    srcs = glob(["src/**/*.cpp"]),
    hdrs = glob(["include/**/*.hpp"]),
    strip_include_prefix = "include",
    deps = [
        "@autoware_internal_planning_msgs//:cc",
        "@autoware_perception_msgs//:cc",
        "@autoware_planning_msgs//:cc",
        "@autoware_utils_math//:autoware_utils_math",
        "@geometry_msgs//:cc",
        "@rosdistro//cc:boost.config",
        "@rosdistro//cc:boost.geometry",
        "@rosdistro//cc:eigen",
        "@tf2//:tf2_library",
        "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
    ],
)

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [
        "@autoware_internal_planning_msgs//:cc_shared",
        "@autoware_perception_msgs//:cc_shared",
        "@autoware_planning_msgs//:cc_shared",
        "@geometry_msgs//:cc_shared",
        "@tf2//:tf2",
        "@tf2_geometry_msgs//:tf2_geometry_msgs",
    ],
)

cc_test(
    name = "test_autoware_utils_geometry",
    srcs = glob(["test/**/*.cpp"]),
    dynamic_deps = [":test_dynamic_deps"],
    deps = [
        ":autoware_utils_geometry",
        "@autoware_utils_system//:autoware_utils_system",
        "@googletest//:gtest",
    ],
)
