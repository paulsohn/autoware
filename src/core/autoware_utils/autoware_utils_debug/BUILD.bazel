load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_utils_debug",
    srcs = ["src/time_keeper.cpp"],
    hdrs = glob(["include/**/*.hpp"]),
    strip_include_prefix = "include",
    deps = [
        "@autoware_internal_debug_msgs//:cc",
        "@autoware_internal_msgs//:cc",
        "@autoware_utils_system",
        "@diagnostic_msgs//:cc",
        "@rclcpp//:rclcpp_library",
        "@rosdistro//cc:fmt",
        "@std_msgs//:cc",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_internal_debug_msgs//:cc_shared",
        "@autoware_internal_msgs//:cc_shared",
        "@diagnostic_msgs//:cc_shared",
        "@rclcpp//:rclcpp",
        "@std_msgs//:cc_shared",
    ],
)

cc_test(
    name = "test_autoware_utils_debug",
    srcs = glob(["test/**/*.cpp"]),
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [
        ":autoware_utils_debug",
        "@googletest//:gtest",
    ],
)
