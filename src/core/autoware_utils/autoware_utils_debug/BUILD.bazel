load("@rosdistro//ament:defs.bzl", "ament_package")
load("@autoware_cmake//:defs.bzl", "AUTOWARE_CXXOPTS", "AUTOWARE_DEFINES", "autoware_copts")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

DEPENDENCIES = {
    "@autoware_internal_debug_msgs//:cc_shared": "@autoware_internal_debug_msgs//:cc",
    "@autoware_internal_msgs//:cc_shared": "@autoware_internal_msgs//:cc",
    "@autoware_utils_system//:autoware_utils_system": "@autoware_utils_system//:autoware_utils_system_library",
    "@diagnostic_msgs//:cc_shared": "@diagnostic_msgs//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosidl_runtime_cpp//:rosidl_runtime_cpp": "@rosidl_runtime_cpp//:rosidl_runtime_cpp_library",
    "@std_msgs//:cc_shared": "@std_msgs//:cc",
}

cc_library(
    name = "autoware_utils_debug_library",
    srcs = [
        "src/time_keeper.cpp",
    ],
    hdrs = glob([
        "include/**/*.hpp",
    ]),
    includes = ["include"],
    copts = autoware_copts(),
    cxxopts = AUTOWARE_CXXOPTS,
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    deps = DEPENDENCIES.values() + [
        "@rosdistro//cc:fmt",
    ],
)

cc_shared_library(
    name = "autoware_utils_debug",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":autoware_utils_debug_library"],
    deps = [":autoware_utils_debug_library"],
)

TEST_DEPENDENCIES = {}

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [":autoware_utils_debug"] + TEST_DEPENDENCIES.keys(),
    visibility = ["//visibility:private"],
)

cc_test(
    name = "test_autoware_utils_debug",
    srcs = [
        "test/cases/debug_publisher.cpp",
        "test/cases/debug_traits.cpp",
        "test/cases/processing_time_publisher.cpp",
        "test/cases/published_time_publisher.cpp",
        "test/cases/time_keeper.cpp",
        "test/main.cpp",
    ],
    data = [
        "@@//bazel/config:cyclonedds.xml",
    ],
    copts = autoware_copts(),
    cxxopts = AUTOWARE_CXXOPTS,
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    dynamic_deps = [":test_dynamic_deps"],
    deps = [":autoware_utils_debug_library"] + DEPENDENCIES.values() + TEST_DEPENDENCIES.values() + [
        "@googletest//:gtest",
    ],
)

# Installable package (P4): the shared libraries and the package.xml dependencies.
ament_package(
    name = "ament_package",
    libraries = [
        ":autoware_utils_debug",
    ],
    package_xml = "package.xml",
    deps = [
        "@autoware_internal_debug_msgs//:ament_package",
        "@autoware_internal_msgs//:ament_package",
        "@autoware_utils_system//:ament_package",
        "@diagnostic_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_runtime_cpp//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
