load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_utils_rclcpp",
    hdrs = glob(["include/**/*.hpp"]),
    strip_include_prefix = "include",
    deps = ["@rclcpp//:rclcpp_library"],
)

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [
        "@rclcpp//:rclcpp",
        "@std_msgs//:cc_shared",
    ],
)

cc_test(
    name = "test_autoware_utils_rclcpp",
    srcs = glob(["test/**/*.cpp"]),
    dynamic_deps = [":test_dynamic_deps"],
    deps = [
        ":autoware_utils_rclcpp",
        "@googletest//:gtest",
        "@std_msgs//:cc",
    ],
)
