load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

DEPENDENCIES = {
    "@autoware_utils_geometry//:autoware_utils_geometry": "@autoware_utils_geometry//:autoware_utils_geometry_library",
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
}

cc_library(
    name = "autoware_utils_tf_library",
    hdrs = glob([
        "include/**/*.hpp",
    ]),
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "autoware_utils_tf",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":autoware_utils_tf_library"],
    deps = [":autoware_utils_tf_library"],
)

TEST_DEPENDENCIES = {}

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [":autoware_utils_tf"] + TEST_DEPENDENCIES.keys(),
    visibility = ["//visibility:private"],
)

cc_test(
    name = "test_autoware_utils_tf",
    srcs = [
        "test/cases/self_pose_listener.cpp",
        "test/cases/transform_listener.cpp",
        "test/main.cpp",
    ],
    data = [
        "@@//bazel/config:cyclonedds.xml",
    ],
    dynamic_deps = [":test_dynamic_deps"],
    deps = [":autoware_utils_tf_library"] + DEPENDENCIES.values() + TEST_DEPENDENCIES.values() + [
        "@googletest//:gtest",
    ],
)
