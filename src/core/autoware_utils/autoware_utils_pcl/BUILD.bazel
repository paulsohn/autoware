load("@autoware_cmake//:defs.bzl", "AUTOWARE_CXXOPTS", "AUTOWARE_DEFINES", "autoware_copts")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

# Deliberate differences from CMakeLists.txt (checked by bazel/tools/cmake_parity):
# cmake-diff dep:pcl_ros: the headers use only pcl_conversions and PCL; pcl_ros is not needed to build or test.

DEPENDENCIES = {
    "@rosdistro//cc:pcl": "@rosdistro//cc:pcl_library",
    "@autoware_utils_tf//:autoware_utils_tf": "@autoware_utils_tf//:autoware_utils_tf_library",
    "@pcl_conversions//:pcl_conversions": "@pcl_conversions//:pcl_conversions_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@sensor_msgs//:cc_shared": "@sensor_msgs//:cc",
}

cc_library(
    name = "autoware_utils_pcl_library",
    hdrs = glob([
        "include/**/*.hpp",
    ]),
    includes = ["include"],
    copts = autoware_copts(),
    cxxopts = AUTOWARE_CXXOPTS,
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    deps = DEPENDENCIES.values() + [
        "@rosdistro//cc:eigen",
    ],
)

cc_shared_library(
    name = "autoware_utils_pcl",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":autoware_utils_pcl_library"],
    deps = [":autoware_utils_pcl_library"],
)

TEST_DEPENDENCIES = {}

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [":autoware_utils_pcl"] + TEST_DEPENDENCIES.keys(),
    visibility = ["//visibility:private"],
)

cc_test(
    name = "test_autoware_utils_pcl",
    srcs = [
        "test/cases/pcl_conversion.cpp",
        "test/cases/transform.cpp",
    ],
    data = [
        "@@//bazel/config:cyclonedds.xml",
    ],
    copts = autoware_copts(),
    cxxopts = AUTOWARE_CXXOPTS,
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    dynamic_deps = [":test_dynamic_deps"],
    deps = [":autoware_utils_pcl_library"] + DEPENDENCIES.values() + TEST_DEPENDENCIES.values() + [
        "@rosdistro//cc:googletest",
    ],
)
