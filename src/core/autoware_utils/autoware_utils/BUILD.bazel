load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_utils",
    hdrs = glob(["include/**/*.hpp"]),
    strip_include_prefix = "include",
    deps = [
        "@autoware_utils_debug",
        "@autoware_utils_diagnostics",
        "@autoware_utils_geometry",
        "@autoware_utils_logging",
        "@autoware_utils_math",
        "@autoware_utils_pcl",
        "@autoware_utils_rclcpp",
        "@autoware_utils_system",
        "@autoware_utils_tf",
        "@autoware_utils_uuid",
        "@autoware_utils_visualization",
    ],
)

# Keep SDK globals in their shared owners when this facade enters a component DSO.
collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_utils_debug//:runtime_dynamic_deps",
        "@autoware_utils_pcl//:runtime_dynamic_deps",
        "@autoware_internal_planning_msgs//:cc_shared",
        "@autoware_perception_msgs//:cc_shared",
        "@autoware_planning_msgs//:cc_shared",
        "@diagnostic_updater//:diagnostic_updater",
        "@geometry_msgs//:cc_shared",
        "@logging_demo//:cc_shared",
        "@rcutils//:rcutils",
        "@tf2//:tf2",
        "@tf2_geometry_msgs//:tf2_geometry_msgs",
        "@tf2_ros//:tf2_ros",
        "@unique_identifier_msgs//:cc_shared",
        "@visualization_msgs//:cc_shared",
    ],
)
