load("@qt//:qt.bzl", "qt_cc_library", "qt_cc_shared_library")
load("@rosdistro//ament:defs.bzl", "ament_index")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")

package(default_visibility = ["//visibility:public"])

# Isolate equal header basenames because the Qt helper flattens moc output names.
qt_cc_library(
    name = "autoware_planning_rviz_plugin_moc_part_1",
    srcs = [],
    moc_hdrs = ["include/autoware_planning_rviz_plugin/pose_with_uuid_stamped/display.hpp"],
    hdrs = glob(["include/**/*.hpp", "src/**/*.hpp"], allow_empty = True),
    copts = ["-include", "char_traits_patch.h"],
    includes = ["include", "src"],
    defines = ["PLUGINLIB__DISABLE_BOOST_FUNCTIONS", "QT_NO_KEYWORDS"],
    deps = [
        "@autoware_internal_planning_msgs//:cc",
        "@autoware_planning_msgs//:cc",
        "@autoware_utils",
        "@autoware_vehicle_info_utils",
        "@geometry_msgs//:cc",
        "@libx11",
        "@pluginlib//:pluginlib_library",
        "@qtbase//:widgets",
        "@rclcpp//:rclcpp_library",
        "@rosdistro//cc:OgreMain_library",
        "@rosdistro//cc:OgreOverlay_library",
        "@rosdistro//cc:boost.geometry",
        "@rosdistro//cc:eigen",
        "@rviz_2d_overlay_msgs//:cc",
        "@rviz_2d_overlay_plugins//:rviz_2d_overlay_plugins_library",
        "@rviz_common//:rviz_common_library",
        "@rviz_default_plugins//:rviz_default_plugins_library",
        "@rviz_rendering//:rviz_rendering_library",
        "@tf2//:tf2_library",
        "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
        "@tf2_ros//:tf2_ros_library",
    ],
)

qt_cc_library(
    name = "autoware_planning_rviz_plugin_library",
    moc_hdrs = [
        "include/autoware_planning_rviz_plugin/candidate_trajectories/candidate_trajectories_display.hpp",
        "include/autoware_planning_rviz_plugin/candidate_trajectories/scored_candidate_trajectories_display.hpp",
        "include/autoware_planning_rviz_plugin/mission_checkpoint/mission_checkpoint.hpp",
        "include/autoware_planning_rviz_plugin/path/display.hpp",
        "src/tools/max_velocity.hpp",
    ],
    srcs = glob(["src/**/*.cpp"]),
    hdrs = glob(["include/**/*.hpp", "src/**/*.hpp"], allow_empty = True),
    copts = ["-include", "char_traits_patch.h"],
    includes = ["include", "src"],
    defines = ["PLUGINLIB__DISABLE_BOOST_FUNCTIONS", "QT_NO_KEYWORDS"],
    deps = [
        ":autoware_planning_rviz_plugin_moc_part_1",
        "@autoware_internal_planning_msgs//:cc",
        "@autoware_planning_msgs//:cc",
        "@autoware_utils",
        "@autoware_vehicle_info_utils",
        "@geometry_msgs//:cc",
        "@libx11",
        "@pluginlib//:pluginlib_library",
        "@qtbase//:widgets",
        "@rclcpp//:rclcpp_library",
        "@rosdistro//cc:OgreMain_library",
        "@rosdistro//cc:OgreOverlay_library",
        "@rosdistro//cc:boost.geometry",
        "@rosdistro//cc:eigen",
        "@rviz_2d_overlay_msgs//:cc",
        "@rviz_2d_overlay_plugins//:rviz_2d_overlay_plugins_library",
        "@rviz_common//:rviz_common_library",
        "@rviz_default_plugins//:rviz_default_plugins_library",
        "@rviz_rendering//:rviz_rendering_library",
        "@tf2//:tf2_library",
        "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
        "@tf2_ros//:tf2_ros_library",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_internal_planning_msgs//:cc_shared",
        "@autoware_planning_msgs//:cc_shared",
        "@autoware_utils//:runtime_dynamic_deps",
        "@geometry_msgs//:cc_shared",
        "@pluginlib//:pluginlib",
        "@rclcpp//:rclcpp",
        "@rosdistro//cc:OgreMain",
        "@rosdistro//cc:OgreOverlay",
        "@rviz_2d_overlay_msgs//:cc_shared",
        "@rviz_2d_overlay_plugins//:rviz_2d_overlay_plugins",
        "@rviz_common//:rviz_common",
        "@rviz_default_plugins//:rviz_default_plugins",
        "@rviz_rendering//:rviz_rendering",
        "@tf2//:tf2",
        "@tf2_geometry_msgs//:tf2_geometry_msgs",
        "@tf2_ros//:tf2_ros",
    ],
)

qt_cc_shared_library(
    name = "autoware_planning_rviz_plugin",
    shared_lib_name = "libautoware_planning_rviz_plugin.so",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":autoware_planning_rviz_plugin_library"],
)

ament_index(
    package_xml = "package.xml",
    data = glob(["icons/**", "images/**", "plugins/**"]),
    libraries = [":autoware_planning_rviz_plugin"],
    deps = ["@rviz_common//:ament_index", "@rviz_default_plugins//:ament_index"],
    plugin_categories = {"plugins/plugin_description.xml": "rviz_common"},
)
