load("@qt//:qt.bzl", "qt_cc_library", "qt_cc_shared_library")
load("@rosdistro//ament:defs.bzl", "ament_index")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")

package(default_visibility = ["//visibility:public"])

qt_cc_library(
    name = "autoware_perception_rviz_plugin_library",
    moc_hdrs = [
        "include/autoware_perception_rviz_plugin/object_detection/detected_objects_display.hpp",
        "include/autoware_perception_rviz_plugin/object_detection/predicted_objects_display.hpp",
        "include/autoware_perception_rviz_plugin/object_detection/tracked_objects_display.hpp",
        "include/autoware_perception_rviz_plugin/traffic_light/traffic_light_display.hpp",
    ],
    srcs = glob(["src/**/*.cpp"]),
    hdrs = glob(["include/**/*.hpp", "src/**/*.hpp"], allow_empty = True),
    includes = ["include", "src"],
    defines = ["PLUGINLIB__DISABLE_BOOST_FUNCTIONS"],
    local_defines = ["OBJECT_DETECTION_PLUGINS_BUILDING_LIBRARY"],
    deps = [
        "@autoware_lanelet2_extension//:autoware_lanelet2_extension_lib_library",
        "@autoware_map_msgs//:cc",
        "@autoware_perception_msgs//:cc",
        "@geometry_msgs//:cc",
        "@pluginlib//:pluginlib_library",
        "@qtbase//:widgets",
        "@rclcpp//:rclcpp_library",
        "@rosdistro//cc:OgreMain_library",
        "@rosdistro//cc:OgreOverlay_library",
        "@rosdistro//cc:boost.geometry",
        "@rosdistro//cc:boost.uuid",
        "@rosdistro//cc:eigen",
        "@rviz_common//:rviz_common_library",
        "@rviz_default_plugins//:rviz_default_plugins_library",
        "@rviz_rendering//:rviz_rendering_library",
        "@tf2//:tf2_library",
        "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
        "@tf2_ros//:tf2_ros_library",
        "@unique_identifier_msgs//:cc",
        "@visualization_msgs//:cc",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_lanelet2_extension//:autoware_lanelet2_extension_lib",
        "@autoware_map_msgs//:cc_shared",
        "@autoware_perception_msgs//:cc_shared",
        "@geometry_msgs//:cc_shared",
        "@pluginlib//:pluginlib",
        "@rclcpp//:rclcpp",
        "@rosdistro//cc:OgreMain",
        "@rosdistro//cc:OgreOverlay",
        "@rviz_common//:rviz_common",
        "@rviz_default_plugins//:rviz_default_plugins",
        "@rviz_rendering//:rviz_rendering",
        "@tf2//:tf2",
        "@tf2_geometry_msgs//:tf2_geometry_msgs",
        "@tf2_ros//:tf2_ros",
        "@unique_identifier_msgs//:cc_shared",
        "@visualization_msgs//:cc_shared",
    ],
)

qt_cc_shared_library(
    name = "autoware_perception_rviz_plugin",
    shared_lib_name = "libautoware_perception_rviz_plugin.so",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":autoware_perception_rviz_plugin_library"],
)

ament_index(
    package_xml = "package.xml",
    data = glob(["icons/**", "images/**", "meshes/**"]),
    libraries = [":autoware_perception_rviz_plugin"],
    deps = ["@rviz_common//:ament_index", "@rviz_default_plugins//:ament_index"],
    plugin_categories = {"plugins_description.xml": "rviz_common"},
)
