load("@rules_cc//cc:defs.bzl", "cc_import")
load("@rules_rs//rs:rust_shared_library.bzl", "rust_shared_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "Cargo.lock",
    "Cargo.toml",
])

cc_import(
    name = "agnocast_runtime",
    shared_library = "@agnocastlib//:agnocast",
)

rust_shared_library(
    name = "agnocast_heaphook",
    srcs = glob(["src/*.rs"]),
    crate_root = "src/lib.rs",
    edition = "2021",
    rustc_env = {"CARGO_PKG_VERSION": "2.4.1"},
    # Match the workspace glibc 2.34 ABI floor without inspecting the host.
    rustc_flags = ["--cfg=glibc_pre_2_35"],
    deps = [
        ":agnocast_runtime",
        "@heaphook_crates//:libc",
        "@heaphook_crates//:rlsf",
    ],
)

rust_test(
    name = "unit_tests",
    srcs = glob(["src/*.rs"]),
    crate_root = "src/lib.rs",
    edition = "2021",
    rustc_env = {"CARGO_PKG_VERSION": "2.4.1"},
    # The existing test fixture uses the default bootstrap path; its legacy
    # startup resolver is excluded by cfg(not(test)). Runs on Ubuntu 24.04.
    deps = [
        "@heaphook_crates//:libc",
        "@heaphook_crates//:rlsf",
    ],
)
