module(name = "agnocast_heaphook", version = "0.0.0")

bazel_dep(name = "agnocastlib", version = "0.0.0")
bazel_dep(name = "rules_cc", version = "0.2.26.rcr.0")
bazel_dep(name = "rules_rs", version = "0.1.0")

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "heaphook_crates",
    cargo_toml = "//:Cargo.toml",
    cargo_lock = "//:Cargo.lock",
    platform_triples = ["x86_64-unknown-linux-gnu"],
)
use_repo(crate, "heaphook_crates")
