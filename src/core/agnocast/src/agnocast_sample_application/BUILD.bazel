load("@agnocast_components//:defs.bzl", "agnocast_components_register_node")
load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_package", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "@agnocastlib//:agnocast_library",
    "@agnocast_sample_interfaces//:cc",
    "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components_library",
    "@std_msgs//:cc",
    "@agnocast_cie_thread_configurator//:agnocast_cie_thread_configurator",
]

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@agnocastlib//:agnocast",
        "@agnocast_sample_interfaces//:cc_shared",
        "@rclcpp_components//:rclcpp_components",
        "@std_msgs//:cc_shared",
    ],
)

cc_binary(
    name = "talker",
    srcs = ["src/minimal_publisher.cpp"],
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = _DEPS,
)

cc_binary(
    name = "generic_talker",
    srcs = ["src/minimal_generic_publisher.cpp"],
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = _DEPS,
)

cc_binary(
    name = "cie_tutorial_node",
    srcs = ["src/cie_tutorial_node.cpp"],
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = _DEPS,
)

cc_binary(
    name = "cie_talker",
    srcs = ["src/cie_publisher.cpp"],
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = _DEPS,
)

cc_binary(
    name = "no_rclcpp_pubsub",
    srcs = ["src/no_rclcpp_pubsub.cpp"],
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = _DEPS,
)

cc_binary(
    name = "no_rclcpp_talker",
    srcs = ["src/no_rclcpp_publisher.cpp"],
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = _DEPS,
)

cc_binary(
    name = "no_rclcpp_take_listener",
    srcs = ["src/no_rclcpp_take_subscriber.cpp"],
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = _DEPS,
)

cc_binary(
    name = "client",
    srcs = ["src/minimal_client.cpp"],
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = _DEPS,
)

cc_binary(
    name = "server",
    srcs = ["src/minimal_server.cpp"],
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = _DEPS,
)

cc_binary(
    name = "no_rclcpp_server",
    srcs = ["src/no_rclcpp_server.cpp"],
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = _DEPS,
)

cc_binary(
    name = "no_rclcpp_client",
    srcs = ["src/no_rclcpp_client.cpp"],
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = _DEPS,
)

cc_binary(
    name = "sim_time_timer",
    srcs = ["src/sim_time_timer.cpp"],
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = _DEPS,
)

cc_library(
    name = "cie_listener_library",
    srcs = ["src/cie_subscriber.cpp"],
    deps = _DEPS,
)

cc_shared_library(
    name = "cie_listener_component",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":cie_listener_library"],
)

agnocast_components_register_node(
    name = "cie_listener",
    component = ":cie_listener_component",
    plugin = "CieSubscriber",
)

cc_library(
    name = "no_rclcpp_listener_library",
    srcs = ["src/no_rclcpp_subscriber.cpp"],
    deps = _DEPS,
)

cc_shared_library(
    name = "no_rclcpp_listener_component",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":no_rclcpp_listener_library"],
)

agnocast_components_register_node(
    name = "no_rclcpp_listener",
    agnocast_only = True,
    component = ":no_rclcpp_listener_component",
    executor = "AgnocastOnlySingleThreadedExecutor",
    plugin = "NoRclcppSubscriber",
)

cc_library(
    name = "listener_library",
    srcs = ["src/minimal_subscriber.cpp"],
    deps = _DEPS,
)

cc_shared_library(
    name = "listener_component",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":listener_library"],
)

agnocast_components_register_node(
    name = "listener",
    component = ":listener_component",
    plugin = "MinimalSubscriber",
)

cc_library(
    name = "generic_listener_library",
    srcs = ["src/minimal_generic_subscriber.cpp"],
    deps = _DEPS,
)

cc_shared_library(
    name = "generic_listener_component",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":generic_listener_library"],
)

agnocast_components_register_node(
    name = "generic_listener",
    component = ":generic_listener_component",
    plugin = "MinimalGenericSubscriber",
)

register_ament_files(
    name = "executable_index",
    files = [
        ":cie_listener",
        ":cie_talker",
        ":cie_tutorial_node",
        ":client",
        ":generic_listener",
        ":generic_talker",
        ":listener",
        ":no_rclcpp_client",
        ":no_rclcpp_listener",
        ":no_rclcpp_pubsub",
        ":no_rclcpp_server",
        ":no_rclcpp_take_listener",
        ":no_rclcpp_talker",
        ":server",
        ":sim_time_timer",
        ":talker",
    ],
    prefix = "lib/agnocast_sample_application",
    strip_prefix = "*",
)

ament_package(
    components = [
        ":cie_listener_record",
        ":no_rclcpp_listener_record",
        ":listener_record",
        ":generic_listener_record",
    ],
    data = [":executable_index"] + glob(["launch/**"]),
    executables = [
        ":talker",
        ":generic_talker",
        ":cie_tutorial_node",
        ":cie_talker",
        ":no_rclcpp_pubsub",
        ":no_rclcpp_talker",
        ":no_rclcpp_take_listener",
        ":client",
        ":server",
        ":no_rclcpp_server",
        ":no_rclcpp_client",
        ":sim_time_timer",
        ":cie_listener",
        ":no_rclcpp_listener",
        ":listener",
        ":generic_listener",
    ],
    deps = [
        "@agnocast_components//:ament_package",
        "@agnocast_sample_interfaces//:ament_package",
        "@agnocastlib//:ament_package",
    ],
)
