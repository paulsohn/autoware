load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

# Client API and announcement transport required by agnocastlib. Daemon
# scheduling logic and executables remain a separate target gate.
cc_library(
    name = "agnocast_cie_thread_configurator",
    srcs = [
        "src/announcement_sources.cpp",
        "src/non_ros_thread_ipc.cpp",
        "src/util.cpp",
    ],
    hdrs = [
        "include/agnocast_cie_thread_configurator/announcement_sources.hpp",
        "include/agnocast_cie_thread_configurator/cie_thread_configurator.hpp",
        "include/agnocast_cie_thread_configurator/non_ros_thread_ipc.hpp",
    ],
    strip_include_prefix = "include",
    deps = [
        "@agnocast_cie_config_msgs//:cc",
        "@rclcpp//:rclcpp_library",
    ],
)

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [
        "@agnocast_cie_config_msgs//:cc_shared",
        "@rclcpp//:rclcpp",
    ],
)

cc_test(
    name = "test_non_ros_thread_ipc",
    srcs = ["test/test_non_ros_thread_ipc.cpp"],
    dynamic_deps = [":test_dynamic_deps"],
    deps = [
        ":agnocast_cie_thread_configurator",
        "@googletest//:gtest_main",
    ],
)
