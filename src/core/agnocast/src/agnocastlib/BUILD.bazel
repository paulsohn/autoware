load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")

package(default_visibility = ["//visibility:public"])

genrule(
    name = "agnocast_version_hpp",
    srcs = [
        "include/agnocast/agnocast_version.hpp.in",
        "package.xml",
    ],
    outs = ["include/agnocast/agnocast_version.hpp"],
    cmd = "version=$$(sed -n 's:.*<version>\\(.*\\)</version>.*:\\1:p' $(location package.xml) | head -1) && " +
          "sed -e 's/[$$]{PROJECT_NAME}/agnocastlib/g' -e \"s/[$$]{PACKAGE_VERSION}/$$version/g\" " +
          "$(location include/agnocast/agnocast_version.hpp.in) > $@",
)

_DYNAMIC_DEPS = [
    "@agnocast_cie_config_msgs//:cc_shared",
    "@ament_index_cpp//:ament_index_cpp",
    "@diagnostic_msgs//:cc_shared",
    "@diagnostic_updater//:diagnostic_updater",
    "@geometry_msgs//:cc_shared",
    "@message_filters//:message_filters",
    "@rcl_yaml_param_parser//:rcl_yaml_param_parser",
    "@rclcpp//:rclcpp",
    "@rcpputils//:rcpputils",
    "@rmw//:rmw",
    "@rosgraph_msgs//:cc_shared",
    "@rosidl_typesupport_introspection_cpp//:rosidl_typesupport_introspection_cpp",
    "@service_msgs//:cc_shared",
    "@tf2//:tf2",
    "@tf2_msgs//:cc_shared",
    "@tf2_ros//:tf2_ros",
    "@tracetools//:tracetools",
] + select({
    "@rosdistro//:tracing_enabled_linux": ["@rosdistro//cc:lttng_ust_shared"],
    "//conditions:default": [],
})

cc_library(
    name = "agnocast_library",
    srcs = [
        "src/agnocast.cpp",
        "src/agnocast_callback_info.cpp",
        "src/agnocast_callback_isolated_executor.cpp",
        "src/agnocast_client.cpp",
        "src/agnocast_epoll.cpp",
        "src/agnocast_epoll_update_dispatcher.cpp",
        "src/agnocast_executor.cpp",
        "src/agnocast_multi_threaded_executor.cpp",
        "src/agnocast_publisher.cpp",
        "src/agnocast_service.cpp",
        "src/agnocast_service_event_publisher.cpp",
        "src/agnocast_single_threaded_executor.cpp",
        "src/agnocast_smart_pointer.cpp",
        "src/agnocast_subscription.cpp",
        "src/agnocast_timer.cpp",
        "src/agnocast_timer_info.cpp",
        "src/agnocast_tracepoint_wrapper.c",
        "src/agnocast_utils.cpp",
        "src/bridge/agnocast_bridge_ipc_event_loop.cpp",
        "src/bridge/agnocast_bridge_loader.cpp",
        "src/bridge/agnocast_bridge_manager.cpp",
        "src/bridge/agnocast_bridge_utils.cpp",
        "src/bridge/agnocast_service_bridge.cpp",
        "src/cie_client_utils.cpp",
        "src/internal/service_typesupport.cpp",
        "src/internal/type_registry_writer.cpp",
        "src/node/agnocast_arguments.cpp",
        "src/node/agnocast_context.cpp",
        "src/node/agnocast_node.cpp",
        "src/node/agnocast_only_callback_isolated_executor.cpp",
        "src/node/agnocast_only_executor.cpp",
        "src/node/agnocast_only_multi_threaded_executor.cpp",
        "src/node/agnocast_only_single_threaded_executor.cpp",
        "src/node/agnocast_parameter_client.cpp",
        "src/node/agnocast_parameter_service.cpp",
        "src/node/agnocast_signal_handler.cpp",
        "src/node/diagnostic_updater/diagnostic_updater.cpp",
        "src/node/node_interfaces/node_base.cpp",
        "src/node/node_interfaces/node_clock.cpp",
        "src/node/node_interfaces/node_graph.cpp",
        "src/node/node_interfaces/node_logging.cpp",
        "src/node/node_interfaces/node_parameters.cpp",
        "src/node/node_interfaces/node_services.cpp",
        "src/node/node_interfaces/node_time_source.cpp",
        "src/node/node_interfaces/node_topics.cpp",
        "src/node/tf2/buffer.cpp",
        "src/node/tf2/static_transform_broadcaster.cpp",
        "src/node/tf2/transform_broadcaster.cpp",
        "src/node/tf2/transform_listener.cpp",
        "src/vendor/rclcpp/generic_client.cpp",
        "src/vendor/rclcpp/generic_service.cpp",
    ] + glob(["src/**/*.hpp"]),
    hdrs = glob([
        "include/**/*.h",
        "include/**/*.hpp",
    ]) + [":agnocast_version_hpp"],
    copts = [
        "-Wall",
        "-Wextra",
        "-Wpedantic",
    ],
    cxxopts = ["-std=c++17"],
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = [
        "@agnocast_cie_config_msgs//:cc",
        "@agnocast_cie_thread_configurator//:agnocast_cie_thread_configurator",
        "@ament_index_cpp//:ament_index_cpp_library",
        "@diagnostic_msgs//:cc",
        "@diagnostic_updater//:diagnostic_updater_library",
        "@geometry_msgs//:cc",
        "@message_filters//:message_filters_library",
        "@rcl_yaml_param_parser//:rcl_yaml_param_parser_library",
        "@rclcpp//:rclcpp_library",
        "@rcpputils//:rcpputils_library",
        "@rmw//:rmw_library",
        "@rosgraph_msgs//:cc",
        "@rosidl_typesupport_introspection_cpp//:rosidl_typesupport_introspection_cpp_library",
        "@service_msgs//:cc",
        "@tf2//:tf2_library",
        "@tf2_msgs//:cc",
        "@tf2_ros//:tf2_ros_library",
        "@tracetools//:tracetools_library",
    ] + select({
        "@rosdistro//:tracing_enabled_linux": ["@rosdistro//cc:lttng_ust"],
        "//conditions:default": [],
    }),
)

cc_shared_library(
    name = "agnocast",
    dynamic_deps = _DYNAMIC_DEPS,
    exports_filter = [":agnocast_library"],
    deps = [":agnocast_library"],
)
