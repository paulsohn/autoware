package(default_visibility = ["//visibility:public"])

genrule(
    name = "agnocast_version_hpp",
    srcs = [
        "include/agnocast/agnocast_version.hpp.in",
        "package.xml",
    ],
    outs = ["include/agnocast/agnocast_version.hpp"],
    cmd = "version=$$(sed -n 's:.*<version>\\(.*\\)</version>.*:\\1:p' $(location package.xml) | head -1) && " +
          "sed -e 's/[$$]{PROJECT_NAME}/agnocastlib/g' -e \"s/[$$]{PACKAGE_VERSION}/$$version/g\" " +
          "$(location include/agnocast/agnocast_version.hpp.in) > $@",
)

