# CMake labels some tests "requires_kernel_module;requires_heaphook" and runs them with libagnocast_heaphook.so
# preloaded (test_integration_agnocast_heaphook: only "requires_heaphook", with libinitialize_shutdown_mock.so
# preloaded first): heaphook_test from @agnocast_heaphook does the same. --config=no-agnocast skips the
# requires_kernel_module ones.
# no-sandbox: Agnocast names shared memory after the process ID and the kernel module tracks host PIDs; Bazel's
# Linux sandbox gives each test its own PID namespace, so concurrent sandboxed tests collide ("shm_open failed:
# File exists").
REQUIRES_HEAPHOOK = [
    "requires_kernel_module",
    "requires_heaphook",
    "no-sandbox",
]

