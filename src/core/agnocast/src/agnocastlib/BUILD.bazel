# TRACETOOLS_DISABLED and agnocast_tracepoint_wrapper.c compiles no tracepoints. See the selects below.

# Agnocast's own flags (not autoware_package()).
COPTS = [
    "-Wall",
    "-Wextra",
    "-Wpedantic",
]

CXXOPTS = ["-std=c++17"]

# include/agnocast/agnocast_version.hpp from the template and package.xml's <version>.
genrule(
    name = "agnocast_version_hpp",
    srcs = [
        "include/agnocast/agnocast_version.hpp.in",
        "package.xml",
    ],
    outs = ["include/agnocast/agnocast_version.hpp"],
    cmd = "v=$$(sed -n 's:.*<version>\\(.*\\)</version>.*:\\1:p' $(location package.xml) | head -1) && " +
          "sed -e 's/[$$]{PROJECT_NAME}/agnocastlib/g' -e \"s/[$$]{PACKAGE_VERSION}/$$v/g\" " +
          "$(location include/agnocast/agnocast_version.hpp.in) > $@",
)

