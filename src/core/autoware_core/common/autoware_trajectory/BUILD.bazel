load("@rosdistro//ament:defs.bzl", "ament_index")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_trajectory",
    srcs = glob(["src/**/*.cpp"]),
    hdrs = glob(["include/**/*.hpp"]),
    # Match upstream CMake: deleted default constructors remain aggregates in C++17.
    copts = ["-std=c++17"],
    strip_include_prefix = "include",
    deps = [
        "@autoware_internal_planning_msgs//:cc",
        "@autoware_lanelet2_utils",
        "@autoware_planning_msgs//:cc",
        "@autoware_utils_geometry",
        "@autoware_utils_math",
        "@builtin_interfaces//:cc",
        "@geometry_msgs//:cc",
        "@lanelet2_core//:lanelet2_core_library",
        "@lanelet2_routing//:lanelet2_routing_library",
        "@lanelet2_traffic_rules//:lanelet2_traffic_rules_library",
        "@rclcpp//:rclcpp_library",
        "@rosdistro//cc:boost.geometry",
        "@rosdistro//cc:boost.scope_exit",
        "@rosdistro//cc:eigen",
        "@rosdistro//cc:fmt",
        "@rosdistro//cc:tl_expected",
        "@tf2//:tf2_library",
        "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_internal_planning_msgs//:cc_shared",
        "@autoware_lanelet2_utils//:runtime_dynamic_deps",
        "@autoware_planning_msgs//:cc_shared",
        "@builtin_interfaces//:cc_shared",
        "@geometry_msgs//:cc_shared",
        "@rclcpp//:rclcpp",
        "@tf2//:tf2",
        "@tf2_geometry_msgs//:tf2_geometry_msgs",
    ],
)

ament_index(
    data = glob(["test_data/**"]),
    package_xml = "package.xml",
)

cc_test(
    name = "test_autoware_trajectory",
    timeout = "long",
    srcs = glob([
        "test/*.cpp",
        "test/*.hpp",
    ]),
    data = [
        ":ament_index",
        "@autoware_lanelet2_utils//:ament_index",
        "@autoware_test_utils//:ament_index",
    ],
    defines = ["PLOT"],
    dynamic_deps = [
        ":runtime_dynamic_deps",
        "@ament_index_cpp//:ament_index_cpp",
        "@autoware_motion_utils//:runtime_dynamic_deps",
        "@autoware_test_utils//:runtime_dynamic_deps",
    ],
    env = {
        "ROS_DOMAIN_ID": "64",
        "ENABLE_TEST_PLOT": "1",
    },
    deps = [
        ":autoware_trajectory",
        "@ament_index_cpp//:ament_index_cpp_library",
        "@autoware_motion_utils",
        "@autoware_pyplot",
        "@autoware_test_utils",
        "@autoware_test_utils//:visualization",
        "@googletest//:gtest",
        "@lanelet2_io//:lanelet2_io_library",
        "@rosdistro//cc:range-v3",
        "@rosdistro//cc:yaml-cpp_library",
    ],
)

[
    cc_binary(
        name = name,
        srcs = ["examples/" + name + ".cpp"],
        data = [
            ":ament_index",
            "@autoware_lanelet2_utils//:ament_index",
            "@autoware_test_utils//:ament_index",
        ],
        dynamic_deps = [
            ":runtime_dynamic_deps",
            "@ament_index_cpp//:ament_index_cpp",
            "@autoware_motion_utils//:runtime_dynamic_deps",
            "@autoware_test_utils//:runtime_dynamic_deps",
        ],
        deps = [
            ":autoware_trajectory",
            "@ament_index_cpp//:ament_index_cpp_library",
            "@autoware_motion_utils",
            "@autoware_pyplot",
            "@autoware_test_utils",
            "@autoware_test_utils//:visualization",
            "@lanelet2_io//:lanelet2_io_library",
            "@rosdistro//cc:range-v3",
            "@rosdistro//cc:yaml-cpp_library",
        ],
    )
    for name in [
        "example_find_if",
        "example_find_intervals",
        "example_interpolator",
        "example_pchip_vs_cubic_spline",
        "example_path_point",
        "example_point",
        "example_pose",
        "example_pretty_build",
        "example_readme",
        "example_reference_path",
        "example_shift",
        "example_self_intersecting",
        "example_lateral_metrics",
        "example_footprint",
        "example_crossed",
        "example_add_offset",
        "example_temporal_trajectory",
        "example_temporal_crop",
        "example_temporal_curvature",
    ]
]
