load("@rosdistro//ament:defs.bzl", "ament_package")
load("@autoware_cmake//:defs.bzl", "AUTOWARE_CXXOPTS", "AUTOWARE_DEFINES", "autoware_copts")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

# Deliberate differences from CMakeLists.txt (checked by bazel/tools/cmake_parity):
# cmake-diff dep:pcl_ros: unused by the headers and tests; they need only PCL and point_cloud_msg_wrapper.

DEPENDENCIES = {
    "@rosdistro//cc:pcl": "@rosdistro//cc:pcl_library",
    "@sensor_msgs//:cc_shared": "@sensor_msgs//:cc",
}

cc_library(
    name = "autoware_point_types_library",
    hdrs = glob(["include/**/*.hpp"]),
    copts = autoware_copts(),
    cxxopts = AUTOWARE_CXXOPTS,
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    includes = ["include"],
    deps = DEPENDENCIES.values() + [
        "@point_cloud_msg_wrapper",
    ],
)

cc_shared_library(
    name = "autoware_point_types",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":autoware_point_types_library"],
    deps = [":autoware_point_types_library"],
)

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [":autoware_point_types"],
    visibility = ["//visibility:private"],
)

[cc_test(
    name = name,
    srcs = [src],
    copts = autoware_copts(),
    cxxopts = AUTOWARE_CXXOPTS,
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    dynamic_deps = [":test_dynamic_deps"],
    deps = [
        ":autoware_point_types_library",
        "@rosdistro//cc:googletest",
    ],
) for name, src in {
    "test_autoware_point_types": "test/test_point_types.cpp",
    "test_autoware_point_types_memory": "test/test_memory.cpp",
}.items()]

# Installable package (P4): the shared libraries and the package.xml dependencies.
ament_package(
    name = "ament_package",
    libraries = [
        ":autoware_point_types",
    ],
    package_xml = "package.xml",
    deps = [
        "@pcl_ros//:ament_package",
        "@point_cloud_msg_wrapper//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)
