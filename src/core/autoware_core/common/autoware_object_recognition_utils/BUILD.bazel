load("@rosdistro//ament:defs.bzl", "ament_package")
load("@autoware_cmake//:defs.bzl", "AUTOWARE_CXXOPTS", "AUTOWARE_DEFINES", "autoware_copts")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

DEPENDENCIES = {
    "@rosdistro//cc:pcl": "@rosdistro//cc:pcl_library",
    "@autoware_interpolation//:autoware_interpolation": "@autoware_interpolation//:autoware_interpolation_library",
    "@autoware_perception_msgs//:cc_shared": "@autoware_perception_msgs//:cc",
    "@autoware_point_types//:autoware_point_types": "@autoware_point_types//:autoware_point_types_library",
    "@autoware_utils_geometry//:autoware_utils_geometry": "@autoware_utils_geometry//:autoware_utils_geometry_library",
    "@autoware_utils_math//:autoware_utils_math": "@autoware_utils_math//:autoware_utils_math_library",
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@pcl_conversions//:pcl_conversions": "@pcl_conversions//:pcl_conversions_library",
    "@pcl_ros//:pcl_ros_tf": "@pcl_ros//:pcl_ros_tf_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@sensor_msgs//:cc_shared": "@sensor_msgs//:cc",
    "@std_msgs//:cc_shared": "@std_msgs//:cc",
    "@tf2//:tf2": "@tf2//:tf2_library",
    "@tf2_eigen//:tf2_eigen": "@tf2_eigen//:tf2_eigen_library",
    "@tf2_geometry_msgs//:tf2_geometry_msgs": "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
}

cc_library(
    name = "autoware_object_recognition_utils_library",
    srcs = glob(["src/*.cpp"]),
    hdrs = glob(["include/**/*.hpp"]),
    copts = autoware_copts(),
    cxxopts = AUTOWARE_CXXOPTS,
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    includes = ["include"],
    deps = DEPENDENCIES.values() + [
        "@rosdistro//cc:boost.geometry",
        "@rosdistro//cc:boost.optional",
        "@rosdistro//cc:eigen",
    ],
)

cc_shared_library(
    name = "autoware_object_recognition_utils",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":autoware_object_recognition_utils_library"],
    deps = [":autoware_object_recognition_utils_library"],
)

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [":autoware_object_recognition_utils"],
    visibility = ["//visibility:private"],
)

cc_test(
    name = "test_object_recognition_utils",
    srcs = glob(["test/**/*.cpp"]),
    copts = autoware_copts(),
    cxxopts = AUTOWARE_CXXOPTS,
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    data = ["@@//bazel/config:cyclonedds.xml"],
    dynamic_deps = [":test_dynamic_deps"],
    deps = [":autoware_object_recognition_utils_library"] + [
        "@rosdistro//cc:googletest",
    ],
)

# Installable package (P4): the shared libraries and the package.xml dependencies.
ament_package(
    name = "ament_package",
    libraries = [
        ":autoware_object_recognition_utils",
    ],
    package_xml = "package.xml",
    deps = [
        "@autoware_interpolation//:ament_package",
        "@autoware_perception_msgs//:ament_package",
        "@autoware_point_types//:ament_package",
        "@autoware_utils_geometry//:ament_package",
        "@autoware_utils_math//:ament_package",
        "@geometry_msgs//:ament_package",
        "@pcl_conversions//:ament_package",
        "@pcl_ros//:ament_package",
        "@rclcpp//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@tf2//:ament_package",
        "@tf2_eigen//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)
