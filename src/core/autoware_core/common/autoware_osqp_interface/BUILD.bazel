load("@rosdistro//ament:defs.bzl", "ament_package")
load("@autoware_cmake//:defs.bzl", "AUTOWARE_CXXOPTS", "AUTOWARE_DEFINES", "autoware_copts")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

# Deliberate differences from CMakeLists.txt (checked by bazel/tools/cmake_parity):
# cmake-diff dep:osqp_vendor: uses OSQP 0.6.3 (shared, @osqp_0_6) instead of osqp_vendor (OSQP 1.0); see PLAN.md.

DEPENDENCIES = {
    "@osqp_0_6//:osqp": "@osqp_0_6//:osqp_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
}

cc_library(
    name = "autoware_osqp_interface_library",
    srcs = [
        "src/csc_matrix_conv.cpp",
        "src/osqp_interface.cpp",
    ],
    hdrs = glob(["include/**/*.hpp"]),
    copts = autoware_copts() + ["-Wno-error=old-style-cast"],
    cxxopts = AUTOWARE_CXXOPTS,
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    includes = ["include"],
    deps = DEPENDENCIES.values() + [
        "@rosdistro//cc:eigen",
    ],
)

cc_shared_library(
    name = "autoware_osqp_interface",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":autoware_osqp_interface_library"],
    deps = [":autoware_osqp_interface_library"],
)

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [":autoware_osqp_interface"],
    visibility = ["//visibility:private"],
)

cc_test(
    name = "test_osqp_interface",
    srcs = [
        "test/test_csc_matrix_conv.cpp",
        "test/test_osqp_interface.cpp",
    ],
    copts = autoware_copts(),
    cxxopts = AUTOWARE_CXXOPTS,
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    data = ["@@//bazel/config:cyclonedds.xml"],
    dynamic_deps = [":test_dynamic_deps"],
    deps = [
        ":autoware_osqp_interface_library",
        "@rosdistro//cc:googletest",
    ],
)

# Installable package (P4): the shared libraries and the package.xml dependencies.
ament_package(
    name = "ament_package",
    libraries = [
        ":autoware_osqp_interface",
    ],
    package_xml = "package.xml",
    deps = [
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
