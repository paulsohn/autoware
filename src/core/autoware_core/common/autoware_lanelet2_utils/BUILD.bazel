load("@autoware_cmake//:defs.bzl", "AUTOWARE_CXXOPTS", "AUTOWARE_DEFINES", "autoware_copts")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library", "cc_test")
load("@rules_python//python:defs.bzl", "py_binary")

package(default_visibility = ["//visibility:public"])

# Deliberate differences from CMakeLists.txt (checked by bazel/tools/cmake_parity):
# cmake-diff dep:autoware_pyplot: test_depend for the examples, which CMake links against Python/pybind11::embed but which use neither.
# cmake-diff dep:rclpy_message_converter: test_depend used only by scripts/test_case_generator.py (not ported, see below).

DEPENDENCIES = {
    "@autoware_lanelet2_extension//:autoware_lanelet2_extension_lib": "@autoware_lanelet2_extension//:autoware_lanelet2_extension_lib_library",
    "@autoware_map_msgs//:cc_shared": "@autoware_map_msgs//:cc",
    "@autoware_planning_msgs//:cc_shared": "@autoware_planning_msgs//:cc",
    "@autoware_utils_geometry//:autoware_utils_geometry": "@autoware_utils_geometry//:autoware_utils_geometry_library",
    "@autoware_utils_math//:autoware_utils_math": "@autoware_utils_math//:autoware_utils_math_library",
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@lanelet2_core//:lanelet2_core": "@lanelet2_core//:lanelet2_core_library",
    "@lanelet2_io//:lanelet2_io": "@lanelet2_io//:lanelet2_io_library",
    "@lanelet2_routing//:lanelet2_routing": "@lanelet2_routing//:lanelet2_routing_library",
    "@lanelet2_traffic_rules//:lanelet2_traffic_rules": "@lanelet2_traffic_rules//:lanelet2_traffic_rules_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:boost.serialization_shared": "@rosdistro//cc:boost.serialization_library",
    "@tf2//:tf2": "@tf2//:tf2_library",
    "@tf2_geometry_msgs//:tf2_geometry_msgs": "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
}

cc_library(
    name = "autoware_lanelet2_utils_library",
    srcs = glob(["src/*.cpp"]),
    hdrs = glob(["include/**/*.hpp"]),
    copts = autoware_copts(),
    cxxopts = AUTOWARE_CXXOPTS,
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    includes = ["include"],
    deps = DEPENDENCIES.values() + [
        "@rosdistro//cc:eigen",
        "@rosdistro//cc:range-v3",
    ],
)

cc_shared_library(
    name = "autoware_lanelet2_utils",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":autoware_lanelet2_utils_library"],
    deps = [":autoware_lanelet2_utils_library"],
)

# install(PROGRAMS scripts/*.py DESTINATION lib/${PROJECT_NAME})
# cmake-diff program:scripts/lanelet_anonymizer.py: needs the mgrs pip package, which the RCR's pip_ros hub lacks.
# cmake-diff program:scripts/test_case_generator.py: needs autoware_lanelet2_extension_python (not ported) and Tk;
#   it is an interactive tool, not used by builds or tests.
py_binary(
    name = "lanelet_id_aligner",
    srcs = ["scripts/lanelet_id_aligner.py"],
    main = "scripts/lanelet_id_aligner.py",
)

# share/autoware_lanelet2_utils/{sample_map,test_data} (INSTALL_TO_SHARE).
ament_package(
    name = "ament_package",
    data = glob([
        "sample_map/**",
        "test_data/**",
    ]),
    executables = [":lanelet_id_aligner"],
    libraries = [":autoware_lanelet2_utils"],
    package_xml = "package.xml",
    deps = [
        "@autoware_lanelet2_extension//:ament_package",
        "@autoware_map_msgs//:ament_package",
        "@autoware_planning_msgs//:ament_package",
        "@autoware_utils_geometry//:ament_package",
        "@autoware_utils_math//:ament_package",
        "@geometry_msgs//:ament_package",
        "@lanelet2_core//:ament_package",
        "@lanelet2_io//:ament_package",
        "@lanelet2_routing//:ament_package",
        "@lanelet2_traffic_rules//:ament_package",
        "@rclcpp//:ament_package",
        "@rosdistro//:ament_package",
        "@tf2//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
    ],
)

# The installed package doubles as the runtime ament index of this package in tests (data = [":ament_index"]).
alias(
    name = "ament_index",
    actual = ":ament_package",
)

TEST_DEPENDENCIES = {
    "@ament_index_cpp//:ament_index_cpp": "@ament_index_cpp//:ament_index_cpp_library",
    "@autoware_test_utils//:autoware_test_utils": "@autoware_test_utils//:autoware_test_utils_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
}

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [":autoware_lanelet2_utils"] + TEST_DEPENDENCIES.keys(),
    testonly = True,
    visibility = ["//visibility:private"],
)

# ament_auto_add_gtest(<file>.cpp_autoware_lanelet2_utils ...). The tests link autoware_test_utils, whose CMake
# target adds -Wno-deprecated-declarations PUBLIC.
OWN_MAIN = [
    "geometry",
    "hatched_road_marking",
    "intersection",
    "kind",
    "lane_sequence",
    "map_handler",
    "route_manager",
    "stop_line",
    "topology",
]

[cc_test(
    name = "{}.cpp_autoware_lanelet2_utils".format(name),
    srcs = ["test/{}.cpp".format(name)] + glob(["test/*.hpp"]),
    copts = autoware_copts() + ["-Wno-deprecated-declarations"],
    cxxopts = AUTOWARE_CXXOPTS,
    data = [
        ":ament_index",
        "@@//bazel/config:cyclonedds.xml",
        "@autoware_test_utils//:ament_index",
    ],
    dynamic_deps = [":test_dynamic_deps"],
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    deps = [":autoware_lanelet2_utils_library"] + TEST_DEPENDENCIES.values() + [
        "@rosdistro//cc:range-v3",
        "@googletest//:gtest" if name in OWN_MAIN else "@rosdistro//cc:googletest",
    ],
) for name in [
    "conversion",
    "geometry",
    "hatched_road_marking",
    "intersection",
    "kind",
    "lane_sequence",
    "map_handler",
    "nn_search",
    "route_manager",
    "stop_line",
    "topology",
]]

# Examples (built with BUILD_TESTING in CMake). Two include gtest headers; all define main().
[cc_binary(
    name = name,
    testonly = True,
    srcs = ["examples/{}.cpp".format(name)],
    copts = autoware_copts(),
    cxxopts = AUTOWARE_CXXOPTS,
    data = [
        ":ament_index",
        "@@//bazel/config:cyclonedds.xml",
    ],
    dynamic_deps = [":test_dynamic_deps"],
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    deps = [":autoware_lanelet2_utils_library"] + TEST_DEPENDENCIES.values() + [
        "@googletest//:gtest",
        "@rosdistro//cc:range-v3",
    ],
) for name in [
    "example_conversion",
    "example_geometry",
    "example_hatched_road_markings",
    "example_intersection",
    "example_kind",
    "example_lane_sequence",
    "example_map_handler",
    "example_nn_search",
    "example_route_manager",
    "example_topology",
]]
