load("@rosdistro//ament:defs.bzl", "ament_package")
load("@autoware_cmake//:defs.bzl", "AUTOWARE_CXXOPTS", "AUTOWARE_DEFINES", "autoware_copts")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

DEPENDENCIES = {
    "@autoware_adapi_v1_msgs//:cc_shared": "@autoware_adapi_v1_msgs//:cc",
    "@autoware_component_interface_specs//:autoware_component_interface_specs": "@autoware_component_interface_specs//:autoware_component_interface_specs_library",
    "@rcl//:rcl": "@rcl//:rcl_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rmw//:rmw": "@rmw//:rmw_library",
    "@rosidl_runtime_cpp//:rosidl_runtime_cpp": "@rosidl_runtime_cpp//:rosidl_runtime_cpp_library",
}

# Header-only.
cc_library(
    name = "autoware_component_interface_utils_library",
    hdrs = glob(["include/**/*.hpp"]),
    copts = autoware_copts(),
    cxxopts = AUTOWARE_CXXOPTS,
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    includes = ["include"],
    deps = DEPENDENCIES.values() + ["@rosdistro//cc:nlohmann_json"],
)

cc_shared_library(
    name = "autoware_component_interface_utils",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":autoware_component_interface_utils_library"],
    deps = [":autoware_component_interface_utils_library"],
)

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [":autoware_component_interface_utils"],
    visibility = ["//visibility:private"],
)

[cc_test(
    name = name,
    srcs = [src],
    copts = autoware_copts(),
    cxxopts = AUTOWARE_CXXOPTS,
    data = data + ["@@//bazel/config:cyclonedds.xml"],
    dynamic_deps = [":test_dynamic_deps"],
    local_defines = ros_local_defines() + AUTOWARE_DEFINES + defines,
    deps = [
        ":autoware_component_interface_utils_library",
        "@rosdistro//cc:googletest",
    ],
) for name, src, data, defines in [
    ("test_component_interface_utils", "test/test_component_interface_utils.cpp", [], []),
    ("test_component_interface_registration", "test/test_registration.cpp", [], []),
    ("test_manifest_json", "test/test_manifest_json.cpp", [], []),
    (
        "test_manifest_drift",
        "test/test_manifest_drift.cpp",
        [
            "test/data/divergent_fragment.json",
            "test/data/matching_fragment.json",
        ],
        # CMake passes absolute source paths; runfiles paths work from the test's working directory.
        [
            "MATCHING_FRAGMENT=\\\"$(rootpath test/data/matching_fragment.json)\\\"",
            "DIVERGENT_FRAGMENT=\\\"$(rootpath test/data/divergent_fragment.json)\\\"",
        ],
    ),
]]

# Installable package (P4): the shared libraries and the package.xml dependencies.
ament_package(
    name = "ament_package",
    libraries = [
        ":autoware_component_interface_utils",
    ],
    package_xml = "package.xml",
    deps = [
        "@autoware_adapi_v1_msgs//:ament_package",
        "@autoware_component_interface_specs//:ament_package",
        "@rcl//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rmw//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_runtime_cpp//:ament_package",
    ],
)
