load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "defs.bzl",
    "templates/node_main_switchable.cpp.in",
])

_DYNAMIC_DEPS = [
    "@agnocastlib//:agnocast",
    "@diagnostic_updater//:diagnostic_updater",
    "@geometry_msgs//:cc_shared",
    "@message_filters//:message_filters",
    "@rcl//:rcl",
    "@rcl_interfaces//:cc_shared",
    "@rclcpp//:rclcpp",
    "@tf2//:tf2",
    "@tf2_ros//:tf2_ros",
]

cc_library(
    name = "autoware_agnocast_wrapper_library",
    srcs = [
        "src/node.cpp",
        "src/runtime.cpp",
    ],
    hdrs = glob(["include/**/*.hpp"]),
    defines = ["USE_AGNOCAST_ENABLED"],
    local_defines = ros_local_defines(),
    strip_include_prefix = "include",
    deps = [
        "@agnocastlib//:agnocast_library",
        "@autoware_utils_rclcpp",
        "@diagnostic_updater//:diagnostic_updater_library",
        "@geometry_msgs//:cc",
        "@message_filters//:message_filters_library",
        "@rcl//:rcl_library",
        "@rcl_interfaces//:cc",
        "@rclcpp//:rclcpp_library",
        "@tf2//:tf2_library",
        "@tf2_ros//:tf2_ros_library",
    ],
)

cc_shared_library(
    name = "autoware_agnocast_wrapper",
    dynamic_deps = _DYNAMIC_DEPS,
    exports_filter = [":autoware_agnocast_wrapper_library"],
    deps = [":autoware_agnocast_wrapper_library"],
)

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [
        ":autoware_agnocast_wrapper",
        "@std_msgs//:cc_shared",
    ] + _DYNAMIC_DEPS,
)

cc_test(
    name = "unit_tests",
    srcs = [
        "test/cases/generic_pubsub.cpp",
        "test/cases/message_filters.cpp",
        "test/cases/parameter_client.cpp",
        "test/cases/polling_subscriber.cpp",
        "test/cases/service_introspection.cpp",
        "test/heaphook_probe.hpp",
        "test/main.cpp",
    ],
    data = ["@agnocast_heaphook"],
    dynamic_deps = [":test_dynamic_deps"],
    includes = ["test"],
    deps = [
        ":autoware_agnocast_wrapper_library",
        "@geometry_msgs//:cc",
        "@googletest//:gtest",
        "@rcl_interfaces//:cc",
        "@std_msgs//:cc",
    ],
)

# Match setup.cfg's launch extension registration in the runfiles Python path.
write_file(
    name = "launch_entry_point",
    out = "autoware_agnocast_wrapper.egg-info/entry_points.txt",
    content = [
        "[launch.frontend.launch_extension]",
        "autoware_agnocast_wrapper = autoware_agnocast_wrapper",
    ],
)

write_file(
    name = "python_pkg_info",
    out = "autoware_agnocast_wrapper.egg-info/PKG-INFO",
    content = [
        "Metadata-Version: 2.1",
        "Name: autoware_agnocast_wrapper",
        "Version: 1.10.0",
    ],
)

py_library(
    name = "python",
    srcs = glob(["autoware_agnocast_wrapper/**/*.py"]),
    data = [
        ":launch_entry_point",
        ":python_pkg_info",
    ],
    deps = [
        "@launch",
        "@launch_ros",
    ],
)

py_pytest(
    name = "launch_tests",
    srcs = ["test/test_autoware_node.py"],
    deps = [
        ":python",
        "@launch_xml",
    ],
)

ament_package(
    data = glob([
        "launch/*",
        "cmake/*",
    ]),
    headers = glob(["include/**/*.hpp"]),
    # Standalone mains emitted by defs.bzl link this shared logging provider.
    libraries = [
        ":autoware_agnocast_wrapper",
        "@rosdistro//cc:glog",
    ],
    python = [":python"],
    setup_cfg = "setup.cfg",
)
