load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_node",
    srcs = ["src/node.cpp"],
    hdrs = glob(["include/**/*.hpp"]),
    strip_include_prefix = "include",
    deps = [
        "@rclcpp//:rclcpp_library",
        "@rcutils//:rcutils_library",
    ],
)

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [
        "@rclcpp//:rclcpp",
        "@rcutils//:rcutils",
        "@std_msgs//:cc_shared",
    ],
)

cc_test(
    name = "test_autoware_node",
    srcs = [
        "test/test_an_init_shutdown.cpp",
        "test/test_pubsub.cpp",
    ],
    dynamic_deps = [":test_dynamic_deps"],
    deps = [
        ":autoware_node",
        "@googletest//:gtest_main",
        "@std_msgs//:cc",
    ],
)
