load("@autoware_cmake//:defs.bzl", "AUTOWARE_CXXOPTS", "AUTOWARE_DEFINES", "autoware_copts")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_index")
load("@rules_python//python:defs.bzl", "py_binary")

package(default_visibility = ["//visibility:public"])

# Deliberate differences from CMakeLists.txt (checked by bazel/tools/cmake_parity):
# cmake-diff library:vehicle_info_utils: named after the package (convention); only matters to CMake consumers linking "vehicle_info_utils".

DEPENDENCIES = {
    "@autoware_utils_geometry//:autoware_utils_geometry": "@autoware_utils_geometry//:autoware_utils_geometry_library",
    "@autoware_utils_rclcpp//:autoware_utils_rclcpp": "@autoware_utils_rclcpp//:autoware_utils_rclcpp_library",
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
}

cc_library(
    name = "autoware_vehicle_info_utils_library",
    srcs = [
        "src/vehicle_info.cpp",
        "src/vehicle_info_utils.cpp",
    ],
    hdrs = glob(["include/**/*.hpp"]),
    copts = autoware_copts(),
    cxxopts = AUTOWARE_CXXOPTS,
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    includes = ["include"],
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "autoware_vehicle_info_utils",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":autoware_vehicle_info_utils_library"],
    deps = [":autoware_vehicle_info_utils_library"],
)

# install(PROGRAMS scripts/min_turning_radius_calculator.py DESTINATION lib/${PROJECT_NAME})
py_binary(
    name = "min_turning_radius_calculator",
    srcs = ["scripts/min_turning_radius_calculator.py"],
    data = [":share"],
    main = "scripts/min_turning_radius_calculator.py",
    deps = [
        "@ament_index_python",
        requirement("pyyaml"),
    ],
)

# share/autoware_vehicle_info_utils/{config,launch} (INSTALL_TO_SHARE). Separate from :ament_index because the
# script reads it and :ament_index lists the script (absorbed below, same package).
ament_index(
    name = "share",
    data = glob([
        "config/**",
        "launch/**",
    ]),
    package_xml = "package.xml",
)

ament_index(
    name = "ament_index",
    executables = [":min_turning_radius_calculator"],
    libraries = [":autoware_vehicle_info_utils"],
    package_xml = "package.xml",
    deps = [":share"],
)

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [
        ":autoware_vehicle_info_utils",
        "@ament_index_cpp//:ament_index_cpp",
    ],
    visibility = ["//visibility:private"],
)

cc_test(
    name = "test_autoware_vehicle_info_utils",
    srcs = ["test/test_vehicle_info_utils.cpp"],
    copts = autoware_copts(),
    cxxopts = AUTOWARE_CXXOPTS,
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    data = [
        ":ament_index",
        "@@//bazel/config:cyclonedds.xml",
    ],
    dynamic_deps = [":test_dynamic_deps"],
    deps = [
        ":autoware_vehicle_info_utils_library",
        "@ament_index_cpp//:ament_index_cpp_library",
        "@rosdistro//cc:googletest",
    ],
)

cc_test(
    name = "test_vehicle_info",
    srcs = ["test/test_vehicle_info.cpp"],
    copts = autoware_copts(),
    cxxopts = AUTOWARE_CXXOPTS,
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    data = ["@@//bazel/config:cyclonedds.xml"],
    dynamic_deps = [":test_dynamic_deps"],
    deps = [
        ":autoware_vehicle_info_utils_library",
        "@rosdistro//cc:googletest",
    ],
)
