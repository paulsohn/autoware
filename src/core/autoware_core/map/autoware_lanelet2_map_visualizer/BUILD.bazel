load("@autoware_agnocast_wrapper//:defs.bzl", "autoware_agnocast_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "test/lanelet2_map_visualizer_launch.test.py",
    "test/test_standalone.py",
])

cc_library(
    name = "autoware_lanelet2_map_visualizer_library",
    srcs = glob(["src/*.cpp"]),
    hdrs = glob(["src/*.hpp"]),
    deps = [
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper_library",
        "@autoware_lanelet2_extension//:autoware_lanelet2_extension_lib_library",
        "@autoware_lanelet2_utils",
        "@autoware_map_msgs//:cc",
        "@autoware_utils_visualization",
        "@lanelet2_core//:lanelet2_core_library",
        "@lanelet2_projection//:lanelet2_projection_library",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
        "@std_msgs//:cc",
        "@visualization_msgs//:cc",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper",
        "@autoware_lanelet2_utils//:runtime_dynamic_deps",
        "@autoware_map_msgs//:cc_shared",
        "@rclcpp_components//:rclcpp_components",
        "@std_msgs//:cc_shared",
        "@visualization_msgs//:cc_shared",
    ],
)

cc_shared_library(
    name = "visualizer_component",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":autoware_lanelet2_map_visualizer_library"],
)

autoware_agnocast_node(
    name = "autoware_lanelet2_map_visualizer",
    package_name = "autoware_lanelet2_map_visualizer",
    component = ":visualizer_component",
    plugin = "autoware::lanelet2_map_visualizer::Lanelet2MapVisualizationNode",
)

register_ament_files(
    name = "node_executables",
    files = [":autoware_lanelet2_map_visualizer"],
    prefix = "lib/autoware_lanelet2_map_visualizer",
    strip_prefix = "*",
)

ament_index(
    components = [":autoware_lanelet2_map_visualizer_components"],
    data = glob(["launch/*"]) + [
        ":autoware_lanelet2_map_visualizer_plugin",
        ":node_executables",
    ],
    package_xml = "package.xml",
)

[
    cc_test(
        name = name,
        srcs = ["test/" + name + ".cpp"],
        dynamic_deps = [":runtime_dynamic_deps"],
        env = {"ENABLE_AGNOCAST": "0"},
        deps = [
            ":autoware_lanelet2_map_visualizer_library",
            "@googletest//:gtest",
            "@lanelet2_io//:lanelet2_io_library",
        ],
    )
    for name in [
        "test_node_initialization",
        "test_lanelet2_map_visualization_node",
        "test_lanelet2_map_visualization",
    ]
]
