load("@rosdistro//ament:defs.bzl", "ament_index")

package(default_visibility = ["//visibility:public"])

# No code: share/autoware_core_map/{config,launch} (INSTALL_TO_SHARE). Its launch file starts the nodes of its
# exec_depends.
ament_index(
    name = "ament_index",
    data = glob([
        "config/**",
        "launch/**",
    ]),
    package_xml = "package.xml",
    deps = [
        "@autoware_lanelet2_map_visualizer//:ament_index",
        "@autoware_map_loader//:ament_index",
        "@autoware_map_projection_loader//:ament_index",
    ],
)
