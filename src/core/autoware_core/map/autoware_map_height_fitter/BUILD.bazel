load("@autoware_agnocast_wrapper//:defs.bzl", "autoware_agnocast_wrapper_register_node")
load("@autoware_cmake//:defs.bzl", "AUTOWARE_CXXOPTS", "AUTOWARE_DEFINES", "autoware_copts")
load("@rosdistro//ament:defs.bzl", "ament_index")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

# Deliberate differences from CMakeLists.txt (checked by bazel/tools/cmake_parity):
# cmake-diff if:NOT (DEFINED ENV{ENABLE_AGNOCAST} AND $ENV{ENABLE_AGNOCAST} STREQUAL 1): the fit test, which CMake builds only without Agnocast, is built and runs on the ROS 2 backend (ENABLE_AGNOCAST=0); PLAN.md.

DEPENDENCIES = {
    "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper": "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper_library",
    "@autoware_internal_localization_msgs//:cc_shared": "@autoware_internal_localization_msgs//:cc",
    "@autoware_lanelet2_utils//:autoware_lanelet2_utils": "@autoware_lanelet2_utils//:autoware_lanelet2_utils_library",
    "@autoware_map_msgs//:cc_shared": "@autoware_map_msgs//:cc",
    "@autoware_qos_utils//:autoware_qos_utils": "@autoware_qos_utils//:autoware_qos_utils_library",
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@lanelet2_core//:lanelet2_core": "@lanelet2_core//:lanelet2_core_library",
    "@pcl_conversions//:pcl_conversions": "@pcl_conversions//:pcl_conversions_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rosdistro//cc:pcl": "@rosdistro//cc:pcl_library",
    "@sensor_msgs//:cc_shared": "@sensor_msgs//:cc",
    "@tf2_geometry_msgs//:tf2_geometry_msgs": "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
}

# Component library.
cc_library(
    name = "autoware_map_height_fitter_library",
    srcs = [
        "src/map_height_fitter.cpp",
        "src/map_height_fitter_kernel.cpp",
        "src/map_height_fitter_kernel.hpp",
        "src/map_height_fitter_node.cpp",
    ],
    hdrs = [
        "include/autoware/map_height_fitter/map_height_fitter.hpp",
    ],
    includes = ["include"],
    copts = autoware_copts(),
    cxxopts = AUTOWARE_CXXOPTS,
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "autoware_map_height_fitter",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":autoware_map_height_fitter_library"],
    deps = [":autoware_map_height_fitter_library"],
)

autoware_agnocast_wrapper_register_node(
    agnocast_executor = "AgnocastOnlyCallbackIsolatedExecutor",
    component = ":autoware_map_height_fitter",
    data = ["@@//bazel/config:cyclonedds.xml"],
    executable = "autoware_map_height_fitter_node",
    plugin = "autoware::map_height_fitter::MapHeightFitterNode",
    ros2_executor = "MultiThreadedExecutor",
)

# share/autoware_map_height_fitter/{config,launch} (INSTALL_TO_SHARE).
ament_index(
    name = "ament_index",
    components = [":autoware_map_height_fitter_node_component_record"],
    data = glob([
        "config/**",
        "launch/**",
    ]),
    executables = [":autoware_map_height_fitter_node"],
    libraries = [
        ":autoware_map_height_fitter",
    ],
    package_xml = "package.xml",
    deps = [":autoware_map_height_fitter_node_autoware_node_plugin"],
)

# target_include_directories(<test> PRIVATE src)
cc_library(
    name = "src_headers",
    testonly = True,
    hdrs = glob(["src/*.hpp"]),
    includes = ["src"],
    visibility = ["//visibility:private"],
)

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [":autoware_map_height_fitter"],
    visibility = ["//visibility:private"],
)

cc_test(
    name = "test_autoware_map_height_fitter_kernel",
    srcs = ["test/test_map_height_fitter_kernel.cpp"],
    copts = autoware_copts(),
    cxxopts = AUTOWARE_CXXOPTS,
    data = ["@@//bazel/config:cyclonedds.xml"],
    dynamic_deps = [":test_dynamic_deps"],
    # Written for the ROS 2 backend (PLAN.md).
    env = {"ENABLE_AGNOCAST": "0"},
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    deps = [
        ":autoware_map_height_fitter_library",
        ":src_headers",
        "@rosdistro//cc:googletest",
    ],
)

cc_test(
    name = "test_autoware_map_height_fitter_fit",
    srcs = ["test/test_map_height_fitter_fit.cpp"],
    copts = autoware_copts(),
    cxxopts = AUTOWARE_CXXOPTS,
    data = ["@@//bazel/config:cyclonedds.xml"],
    dynamic_deps = [":test_dynamic_deps"],
    # Written for the ROS 2 backend (PLAN.md).
    env = {"ENABLE_AGNOCAST": "0"},
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    deps = [
        ":autoware_map_height_fitter_library",
        ":src_headers",
        "@rosdistro//cc:googletest",
    ],
)
