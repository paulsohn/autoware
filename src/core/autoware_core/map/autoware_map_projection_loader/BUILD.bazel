load("@autoware_agnocast_wrapper//:defs.bzl", "autoware_agnocast_wrapper_register_node")
load("@autoware_cmake//:defs.bzl", "AUTOWARE_CXXOPTS", "AUTOWARE_DEFINES", "autoware_copts")
load("@launch_testing_ros//:defs.bzl", "launch_ros_test")
load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_index")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

# Deliberate differences from CMakeLists.txt (checked by bazel/tools/cmake_parity):
# cmake-diff if:NOT $ENV{ENABLE_AGNOCAST} STREQUAL 1: the launch tests, which CMake adds only without Agnocast, run on the ROS 2 backend (ENABLE_AGNOCAST=0); PLAN.md.
# cmake-diff timeout:test_test_node_load_mgrs_from_yaml.test.py: CMake TIMEOUT 30; Bazel has fixed tiers, "short" (60 s) is the smallest.
# cmake-diff timeout:test_test_node_load_local_from_yaml.test.py: same as above.
# cmake-diff timeout:test_test_node_load_local_cartesian_utm_from_yaml.test.py: same as above.
# cmake-diff timeout:test_test_node_load_transverse_mercator_from_yaml.test.py: same as above.
# cmake-diff dep:ros_testing: test_depend, but no ros_testing CMake function is called; the launch tests use launch_ros_test.

DEPENDENCIES = {
    "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper": "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper_library",
    "@autoware_component_interface_specs//:autoware_component_interface_specs": "@autoware_component_interface_specs//:autoware_component_interface_specs_library",
    "@autoware_lanelet2_extension//:autoware_lanelet2_extension_lib": "@autoware_lanelet2_extension//:autoware_lanelet2_extension_lib_library",
    "@autoware_map_msgs//:cc_shared": "@autoware_map_msgs//:cc",
    "@lanelet2_core//:lanelet2_core": "@lanelet2_core//:lanelet2_core_library",
    "@lanelet2_io//:lanelet2_io": "@lanelet2_io//:lanelet2_io_library",
    "@lanelet2_projection//:lanelet2_projection": "@lanelet2_projection//:lanelet2_projection_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rosdistro//cc:geographiclib": "@rosdistro//cc:geographiclib_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
}

# Component library.
cc_library(
    name = "autoware_map_projection_loader_library",
    srcs = [
        "src/load_info_from_lanelet2_map.cpp",
        "src/map_projection_loader.cpp",
        "src/map_projection_loader_node.cpp",
        "src/map_projection_loader_node.hpp",
    ],
    hdrs = glob(["include/**/*.hpp"]),
    copts = autoware_copts(),
    cxxopts = AUTOWARE_CXXOPTS,
    includes = ["include"],
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "autoware_map_projection_loader",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":autoware_map_projection_loader_library"],
    deps = [":autoware_map_projection_loader_library"],
)

autoware_agnocast_wrapper_register_node(
    agnocast_executor = "AgnocastOnlyCallbackIsolatedExecutor",
    component = ":autoware_map_projection_loader",
    data = ["@@//bazel/config:cyclonedds.xml"],
    executable = "autoware_map_projection_loader_node",
    plugin = "autoware::map_projection_loader::MapProjectionLoader",
    ros2_executor = "SingleThreadedExecutor",
)

# share/autoware_map_projection_loader/{launch,config} (INSTALL_TO_SHARE) and test/data (install(DIRECTORY), in
# BUILD_TESTING).
ament_index(
    name = "ament_index",
    components = [":autoware_map_projection_loader_node_component_record"],
    data = glob([
        "config/**",
        "launch/**",
        "test/data/**",
    ]),
    executables = [":autoware_map_projection_loader_node"],
    libraries = [":autoware_map_projection_loader"],
    package_xml = "package.xml",
    deps = [":autoware_map_projection_loader_node_autoware_node_plugin"],
)

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [":autoware_map_projection_loader"],
    visibility = ["//visibility:private"],
)

# add_testcase(): ament_add_gmock, named after the file.
[
    cc_test(
        name = name,
        srcs = ["test/%s.cpp" % name],
        copts = autoware_copts(),
        cxxopts = AUTOWARE_CXXOPTS,
        local_defines = ros_local_defines() + AUTOWARE_DEFINES,
        dynamic_deps = [":test_dynamic_deps"],
        deps = [
            ":autoware_map_projection_loader_library",
            "@rosdistro//cc:googletest",
        ],
    )
    for name in [
        "test_load_info_from_lanelet2_map",
        "test_load_info_from_yaml",
    ]
]

# add_launch_test() names each test after its path ("/" -> "_").
[
    launch_ros_test(
        name = "test_%s" % src,
        src = "test/" + src,
        data = [
            ":ament_index",
            "@@//bazel/config:cyclonedds.xml",
            "@autoware_agnocast_wrapper//:ament_index",
        ],
        # Written for the ROS 2 backend (PLAN.md).
        env = {"ENABLE_AGNOCAST": "0"},
        timeout = "short",
        deps = [
            ":autoware_map_projection_loader_node",
            "@ament_index_python",
            "@autoware_map_msgs//:py",
            "@rclpy",
            requirement("pyyaml"),
        ],
    )
    for src in [
        "test_node_load_mgrs_from_yaml.test.py",
        "test_node_load_local_from_yaml.test.py",
        "test_node_load_local_cartesian_utm_from_yaml.test.py",
        "test_node_load_transverse_mercator_from_yaml.test.py",
    ]
]
