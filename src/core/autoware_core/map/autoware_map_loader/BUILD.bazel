load("@autoware_agnocast_wrapper//:defs.bzl", "autoware_agnocast_wrapper_register_node")
load("@autoware_cmake//:defs.bzl", "AUTOWARE_CXXOPTS", "AUTOWARE_DEFINES", "autoware_copts")
load("@launch_testing_ros//:defs.bzl", "launch_ros_test")
load("@rosdistro//ament:defs.bzl", "ament_index")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

# Deliberate differences from CMakeLists.txt (checked by bazel/tools/cmake_parity):
# cmake-diff if:NOT (DEFINED ENV{ENABLE_AGNOCAST} AND $ENV{ENABLE_AGNOCAST} STREQUAL 1): the launch tests and gtests that CMake builds only without Agnocast are built and run on the ROS 2 backend (ENABLE_AGNOCAST=0); PLAN.md.
# cmake-diff if:NOT $ENV{ENABLE_AGNOCAST} STREQUAL 1: same as above (test_pointcloud_map_loader_node).
# cmake-diff if:NOT TARGET yaml-cpp::yaml-cpp: compatibility shim for old yaml-cpp CMake configs; not needed with @rosdistro//cc:yaml-cpp.
# cmake-diff timeout:test_lanelet2_map_loader_launch.test.py: CMake TIMEOUT 30; Bazel has fixed tiers, "short" (60 s) is the smallest.
# cmake-diff timeout:test_pointcloud_map_loader_metadata_launch.test.py: same as above.
# cmake-diff dep:ros_testing: test_depend, but no ros_testing CMake function is called; the launch tests use launch_ros_test.
# cmake-diff program:script/map_hash_generator: not built yet; it imports tier4_external_api_msgs, which package.xml does not declare and which is only in src/universe (not ported).

DEPENDENCIES = {
    "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper": "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper_library",
    "@autoware_component_interface_specs//:autoware_component_interface_specs": "@autoware_component_interface_specs//:autoware_component_interface_specs_library",
    "@autoware_geography_utils//:autoware_geography_utils": "@autoware_geography_utils//:autoware_geography_utils_library",
    "@autoware_lanelet2_extension//:autoware_lanelet2_extension_lib": "@autoware_lanelet2_extension//:autoware_lanelet2_extension_lib_library",
    "@autoware_lanelet2_utils//:autoware_lanelet2_utils": "@autoware_lanelet2_utils//:autoware_lanelet2_utils_library",
    "@autoware_map_msgs//:cc_shared": "@autoware_map_msgs//:cc",
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@lanelet2_core//:lanelet2_core": "@lanelet2_core//:lanelet2_core_library",
    "@lanelet2_io//:lanelet2_io": "@lanelet2_io//:lanelet2_io_library",
    "@lanelet2_projection//:lanelet2_projection": "@lanelet2_projection//:lanelet2_projection_library",
    "@pcl_conversions//:pcl_conversions": "@pcl_conversions//:pcl_conversions_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rosdistro//cc:pcl": "@rosdistro//cc:pcl_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@sensor_msgs//:cc_shared": "@sensor_msgs//:cc",
    "@visualization_msgs//:cc_shared": "@visualization_msgs//:cc",
}

# ament_auto_add_library: every library gets include/ and all build dependencies.
[
    (
        cc_library(
            name = name + "_library",
            srcs = srcs + glob(["src/%s/**/*.hpp" % subdir]),
            hdrs = glob(["include/**/*.hpp"]),
            copts = autoware_copts(),
            cxxopts = AUTOWARE_CXXOPTS,
            includes = ["include"],
            local_defines = ros_local_defines() + AUTOWARE_DEFINES,
            deps = DEPENDENCIES.values() + [
                "@rosdistro//cc:boost.optional",
                "@rosdistro//cc:fmt",
            ],
        ),
        cc_shared_library(
            name = name,
            dynamic_deps = DEPENDENCIES.keys(),
            exports_filter = [":%s_library" % name],
            deps = [":%s_library" % name],
        ),
        autoware_agnocast_wrapper_register_node(
            agnocast_executor = "AgnocastOnlyCallbackIsolatedExecutor",
            component = ":" + name,
            data = ["@@//bazel/config:cyclonedds.xml"],
            executable = executable,
            plugin = plugin,
            ros2_executor = "SingleThreadedExecutor",
        ),
    )
    for name, subdir, executable, plugin, srcs in [
        (
            "pointcloud_map_loader_node",
            "pointcloud_map_loader",
            "autoware_pointcloud_map_loader",
            "autoware::map_loader::PointCloudMapLoaderNode",
            [
                "src/pointcloud_map_loader/differential_map_loader.cpp",
                "src/pointcloud_map_loader/partial_map_loader.cpp",
                "src/pointcloud_map_loader/pointcloud_map_loader.cpp",
                "src/pointcloud_map_loader/pointcloud_map_loader_node.cpp",
                "src/pointcloud_map_loader/selected_map_loader.cpp",
                "src/pointcloud_map_loader/utils.cpp",
            ],
        ),
        (
            "lanelet2_map_loader_node",
            "lanelet2_map_loader",
            "autoware_lanelet2_map_loader",
            "autoware::map_loader::Lanelet2MapLoaderNode",
            [
                "src/lanelet2_map_loader/lanelet2_map_loader.cpp",
                "src/lanelet2_map_loader/lanelet2_map_loader_node.cpp",
                "src/lanelet2_map_loader/lanelet2_selected_map_loader_module.cpp",
                "src/lanelet2_map_loader/utils/lanelet2_map_cell_metadata.cpp",
                "src/lanelet2_map_loader/utils/lanelet2_map_loader_utils.cpp",
            ],
        ),
    ]
]

# share/autoware_map_loader/{launch,config} (INSTALL_TO_SHARE) and test/data (install(DIRECTORY), in BUILD_TESTING).
ament_index(
    name = "ament_index",
    components = [
        ":autoware_lanelet2_map_loader_component_record",
        ":autoware_pointcloud_map_loader_component_record",
    ],
    data = glob([
        "config/**",
        "launch/**",
        "test/data/**",
    ]),
    executables = [
        ":autoware_lanelet2_map_loader",
        ":autoware_pointcloud_map_loader",
    ],
    libraries = [
        ":lanelet2_map_loader_node",
        ":pointcloud_map_loader_node",
    ],
    package_xml = "package.xml",
    deps = [
        ":autoware_lanelet2_map_loader_autoware_node_plugin",
        ":autoware_pointcloud_map_loader_autoware_node_plugin",
    ],
)

# The tests include "../src/<...>.hpp" through include/ (target_include_directories(PUBLIC include)).
cc_library(
    name = "src_headers",
    testonly = True,
    hdrs = glob(["src/**/*.hpp"]),
    visibility = ["//visibility:private"],
)

TEST_DEPENDENCIES = {
    "@ament_index_cpp//:ament_index_cpp": "@ament_index_cpp//:ament_index_cpp_library",
}

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [
        ":lanelet2_map_loader_node",
        ":pointcloud_map_loader_node",
    ] + TEST_DEPENDENCIES.keys(),
    visibility = ["//visibility:private"],
)

# add_testcase(): ament_add_gmock named after the file, linking ${PROJECT_NAME}_LIBRARIES (both libraries).
[
    cc_test(
        name = src.rsplit("/", 1)[-1].removesuffix(".cpp"),
        srcs = [src],
        copts = autoware_copts(),
        cxxopts = AUTOWARE_CXXOPTS,
        data = [
            ":ament_index",
            "@@//bazel/config:cyclonedds.xml",
        ],
        dynamic_deps = [":test_dynamic_deps"],
        # Written for the ROS 2 backend (PLAN.md).
        env = {"ENABLE_AGNOCAST": "0"},
        local_defines = ros_local_defines() + AUTOWARE_DEFINES,
        deps = [
            ":lanelet2_map_loader_node_library",
            ":pointcloud_map_loader_node_library",
            ":src_headers",
            "@rosdistro//cc:googletest",
        ] + TEST_DEPENDENCIES.values(),
    )
    for src in [
        "test/pointcloud_map_loader/test_cylinder_box_overlap.cpp",
        "test/pointcloud_map_loader/test_replace_with_absolute_path.cpp",
        "test/pointcloud_map_loader/test_load_pcd_metadata.cpp",
        "test/pointcloud_map_loader/test_pointcloud_map_loader.cpp",
        "test/pointcloud_map_loader/test_partial_map_loader.cpp",
        "test/pointcloud_map_loader/test_differential_map_loader.cpp",
        "test/pointcloud_map_loader/test_selected_map_loader.cpp",
        "test/pointcloud_map_loader/test_pointcloud_map_loader_node.cpp",
        "test/lanelet2_map_loader/test_lanelet2_map_loader_utils.cpp",
        "test/lanelet2_map_loader/test_lanelet2_map_cell_metadata.cpp",
        "test/lanelet2_map_loader/test_lanelet2_selected_map_loader_module.cpp",
        "test/lanelet2_map_loader/test_lanelet2_map_loader_integration.cpp",
    ]
]

# add_launch_test() names each test after its path ("/" -> "_").
[
    launch_ros_test(
        name = "test_%s" % src,
        src = "test/" + src,
        data = [
            ":ament_index",
            "@@//bazel/config:cyclonedds.xml",
            "@autoware_agnocast_wrapper//:ament_index",
        ],
        # Written for the ROS 2 backend (PLAN.md).
        env = {"ENABLE_AGNOCAST": "0"},
        timeout = "short",
        deps = [
            ":autoware_lanelet2_map_loader",
            ":autoware_pointcloud_map_loader",
            "@ament_index_python",
            "@autoware_map_msgs//:py",
            "@rclpy",
        ],
    )
    for src in [
        "lanelet2_map_loader_launch.test.py",
        "pointcloud_map_loader_metadata_launch.test.py",
    ]
]
