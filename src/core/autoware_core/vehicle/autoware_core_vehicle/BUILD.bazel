load("@rosdistro//ament:defs.bzl", "ament_package")

package(default_visibility = ["//visibility:public"])

# No code: share/autoware_core_vehicle/{launch,urdf} (INSTALL_TO_SHARE).
ament_package(
    name = "ament_package",
    data = glob(["launch/**", "urdf/**"]),
    package_xml = "package.xml",
    deps = [
        "@robot_state_publisher//:ament_package",
        "@rosdistro//:ament_package",
    ],
)

# The installed package doubles as the runtime ament index of this package in tests (data = [":ament_index"]).
alias(
    name = "ament_index",
    actual = ":ament_package",
)
