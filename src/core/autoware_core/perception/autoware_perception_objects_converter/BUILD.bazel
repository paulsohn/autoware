load("@autoware_cmake//:defs.bzl", "AUTOWARE_CXXOPTS", "AUTOWARE_DEFINES", "autoware_copts")
load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

DEPENDENCIES = {
    "@autoware_perception_msgs//:cc_shared": "@autoware_perception_msgs//:cc",
    "@autoware_utils_uuid//:autoware_utils_uuid": "@autoware_utils_uuid//:autoware_utils_uuid_library",
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@unique_identifier_msgs//:cc_shared": "@unique_identifier_msgs//:cc",
}

# Component library; keeps the CMake name, since the component record stores the .so file name.
cc_library(
    name = "detected_to_predicted_objects_converter_library",
    srcs = [
        "src/conversion.hpp",
        "src/detected_to_predicted_objects_converter.cpp",
        "src/detected_to_predicted_objects_converter.hpp",
    ],
    copts = autoware_copts(),
    cxxopts = AUTOWARE_CXXOPTS,
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "detected_to_predicted_objects_converter",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":detected_to_predicted_objects_converter_library"],
    deps = [":detected_to_predicted_objects_converter_library"],
)

rclcpp_components_register_node(
    name = "detected_to_predicted_objects_converter_node",
    component = ":detected_to_predicted_objects_converter",
    data = ["@@//bazel/config:cyclonedds.xml"],
    node_name = "detected_to_predicted_objects_converter_node",
    plugin = "autoware::perception_objects_converter::DetectedToPredictedObjectsConverter",
)

ament_package(
    name = "ament_package",
    components = [":detected_to_predicted_objects_converter_node_record"],
    data = glob(["launch/**"]),
    executables = [":detected_to_predicted_objects_converter_node"],
    libraries = [":detected_to_predicted_objects_converter"],
    package_xml = "package.xml",
    deps = [
        "@autoware_perception_msgs//:ament_package",
        "@autoware_utils_uuid//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rosdistro//:ament_package",
        "@unique_identifier_msgs//:ament_package",
    ],
)

# The installed package doubles as the runtime ament index of this package in tests (data = [":ament_index"]).
alias(
    name = "ament_index",
    actual = ":ament_package",
)

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [":detected_to_predicted_objects_converter"],
    visibility = ["//visibility:private"],
)

cc_test(
    name = "test_autoware_perception_objects_converter",
    srcs = [
        "src/conversion.hpp",
        "test/test_conversion.cpp",
    ],
    copts = autoware_copts(),
    cxxopts = AUTOWARE_CXXOPTS,
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    data = ["@@//bazel/config:cyclonedds.xml"],
    dynamic_deps = [":test_dynamic_deps"],
    deps = [
        ":detected_to_predicted_objects_converter_library",
        "@rosdistro//cc:googletest",
    ],
)
