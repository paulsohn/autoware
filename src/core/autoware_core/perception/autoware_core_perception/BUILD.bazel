load("@rosdistro//ament:defs.bzl", "ament_package")

package(default_visibility = ["//visibility:public"])

# No code: share/autoware_core_perception/{config,launch} (INSTALL_TO_SHARE); the launch files start the packages below.
ament_package(
    name = "ament_package",
    data = glob([
        "config/**",
        "launch/**",
    ]),
    package_xml = "package.xml",
    deps = [
        "@autoware_euclidean_cluster_object_detector//:ament_package",
        "@autoware_ground_filter//:ament_package",
        "@autoware_perception_objects_converter//:ament_package",
        "@rosdistro//:ament_package",
    ],
)

# The installed package doubles as the runtime ament index of this package in tests (data = [":ament_index"]).
alias(
    name = "ament_index",
    actual = ":ament_package",
)
