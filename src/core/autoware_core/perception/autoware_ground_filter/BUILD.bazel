load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "config/ground_filter.param.yaml",
])

cc_library(
    name = "autoware_ground_filter",
    srcs = glob(["src/*.cpp"]),
    hdrs = glob(["src/*.hpp"]),
    deps = [
        "@autoware_internal_debug_msgs//:cc",
        "@autoware_point_types",
        "@autoware_utils_debug",
        "@autoware_utils_geometry",
        "@autoware_utils_math",
        "@autoware_utils_system",
        "@autoware_utils_tf",
        "@autoware_vehicle_info_utils",
        "@message_filters//:message_filters_library",
        "@pcl_conversions//:pcl_conversions_library",
        "@pcl_msgs//:cc",
        "@pcl_ros//:pcl_ros_tf_library",
        "@rcl_interfaces//:cc",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
        "@rcpputils//:rcpputils_library",
        "@rosdistro//cc:boost.thread",
        "@rosdistro//cc:pcl_filters",
        "@sensor_msgs//:cc",
        "@std_msgs//:cc",
        "@tf2_eigen//:tf2_eigen_library",
        "@tf2_sensor_msgs//:tf2_sensor_msgs_library",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_utils_debug//:runtime_dynamic_deps",
        "@message_filters//:message_filters",
        "@pcl_conversions//:pcl_conversions",
        "@pcl_ros//:pcl_ros_tf",
        "@rclcpp_components//:rclcpp_components",
        "@tf2_eigen//:tf2_eigen",
        "@tf2_sensor_msgs//:tf2_sensor_msgs",
        "@autoware_internal_debug_msgs//:cc_shared",
        "@pcl_msgs//:cc_shared",
        "@rcl_interfaces//:cc_shared",
        "@sensor_msgs//:cc_shared",
    ],
)

cc_shared_library(
    name = "ground_filter_component",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":autoware_ground_filter"],
)

rclcpp_components_register_node(
    name = "ground_filter_node",
    component = ":ground_filter_component",
    node_name = "ground_filter_node",
    plugin = "autoware::ground_filter::GroundFilterComponent",
)

register_ament_files(
    name = "node_executables",
    files = [":ground_filter_node"],
    prefix = "lib/autoware_ground_filter",
    strip_prefix = "*",
)

ament_index(
    components = [":ground_filter_node_record"],
    data = glob([
        "config/*",
        "launch/*",
    ]) + [":node_executables"],
    package_xml = "package.xml",
)

[
    cc_test(
        name = name,
        srcs = ["test/" + name + ".cpp"],
        data = [
            ":ament_index",
            "@autoware_test_utils//:ament_index",
        ],
        dynamic_deps = [
            ":runtime_dynamic_deps",
            "@autoware_test_utils//:runtime_dynamic_deps",
        ],
        includes = ["src"],
        deps = [
            ":autoware_ground_filter",
            "@autoware_test_utils",
            "@googletest//:gtest_main" if integration else "@googletest//:gtest",
        ],
    )
    for name, integration in [
        ("test_ground_filter", False),
        ("test_sanity_check", False),
        ("test_ground_filter_integration", True),
    ]
]
