load("@autoware_agnocast_wrapper//:defs.bzl", "autoware_agnocast_wrapper_register_node")
load("@autoware_cmake//:defs.bzl", "AUTOWARE_CXXOPTS", "AUTOWARE_DEFINES", "autoware_copts")
load("@rosdistro//ament:defs.bzl", "ament_index")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

# Deliberate differences from CMakeLists.txt (checked by bazel/tools/cmake_parity):
# cmake-diff if:NOT (DEFINED ENV{ENABLE_AGNOCAST} AND $ENV{ENABLE_AGNOCAST} STREQUAL 1): the node test, which CMake
#   builds only without Agnocast, is built and runs on the ROS 2 backend (ENABLE_AGNOCAST=0); PLAN.md.

DEPENDENCIES = {
    "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper": "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper_library",
    "@autoware_internal_debug_msgs//:cc_shared": "@autoware_internal_debug_msgs//:cc",
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@nav_msgs//:cc_shared": "@nav_msgs//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@tf2//:tf2": "@tf2//:tf2_library",
}

cc_library(
    name = "autoware_stop_filter_library",
    srcs = ["src/stop_filter.cpp"],
    hdrs = ["src/stop_filter.hpp"],
    copts = autoware_copts(),
    cxxopts = AUTOWARE_CXXOPTS,
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "autoware_stop_filter",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":autoware_stop_filter_library"],
    deps = [":autoware_stop_filter_library"],
)

# Component library.
cc_library(
    name = "autoware_stop_filter_ros_library",
    srcs = ["src/stop_filter_node.cpp"],
    hdrs = ["src/stop_filter_node.hpp"],
    copts = autoware_copts(),
    cxxopts = AUTOWARE_CXXOPTS,
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    deps = [":autoware_stop_filter_library"] + DEPENDENCIES.values(),
)

cc_shared_library(
    name = "autoware_stop_filter_ros",
    dynamic_deps = [":autoware_stop_filter"] + DEPENDENCIES.keys(),
    exports_filter = [":autoware_stop_filter_ros_library"],
    deps = [":autoware_stop_filter_ros_library"],
)

autoware_agnocast_wrapper_register_node(
    agnocast_executor = "AgnocastOnlyCallbackIsolatedExecutor",
    component = ":autoware_stop_filter_ros",
    data = ["@@//bazel/config:cyclonedds.xml"],
    executable = "autoware_stop_filter_node",
    plugin = "autoware::stop_filter::StopFilterNode",
    ros2_executor = "SingleThreadedExecutor",
)

# share/autoware_stop_filter/{launch,config} (INSTALL_TO_SHARE).
ament_index(
    name = "ament_index",
    components = [":autoware_stop_filter_node_component_record"],
    data = glob([
        "config/**",
        "launch/**",
    ]),
    executables = [":autoware_stop_filter_node"],
    libraries = [
        ":autoware_stop_filter",
        ":autoware_stop_filter_ros",
    ],
    package_xml = "package.xml",
    deps = [":autoware_stop_filter_node_autoware_node_plugin"],
)

# target_include_directories(<test> PRIVATE src)
cc_library(
    name = "src_headers",
    testonly = True,
    hdrs = glob(["src/*.hpp"]),
    includes = ["src"],
    visibility = ["//visibility:private"],
)

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [":autoware_stop_filter_ros"],
    visibility = ["//visibility:private"],
)

[cc_test(
    name = name,
    srcs = ["test/{}.cpp".format(name)],
    copts = autoware_copts(),
    cxxopts = AUTOWARE_CXXOPTS,
    data = ["@@//bazel/config:cyclonedds.xml"],
    dynamic_deps = [":test_dynamic_deps"],
    # Written for the ROS 2 backend (PLAN.md).
    env = {"ENABLE_AGNOCAST": "0"},
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    deps = [
        lib,
        ":src_headers",
        "@rosdistro//cc:googletest",
    ],
) for name, lib in {
    "test_stop_filter": ":autoware_stop_filter_library",
    "test_stop_filter_node": ":autoware_stop_filter_ros_library",
}.items()]
