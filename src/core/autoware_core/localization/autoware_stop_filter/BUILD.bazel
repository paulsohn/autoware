load("@autoware_agnocast_wrapper//:defs.bzl", "autoware_agnocast_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "test/test_standalone.py",
    "config/stop_filter.param.yaml",
])

cc_library(
    name = "autoware_stop_filter",
    srcs = ["src/stop_filter.cpp"],
    hdrs = ["src/stop_filter.hpp"],
    deps = [
        "@autoware_internal_debug_msgs//:cc",
        "@nav_msgs//:cc",
    ],
)

cc_library(
    name = "node_library",
    srcs = ["src/stop_filter_node.cpp"],
    hdrs = ["src/stop_filter_node.hpp"],
    deps = [
        ":autoware_stop_filter",
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper_library",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper",
        "@autoware_internal_debug_msgs//:cc_shared",
        "@nav_msgs//:cc_shared",
        "@rclcpp_components//:rclcpp_components",
    ],
)

cc_shared_library(
    name = "autoware_stop_filter_ros",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":node_library"],
)

autoware_agnocast_node(
    name = "autoware_stop_filter_node",
    package_name = "autoware_stop_filter",
    component = ":autoware_stop_filter_ros",
    plugin = "autoware::stop_filter::StopFilterNode",
)

register_ament_files(
    name = "node_executable",
    files = [":autoware_stop_filter_node"],
    prefix = "lib/autoware_stop_filter",
    strip_prefix = "*",
)

ament_index(
    components = [":autoware_stop_filter_node_components"],
    data = glob([
        "config/*",
        "launch/*",
    ]) + [
        ":autoware_stop_filter_node_plugin",
        ":node_executable",
    ],
    package_xml = "package.xml",
)

cc_test(
    name = "test_autoware_stop_filter",
    srcs = ["test/test_stop_filter.cpp"],
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [
        ":autoware_stop_filter",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "test_autoware_stop_filter_node",
    srcs = ["test/test_stop_filter_node.cpp"],
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [
        ":node_library",
        "@googletest//:gtest_main",
    ],
)
