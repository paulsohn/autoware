load("@autoware_agnocast_wrapper//:defs.bzl", "autoware_agnocast_wrapper_register_node")
load("@autoware_cmake//:defs.bzl", "AUTOWARE_CXXOPTS", "AUTOWARE_DEFINES", "autoware_copts")
load("@launch_testing_ros//:defs.bzl", "launch_ros_test")
load("@rosdistro//ament:defs.bzl", "ament_index")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

# Deliberate differences from CMakeLists.txt (checked by bazel/tools/cmake_parity):
# cmake-diff if:NOT (DEFINED ENV{ENABLE_AGNOCAST} AND $ENV{ENABLE_AGNOCAST} STREQUAL 1): the launch test, which CMake adds only without Agnocast, runs on the ROS 2 backend (ENABLE_AGNOCAST=0); PLAN.md.
# cmake-diff timeout:test_utils_test_ekf_localizer_launch.py: CMake TIMEOUT 30; Bazel has fixed tiers, "short" (60 s) is the smallest.
# cmake-diff dep:ros_testing: test_depend, but no ros_testing CMake function is called; the launch test uses launch_ros_test.
# cmake-diff if:DEFINED ENV{ENABLE_AGNOCAST} AND $ENV{ENABLE_AGNOCAST} STREQUAL 1: the gtests are written for ROS 2 and all run on the ROS 2 backend, so none is filtered out for Agnocast; PLAN.md.

DEPENDENCIES = {
    "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper": "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper_library",
    "@autoware_internal_debug_msgs//:cc_shared": "@autoware_internal_debug_msgs//:cc",
    "@autoware_kalman_filter//:autoware_kalman_filter": "@autoware_kalman_filter//:autoware_kalman_filter_library",
    "@autoware_localization_util//:autoware_localization_util": "@autoware_localization_util//:autoware_localization_util_library",
    "@autoware_utils_geometry//:autoware_utils_geometry": "@autoware_utils_geometry//:autoware_utils_geometry_library",
    "@autoware_utils_logging//:autoware_utils_logging": "@autoware_utils_logging//:autoware_utils_logging_library",
    "@autoware_utils_system//:autoware_utils_system": "@autoware_utils_system//:autoware_utils_system_library",
    "@diagnostic_msgs//:cc_shared": "@diagnostic_msgs//:cc",
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@nav_msgs//:cc_shared": "@nav_msgs//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@std_srvs//:cc_shared": "@std_srvs//:cc",
    "@tf2//:tf2": "@tf2//:tf2_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
}

# Component library; target_include_directories(PUBLIC src).
cc_library(
    name = "autoware_ekf_localizer_library",
    srcs = [
        "src/ekf_localizer.cpp",
        "src/ekf_localizer_node.cpp",
        "src/utils/covariance.cpp",
        "src/utils/diagnostics.cpp",
        "src/utils/hyper_parameters.cpp",
        "src/utils/mahalanobis.cpp",
        "src/utils/measurement.cpp",
        "src/utils/state_transition.cpp",
        "src/utils/warning_message.cpp",
    ],
    hdrs = glob(["src/**/*.hpp"]),
    copts = autoware_copts(),
    cxxopts = AUTOWARE_CXXOPTS,
    includes = ["src"],
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    deps = DEPENDENCIES.values() + [
        "@rosdistro//cc:eigen",
        "@rosdistro//cc:fmt",
    ],
)

cc_shared_library(
    name = "autoware_ekf_localizer",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":autoware_ekf_localizer_library"],
    deps = [":autoware_ekf_localizer_library"],
)

autoware_agnocast_wrapper_register_node(
    agnocast_executor = "AgnocastOnlyCallbackIsolatedExecutor",
    component = ":autoware_ekf_localizer",
    data = ["@@//bazel/config:cyclonedds.xml"],
    executable = "autoware_ekf_localizer_node",
    plugin = "autoware::ekf_localizer::EKFLocalizerNode",
    ros2_executor = "SingleThreadedExecutor",
)

# share/autoware_ekf_localizer/{config,launch} (INSTALL_TO_SHARE).
ament_index(
    name = "ament_index",
    components = [":autoware_ekf_localizer_node_component_record"],
    data = glob([
        "config/**",
        "launch/**",
    ]),
    executables = [":autoware_ekf_localizer_node"],
    libraries = [":autoware_ekf_localizer"],
    package_xml = "package.xml",
    deps = [":autoware_ekf_localizer_node_autoware_node_plugin"],
)

# target_include_directories(<test> PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}): tests include "src/...".
cc_library(
    name = "package_root_headers",
    testonly = True,
    hdrs = glob(["src/**/*.hpp"]),
    includes = ["."],
    visibility = ["//visibility:private"],
)

TEST_DEPENDENCIES = {
    "@rosgraph_msgs//:cc_shared": "@rosgraph_msgs//:cc",
}

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [":autoware_ekf_localizer"] + TEST_DEPENDENCIES.keys(),
    visibility = ["//visibility:private"],
)

# file(GLOB_RECURSE TEST_FILES test/*.cpp) + add_testcase(): one gtest per file, named after it.
[
    cc_test(
        name = src.rsplit("/", 1)[-1].removesuffix(".cpp"),
        srcs = [src],
        copts = autoware_copts(),
        cxxopts = AUTOWARE_CXXOPTS,
        data = ["@@//bazel/config:cyclonedds.xml"],
        dynamic_deps = [":test_dynamic_deps"],
        # Written for the ROS 2 backend (PLAN.md).
        env = {"ENABLE_AGNOCAST": "0"},
        local_defines = ros_local_defines() + AUTOWARE_DEFINES,
        deps = [
            ":autoware_ekf_localizer_library",
            ":package_root_headers",
            "@rosdistro//cc:googletest",
        ] + TEST_DEPENDENCIES.values(),
    )
    for src in glob(["test/**/*.cpp"])
]

launch_ros_test(
    # add_launch_test() names the test after its path.
    name = "test_utils_test_ekf_localizer_launch.py",
    src = "test/utils/test_ekf_localizer_launch.py",
    data = [
        ":ament_index",
        "@@//bazel/config:cyclonedds.xml",
        "@autoware_agnocast_wrapper//:ament_index",
    ],
    # Written for the ROS 2 backend (PLAN.md).
    env = {"ENABLE_AGNOCAST": "0"},
    timeout = "short",
    deps = [
        ":autoware_ekf_localizer_node",
        "@ament_index_python",
        "@geometry_msgs//:py",
        "@nav_msgs//:py",
        "@rclpy",
        "@std_srvs//:py",
    ],
)
