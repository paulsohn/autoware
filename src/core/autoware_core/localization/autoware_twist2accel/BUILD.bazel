load("@autoware_agnocast_wrapper//:defs.bzl", "autoware_agnocast_wrapper_register_node")
load("@autoware_cmake//:defs.bzl", "AUTOWARE_CXXOPTS", "AUTOWARE_DEFINES", "autoware_copts")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

# Deliberate differences from CMakeLists.txt (checked by bazel/tools/cmake_parity):
# cmake-diff if:NOT (DEFINED ENV{ENABLE_AGNOCAST} AND $ENV{ENABLE_AGNOCAST} STREQUAL 1): the node test, which CMake builds only without Agnocast, is built and runs on the ROS 2 backend (ENABLE_AGNOCAST=0); PLAN.md.

DEPENDENCIES = {
    "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper": "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper_library",
    "@autoware_signal_processing//:autoware_signal_processing": "@autoware_signal_processing//:autoware_signal_processing_library",
    "@autoware_utils_geometry//:autoware_utils_geometry": "@autoware_utils_geometry//:autoware_utils_geometry_library",
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@nav_msgs//:cc_shared": "@nav_msgs//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
}

# Component library.
cc_library(
    name = "autoware_twist2accel_library",
    srcs = [
        "src/accel_estimator.cpp",
        "src/twist2accel.cpp",
    ],
    hdrs = [
        "src/accel_estimator.hpp",
        "src/twist2accel.hpp",
    ],
    copts = autoware_copts(),
    cxxopts = AUTOWARE_CXXOPTS,
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "autoware_twist2accel",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":autoware_twist2accel_library"],
    deps = [":autoware_twist2accel_library"],
)

autoware_agnocast_wrapper_register_node(
    agnocast_executor = "AgnocastOnlyCallbackIsolatedExecutor",
    component = ":autoware_twist2accel",
    data = ["@@//bazel/config:cyclonedds.xml"],
    executable = "autoware_twist2accel_node",
    plugin = "autoware::twist2accel::Twist2Accel",
    ros2_executor = "SingleThreadedExecutor",
)

# share/autoware_twist2accel/{config,launch} (INSTALL_TO_SHARE).
ament_package(
    name = "ament_package",
    components = [":autoware_twist2accel_node_component_record"],
    data = glob([
        "config/**",
        "launch/**",
    ]),
    executables = [":autoware_twist2accel_node"],
    libraries = [
        ":autoware_twist2accel",
    ],
    package_xml = "package.xml",
    deps = [
        ":autoware_twist2accel_node_autoware_node_plugin",
        "@autoware_agnocast_wrapper//:ament_package",
        "@autoware_signal_processing//:ament_package",
        "@autoware_utils_geometry//:ament_package",
        "@geometry_msgs//:ament_package",
        "@nav_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rosdistro//:ament_package",
    ],
)

# The installed package doubles as the runtime ament index of this package in tests (data = [":ament_index"]).
alias(
    name = "ament_index",
    actual = ":ament_package",
)

# target_include_directories(<test> PRIVATE src)
cc_library(
    name = "src_headers",
    testonly = True,
    hdrs = glob(["src/*.hpp"]),
    includes = ["src"],
    visibility = ["//visibility:private"],
)

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [":autoware_twist2accel"],
    visibility = ["//visibility:private"],
)

cc_test(
    name = "test_accel_estimator",
    srcs = ["test/test_accel_estimator.cpp"],
    copts = autoware_copts(),
    cxxopts = AUTOWARE_CXXOPTS,
    data = ["@@//bazel/config:cyclonedds.xml"],
    dynamic_deps = [":test_dynamic_deps"],
    # Written for the ROS 2 backend (PLAN.md).
    env = {"ENABLE_AGNOCAST": "0"},
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    deps = [
        ":autoware_twist2accel_library",
        ":src_headers",
        "@rosdistro//cc:googletest",
    ],
)

cc_test(
    name = "test_twist2accel_node",
    srcs = ["test/test_twist2accel_node.cpp"],
    copts = autoware_copts(),
    cxxopts = AUTOWARE_CXXOPTS,
    data = ["@@//bazel/config:cyclonedds.xml"],
    dynamic_deps = [":test_dynamic_deps"],
    # Written for the ROS 2 backend (PLAN.md).
    env = {"ENABLE_AGNOCAST": "0"},
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    deps = [
        ":autoware_twist2accel_library",
        ":src_headers",
        "@rosdistro//cc:googletest",
    ],
)
