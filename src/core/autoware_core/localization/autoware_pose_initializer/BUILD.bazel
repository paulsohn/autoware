load("@autoware_agnocast_wrapper//:defs.bzl", "autoware_agnocast_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_pose_initializer",
    srcs = glob(["src/*.cpp"]),
    hdrs = glob(["src/*.hpp"]),
    deps = [
        "@autoware_adapi_v1_msgs//:cc",
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper_library",
        "@autoware_common_msgs//:cc",
        "@autoware_component_interface_specs",
        "@autoware_component_interface_utils",
        "@autoware_internal_localization_msgs//:cc",
        "@autoware_localization_msgs//:cc",
        "@autoware_map_height_fitter",
        "@autoware_motion_utils",
        "@autoware_utils_diagnostics",
        "@autoware_utils_geometry",
        "@autoware_utils_logging",
        "@diagnostic_msgs//:cc",
        "@geometry_msgs//:cc",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
        "@std_srvs//:cc",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_adapi_v1_msgs//:cc_shared",
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper",
        "@autoware_common_msgs//:cc_shared",
        "@autoware_internal_localization_msgs//:cc_shared",
        "@diagnostic_msgs//:cc_shared",
        "@geometry_msgs//:cc_shared",
        "@rclcpp//:rclcpp",
        "@rclcpp_components//:rclcpp_components",
        "@std_srvs//:cc_shared",
        "@autoware_map_height_fitter//:runtime_dynamic_deps",
        "@autoware_motion_utils//:runtime_dynamic_deps",
        "@diagnostic_updater//:diagnostic_updater",
        "@logging_demo//:cc_shared",
        "@rcutils//:rcutils",
        "@autoware_localization_msgs//:cc_shared",
    ],
)

cc_shared_library(
    name = "pose_initializer_component",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":autoware_pose_initializer"],
)

autoware_agnocast_node(
    name = "autoware_pose_initializer_node",
    package_name = "autoware_pose_initializer",
    component = ":pose_initializer_component",
    plugin = "autoware::pose_initializer::PoseInitializer",
    ros2_executor = "MultiThreadedExecutor",
)

register_ament_files(
    name = "node_executables",
    files = [":autoware_pose_initializer_node"],
    prefix = "lib/autoware_pose_initializer",
    strip_prefix = "*",
)

ament_index(
    components = [":autoware_pose_initializer_node_components"],
    data = glob([
        "config/*",
        "launch/*",
    ]) + [
        ":autoware_pose_initializer_node_plugin",
        ":node_executables",
    ],
    package_xml = "package.xml",
)

[
    cc_test(
        name = name,
        timeout = "long",
        srcs = ["test/" + name + ".cpp"],
        dynamic_deps = [":runtime_dynamic_deps"],
        env = {
            "ENABLE_AGNOCAST": "0",
            "ROS_DOMAIN_ID": "101",
        },
        deps = [
            ":autoware_pose_initializer",
            "@googletest//:gtest_main" if name != "test_pose_initializer_node_integration" else "@googletest//:gtest",
        ],
    )
    for name in [
        "test_copy_vector_to_array",
        "test_localization_util",
        "test_pose_initializer_node_integration",
    ]
]
