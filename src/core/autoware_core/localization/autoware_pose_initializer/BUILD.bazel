load("@autoware_agnocast_wrapper//:defs.bzl", "autoware_agnocast_wrapper_register_node")
load("@autoware_cmake//:defs.bzl", "AUTOWARE_CXXOPTS", "AUTOWARE_DEFINES", "autoware_copts")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

# Deliberate differences from CMakeLists.txt (checked by bazel/tools/cmake_parity):
# cmake-diff if:NOT (DEFINED ENV{ENABLE_AGNOCAST} AND $ENV{ENABLE_AGNOCAST} STREQUAL 1): the node integration test, which CMake builds only without Agnocast, is built and runs on the ROS 2 backend (ENABLE_AGNOCAST=0); PLAN.md.

DEPENDENCIES = {
    "@autoware_adapi_v1_msgs//:cc_shared": "@autoware_adapi_v1_msgs//:cc",
    "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper": "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper_library",
    "@autoware_common_msgs//:cc_shared": "@autoware_common_msgs//:cc",
    "@autoware_component_interface_specs//:autoware_component_interface_specs": "@autoware_component_interface_specs//:autoware_component_interface_specs_library",
    "@autoware_component_interface_utils//:autoware_component_interface_utils": "@autoware_component_interface_utils//:autoware_component_interface_utils_library",
    "@autoware_internal_localization_msgs//:cc_shared": "@autoware_internal_localization_msgs//:cc",
    "@autoware_localization_msgs//:cc_shared": "@autoware_localization_msgs//:cc",
    "@autoware_map_height_fitter//:autoware_map_height_fitter": "@autoware_map_height_fitter//:autoware_map_height_fitter_library",
    "@autoware_motion_utils//:autoware_motion_utils": "@autoware_motion_utils//:autoware_motion_utils_library",
    "@autoware_utils_diagnostics//:autoware_utils_diagnostics": "@autoware_utils_diagnostics//:autoware_utils_diagnostics_library",
    "@autoware_utils_geometry//:autoware_utils_geometry": "@autoware_utils_geometry//:autoware_utils_geometry_library",
    "@autoware_utils_logging//:autoware_utils_logging": "@autoware_utils_logging//:autoware_utils_logging_library",
    "@diagnostic_msgs//:cc_shared": "@diagnostic_msgs//:cc",
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@std_srvs//:cc_shared": "@std_srvs//:cc",
}

# Component library.
cc_library(
    name = "autoware_pose_initializer_library",
    srcs = [
        "src/gnss_module.cpp",
        "src/localization_module.cpp",
        "src/localization_trigger_module.cpp",
        "src/pose_error_check_module.cpp",
        "src/pose_initializer_core.cpp",
        "src/stop_check_module.cpp",
    ] + glob(["src/*.hpp"]),
    copts = autoware_copts(),
    cxxopts = AUTOWARE_CXXOPTS,
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "autoware_pose_initializer",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":autoware_pose_initializer_library"],
    deps = [":autoware_pose_initializer_library"],
)

autoware_agnocast_wrapper_register_node(
    agnocast_executor = "AgnocastOnlyCallbackIsolatedExecutor",
    component = ":autoware_pose_initializer",
    data = ["@@//bazel/config:cyclonedds.xml"],
    executable = "autoware_pose_initializer_node",
    plugin = "autoware::pose_initializer::PoseInitializer",
    ros2_executor = "MultiThreadedExecutor",
)

# share/autoware_pose_initializer/{launch,config} (INSTALL_TO_SHARE).
ament_package(
    name = "ament_package",
    components = [":autoware_pose_initializer_node_component_record"],
    data = glob([
        "config/**",
        "launch/**",
    ]),
    executables = [":autoware_pose_initializer_node"],
    libraries = [":autoware_pose_initializer"],
    package_xml = "package.xml",
    deps = [
        ":autoware_pose_initializer_node_autoware_node_plugin",
        "@autoware_adapi_v1_msgs//:ament_package",
        "@autoware_agnocast_wrapper//:ament_package",
        "@autoware_common_msgs//:ament_package",
        "@autoware_component_interface_specs//:ament_package",
        "@autoware_component_interface_utils//:ament_package",
        "@autoware_internal_localization_msgs//:ament_package",
        "@autoware_map_height_fitter//:ament_package",
        "@autoware_motion_utils//:ament_package",
        "@autoware_utils_diagnostics//:ament_package",
        "@autoware_utils_geometry//:ament_package",
        "@autoware_utils_logging//:ament_package",
        "@diagnostic_msgs//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rosdistro//:ament_package",
        "@std_srvs//:ament_package",
    ],
)

# The installed package doubles as the runtime ament index of this package in tests (data = [":ament_index"]).
alias(
    name = "ament_index",
    actual = ":ament_package",
)

# The tests include "../src/<...>.hpp".
cc_library(
    name = "src_headers",
    testonly = True,
    hdrs = glob(["src/*.hpp"]),
    visibility = ["//visibility:private"],
)

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [":autoware_pose_initializer"],
    visibility = ["//visibility:private"],
)

[
    cc_test(
        name = name,
        srcs = ["test/%s.cpp" % name],
        copts = autoware_copts(),
        cxxopts = AUTOWARE_CXXOPTS,
        data = ["@@//bazel/config:cyclonedds.xml"],
        dynamic_deps = [":test_dynamic_deps"],
        # Written for the ROS 2 backend (PLAN.md).
        env = {"ENABLE_AGNOCAST": "0"},
        local_defines = ros_local_defines() + AUTOWARE_DEFINES,
        deps = [
            ":autoware_pose_initializer_library",
            ":src_headers",
            "@rosdistro//cc:googletest",
        ],
    )
    for name in [
        "test_copy_vector_to_array",
        "test_localization_util",
        "test_pose_initializer_node_integration",
    ]
]
