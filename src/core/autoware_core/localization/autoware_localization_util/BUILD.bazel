load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_localization_util",
    srcs = glob(["src/*.cpp"]),
    hdrs = glob(["include/**/*.hpp"]),
    strip_include_prefix = "include",
    deps = [
        "@autoware_utils_geometry",
        "@autoware_utils_math",
        "@geometry_msgs//:cc",
        "@rclcpp//:rclcpp_library",
        "@rosdistro//cc:eigen",
        "@std_msgs//:cc",
        "@tf2//:tf2_library",
        "@tf2_eigen//:tf2_eigen_library",
        "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
        "@visualization_msgs//:cc",
    ],
)

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [
        "@ament_index_cpp//:ament_index_cpp",
        "@autoware_internal_planning_msgs//:cc_shared",
        "@autoware_perception_msgs//:cc_shared",
        "@autoware_planning_msgs//:cc_shared",
        "@geometry_msgs//:cc_shared",
        "@rcl_yaml_param_parser//:rcl_yaml_param_parser",
        "@rclcpp//:rclcpp",
        "@std_msgs//:cc_shared",
        "@tf2//:tf2",
        "@tf2_eigen//:tf2_eigen",
        "@tf2_geometry_msgs//:tf2_geometry_msgs",
        "@visualization_msgs//:cc_shared",
    ],
)

[
    cc_test(
        name = "test_" + suite,
        srcs = ["test/test_" + suite + ".cpp"],
        dynamic_deps = [":test_dynamic_deps"],
        deps = [
            ":autoware_localization_util",
            "@googletest//:gtest" if suite == "smart_pose_buffer" else "@googletest//:gtest_main",
        ] + ([
            "@ament_index_cpp//:ament_index_cpp_library",
            "@rcl_yaml_param_parser//:rcl_yaml_param_parser_library",
        ] if suite == "smart_pose_buffer" else []),
    )
    for suite in [
        "smart_pose_buffer",
        "tpe",
        "covariance_ellipse",
        "util_func",
    ]
]
