load("@rosdistro//ament:defs.bzl", "ament_index")

package(default_visibility = ["//visibility:public"])

# No code: share/autoware_core_localization/launch (INSTALL_TO_SHARE). Its launch file starts the nodes of its
# exec_depends.
ament_index(
    name = "ament_index",
    data = glob(["launch/**"]),
    package_xml = "package.xml",
    deps = [
        "@autoware_downsample_filters//:ament_index",
        "@autoware_ekf_localizer//:ament_index",
        "@autoware_ndt_scan_matcher//:ament_index",
        "@autoware_pose_initializer//:ament_index",
        "@autoware_stop_filter//:ament_index",
        "@autoware_twist2accel//:ament_index",
        "@topic_tools//:ament_index",
    ],
)
