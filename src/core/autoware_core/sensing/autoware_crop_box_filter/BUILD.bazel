load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "config/crop_box_filter_node.param.yaml",
])

cc_library(
    name = "autoware_crop_box_filter",
    srcs = ["src/crop_box_filter.cpp"],
    hdrs = ["src/crop_box_filter.hpp"],
    deps = [
        "@geometry_msgs//:cc",
        "@rosdistro//cc:eigen",
        "@sensor_msgs//:cc",
        "@tf2_eigen//:tf2_eigen_library",
    ],
)

cc_library(
    name = "node_library",
    srcs = ["src/crop_box_filter_node.cpp"],
    hdrs = ["src/crop_box_filter_node.hpp"],
    deps = [
        ":autoware_crop_box_filter",
        "@autoware_utils_debug",
        "@autoware_utils_system",
        "@autoware_utils_tf",
        "@rcl_interfaces//:cc",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_utils_debug//:runtime_dynamic_deps",
        "@autoware_internal_planning_msgs//:cc_shared",
        "@autoware_perception_msgs//:cc_shared",
        "@autoware_planning_msgs//:cc_shared",
        "@geometry_msgs//:cc_shared",
        "@sensor_msgs//:cc_shared",
        "@rcl_interfaces//:cc_shared",
        "@rclcpp_components//:rclcpp_components",
        "@tf2//:tf2",
        "@tf2_eigen//:tf2_eigen",
        "@tf2_geometry_msgs//:tf2_geometry_msgs",
        "@tf2_ros//:tf2_ros",
    ],
)

cc_shared_library(
    name = "crop_box_filter_node",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":node_library"],
)

rclcpp_components_register_node(
    name = "crop_box_filter",
    component = ":crop_box_filter_node",
    node_name = "crop_box_filter",
    plugin = "autoware::crop_box_filter::CropBoxFilterNode",
)

register_ament_files(
    name = "node_executable",
    files = [":crop_box_filter"],
    prefix = "lib/autoware_crop_box_filter",
    strip_prefix = "*",
)

ament_index(
    components = [":crop_box_filter_record"],
    data = glob([
        "config/*",
        "launch/*",
    ]) + [":node_executable"],
    package_xml = "package.xml",
)

[
    cc_test(
        name = name,
        srcs = [src],
        dynamic_deps = [":runtime_dynamic_deps"],
        includes = ["src"],
        deps = [
            dep,
            "@googletest//:gtest",
            "@rclcpp//:rclcpp_library",
            "@tf2_ros//:tf2_ros_library",
        ],
    )
    for name, src, dep in [
        ("test_crop_box_filter", "test/test_crop_box_filter.cpp", ":autoware_crop_box_filter"),
        ("test_crop_box_filter_integration", "test/test_crop_box_filter_integration.cpp", ":node_library"),
    ]
]
