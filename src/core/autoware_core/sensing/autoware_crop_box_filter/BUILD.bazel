load("@autoware_cmake//:defs.bzl", "AUTOWARE_CXXOPTS", "AUTOWARE_DEFINES", "autoware_copts")
load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

DEPENDENCIES = {
    "@autoware_internal_debug_msgs//:cc_shared": "@autoware_internal_debug_msgs//:cc",
    "@autoware_point_types//:autoware_point_types": "@autoware_point_types//:autoware_point_types_library",
    "@autoware_utils_debug//:autoware_utils_debug": "@autoware_utils_debug//:autoware_utils_debug_library",
    "@autoware_utils_system//:autoware_utils_system": "@autoware_utils_system//:autoware_utils_system_library",
    "@autoware_utils_tf//:autoware_utils_tf": "@autoware_utils_tf//:autoware_utils_tf_library",
    "@builtin_interfaces//:cc_shared": "@builtin_interfaces//:cc",
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@rcl_interfaces//:cc_shared": "@rcl_interfaces//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@sensor_msgs//:cc_shared": "@sensor_msgs//:cc",
    "@tf2_eigen//:tf2_eigen": "@tf2_eigen//:tf2_eigen_library",
}

# Component library; keeps the CMake name (crop_box_filter_node), which the component record stores.
cc_library(
    name = "crop_box_filter_node_library",
    srcs = glob([
        "src/*.cpp",
        "src/*.hpp",
    ]),
    copts = autoware_copts(),
    cxxopts = AUTOWARE_CXXOPTS,
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    deps = DEPENDENCIES.values() + ["@rosdistro//cc:eigen"],
)

cc_shared_library(
    name = "crop_box_filter_node",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":crop_box_filter_node_library"],
    deps = [":crop_box_filter_node_library"],
)

rclcpp_components_register_node(
    name = "crop_box_filter",
    component = ":crop_box_filter_node",
    data = ["@@//bazel/config:cyclonedds.xml"],
    node_name = "crop_box_filter",
    plugin = "autoware::crop_box_filter::CropBoxFilterNode",
)

# share/autoware_crop_box_filter/{launch,config,test} (INSTALL_TO_SHARE).
ament_index(
    name = "ament_index",
    components = [":crop_box_filter_record"],
    data = glob([
        "config/**",
        "launch/**",
        "test/**",
    ]),
    executables = [":crop_box_filter"],
    libraries = [":crop_box_filter_node"],
    package_xml = "package.xml",
)

# target_include_directories(<test> PRIVATE src)
cc_library(
    name = "src_headers",
    testonly = True,
    hdrs = glob(["src/*.hpp"]),
    includes = ["src"],
    visibility = ["//visibility:private"],
)

TEST_DEPENDENCIES = {
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
}

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [":crop_box_filter_node"] + TEST_DEPENDENCIES.keys(),
    visibility = ["//visibility:private"],
)

[cc_test(
    name = name,
    srcs = ["test/{}.cpp".format(name)],
    copts = autoware_copts(),
    cxxopts = AUTOWARE_CXXOPTS,
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    data = ["@@//bazel/config:cyclonedds.xml"],
    dynamic_deps = [":test_dynamic_deps"],
    deps = [
        ":crop_box_filter_node_library",
        ":src_headers",
        "@googletest//:gtest",
    ] + TEST_DEPENDENCIES.values(),
) for name in [
    "test_crop_box_filter",
    "test_crop_box_filter_integration",
]]
