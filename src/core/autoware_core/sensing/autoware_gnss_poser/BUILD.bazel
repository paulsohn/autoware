load("@autoware_agnocast_wrapper//:defs.bzl", "autoware_agnocast_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "test/test_standalone.py",
    "config/gnss_poser.param.yaml",
])

cc_library(
    name = "autoware_gnss_poser",
    srcs = ["src/gnss_poser_node.cpp"],
    hdrs = ["src/gnss_poser_node.hpp"],
    deps = [
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper_library",
        "@autoware_geography_utils",
        "@autoware_internal_debug_msgs//:cc",
        "@autoware_map_msgs//:cc",
        "@autoware_sensing_msgs//:cc",
        "@geometry_msgs//:cc",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
        "@rosdistro//cc:boost.circular_buffer",
        "@sensor_msgs//:cc",
        "@tf2//:tf2_library",
        "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper",
        "@autoware_geography_utils//:runtime_dynamic_deps",
        "@autoware_internal_debug_msgs//:cc_shared",
        "@autoware_map_msgs//:cc_shared",
        "@autoware_sensing_msgs//:cc_shared",
        "@geographic_msgs//:cc_shared",
        "@geometry_msgs//:cc_shared",
        "@rclcpp_components//:rclcpp_components",
        "@sensor_msgs//:cc_shared",
        "@tf2_msgs//:cc_shared",
        "@tf2_ros//:tf2_ros",
    ],
)

cc_shared_library(
    name = "gnss_poser_component",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":autoware_gnss_poser"],
)

autoware_agnocast_node(
    name = "gnss_poser",
    package_name = "autoware_gnss_poser",
    component = ":gnss_poser_component",
    plugin = "autoware::gnss_poser::GNSSPoser",
)

register_ament_files(
    name = "node_executable",
    files = [":gnss_poser"],
    prefix = "lib/autoware_gnss_poser",
    strip_prefix = "*",
)

ament_index(
    components = [":gnss_poser_components"],
    data = glob([
        "config/*",
        "launch/*",
    ]) + [
        ":gnss_poser_plugin",
        ":node_executable",
    ],
    package_xml = "package.xml",
)

[
    cc_binary(
        name = name + "_binary",
        testonly = True,
        srcs = [src],
        defines = ['GNSS_POSER_CONFIG_DIR=\\"share/autoware_gnss_poser/config\\"'],
        dynamic_deps = [":runtime_dynamic_deps"],
        includes = ["src"],
        deps = [
            ":autoware_gnss_poser",
            "@geographic_msgs//:cc",
            "@googletest//:gtest",
            "@tf2_msgs//:cc",
            "@tf2_ros//:tf2_ros_library",
        ],
    )
    for name, src in [
        ("test_gnss_poser", "test/test_gnss_poser_node.cpp"),
        ("test_gnss_poser_characterization", "test/test_gnss_poser_node_characterization.cpp"),
    ]
]

[
    sh_test(
        name = name,
        timeout = "long",
        srcs = ["test/run_geoid_test.sh"],
        args = [
            "$(rootpath :" + name + "_binary)",
            "$(rootpath @autoware_geography_utils//:geoid_grid)",
        ],
        data = [
            ":" + name + "_binary",
            ":ament_index",
            "@autoware_geography_utils//:geoid_grid",
        ],
    )
    for name in [
        "test_gnss_poser",
        "test_gnss_poser_characterization",
    ]
]
