load("@rosdistro//ament:defs.bzl", "ament_package")
load("@autoware_cmake//:defs.bzl", "AUTOWARE_CXXOPTS", "AUTOWARE_DEFINES", "autoware_copts")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")

package(default_visibility = ["//visibility:public"])

DEPENDENCIES = {
    "@autoware_adapi_v1_msgs//:cc_shared": "@autoware_adapi_v1_msgs//:cc",
    "@autoware_adapi_version_msgs//:cc_shared": "@autoware_adapi_version_msgs//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
}

cc_library(
    name = "autoware_adapi_specs_library",
    hdrs = glob(["include/**/*.hpp"]),
    copts = autoware_copts(),
    cxxopts = AUTOWARE_CXXOPTS,
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    includes = ["include"],
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "autoware_adapi_specs",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":autoware_adapi_specs_library"],
    deps = [":autoware_adapi_specs_library"],
)

# Installable package (P4): the shared libraries and the package.xml dependencies.
ament_package(
    name = "ament_package",
    libraries = [
        ":autoware_adapi_specs",
    ],
    package_xml = "package.xml",
    deps = [
        "@autoware_adapi_v1_msgs//:ament_package",
        "@autoware_adapi_version_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
