load("@autoware_agnocast_wrapper//:defs.bzl", "autoware_agnocast_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_default_adapi",
    srcs = glob(["src/**/*.cpp"]),
    hdrs = glob(["src/**/*.hpp"]),
    includes = ["src"],
    deps = [
        "@autoware_adapi_specs",
        "@autoware_adapi_v1_msgs//:cc",
        "@autoware_adapi_version_msgs//:cc",
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper_library",
        "@autoware_common_msgs//:cc",
        "@autoware_component_interface_specs",
        "@autoware_component_interface_utils",
        "@autoware_geography_utils",
        "@autoware_localization_msgs//:cc",
        "@autoware_motion_utils",
        "@autoware_planning_msgs//:cc",
        "@autoware_system_msgs//:cc",
        "@autoware_utils_rclcpp",
        "@autoware_vehicle_info_utils",
        "@autoware_vehicle_msgs//:cc",
        "@diagnostic_msgs//:cc",
        "@diagnostic_updater//:diagnostic_updater_library",
        "@geographic_msgs//:cc",
        "@nav_msgs//:cc",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
        "@shape_msgs//:cc",
        "@std_srvs//:cc",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_adapi_specs//:runtime_dynamic_deps",
        "@autoware_adapi_v1_msgs//:cc_shared",
        "@autoware_adapi_version_msgs//:cc_shared",
        "@autoware_agnocast_wrapper//:test_dynamic_deps",
        "@autoware_common_msgs//:cc_shared",
        "@autoware_component_interface_specs//:runtime_dynamic_deps",
        "@autoware_component_interface_utils//:runtime_dynamic_deps",
        "@autoware_geography_utils//:runtime_dynamic_deps",
        "@autoware_localization_msgs//:cc_shared",
        "@autoware_motion_utils//:runtime_dynamic_deps",
        "@autoware_planning_msgs//:cc_shared",
        "@autoware_system_msgs//:cc_shared",
        "@autoware_vehicle_msgs//:cc_shared",
        "@diagnostic_msgs//:cc_shared",
        "@diagnostic_updater//:diagnostic_updater",
        "@geographic_msgs//:cc_shared",
        "@nav_msgs//:cc_shared",
        "@rclcpp//:rclcpp",
        "@rclcpp_components//:rclcpp_components",
        "@shape_msgs//:cc_shared",
        "@std_srvs//:cc_shared",
    ],
)

cc_shared_library(
    name = "api_component",
    dynamic_deps = [":runtime_dynamic_deps"],
    shared_lib_name = "libautoware_default_adapi_component.so",
    deps = [":autoware_default_adapi"],
)

autoware_agnocast_node(
    name = "interface_node",
    package_name = "autoware_default_adapi",
    component = ":api_component",
    plugin = "autoware::default_adapi::InterfaceNode",
    ros2_executor = "MultiThreadedExecutor",
)

autoware_agnocast_node(
    name = "localization_node",
    package_name = "autoware_default_adapi",
    component = ":api_component",
    plugin = "autoware::default_adapi::LocalizationNode",
    ros2_executor = "MultiThreadedExecutor",
)

autoware_agnocast_node(
    name = "routing_node",
    package_name = "autoware_default_adapi",
    component = ":api_component",
    plugin = "autoware::default_adapi::RoutingNode",
    ros2_executor = "MultiThreadedExecutor",
)

register_ament_files(
    name = "node_executables",
    files = [
        ":interface_node",
        ":localization_node",
        ":routing_node",
    ],
    prefix = "lib/autoware_default_adapi",
    strip_prefix = "*",
)

ament_index(
    components = [
        ":interface_node_components",
        ":localization_node_components",
        ":routing_node_components",
    ],
    data = glob([
        "config/**",
        "launch/**",
        "test/**",
    ]) + [
        ":interface_node_plugin",
        ":localization_node_plugin",
        ":node_executables",
        ":routing_node_plugin",
    ],
    package_xml = "package.xml",
    deps = [
        "@autoware_agnocast_wrapper//:ament_package",
        "@autoware_global_parameter_loader//:ament_index",
        "@rclcpp_components//:ament_package",
    ],
)

cc_test(
    name = "test_autoware_default_adapi",
    srcs = [
        "test/test_conversion.cpp",
    ],
    dynamic_deps = [":runtime_dynamic_deps"],
    env = {"ENABLE_AGNOCAST": "0"},
    deps = [
        ":autoware_default_adapi",
        "@geometry_msgs//:cc",
        "@googletest//:gtest",
    ],
)
