load("@autoware_agnocast_wrapper//:defs.bzl", "autoware_agnocast_wrapper_register_node")
load("@autoware_cmake//:defs.bzl", "AUTOWARE_CXXOPTS", "AUTOWARE_DEFINES", "autoware_copts")
load("@launch_testing_ros//:defs.bzl", "launch_ros_test")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

# Deliberate differences from CMakeLists.txt (checked by bazel/tools/cmake_parity):
# cmake-diff if:NOT (DEFINED ENV{ENABLE_AGNOCAST} AND $ENV{ENABLE_AGNOCAST} STREQUAL 1): the launch test, which CMake adds only without Agnocast, runs on the ROS 2 backend (ENABLE_AGNOCAST=0); PLAN.md.

# Not built here: exec_depend autoware_global_parameter_loader, used only by launch/test_default_adapi.launch.xml; it belongs to the runtime install tree (P4), not to any target here.

DEPENDENCIES = {
    "@autoware_adapi_specs//:autoware_adapi_specs": "@autoware_adapi_specs//:autoware_adapi_specs_library",
    "@autoware_adapi_v1_msgs//:cc_shared": "@autoware_adapi_v1_msgs//:cc",
    "@autoware_adapi_version_msgs//:cc_shared": "@autoware_adapi_version_msgs//:cc",
    "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper": "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper_library",
    "@autoware_common_msgs//:cc_shared": "@autoware_common_msgs//:cc",
    "@autoware_component_interface_specs//:autoware_component_interface_specs": "@autoware_component_interface_specs//:autoware_component_interface_specs_library",
    "@autoware_component_interface_utils//:autoware_component_interface_utils": "@autoware_component_interface_utils//:autoware_component_interface_utils_library",
    "@autoware_geography_utils//:autoware_geography_utils": "@autoware_geography_utils//:autoware_geography_utils_library",
    "@autoware_localization_msgs//:cc_shared": "@autoware_localization_msgs//:cc",
    "@autoware_motion_utils//:autoware_motion_utils": "@autoware_motion_utils//:autoware_motion_utils_library",
    "@autoware_planning_msgs//:cc_shared": "@autoware_planning_msgs//:cc",
    "@autoware_system_msgs//:cc_shared": "@autoware_system_msgs//:cc",
    "@autoware_utils_rclcpp//:autoware_utils_rclcpp": "@autoware_utils_rclcpp//:autoware_utils_rclcpp_library",
    "@autoware_vehicle_info_utils//:autoware_vehicle_info_utils": "@autoware_vehicle_info_utils//:autoware_vehicle_info_utils_library",
    "@autoware_vehicle_msgs//:cc_shared": "@autoware_vehicle_msgs//:cc",
    "@diagnostic_msgs//:cc_shared": "@diagnostic_msgs//:cc",
    "@diagnostic_updater//:diagnostic_updater": "@diagnostic_updater//:diagnostic_updater_library",
    "@geographic_msgs//:cc_shared": "@geographic_msgs//:cc",
    "@nav_msgs//:cc_shared": "@nav_msgs//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@shape_msgs//:cc_shared": "@shape_msgs//:cc",
    "@std_srvs//:cc_shared": "@std_srvs//:cc",
}

# Component library holding the three API nodes.
cc_library(
    name = "autoware_default_adapi_library",
    srcs = [
        "src/interface.cpp",
        "src/localization.cpp",
        "src/routing.cpp",
        "src/utils/localization_conversion.cpp",
        "src/utils/route_conversion.cpp",
    ] + glob(["src/**/*.hpp"]),
    copts = autoware_copts(),
    cxxopts = AUTOWARE_CXXOPTS,
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "autoware_default_adapi",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":autoware_default_adapi_library"],
    deps = [":autoware_default_adapi_library"],
)

API_NODES = [
    ("interface_node", "autoware::default_adapi::InterfaceNode"),
    ("localization_node", "autoware::default_adapi::LocalizationNode"),
    ("routing_node", "autoware::default_adapi::RoutingNode"),
]

[
    autoware_agnocast_wrapper_register_node(
        agnocast_executor = "AgnocastOnlyCallbackIsolatedExecutor",
        component = ":autoware_default_adapi",
        data = ["@@//bazel/config:cyclonedds.xml"],
        executable = executable,
        plugin = plugin,
        ros2_executor = "MultiThreadedExecutor",
    )
    for executable, plugin in API_NODES
]

# share/autoware_default_adapi/{config,launch,test} (INSTALL_TO_SHARE).
ament_package(
    name = "ament_package",
    components = [":%s_component_record" % e for e, _ in API_NODES],
    data = glob([
        "config/**",
        "launch/**",
        "test/**",
    ]),
    executables = [":" + e for e, _ in API_NODES],
    libraries = [":autoware_default_adapi"],
    package_xml = "package.xml",
    deps = [":%s_autoware_node_plugin" % e for e, _ in API_NODES] + [
        "@autoware_adapi_specs//:ament_package",
        "@autoware_adapi_v1_msgs//:ament_package",
        "@autoware_adapi_version_msgs//:ament_package",
        "@autoware_agnocast_wrapper//:ament_package",
        "@autoware_common_msgs//:ament_package",
        "@autoware_component_interface_specs//:ament_package",
        "@autoware_component_interface_utils//:ament_package",
        "@autoware_geography_utils//:ament_package",
        "@autoware_global_parameter_loader//:ament_package",
        "@autoware_localization_msgs//:ament_package",
        "@autoware_motion_utils//:ament_package",
        "@autoware_planning_msgs//:ament_package",
        "@autoware_system_msgs//:ament_package",
        "@autoware_utils_rclcpp//:ament_package",
        "@autoware_vehicle_info_utils//:ament_package",
        "@autoware_vehicle_msgs//:ament_package",
        "@diagnostic_msgs//:ament_package",
        "@diagnostic_updater//:ament_package",
        "@geographic_msgs//:ament_package",
        "@nav_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rosdistro//:ament_package",
        "@shape_msgs//:ament_package",
        "@std_srvs//:ament_package",
    ],
)

# The installed package doubles as the runtime ament index of this package in tests (data = [":ament_index"]).
alias(
    name = "ament_index",
    actual = ":ament_package",
)

# target_include_directories(<test> PRIVATE src)
cc_library(
    name = "src_headers",
    testonly = True,
    hdrs = glob(["src/**/*.hpp"]),
    includes = ["src"],
    visibility = ["//visibility:private"],
)

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [":autoware_default_adapi"],
    visibility = ["//visibility:private"],
)

cc_test(
    name = "test_autoware_default_adapi",
    srcs = ["test/test_conversion.cpp"],
    copts = autoware_copts(),
    cxxopts = AUTOWARE_CXXOPTS,
    dynamic_deps = [":test_dynamic_deps"],
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    deps = [
        ":autoware_default_adapi_library",
        ":src_headers",
        "@geometry_msgs//:cc",
        "@rosdistro//cc:googletest",
    ],
)

# add_launch_test() names the test after its path ("/" -> "_"). It composes the nodes into rclcpp_components'
# component_container_mt and runs test/node/interface_version.py with python3 (the runner puts the test's
# interpreter on PATH and exports its PYTHONPATH).
launch_ros_test(
    name = "test_main.test.py",
    src = "test/main.test.py",
    data = [
        ":ament_index",
        "@@//bazel/config:cyclonedds.xml",
        "@autoware_agnocast_wrapper//:ament_index",
        "@rclcpp_components//:ament_index",
    ],
    # Written for the ROS 2 backend (PLAN.md).
    env = {"ENABLE_AGNOCAST": "0"},
    deps = [
        "@ament_index_python",
        "@autoware_adapi_version_msgs//:py",
        "@launch_testing",
        "@rclcpp_components//:component_container_mt",
        "@rclpy",
    ],
)
