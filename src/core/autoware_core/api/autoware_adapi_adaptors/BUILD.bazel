load("@autoware_agnocast_wrapper//:defs.bzl", "autoware_agnocast_wrapper_register_node")
load("@autoware_cmake//:defs.bzl", "AUTOWARE_CXXOPTS", "AUTOWARE_DEFINES", "autoware_copts")
load("@rosdistro//ament:defs.bzl", "ament_index")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

DEPENDENCIES = {
    "@autoware_adapi_specs//:autoware_adapi_specs": "@autoware_adapi_specs//:autoware_adapi_specs_library",
    "@autoware_adapi_v1_msgs//:cc_shared": "@autoware_adapi_v1_msgs//:cc",
    "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper": "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper_library",
    "@autoware_component_interface_specs//:autoware_component_interface_specs": "@autoware_component_interface_specs//:autoware_component_interface_specs_library",
    "@autoware_component_interface_utils//:autoware_component_interface_utils": "@autoware_component_interface_utils//:autoware_component_interface_utils_library",
    "@autoware_map_height_fitter//:autoware_map_height_fitter": "@autoware_map_height_fitter//:autoware_map_height_fitter_library",
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
}

# Component library holding both adaptors.
cc_library(
    name = "autoware_adapi_adaptors_library",
    srcs = [
        "src/initial_pose_adaptor.cpp",
        "src/routing_adaptor.cpp",
    ] + glob(["src/*.hpp"]),
    copts = autoware_copts(),
    cxxopts = AUTOWARE_CXXOPTS,
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "autoware_adapi_adaptors",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":autoware_adapi_adaptors_library"],
    deps = [":autoware_adapi_adaptors_library"],
)

[
    autoware_agnocast_wrapper_register_node(
        agnocast_executor = "AgnocastOnlyCallbackIsolatedExecutor",
        component = ":autoware_adapi_adaptors",
        data = ["@@//bazel/config:cyclonedds.xml"],
        executable = executable,
        plugin = plugin,
        ros2_executor = ros2_executor,
    )
    for executable, plugin, ros2_executor in [
        ("initial_pose_adaptor_node", "autoware::adapi_adaptors::InitialPoseAdaptor", "MultiThreadedExecutor"),
        ("routing_adaptor_node", "autoware::adapi_adaptors::RoutingAdaptor", "SingleThreadedExecutor"),
    ]
]

# share/autoware_adapi_adaptors/{config,launch} (INSTALL_TO_SHARE).
ament_index(
    name = "ament_index",
    components = [
        ":initial_pose_adaptor_node_component_record",
        ":routing_adaptor_node_component_record",
    ],
    data = glob([
        "config/**",
        "launch/**",
    ]),
    executables = [
        ":initial_pose_adaptor_node",
        ":routing_adaptor_node",
    ],
    libraries = [":autoware_adapi_adaptors"],
    package_xml = "package.xml",
    deps = [
        ":initial_pose_adaptor_node_autoware_node_plugin",
        ":routing_adaptor_node_autoware_node_plugin",
    ],
)

# The test includes "../src/<...>.hpp".
cc_library(
    name = "src_headers",
    testonly = True,
    hdrs = glob(["src/*.hpp"]),
    visibility = ["//visibility:private"],
)

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [":autoware_adapi_adaptors"],
    visibility = ["//visibility:private"],
)

# ament_auto_add_gtest: links the package's library and build dependencies.
cc_test(
    name = "test_autoware_adapi_adaptors",
    srcs = ["test/test_helpers.cpp"],
    copts = autoware_copts(),
    cxxopts = AUTOWARE_CXXOPTS,
    dynamic_deps = [":test_dynamic_deps"],
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    deps = [
        ":autoware_adapi_adaptors_library",
        ":src_headers",
        "@rosdistro//cc:googletest",
    ],
)
