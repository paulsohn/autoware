load("@autoware_agnocast_wrapper//:defs.bzl", "autoware_agnocast_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_adapi_adaptors",
    srcs = glob(["src/**/*.cpp"]),
    hdrs = glob(["src/**/*.hpp"]),
    includes = ["src"],
    deps = [
        "@autoware_adapi_specs",
        "@autoware_adapi_v1_msgs//:cc",
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper_library",
        "@autoware_component_interface_specs",
        "@autoware_component_interface_utils",
        "@autoware_map_height_fitter",
        "@geometry_msgs//:cc",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_adapi_specs//:runtime_dynamic_deps",
        "@autoware_adapi_v1_msgs//:cc_shared",
        "@autoware_agnocast_wrapper//:test_dynamic_deps",
        "@autoware_component_interface_specs//:runtime_dynamic_deps",
        "@autoware_component_interface_utils//:runtime_dynamic_deps",
        "@autoware_map_height_fitter//:runtime_dynamic_deps",
        "@geometry_msgs//:cc_shared",
        "@rclcpp//:rclcpp",
        "@rclcpp_components//:rclcpp_components",
    ],
)

cc_shared_library(
    name = "api_component",
    dynamic_deps = [":runtime_dynamic_deps"],
    shared_lib_name = "libautoware_adapi_adaptors_component.so",
    deps = [":autoware_adapi_adaptors"],
)

autoware_agnocast_node(
    name = "initial_pose_adaptor_node",
    package_name = "autoware_adapi_adaptors",
    component = ":api_component",
    plugin = "autoware::adapi_adaptors::InitialPoseAdaptor",
    ros2_executor = "MultiThreadedExecutor",
)

autoware_agnocast_node(
    name = "routing_adaptor_node",
    package_name = "autoware_adapi_adaptors",
    component = ":api_component",
    plugin = "autoware::adapi_adaptors::RoutingAdaptor",
    ros2_executor = "SingleThreadedExecutor",
)

register_ament_files(
    name = "node_executables",
    files = [
        ":initial_pose_adaptor_node",
        ":routing_adaptor_node",
    ],
    prefix = "lib/autoware_adapi_adaptors",
    strip_prefix = "*",
)

ament_index(
    components = [
        ":initial_pose_adaptor_node_components",
        ":routing_adaptor_node_components",
    ],
    data = glob([
        "config/**",
        "launch/**",
        "test/**",
    ]) + [
        ":initial_pose_adaptor_node_plugin",
        ":node_executables",
        ":routing_adaptor_node_plugin",
    ],
    package_xml = "package.xml",
    deps = ["@autoware_agnocast_wrapper//:ament_package"],
)

cc_test(
    name = "test_autoware_adapi_adaptors",
    srcs = [
        "test/test_helpers.cpp",
    ],
    dynamic_deps = [":runtime_dynamic_deps"],
    env = {"ENABLE_AGNOCAST": "0"},
    deps = [
        ":autoware_adapi_adaptors",
        "@geometry_msgs//:cc",
        "@googletest//:gtest",
    ],
)
