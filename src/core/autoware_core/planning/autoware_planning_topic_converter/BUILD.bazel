load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_planning_topic_converter",
    srcs = [
        "src/path_to_trajectory.cpp",
        "src/path_to_trajectory_node.cpp",
    ],
    hdrs = [
        "src/path_to_trajectory.hpp",
        "src/path_to_trajectory_node.hpp",
    ],
    includes = [
        "src",
    ],
    deps = [
        "@autoware_motion_utils",
        "@autoware_planning_msgs//:cc",
        "@autoware_utils_geometry",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_motion_utils//:runtime_dynamic_deps",
        "@autoware_planning_msgs//:cc_shared",
        "@rclcpp//:rclcpp",
        "@rclcpp_components//:rclcpp_components",
    ],
)

cc_shared_library(
    name = "autoware_planning_topic_converter_component",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":autoware_planning_topic_converter"],
)

rclcpp_components_register_node(
    name = "path_to_trajectory_converter_exe",
    component = ":autoware_planning_topic_converter_component",
    node_name = "path_to_trajectory_converter",
    plugin = "autoware::planning_topic_converter::PathToTrajectoryNode",
)

register_ament_files(
    name = "node_executables",
    files = [
        ":path_to_trajectory_converter_exe",
    ],
    prefix = "lib/autoware_planning_topic_converter",
    strip_prefix = "*",
)

ament_index(
    components = [
        ":path_to_trajectory_converter_exe_record",
    ],
    data = [] + [":node_executables"],
    package_xml = "package.xml",
)

cc_test(
    name = "test_path_to_trajectory",
    timeout = "long",
    srcs = [
        "test/test_path_to_trajectory.cpp",
    ],
    data = [
        ":ament_index",
    ],
    dynamic_deps = [
        ":runtime_dynamic_deps",
    ],
    env = {"ROS_DOMAIN_ID": "65"},
    deps = [
        ":autoware_planning_topic_converter",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "test_path_to_trajectory_node",
    timeout = "long",
    srcs = [
        "test/test_path_to_trajectory_node.cpp",
    ],
    data = [
        ":ament_index",
    ],
    dynamic_deps = [
        ":runtime_dynamic_deps",
    ],
    env = {"ROS_DOMAIN_ID": "65"},
    deps = [
        ":autoware_planning_topic_converter",
        "@googletest//:gtest_main",
    ],
)
