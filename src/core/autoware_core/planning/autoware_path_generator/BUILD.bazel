load("@generate_parameter_library//:defs.bzl", "generate_parameter_library")
load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

generate_parameter_library(
    name = "path_generator_parameters",
    yaml_file = "param/path_generator_parameters.yaml",
)

cc_library(
    name = "autoware_path_generator",
    srcs = [
        "src/node.cpp",
        "src/utils.cpp",
    ],
    hdrs = [
        "include/autoware/path_generator/node.hpp",
        "src/utils.hpp",
    ],
    includes = [
        "include",
        "src",
    ],
    deps = [
        ":path_generator_parameters",
        "@autoware_internal_debug_msgs//:cc",
        "@autoware_internal_planning_msgs//:cc",
        "@autoware_lanelet2_utils",
        "@autoware_map_msgs//:cc",
        "@autoware_motion_utils",
        "@autoware_planning_msgs//:cc",
        "@autoware_trajectory",
        "@autoware_utils_debug",
        "@autoware_utils_geometry",
        "@autoware_utils_math",
        "@autoware_utils_rclcpp",
        "@autoware_utils_system",
        "@autoware_vehicle_info_utils",
        "@autoware_vehicle_msgs//:cc",
        "@geometry_msgs//:cc",
        "@lanelet2_core//:lanelet2_core_library",
        "@lanelet2_routing//:lanelet2_routing_library",
        "@nav_msgs//:cc",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
        "@rosdistro//cc:boost.geometry",
        "@rosdistro//cc:eigen",
        "@rosdistro//cc:yaml-cpp_library",
        "@tf2//:tf2_library",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_internal_debug_msgs//:cc_shared",
        "@autoware_internal_planning_msgs//:cc_shared",
        "@autoware_lanelet2_utils//:runtime_dynamic_deps",
        "@autoware_map_msgs//:cc_shared",
        "@autoware_motion_utils//:runtime_dynamic_deps",
        "@autoware_planning_msgs//:cc_shared",
        "@autoware_trajectory//:runtime_dynamic_deps",
        "@autoware_utils_debug//:runtime_dynamic_deps",
        "@autoware_vehicle_msgs//:cc_shared",
        "@generate_parameter_library//:rclcpp_lifecycle",
        "@generate_parameter_library//:rsl",
        "@geometry_msgs//:cc_shared",
        "@nav_msgs//:cc_shared",
        "@rclcpp//:rclcpp",
        "@rclcpp_components//:rclcpp_components",
        "@tf2//:tf2",
    ],
)

cc_shared_library(
    name = "autoware_path_generator_component",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":autoware_path_generator"],
)

rclcpp_components_register_node(
    name = "path_generator_node_exe",
    component = ":autoware_path_generator_component",
    node_name = "path_generator_node",
    plugin = "autoware::path_generator::PathGenerator",
)

register_ament_files(
    name = "node_executables",
    files = [
        ":path_generator_node_exe",
    ],
    prefix = "lib/autoware_path_generator",
    strip_prefix = "*",
)

ament_index(
    components = [
        ":path_generator_node_exe_record",
    ],
    data = glob([
        "config/**",
        "test_route/**",
    ]) + [":node_executables"],
    package_xml = "package.xml",
)

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [
        ":runtime_dynamic_deps",
        "@ament_index_cpp//:ament_index_cpp",
        "@autoware_test_utils//:runtime_dynamic_deps",
        "@autoware_planning_test_manager//:runtime_dynamic_deps",
    ],
)

cc_test(
    name = "test_autoware_path_generator",
    timeout = "long",
    srcs = [
        "test/test_goal_connection.cpp",
        "test/test_lanelet.cpp",
        "test/test_path_cut.cpp",
        "test/test_path_generator_integration.cpp",
        "test/test_turn_signal.cpp",
        "test/utils_test.hpp",
    ],
    data = [
        ":ament_index",
        "@autoware_lanelet2_utils//:ament_index",
        "@autoware_test_utils//:ament_index",
        "@autoware_vehicle_info_utils//:ament_index",
    ],
    dynamic_deps = [
        ":test_dynamic_deps",
    ],
    env = {"ROS_DOMAIN_ID": "65"},
    deps = [
        ":autoware_path_generator",
        "@ament_index_cpp//:ament_index_cpp_library",
        "@autoware_planning_test_manager",
        "@autoware_test_utils",
        "@googletest//:gtest_main",
    ],
)
