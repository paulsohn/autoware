load("@autoware_cmake//:defs.bzl", "AUTOWARE_CXXOPTS", "AUTOWARE_DEFINES", "autoware_copts")
load("@autoware_pyplot//:defs.bzl", "pyplot_test")
load("@rosdistro//ament:defs.bzl", "ament_index")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")

package(default_visibility = ["//visibility:public"])

DEPENDENCIES = {
    "@autoware_internal_planning_msgs//:cc_shared": "@autoware_internal_planning_msgs//:cc",
    "@autoware_lanelet2_extension//:autoware_lanelet2_extension_lib": "@autoware_lanelet2_extension//:autoware_lanelet2_extension_lib_library",
    "@autoware_lanelet2_utils//:autoware_lanelet2_utils": "@autoware_lanelet2_utils//:autoware_lanelet2_utils_library",
    "@autoware_map_msgs//:cc_shared": "@autoware_map_msgs//:cc",
    "@autoware_planning_msgs//:cc_shared": "@autoware_planning_msgs//:cc",
    "@autoware_trajectory//:autoware_trajectory": "@autoware_trajectory//:autoware_trajectory_library",
    "@autoware_utils_geometry//:autoware_utils_geometry": "@autoware_utils_geometry//:autoware_utils_geometry_library",
    "@autoware_utils_math//:autoware_utils_math": "@autoware_utils_math//:autoware_utils_math_library",
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@lanelet2_core//:lanelet2_core": "@lanelet2_core//:lanelet2_core_library",
    "@lanelet2_routing//:lanelet2_routing": "@lanelet2_routing//:lanelet2_routing_library",
    "@lanelet2_traffic_rules//:lanelet2_traffic_rules": "@lanelet2_traffic_rules//:lanelet2_traffic_rules_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@std_msgs//:cc_shared": "@std_msgs//:cc",
    "@tf2//:tf2": "@tf2//:tf2_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
    "@unique_identifier_msgs//:cc_shared": "@unique_identifier_msgs//:cc",
}

cc_library(
    name = "autoware_route_handler_library",
    srcs = ["src/route_handler.cpp"],
    hdrs = glob(["include/**/*.hpp"]),
    copts = autoware_copts(),
    cxxopts = AUTOWARE_CXXOPTS,
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    includes = ["include"],
    deps = DEPENDENCIES.values() + [
        "@rosdistro//cc:boost.geometry",
        "@rosdistro//cc:range-v3",
    ],
)

cc_shared_library(
    name = "autoware_route_handler",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":autoware_route_handler_library"],
    deps = [":autoware_route_handler_library"],
)

# share/autoware_route_handler/test_route (INSTALL_TO_SHARE).
ament_index(
    name = "ament_index",
    data = glob(["test_route/**"]),
    libraries = [":autoware_route_handler"],
    package_xml = "package.xml",
)

TEST_DEPENDENCIES = {
    "@ament_index_cpp//:ament_index_cpp": "@ament_index_cpp//:ament_index_cpp_library",
    "@autoware_test_utils//:autoware_test_utils": "@autoware_test_utils//:autoware_test_utils_library",
    "@lanelet2_io//:lanelet2_io": "@lanelet2_io//:lanelet2_io_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
}

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    testonly = True,
    dynamic_deps = [":autoware_route_handler"] + TEST_DEPENDENCIES.keys(),
    visibility = ["//visibility:private"],
)

# One gtest binary built with PLOT, embedding Python (autoware_pyplot), hence pyplot_test. It links
# autoware_test_utils, whose CMake target adds -Wno-deprecated-declarations PUBLIC.
pyplot_test(
    name = "test_autoware_route_handler",
    srcs = glob([
        "test/*.cpp",
        "test/*.hpp",
    ]),
    copts = autoware_copts() + ["-Wno-deprecated-declarations"],
    cxxopts = AUTOWARE_CXXOPTS,
    data = [
        ":ament_index",
        "@@//bazel/config:cyclonedds.xml",
        "@autoware_lanelet2_utils//:ament_index",
        "@autoware_test_utils//:ament_index",
        "@autoware_trajectory//:ament_index",
    ],
    dynamic_deps = [":test_dynamic_deps"],
    local_defines = ros_local_defines() + AUTOWARE_DEFINES + ["PLOT"],
    deps = [":autoware_route_handler_library"] + TEST_DEPENDENCIES.values() + [
        "@autoware_pyplot",
        "@googletest//:gtest",
        "@rosdistro//cc:fmt",
        "@rosdistro//cc:range-v3",
    ],
)
