load("@rosdistro//ament:defs.bzl", "ament_index")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_behavior_velocity_stop_line_module",
    srcs = [
        "src/debug.cpp",
        "src/experimental/manager.cpp",
        "src/experimental/scene.cpp",
        "src/manager.cpp",
        "src/scene.cpp",
        "src/stop_line_util.cpp",
    ],
    hdrs = [
        "src/experimental/manager.hpp",
        "src/experimental/scene.hpp",
        "src/manager.hpp",
        "src/scene.hpp",
        "src/stop_line_util.hpp",
    ],
    includes = [
        "include",
        "src",
    ],
    deps = [
        "@ament_index_cpp//:ament_index_cpp_library",
        "@autoware_behavior_velocity_planner",
        "@autoware_behavior_velocity_planner_common",
        "@autoware_internal_planning_msgs//:cc",
        "@autoware_motion_utils",
        "@autoware_planning_factor_interface",
        "@autoware_route_handler",
        "@autoware_trajectory",
        "@autoware_utils_debug",
        "@autoware_utils_geometry",
        "@autoware_utils_rclcpp",
        "@geometry_msgs//:cc",
        "@lanelet2_core//:lanelet2_core_library",
        "@pluginlib//:pluginlib_library",
        "@rclcpp//:rclcpp_library",
        "@rosdistro//cc:boost.geometry",
        "@rosdistro//cc:eigen",
        "@rosdistro//cc:pcl_common",
        "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
        "@visualization_msgs//:cc",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@ament_index_cpp//:ament_index_cpp",
        "@autoware_behavior_velocity_planner//:runtime_dynamic_deps",
        "@autoware_behavior_velocity_planner_common//:runtime_dynamic_deps",
        "@autoware_internal_planning_msgs//:cc_shared",
        "@autoware_motion_utils//:runtime_dynamic_deps",
        "@autoware_planning_factor_interface//:runtime_dynamic_deps",
        "@autoware_route_handler//:runtime_dynamic_deps",
        "@autoware_trajectory//:runtime_dynamic_deps",
        "@autoware_utils_debug//:runtime_dynamic_deps",
        "@geometry_msgs//:cc_shared",
        "@lanelet2_core//:lanelet2_core",
        "@pluginlib//:pluginlib",
        "@rclcpp//:rclcpp",
        "@tf2_geometry_msgs//:tf2_geometry_msgs",
        "@visualization_msgs//:cc_shared",
    ],
)

cc_shared_library(
    name = "stop_line_plugin",
    dynamic_deps = [":runtime_dynamic_deps"],
    shared_lib_name = "libautoware_behavior_velocity_stop_line_module.so",
    deps = [":autoware_behavior_velocity_stop_line_module"],
)

ament_index(
    data = glob(["config/**"]),
    libraries = [":stop_line_plugin"],
    package_xml = "package.xml",
    plugin_categories = {"plugins.xml": "autoware_behavior_velocity_planner"},
)

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [
        ":runtime_dynamic_deps",
        "@ament_index_cpp//:ament_index_cpp",
    ],
)

cc_test(
    name = "test_autoware_behavior_velocity_stop_line_module",
    timeout = "long",
    srcs = [
        "test/test_node_interface.cpp",
        "test/test_scene.cpp",
        "test/test_stop_line_util.cpp",
    ],
    data = [
        ":ament_index",
        "@autoware_behavior_velocity_planner//:ament_index",
        "@autoware_behavior_velocity_planner_common//:ament_index",
        "@autoware_lanelet2_utils//:ament_index",
        "@autoware_route_handler//:ament_index",
        "@autoware_test_utils//:ament_index",
        "@autoware_vehicle_info_utils//:ament_index",
        "@autoware_velocity_smoother//:ament_index",
    ],
    dynamic_deps = [":test_dynamic_deps"],
    env = {
        "ENABLE_AGNOCAST": "0",
        "ROS_DOMAIN_ID": "69",
        "LD_LIBRARY_PATH": "lib",
    },
    deps = [
        ":autoware_behavior_velocity_stop_line_module",
        "@ament_index_cpp//:ament_index_cpp_library",
        "@autoware_behavior_velocity_planner//:test_utils",
        "@googletest//:gtest_main",
    ],
)
