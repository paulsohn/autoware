        "@tf2_eigen//:tf2_eigen",
        "@tf2_geometry_msgs//:tf2_geometry_msgs",
        "@tf2_ros//:tf2_ros",
        "@unique_identifier_msgs//:cc_shared",
        "@visualization_msgs//:cc_shared",
    ],
)

ament_index(
    data = glob(
        ["config/**"],
        allow_empty = True,
    ),
    package_xml = "package.xml",
)

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [
        ":runtime_dynamic_deps",
        "@ament_index_cpp//:ament_index_cpp",
        "@autoware_test_utils//:runtime_dynamic_deps",
        "@rcl//:rcl",
    ],
)

cc_test(
    name = "test_autoware_behavior_velocity_planner_common",
    timeout = "long",
    srcs = [
        "test/src/test_arc_lane_util.cpp",
        "test/src/test_path_utilization.cpp",
        "test/src/test_state_machine.cpp",
        "test/src/test_trajectory_utils.cpp",
        "test/src/test_util.cpp",
        "test/src/test_util_pure.cpp",
        "test/src/utils.hpp",
    ],
    data = [
        ":ament_index",
        "@autoware_lanelet2_utils//:ament_index",
        "@autoware_route_handler//:ament_index",
        "@autoware_test_utils//:ament_index",
        "@autoware_vehicle_info_utils//:ament_index",
        "@autoware_velocity_smoother//:ament_index",
    ],
    dynamic_deps = [":test_dynamic_deps"],
    env = {
        "ENABLE_AGNOCAST": "0",
        "ROS_DOMAIN_ID": "69",
        "LD_LIBRARY_PATH": "lib",
    },
    deps = [
        ":autoware_behavior_velocity_planner_common",
        "@ament_index_cpp//:ament_index_cpp_library",
        "@autoware_test_utils",
        "@googletest//:gtest_main",
        "@rcl//:rcl_library",
    ],
)
