# autoware_test_utils' PUBLIC -Wno-deprecated-declarations reaches these targets in CMake through
# autoware_velocity_smoother -> autoware_planning_test_manager (as in path_generator).
COPTS = autoware_copts() + ["-Wno-deprecated-declarations"]

THIRD_PARTY = [
    "@rosdistro//cc:boost.geometry",
    "@rosdistro//cc:eigen",
]

cc_library(
    name = "autoware_behavior_velocity_planner_common_library",
    srcs = [
        "src/experimental/scene_module_interface.cpp",
        "src/planner_data.cpp",
        "src/scene_module_interface.cpp",
        "src/utilization/arc_lane_util.cpp",
        "src/utilization/boost_geometry_helper.cpp",
        "src/utilization/debug.cpp",
        "src/utilization/path_utilization.cpp",
        "src/utilization/trajectory_utils.cpp",
        "src/utilization/util.cpp",
        "src/utilization/util_internal.hpp",
    ],
    hdrs = glob(["include/**/*.hpp"]),
    # target_include_directories(PRIVATE src): a -I flag, which (unlike includes) does not reach dependents.
    copts = COPTS + ["-I" + ("external/%s/src" % repo_name() if repo_name() else "src")],
    cxxopts = AUTOWARE_CXXOPTS,
    includes = ["include"],
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    deps = DEPENDENCIES.values() + THIRD_PARTY,
)

cc_shared_library(
    name = "autoware_behavior_velocity_planner_common",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":autoware_behavior_velocity_planner_common_library"],
    deps = [":autoware_behavior_velocity_planner_common_library"],
)

# share/autoware_behavior_velocity_planner_common/config (INSTALL_TO_SHARE).
ament_package(
    name = "ament_package",
    data = glob(["config/**"]),
    libraries = [":autoware_behavior_velocity_planner_common"],
    package_xml = "package.xml",
    deps = [
        "@autoware_adapi_v1_msgs//:ament_package",
        "@autoware_internal_debug_msgs//:ament_package",
        "@autoware_internal_planning_msgs//:ament_package",
        "@autoware_interpolation//:ament_package",
        "@autoware_lanelet2_extension//:ament_package",
        "@autoware_lanelet2_utils//:ament_package",
        "@autoware_map_msgs//:ament_package",
        "@autoware_motion_utils//:ament_package",
        "@autoware_objects_of_interest_marker_interface//:ament_package",
        "@autoware_perception_msgs//:ament_package",
        "@autoware_planning_factor_interface//:ament_package",
        "@autoware_planning_msgs//:ament_package",
        "@autoware_route_handler//:ament_package",
        "@autoware_trajectory//:ament_package",
        "@autoware_utils_debug//:ament_package",
        "@autoware_utils_geometry//:ament_package",
        "@autoware_utils_rclcpp//:ament_package",
        "@autoware_utils_system//:ament_package",
        "@autoware_utils_visualization//:ament_package",
        "@autoware_vehicle_info_utils//:ament_package",
        "@autoware_velocity_smoother//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@diagnostic_msgs//:ament_package",
        "@geometry_msgs//:ament_package",
        "@lanelet2_core//:ament_package",
        "@lanelet2_routing//:ament_package",
        "@nav_msgs//:ament_package",
        "@pcl_conversions//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@tf2//:ament_package",
        "@tf2_eigen//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
        "@tf2_ros//:ament_package",
        "@unique_identifier_msgs//:ament_package",
        "@visualization_msgs//:ament_package",
    ],
)

# The installed package doubles as the runtime ament index of this package in tests (data = [":ament_index"]).
alias(
    name = "ament_index",
    actual = ":ament_package",
)

# Test helpers: test/src/utils.hpp, and src/utilization/util_internal.hpp included as "utilization/...".
cc_library(
    name = "test_headers",
    testonly = True,
    hdrs = glob([
        "src/**/*.hpp",
        "test/src/*.hpp",
    ]),
    includes = ["src"],
    visibility = ["//visibility:private"],
)

TEST_DEPENDENCIES = {
    "@ament_index_cpp//:ament_index_cpp": "@ament_index_cpp//:ament_index_cpp_library",
    "@autoware_test_utils//:autoware_test_utils": "@autoware_test_utils//:autoware_test_utils_library",
    "@rcl//:rcl": "@rcl//:rcl_library",
}

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [":autoware_behavior_velocity_planner_common"] + TEST_DEPENDENCIES.keys(),
    visibility = ["//visibility:private"],
)

# file(GLOB test/src/*.cpp) in one gtest, linked with gtest_main.
cc_test(
    name = "test_autoware_behavior_velocity_planner_common",
    srcs = glob(["test/src/*.cpp"]),
    copts = COPTS,
    cxxopts = AUTOWARE_CXXOPTS,
    data = [
        ":ament_index",
        "@@//bazel/config:cyclonedds.xml",
        "@autoware_test_utils//:ament_index",
        "@autoware_velocity_smoother//:ament_index",
    ],
    dynamic_deps = [":test_dynamic_deps"],
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    deps = [
        ":autoware_behavior_velocity_planner_common_library",
        ":test_headers",
        "@rosdistro//cc:googletest",
    ] + TEST_DEPENDENCIES.values() + THIRD_PARTY,
)
