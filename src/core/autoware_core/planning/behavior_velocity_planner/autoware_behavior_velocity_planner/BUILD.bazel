load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_behavior_velocity_planner",
    srcs = [
        "src/data_processing.cpp",
        "src/experimental/node.cpp",
        "src/experimental/planner_manager.cpp",
        "src/node.cpp",
        "src/planner_manager.cpp",
    ],
    hdrs = [
        "include/autoware/behavior_velocity_planner/experimental/node.hpp",
        "include/autoware/behavior_velocity_planner/experimental/planner_manager.hpp",
        "include/autoware/behavior_velocity_planner/node.hpp",
        "include/autoware/behavior_velocity_planner/planner_manager.hpp",
        "src/data_processing.hpp",
    ],
    includes = [
        "include",
        "src",
    ],
    deps = [
        "@ament_index_cpp//:ament_index_cpp_library",
        "@autoware_behavior_velocity_planner_common",
        "@autoware_internal_debug_msgs//:cc",
        "@autoware_internal_planning_msgs//:cc",
        "@autoware_map_msgs//:cc",
        "@autoware_motion_utils",
        "@autoware_perception_msgs//:cc",
        "@autoware_planning_msgs//:cc",
        "@autoware_route_handler",
        "@autoware_trajectory",
        "@autoware_utils_debug",
        "@autoware_utils_logging",
        "@autoware_utils_math",
        "@autoware_utils_pcl",
        "@autoware_utils_rclcpp",
        "@autoware_utils_system",
        "@autoware_velocity_smoother",
        "@diagnostic_msgs//:cc",
        "@geometry_msgs//:cc",
        "@lanelet2_core//:lanelet2_core_library",
        "@lanelet2_routing//:lanelet2_routing_library",
        "@lanelet2_traffic_rules//:lanelet2_traffic_rules_library",
        "@nav_msgs//:cc",
        "@pcl_conversions//:pcl_conversions_library",
        "@pluginlib//:pluginlib_library",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
        "@rosdistro//cc:boost.geometry",
        "@rosdistro//cc:eigen",
        "@rosdistro//cc:pcl_common",
        "@sensor_msgs//:cc",
        "@std_msgs//:cc",
        "@tf2//:tf2_library",
        "@tf2_eigen//:tf2_eigen_library",
        "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
        "@tf2_ros//:tf2_ros_library",
        "@visualization_msgs//:cc",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@ament_index_cpp//:ament_index_cpp",
        "@autoware_behavior_velocity_planner_common//:runtime_dynamic_deps",
        "@autoware_internal_debug_msgs//:cc_shared",
        "@autoware_internal_planning_msgs//:cc_shared",
        "@autoware_map_msgs//:cc_shared",
        "@autoware_motion_utils//:runtime_dynamic_deps",
        "@autoware_perception_msgs//:cc_shared",
        "@autoware_planning_msgs//:cc_shared",
        "@autoware_route_handler//:runtime_dynamic_deps",
        "@autoware_trajectory//:runtime_dynamic_deps",
        "@autoware_utils_debug//:runtime_dynamic_deps",
        "@autoware_utils_pcl//:runtime_dynamic_deps",
        "@autoware_velocity_smoother//:runtime_dynamic_deps",
        "@diagnostic_msgs//:cc_shared",
        "@geometry_msgs//:cc_shared",
        "@lanelet2_core//:lanelet2_core",
        "@lanelet2_routing//:lanelet2_routing",
        "@lanelet2_traffic_rules//:lanelet2_traffic_rules",
        "@nav_msgs//:cc_shared",
        "@pcl_conversions//:pcl_conversions",
        "@pluginlib//:pluginlib",
        "@rclcpp//:rclcpp",
        "@rclcpp_components//:rclcpp_components",
        "@sensor_msgs//:cc_shared",
        "@std_msgs//:cc_shared",
        "@tf2//:tf2",
        "@tf2_eigen//:tf2_eigen",
        "@tf2_geometry_msgs//:tf2_geometry_msgs",
        "@tf2_ros//:tf2_ros",
        "@visualization_msgs//:cc_shared",
        "@logging_demo//:cc_shared",
    ],
)

cc_library(
    name = "test_utils",
    testonly = True,
    srcs = ["src/test_utils.cpp"],
    hdrs = ["include/autoware/behavior_velocity_planner/test_utils.hpp"],
    includes = ["include"],
    deps = [
        ":autoware_behavior_velocity_planner",
        "@autoware_planning_test_manager",
        "@autoware_test_utils",
    ],
)

cc_shared_library(
    name = "planner_component",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":autoware_behavior_velocity_planner"],
)

rclcpp_components_register_node(
    name = "autoware_behavior_velocity_planner_node",
    component = ":planner_component",
    node_name = "autoware_behavior_velocity_planner_node",
    plugin = "autoware::behavior_velocity_planner::BehaviorVelocityPlannerNode",
)

rclcpp_components_register_node(
    name = "experimental_autoware_behavior_velocity_planner_node",
    component = ":planner_component",
    node_name = "experimental_autoware_behavior_velocity_planner_node",
    plugin = "autoware::behavior_velocity_planner::experimental::BehaviorVelocityPlannerNode",
)

register_ament_files(
    name = "node_executables",
    files = [
        ":autoware_behavior_velocity_planner_node",
        ":experimental_autoware_behavior_velocity_planner_node",
    ],
    prefix = "lib/autoware_behavior_velocity_planner",
    strip_prefix = "*",
)

ament_index(
    components = [
        ":autoware_behavior_velocity_planner_node_record",
        ":experimental_autoware_behavior_velocity_planner_node_record",
    ],
    data = glob([
        "config/**",
        "launch/**",
    ]) + [":node_executables"],
    package_xml = "package.xml",
)

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [
        ":runtime_dynamic_deps",
        "@autoware_planning_test_manager//:runtime_dynamic_deps",
        "@autoware_test_utils//:runtime_dynamic_deps",
        "@builtin_interfaces//:cc_shared",
    ],
)

cc_test(
    name = "test_autoware_behavior_velocity_planner",
    timeout = "long",
    srcs = [
        "test/test_node_interface.cpp",
    ],
    data = [
        ":ament_index",
        "@autoware_behavior_velocity_planner_common//:ament_index",
        "@autoware_route_handler//:ament_index",
        "@autoware_test_utils//:ament_index",
        "@autoware_velocity_smoother//:ament_index",
    ],
    dynamic_deps = [":test_dynamic_deps"],
    env = {
        "ENABLE_AGNOCAST": "0",
        "ROS_DOMAIN_ID": "69",
        "LD_LIBRARY_PATH": "lib",
    },
    deps = [
        ":autoware_behavior_velocity_planner",
        ":test_utils",
        "@autoware_planning_test_manager",
        "@autoware_test_utils",
        "@builtin_interfaces//:cc",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "test_autoware_behavior_velocity_planner_data_processing",
    timeout = "long",
    srcs = [
        "test/test_data_processing.cpp",
    ],
    data = [
        ":ament_index",
        "@autoware_behavior_velocity_planner_common//:ament_index",
        "@autoware_route_handler//:ament_index",
        "@autoware_test_utils//:ament_index",
        "@autoware_velocity_smoother//:ament_index",
    ],
    dynamic_deps = [":test_dynamic_deps"],
    env = {
        "ENABLE_AGNOCAST": "0",
        "ROS_DOMAIN_ID": "69",
        "LD_LIBRARY_PATH": "lib",
    },
    deps = [
        ":autoware_behavior_velocity_planner",
        ":test_utils",
        "@autoware_planning_test_manager",
        "@autoware_test_utils",
        "@builtin_interfaces//:cc",
        "@googletest//:gtest_main",
    ],
)
