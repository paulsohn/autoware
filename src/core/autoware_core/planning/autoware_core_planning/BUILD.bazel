load("@rosdistro//ament:defs.bzl", "ament_package")

package(default_visibility = ["//visibility:public"])

# No code: share/autoware_core_planning/{config,launch} (INSTALL_TO_SHARE). Its launch file starts the nodes and
# plugins of its exec_depends.
ament_package(
    name = "ament_package",
    data = glob([
        "config/**",
        "launch/**",
    ]),
    package_xml = "package.xml",
    deps = [
        "@autoware_behavior_velocity_planner//:ament_package",
        "@autoware_behavior_velocity_stop_line_module//:ament_package",
        "@autoware_mission_planner//:ament_package",
        "@autoware_motion_velocity_obstacle_stop_module//:ament_package",
        "@autoware_motion_velocity_planner//:ament_package",
        "@autoware_path_generator//:ament_package",
        "@autoware_planning_topic_converter//:ament_package",
        "@autoware_velocity_smoother//:ament_package",
        "@rosdistro//:ament_package",
    ],
)

# The installed package doubles as the runtime ament index of this package in tests (data = [":ament_index"]).
alias(
    name = "ament_index",
    actual = ":ament_package",
)
