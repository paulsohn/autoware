load("@autoware_cmake//:defs.bzl", "AUTOWARE_CXXOPTS", "AUTOWARE_DEFINES", "autoware_copts", "cc_headers_only")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

# Deliberate differences from CMakeLists.txt (checked by bazel/tools/cmake_parity):
# cmake-diff dep:yaml_cpp_vendor: yaml-cpp comes from @rosdistro//cc:yaml-cpp.

DEPENDENCIES = {
    "@autoware_component_interface_specs//:autoware_component_interface_specs": "@autoware_component_interface_specs//:autoware_component_interface_specs_library",
    "@autoware_component_interface_utils//:autoware_component_interface_utils": "@autoware_component_interface_utils//:autoware_component_interface_utils_library",
    "@autoware_internal_planning_msgs//:cc_shared": "@autoware_internal_planning_msgs//:cc",
    "@autoware_motion_utils//:autoware_motion_utils": "@autoware_motion_utils//:autoware_motion_utils_library",
    "@autoware_planning_msgs//:cc_shared": "@autoware_planning_msgs//:cc",
    "@autoware_route_handler//:autoware_route_handler": "@autoware_route_handler//:autoware_route_handler_library",
    "@autoware_test_utils//:autoware_test_utils": "@autoware_test_utils//:autoware_test_utils_library",
    "@autoware_utils_geometry//:autoware_utils_geometry": "@autoware_utils_geometry//:autoware_utils_geometry_library",
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@lanelet2_core//:lanelet2_core": "@lanelet2_core//:lanelet2_core_library",
    "@nav_msgs//:cc_shared": "@nav_msgs//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@rosidl_runtime_cpp//:rosidl_runtime_cpp": "@rosidl_runtime_cpp//:rosidl_runtime_cpp_library",
    "@tf2_msgs//:cc_shared": "@tf2_msgs//:cc",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
    "@unique_identifier_msgs//:cc_shared": "@unique_identifier_msgs//:cc",
}

# autoware_test_utils is a regular dependency, so in CMake its PUBLIC -Wno-deprecated-declarations reaches every
# target here.
COPTS = autoware_copts() + ["-Wno-deprecated-declarations"]

# The public header includes gtest/gtest.h for macros its users (tests) need; the library itself calls no gtest
# code, and the tests link gtest. CMake gets the header path from the test environment.
cc_headers_only(
    name = "gtest_headers",
    visibility = ["//visibility:private"],
    deps = ["@googletest//:gtest"],
)

cc_library(
    name = "autoware_planning_test_manager_library",
    srcs = ["src/autoware_planning_test_manager.cpp"],
    hdrs = glob(["include/**/*.hpp"]),
    copts = COPTS,
    cxxopts = AUTOWARE_CXXOPTS,
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    includes = ["include"],
    deps = DEPENDENCIES.values() + [":gtest_headers"],
)

cc_shared_library(
    name = "autoware_planning_test_manager",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":autoware_planning_test_manager_library"],
    deps = [":autoware_planning_test_manager_library"],
)

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [":autoware_planning_test_manager"],
    visibility = ["//visibility:private"],
)

[cc_test(
    name = name,
    srcs = ["test/{}.cpp".format(src)],
    copts = COPTS,
    cxxopts = AUTOWARE_CXXOPTS,
    data = [
        "@@//bazel/config:cyclonedds.xml",
        "@autoware_test_utils//:ament_index",
    ],
    dynamic_deps = [":test_dynamic_deps"],
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    deps = [
        ":autoware_planning_test_manager_library",
        "@rosdistro//cc:googletest",
    ],
) for name, src in [
    ("test_autoware_planning_test_manager", "test_planning_test_manager"),
    ("test_autoware_planning_test_manager_utils", "test_planning_test_manager_utils"),
]]
