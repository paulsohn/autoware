load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_mission_planner",
    srcs = [
        "src/goal_pose_visualizer/goal_pose_visualizer.cpp",
        "src/lanelet2_plugins/default_planner.cpp",
        "src/lanelet2_plugins/utility_functions.cpp",
        "src/mission_planner/arrival_checker.cpp",
        "src/mission_planner/mission_planner.cpp",
        "src/mission_planner/mission_planner_node.cpp",
        "src/mission_planner/reroute_safety.cpp",
    ],
    hdrs = [
        "src/goal_pose_visualizer/goal_pose_visualizer.hpp",
        "src/lanelet2_plugins/default_planner.hpp",
        "src/lanelet2_plugins/utility_functions.hpp",
        "src/mission_planner/arrival_checker.hpp",
        "src/mission_planner/mission_planner.hpp",
        "src/mission_planner/mission_planner_node.hpp",
        "src/mission_planner/reroute_safety.hpp",
    ],
    includes = [
        "src",
    ],
    deps = [
        "@autoware_adapi_v1_msgs//:cc",
        "@autoware_common_msgs//:cc",
        "@autoware_component_interface_specs",
        "@autoware_component_interface_utils",
        "@autoware_internal_debug_msgs//:cc",
        "@autoware_lanelet2_extension//:autoware_lanelet2_extension_lib_library",
        "@autoware_lanelet2_utils",
        "@autoware_map_msgs//:cc",
        "@autoware_motion_utils",
        "@autoware_planning_msgs//:cc",
        "@autoware_route_handler",
        "@autoware_utils_geometry",
        "@autoware_utils_logging",
        "@autoware_utils_math",
        "@autoware_utils_system",
        "@autoware_utils_visualization",
        "@autoware_vehicle_info_utils",
        "@geometry_msgs//:cc",
        "@lanelet2_core//:lanelet2_core_library",
        "@lanelet2_routing//:lanelet2_routing_library",
        "@lanelet2_traffic_rules//:lanelet2_traffic_rules_library",
        "@nav_msgs//:cc",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
        "@rosdistro//cc:boost.geometry",
        "@rosdistro//cc:eigen",
        "@rosdistro//cc:yaml-cpp_library",
        "@std_msgs//:cc",
        "@tf2//:tf2_library",
        "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
        "@tf2_ros//:tf2_ros_library",
        "@visualization_msgs//:cc",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@logging_demo//:cc_shared",
        "@autoware_adapi_v1_msgs//:cc_shared",
        "@autoware_common_msgs//:cc_shared",
        "@autoware_component_interface_specs//:runtime_dynamic_deps",
        "@autoware_component_interface_utils//:runtime_dynamic_deps",
        "@autoware_internal_debug_msgs//:cc_shared",
        "@autoware_lanelet2_extension//:autoware_lanelet2_extension_lib",
        "@autoware_lanelet2_utils//:runtime_dynamic_deps",
        "@autoware_map_msgs//:cc_shared",
        "@autoware_motion_utils//:runtime_dynamic_deps",
        "@autoware_planning_msgs//:cc_shared",
        "@autoware_route_handler//:runtime_dynamic_deps",
        "@geometry_msgs//:cc_shared",
        "@nav_msgs//:cc_shared",
        "@rclcpp//:rclcpp",
        "@rclcpp_components//:rclcpp_components",
        "@std_msgs//:cc_shared",
        "@tf2//:tf2",
        "@tf2_geometry_msgs//:tf2_geometry_msgs",
        "@tf2_ros//:tf2_ros",
        "@visualization_msgs//:cc_shared",
    ],
)

cc_shared_library(
    name = "autoware_mission_planner_component",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":autoware_mission_planner"],
)

rclcpp_components_register_node(
    name = "goal_pose_visualizer_exe",
    component = ":autoware_mission_planner_component",
    node_name = "goal_pose_visualizer",
    plugin = "autoware::mission_planner::GoalPoseVisualizer",
)

rclcpp_components_register_node(
    name = "mission_planner_exe",
    component = ":autoware_mission_planner_component",
    node_name = "mission_planner",
    plugin = "autoware::mission_planner::MissionPlannerNode",
)

register_ament_files(
    name = "node_executables",
    files = [
        ":goal_pose_visualizer_exe",
        ":mission_planner_exe",
    ],
    prefix = "lib/autoware_mission_planner",
    renames = {
        ":mission_planner_exe": "mission_planner",
        ":goal_pose_visualizer_exe": "goal_pose_visualizer",
    },
    strip_prefix = "*",
)

ament_index(
    components = [
        ":goal_pose_visualizer_exe_record",
        ":mission_planner_exe_record",
    ],
    data = glob([
        "config/**",
        "launch/**",
    ]) + [":node_executables"],
    package_xml = "package.xml",
)

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [
        ":runtime_dynamic_deps",
        "@ament_index_cpp//:ament_index_cpp",
        "@autoware_test_utils//:runtime_dynamic_deps",
    ],
)

cc_test(
    name = "test_autoware_mission_planner",
    timeout = "long",
    srcs = [
        "test/test_lanelet2_plugins_default_planner.cpp",
        "test/test_utility_functions.cpp",
    ],
    data = [
        ":ament_index",
        "@autoware_lanelet2_utils//:ament_index",
        "@autoware_route_handler//:ament_index",
        "@autoware_test_utils//:ament_index",
        "@autoware_vehicle_info_utils//:ament_index",
    ],
    dynamic_deps = [
        ":test_dynamic_deps",
    ],
    env = {"ROS_DOMAIN_ID": "65"},
    deps = [
        ":autoware_mission_planner",
        "@ament_index_cpp//:ament_index_cpp_library",
        "@autoware_test_utils",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "test_autoware_mission_planner_arrival_checker",
    timeout = "long",
    srcs = [
        "test/test_arrival_checker.cpp",
    ],
    data = [
        ":ament_index",
        "@autoware_lanelet2_utils//:ament_index",
        "@autoware_route_handler//:ament_index",
        "@autoware_test_utils//:ament_index",
        "@autoware_vehicle_info_utils//:ament_index",
    ],
    dynamic_deps = [
        ":test_dynamic_deps",
    ],
    env = {"ROS_DOMAIN_ID": "65"},
    deps = [
        ":autoware_mission_planner",
        "@ament_index_cpp//:ament_index_cpp_library",
        "@autoware_test_utils",
        "@googletest//:gtest",
    ],
)

cc_test(
    name = "test_autoware_mission_planner_reroute_safety",
    timeout = "long",
    srcs = [
        "test/test_reroute_safety.cpp",
    ],
    data = [
        ":ament_index",
        "@autoware_lanelet2_utils//:ament_index",
        "@autoware_route_handler//:ament_index",
        "@autoware_test_utils//:ament_index",
        "@autoware_vehicle_info_utils//:ament_index",
    ],
    dynamic_deps = [
        ":test_dynamic_deps",
    ],
    env = {"ROS_DOMAIN_ID": "65"},
    deps = [
        ":autoware_mission_planner",
        "@ament_index_cpp//:ament_index_cpp_library",
        "@autoware_test_utils",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "test_autoware_mission_planner_mission_planner_node",
    timeout = "long",
    srcs = [
        "test/test_mission_planner_node.cpp",
    ],
    data = [
        ":ament_index",
        "@autoware_lanelet2_utils//:ament_index",
        "@autoware_route_handler//:ament_index",
        "@autoware_test_utils//:ament_index",
        "@autoware_vehicle_info_utils//:ament_index",
    ],
    dynamic_deps = [
        ":test_dynamic_deps",
    ],
    env = {"ROS_DOMAIN_ID": "65"},
    deps = [
        ":autoware_mission_planner",
        "@ament_index_cpp//:ament_index_cpp_library",
        "@autoware_test_utils",
        "@googletest//:gtest",
    ],
)
