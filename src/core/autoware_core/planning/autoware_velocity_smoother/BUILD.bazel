load("@autoware_agnocast_wrapper//:defs.bzl", "autoware_agnocast_wrapper_register_node")
load("@autoware_cmake//:defs.bzl", "AUTOWARE_CXXOPTS", "AUTOWARE_DEFINES", "autoware_copts")
load("@rosdistro//ament:defs.bzl", "ament_index")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

# Deliberate differences from CMakeLists.txt (checked by bazel/tools/cmake_parity):
# cmake-diff if:NOT (DEFINED ENV{ENABLE_AGNOCAST} AND $ENV{ENABLE_AGNOCAST} STREQUAL 1): the node interface test, which CMake builds only without Agnocast, is built and runs on the ROS 2 backend (ENABLE_AGNOCAST=0); PLAN.md.

DEPENDENCIES = {
    "@autoware_adapi_v1_msgs//:cc_shared": "@autoware_adapi_v1_msgs//:cc",
    "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper": "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper_library",
    "@autoware_internal_debug_msgs//:cc_shared": "@autoware_internal_debug_msgs//:cc",
    "@autoware_internal_planning_msgs//:cc_shared": "@autoware_internal_planning_msgs//:cc",
    "@autoware_interpolation//:autoware_interpolation": "@autoware_interpolation//:autoware_interpolation_library",
    "@autoware_motion_utils//:autoware_motion_utils": "@autoware_motion_utils//:autoware_motion_utils_library",
    "@autoware_osqp_interface//:autoware_osqp_interface": "@autoware_osqp_interface//:autoware_osqp_interface_library",
    "@autoware_planning_msgs//:cc_shared": "@autoware_planning_msgs//:cc",
    "@autoware_planning_test_manager//:autoware_planning_test_manager": "@autoware_planning_test_manager//:autoware_planning_test_manager_library",
    "@autoware_qp_interface//:autoware_qp_interface": "@autoware_qp_interface//:autoware_qp_interface_library",
    "@autoware_trajectory//:autoware_trajectory": "@autoware_trajectory//:autoware_trajectory_library",
    "@autoware_utils_debug//:autoware_utils_debug": "@autoware_utils_debug//:autoware_utils_debug_library",
    "@autoware_utils_diagnostics//:autoware_utils_diagnostics": "@autoware_utils_diagnostics//:autoware_utils_diagnostics_library",
    "@autoware_utils_geometry//:autoware_utils_geometry": "@autoware_utils_geometry//:autoware_utils_geometry_library",
    "@autoware_utils_logging//:autoware_utils_logging": "@autoware_utils_logging//:autoware_utils_logging_library",
    "@autoware_utils_math//:autoware_utils_math": "@autoware_utils_math//:autoware_utils_math_library",
    "@autoware_utils_rclcpp//:autoware_utils_rclcpp": "@autoware_utils_rclcpp//:autoware_utils_rclcpp_library",
    "@autoware_utils_system//:autoware_utils_system": "@autoware_utils_system//:autoware_utils_system_library",
    "@autoware_vehicle_info_utils//:autoware_vehicle_info_utils": "@autoware_vehicle_info_utils//:autoware_vehicle_info_utils_library",
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@nav_msgs//:cc_shared": "@nav_msgs//:cc",
    "@rcl_interfaces//:cc_shared": "@rcl_interfaces//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@std_msgs//:cc_shared": "@std_msgs//:cc",
    "@tf2//:tf2": "@tf2//:tf2_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
    "@visualization_msgs//:cc_shared": "@visualization_msgs//:cc",
}

# autoware_test_utils' PUBLIC -Wno-deprecated-declarations reaches these targets in CMake through
# autoware_planning_test_manager (a regular dependency).
COPTS = autoware_copts() + ["-Wno-deprecated-declarations"]

# ament_auto_add_library: both libraries get include/ and every build dependency.
cc_library(
    name = "smoother_library",
    srcs = [
        "src/resample.cpp",
        "src/smoother/analytical_jerk_constrained_smoother/analytical_jerk_constrained_smoother.cpp",
        "src/smoother/analytical_jerk_constrained_smoother/velocity_planning_utils.cpp",
        "src/smoother/jerk_filtered_smoother.cpp",
        "src/smoother/l2_pseudo_jerk_smoother.cpp",
        "src/smoother/linf_pseudo_jerk_smoother.cpp",
        "src/smoother/smoother_base.cpp",
        "src/trajectory_utils.cpp",
    ],
    hdrs = glob(["include/**/*.hpp"]),
    copts = COPTS,
    cxxopts = AUTOWARE_CXXOPTS,
    includes = ["include"],
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    deps = DEPENDENCIES.values() + [
        "@rosdistro//cc:boost.optional",
        "@rosdistro//cc:eigen",
        "@rosdistro//cc:range-v3",
    ],
)

cc_shared_library(
    name = "smoother",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":smoother_library"],
    deps = [":smoother_library"],
)

# Component library.
cc_library(
    name = "autoware_velocity_smoother_node_library",
    srcs = ["src/node.cpp"],
    copts = COPTS,
    cxxopts = AUTOWARE_CXXOPTS,
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    deps = [":smoother_library"] + DEPENDENCIES.values(),
)

cc_shared_library(
    name = "autoware_velocity_smoother_node",
    dynamic_deps = [":smoother"] + DEPENDENCIES.keys(),
    exports_filter = [":autoware_velocity_smoother_node_library"],
    deps = [":autoware_velocity_smoother_node_library"],
)

autoware_agnocast_wrapper_register_node(
    agnocast_executor = "AgnocastOnlyCallbackIsolatedExecutor",
    component = ":autoware_velocity_smoother_node",
    data = ["@@//bazel/config:cyclonedds.xml"],
    executable = "velocity_smoother_node",
    plugin = "autoware::velocity_smoother::VelocitySmootherNode",
    ros2_executor = "SingleThreadedExecutor",
)

# share/autoware_velocity_smoother/{launch,config} (INSTALL_TO_SHARE).
ament_index(
    name = "ament_index",
    components = [":velocity_smoother_node_component_record"],
    data = glob([
        "config/**",
        "launch/**",
    ]),
    executables = [":velocity_smoother_node"],
    libraries = [
        ":autoware_velocity_smoother_node",
        ":smoother",
    ],
    package_xml = "package.xml",
    deps = [":velocity_smoother_node_autoware_node_plugin"],
)

TEST_DEPENDENCIES = {
    "@ament_index_cpp//:ament_index_cpp": "@ament_index_cpp//:ament_index_cpp_library",
    "@autoware_test_utils//:autoware_test_utils": "@autoware_test_utils//:autoware_test_utils_library",
}

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [":autoware_velocity_smoother_node"] + TEST_DEPENDENCIES.keys(),
    visibility = ["//visibility:private"],
)

[
    cc_test(
        name = name,
        srcs = srcs,
        copts = COPTS,
        cxxopts = AUTOWARE_CXXOPTS,
        data = [
            ":ament_index",
            "@@//bazel/config:cyclonedds.xml",
            "@autoware_test_utils//:ament_index",
        ],
        dynamic_deps = [":test_dynamic_deps"],
        # Written for the ROS 2 backend (PLAN.md).
        env = {"ENABLE_AGNOCAST": "0"},
        local_defines = ros_local_defines() + AUTOWARE_DEFINES,
        deps = [
            ":autoware_velocity_smoother_node_library",
            ":smoother_library",
            "@rosdistro//cc:googletest",
        ] + TEST_DEPENDENCIES.values(),
    )
    for name, srcs in [
        ("test_smoother_base_functions", ["test/test_smoother_base_functions.cpp"]),
        ("test_smoother_functions", [
            "test/test_resample.cpp",
            "test/test_smoother_functions.cpp",
        ]),
        ("test_trajectory_utils", ["test/test_trajectory_utils.cpp"]),
        ("test_pseudo_jerk_smoothers", ["test/test_pseudo_jerk_smoothers.cpp"]),
        ("test_autoware_velocity_smoother", ["test/test_velocity_smoother_node_interface.cpp"]),
    ]
]
