load("@autoware_cmake//:defs.bzl", "AUTOWARE_CXXOPTS", "AUTOWARE_DEFINES", "autoware_copts")
load("@rosdistro//ament:defs.bzl", "ament_index")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

DEPENDENCIES = {
    "@autoware_behavior_velocity_planner_common//:autoware_behavior_velocity_planner_common": "@autoware_behavior_velocity_planner_common//:autoware_behavior_velocity_planner_common_library",
    "@autoware_internal_debug_msgs//:cc_shared": "@autoware_internal_debug_msgs//:cc",
    "@autoware_internal_planning_msgs//:cc_shared": "@autoware_internal_planning_msgs//:cc",
    "@autoware_lanelet2_extension//:autoware_lanelet2_extension_lib": "@autoware_lanelet2_extension//:autoware_lanelet2_extension_lib_library",
    "@autoware_map_msgs//:cc_shared": "@autoware_map_msgs//:cc",
    "@autoware_motion_utils//:autoware_motion_utils": "@autoware_motion_utils//:autoware_motion_utils_library",
    "@autoware_object_recognition_utils//:autoware_object_recognition_utils": "@autoware_object_recognition_utils//:autoware_object_recognition_utils_library",
    "@autoware_perception_msgs//:cc_shared": "@autoware_perception_msgs//:cc",
    "@autoware_planning_factor_interface//:autoware_planning_factor_interface": "@autoware_planning_factor_interface//:autoware_planning_factor_interface_library",
    "@autoware_planning_msgs//:cc_shared": "@autoware_planning_msgs//:cc",
    "@autoware_route_handler//:autoware_route_handler": "@autoware_route_handler//:autoware_route_handler_library",
    "@autoware_utils_debug//:autoware_utils_debug": "@autoware_utils_debug//:autoware_utils_debug_library",
    "@autoware_utils_geometry//:autoware_utils_geometry": "@autoware_utils_geometry//:autoware_utils_geometry_library",
    "@autoware_utils_math//:autoware_utils_math": "@autoware_utils_math//:autoware_utils_math_library",
    "@autoware_utils_rclcpp//:autoware_utils_rclcpp": "@autoware_utils_rclcpp//:autoware_utils_rclcpp_library",
    "@autoware_utils_visualization//:autoware_utils_visualization": "@autoware_utils_visualization//:autoware_utils_visualization_library",
    "@autoware_vehicle_info_utils//:autoware_vehicle_info_utils": "@autoware_vehicle_info_utils//:autoware_vehicle_info_utils_library",
    "@autoware_velocity_smoother//:smoother": "@autoware_velocity_smoother//:smoother_library",
    "@builtin_interfaces//:cc_shared": "@builtin_interfaces//:cc",
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@lanelet2_core//:lanelet2_core": "@lanelet2_core//:lanelet2_core_library",
    "@nav_msgs//:cc_shared": "@nav_msgs//:cc",
    "@pcl_conversions//:pcl_conversions": "@pcl_conversions//:pcl_conversions_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:pcl": "@rosdistro//cc:pcl_library",
    "@sensor_msgs//:cc_shared": "@sensor_msgs//:cc",
    "@std_msgs//:cc_shared": "@std_msgs//:cc",
    "@tf2//:tf2": "@tf2//:tf2_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
    "@visualization_msgs//:cc_shared": "@visualization_msgs//:cc",
}

# autoware_test_utils' PUBLIC -Wno-deprecated-declarations reaches these targets in CMake through
# autoware_velocity_smoother -> autoware_planning_test_manager (as in path_generator).
COPTS = autoware_copts() + ["-Wno-deprecated-declarations"]

THIRD_PARTY = [
    "@rosdistro//cc:boost.geometry",
    "@rosdistro//cc:eigen",
]

# ament_auto_add_library(${PROJECT_NAME}_lib SHARED DIRECTORY src)
cc_library(
    name = "autoware_motion_velocity_planner_common_lib_library",
    srcs = glob(["src/**/*.cpp"]),
    hdrs = glob(["include/**/*.hpp"]),
    copts = COPTS,
    cxxopts = AUTOWARE_CXXOPTS,
    includes = ["include"],
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    deps = DEPENDENCIES.values() + THIRD_PARTY,
)

cc_shared_library(
    name = "autoware_motion_velocity_planner_common_lib",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":autoware_motion_velocity_planner_common_lib_library"],
    deps = [":autoware_motion_velocity_planner_common_lib_library"],
)

# share/autoware_motion_velocity_planner_common/include (INSTALL_TO_SHARE include).
ament_index(
    name = "ament_index",
    data = glob(["include/**"]),
    libraries = [":autoware_motion_velocity_planner_common_lib"],
    package_xml = "package.xml",
)

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [":autoware_motion_velocity_planner_common_lib"],
    visibility = ["//visibility:private"],
)

# Linked with gtest_main; target_include_directories(PRIVATE src) has no headers to find.
cc_test(
    name = "test_autoware_motion_velocity_planner_common",
    srcs = [
        "test/test_collision_checker.cpp",
        "test/test_polygon_utils.cpp",
        "test/test_utils.cpp",
    ],
    copts = COPTS,
    cxxopts = AUTOWARE_CXXOPTS,
    data = ["@@//bazel/config:cyclonedds.xml"],
    dynamic_deps = [":test_dynamic_deps"],
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    deps = [
        ":autoware_motion_velocity_planner_common_lib_library",
        "@rosdistro//cc:googletest",
    ] + THIRD_PARTY,
)
