load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_motion_velocity_planner",
    srcs = glob(["src/**/*.cpp"]),
    hdrs = glob(["src/**/*.hpp"]),
    includes = ["src"],
    deps = [
        "@autoware_internal_debug_msgs//:cc",
        "@autoware_internal_planning_msgs//:cc",
        "@autoware_map_msgs//:cc",
        "@autoware_motion_utils",
        "@autoware_motion_velocity_planner_common",
        "@autoware_perception_msgs//:cc",
        "@autoware_planning_factor_interface",
        "@autoware_planning_msgs//:cc",
        "@autoware_utils_debug",
        "@autoware_utils_geometry",
        "@autoware_utils_logging",
        "@autoware_utils_pcl",
        "@autoware_utils_rclcpp",
        "@autoware_utils_system",
        "@autoware_velocity_smoother",
        "@geometry_msgs//:cc",
        "@lanelet2_core//:lanelet2_core_library",
        "@lanelet2_routing//:lanelet2_routing_library",
        "@lanelet2_traffic_rules//:lanelet2_traffic_rules_library",
        "@nav_msgs//:cc",
        "@pcl_conversions//:pcl_conversions_library",
        "@pluginlib//:pluginlib_library",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
        "@rosdistro//cc:boost.geometry",
        "@rosdistro//cc:eigen",
        "@rosdistro//cc:pcl_common",
        "@sensor_msgs//:cc",
        "@tf2//:tf2_library",
        "@tf2_eigen//:tf2_eigen_library",
        "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
        "@tf2_ros//:tf2_ros_library",
        "@visualization_msgs//:cc",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_internal_debug_msgs//:cc_shared",
        "@autoware_internal_planning_msgs//:cc_shared",
        "@autoware_map_msgs//:cc_shared",
        "@autoware_motion_utils//:runtime_dynamic_deps",
        "@autoware_motion_velocity_planner_common//:runtime_dynamic_deps",
        "@autoware_perception_msgs//:cc_shared",
        "@autoware_planning_factor_interface//:runtime_dynamic_deps",
        "@autoware_planning_msgs//:cc_shared",
        "@autoware_utils_debug//:runtime_dynamic_deps",
        "@autoware_utils_pcl//:runtime_dynamic_deps",
        "@autoware_velocity_smoother//:runtime_dynamic_deps",
        "@geometry_msgs//:cc_shared",
        "@lanelet2_core//:lanelet2_core",
        "@lanelet2_routing//:lanelet2_routing",
        "@lanelet2_traffic_rules//:lanelet2_traffic_rules",
        "@logging_demo//:cc_shared",
        "@nav_msgs//:cc_shared",
        "@pcl_conversions//:pcl_conversions",
        "@pluginlib//:pluginlib",
        "@rclcpp//:rclcpp",
        "@rclcpp_components//:rclcpp_components",
        "@sensor_msgs//:cc_shared",
        "@tf2//:tf2",
        "@tf2_eigen//:tf2_eigen",
        "@tf2_geometry_msgs//:tf2_geometry_msgs",
        "@tf2_ros//:tf2_ros",
        "@visualization_msgs//:cc_shared",
    ],
)

cc_shared_library(
    name = "planner_component",
    dynamic_deps = [":runtime_dynamic_deps"],
    shared_lib_name = "libautoware_motion_velocity_planner_component.so",
    deps = [":autoware_motion_velocity_planner"],
)

rclcpp_components_register_node(
    name = "autoware_motion_velocity_planner_node",
    component = ":planner_component",
    node_name = "autoware_motion_velocity_planner_node",
    plugin = "autoware::motion_velocity_planner::MotionVelocityPlannerNode",
)

register_ament_files(
    name = "node_executables",
    files = [":autoware_motion_velocity_planner_node"],
    prefix = "lib/autoware_motion_velocity_planner",
    strip_prefix = "*",
)

ament_index(
    components = [":autoware_motion_velocity_planner_node_record"],
    data = glob([
        "config/**",
        "launch/**",
        "test_config/**",
        "test_data/**",
        "test_map/**",
    ]) + [":node_executables"],
    package_xml = "package.xml",
)

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [
        ":runtime_dynamic_deps",
        "@ament_index_cpp//:ament_index_cpp",
        "@autoware_test_utils//:runtime_dynamic_deps",
        "@builtin_interfaces//:cc_shared",
        "@tf2_msgs//:cc_shared",
    ],
)

cc_test(
    name = "test_node",
    timeout = "long",
    srcs = [
        "test/test_node.cpp",
    ],
    data = [
        ":ament_index",
        "@autoware_motion_velocity_obstacle_stop_module//:ament_index",
        "@autoware_test_utils//:ament_index",
    ],
    dynamic_deps = [":test_dynamic_deps"],
    env = {
        "ENABLE_AGNOCAST": "0",
        "ROS_DOMAIN_ID": "71",
        "LD_LIBRARY_PATH": "lib",
    },
    deps = [
        ":autoware_motion_velocity_planner",
        "@ament_index_cpp//:ament_index_cpp_library",
        "@autoware_test_utils",
        "@builtin_interfaces//:cc",
        "@googletest//:gtest",
        "@rosdistro//cc:yaml-cpp_library",
        "@tf2_msgs//:cc",
    ],
)

cc_test(
    name = "test_node_utils",
    timeout = "long",
    srcs = [
        "test/test_node_utils.cpp",
    ],
    data = [
        ":ament_index",
        "@autoware_test_utils//:ament_index",
    ],
    dynamic_deps = [":test_dynamic_deps"],
    env = {
        "ENABLE_AGNOCAST": "0",
        "ROS_DOMAIN_ID": "71",
        "LD_LIBRARY_PATH": "lib",
    },
    deps = [
        ":autoware_motion_velocity_planner",
        "@ament_index_cpp//:ament_index_cpp_library",
        "@autoware_test_utils",
        "@builtin_interfaces//:cc",
        "@googletest//:gtest_main",
        "@tf2_msgs//:cc",
    ],
)
