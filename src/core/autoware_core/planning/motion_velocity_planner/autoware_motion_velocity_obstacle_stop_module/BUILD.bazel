load("@autoware_cmake//:defs.bzl", "AUTOWARE_CXXOPTS", "AUTOWARE_DEFINES", "autoware_copts")
load("@rosdistro//ament:defs.bzl", "ament_index")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

# Deliberate differences from CMakeLists.txt (checked by bazel/tools/cmake_parity):
# cmake-diff dep:grid_map_core: declared in package.xml, but no source of this package includes grid_map; it is not in the RCR either.

DEPENDENCIES = {
    "@autoware_internal_debug_msgs//:cc_shared": "@autoware_internal_debug_msgs//:cc",
    "@autoware_internal_planning_msgs//:cc_shared": "@autoware_internal_planning_msgs//:cc",
    "@autoware_motion_utils//:autoware_motion_utils": "@autoware_motion_utils//:autoware_motion_utils_library",
    "@autoware_motion_velocity_planner_common//:autoware_motion_velocity_planner_common_lib": "@autoware_motion_velocity_planner_common//:autoware_motion_velocity_planner_common_lib_library",
    "@autoware_object_recognition_utils//:autoware_object_recognition_utils": "@autoware_object_recognition_utils//:autoware_object_recognition_utils_library",
    "@autoware_objects_of_interest_marker_interface//:autoware_objects_of_interest_marker_interface": "@autoware_objects_of_interest_marker_interface//:autoware_objects_of_interest_marker_interface_library",
    "@autoware_perception_msgs//:cc_shared": "@autoware_perception_msgs//:cc",
    "@autoware_planning_factor_interface//:autoware_planning_factor_interface": "@autoware_planning_factor_interface//:autoware_planning_factor_interface_library",
    "@autoware_planning_msgs//:cc_shared": "@autoware_planning_msgs//:cc",
    "@autoware_signal_processing//:autoware_signal_processing": "@autoware_signal_processing//:autoware_signal_processing_library",
    "@autoware_utils_debug//:autoware_utils_debug": "@autoware_utils_debug//:autoware_utils_debug_library",
    "@autoware_utils_geometry//:autoware_utils_geometry": "@autoware_utils_geometry//:autoware_utils_geometry_library",
    "@autoware_utils_rclcpp//:autoware_utils_rclcpp": "@autoware_utils_rclcpp//:autoware_utils_rclcpp_library",
    "@autoware_utils_system//:autoware_utils_system": "@autoware_utils_system//:autoware_utils_system_library",
    "@autoware_utils_uuid//:autoware_utils_uuid": "@autoware_utils_uuid//:autoware_utils_uuid_library",
    "@autoware_utils_visualization//:autoware_utils_visualization": "@autoware_utils_visualization//:autoware_utils_visualization_library",
    "@autoware_vehicle_info_utils//:autoware_vehicle_info_utils": "@autoware_vehicle_info_utils//:autoware_vehicle_info_utils_library",
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@nav_msgs//:cc_shared": "@nav_msgs//:cc",
    "@pcl_conversions//:pcl_conversions": "@pcl_conversions//:pcl_conversions_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:pcl": "@rosdistro//cc:pcl_library",
    "@sensor_msgs//:cc_shared": "@sensor_msgs//:cc",
    "@tf2//:tf2": "@tf2//:tf2_library",
    "@tf2_eigen//:tf2_eigen": "@tf2_eigen//:tf2_eigen_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
    "@unique_identifier_msgs//:cc_shared": "@unique_identifier_msgs//:cc",
    "@visualization_msgs//:cc_shared": "@visualization_msgs//:cc",
}

# autoware_test_utils' PUBLIC -Wno-deprecated-declarations reaches these targets in CMake through
# autoware_velocity_smoother -> autoware_planning_test_manager (as in path_generator).
COPTS = autoware_copts() + ["-Wno-deprecated-declarations"]

THIRD_PARTY = [
    "@rosdistro//cc:boost.geometry",
    "@rosdistro//cc:eigen",
]

# The pluginlib plugin library (ament_auto_add_library(... DIRECTORY src)).
cc_library(
    name = "autoware_motion_velocity_obstacle_stop_module_library",
    srcs = glob([
        "src/**/*.cpp",
        "src/**/*.hpp",
    ]),
    copts = COPTS,
    cxxopts = AUTOWARE_CXXOPTS,
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    deps = DEPENDENCIES.values() + THIRD_PARTY,
)

cc_shared_library(
    name = "autoware_motion_velocity_obstacle_stop_module",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":autoware_motion_velocity_obstacle_stop_module_library"],
    deps = [":autoware_motion_velocity_obstacle_stop_module_library"],
)

# share/autoware_motion_velocity_obstacle_stop_module/config (INSTALL_TO_SHARE); pluginlib_export_plugin_description_file(autoware_motion_velocity_planner
# plugins.xml).
ament_index(
    name = "ament_index",
    data = glob(["config/**"]),
    libraries = [":autoware_motion_velocity_obstacle_stop_module"],
    package_xml = "package.xml",
    plugin_category = "autoware_motion_velocity_planner",
    plugins = ["plugins.xml"],
)

# target_include_directories(<test> PRIVATE src), plus test/test_utils.hpp.
cc_library(
    name = "test_headers",
    testonly = True,
    hdrs = glob([
        "src/**/*.hpp",
        "test/*.hpp",
    ]),
    includes = ["src"],
    visibility = ["//visibility:private"],
)

TEST_DEPENDENCIES = {
    "@ament_index_cpp//:ament_index_cpp": "@ament_index_cpp//:ament_index_cpp_library",
    "@autoware_test_utils//:autoware_test_utils": "@autoware_test_utils//:autoware_test_utils_library",
}

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [":autoware_motion_velocity_obstacle_stop_module"] + TEST_DEPENDENCIES.keys(),
    visibility = ["//visibility:private"],
)

# Linked with gtest_main.
cc_test(
    name = "test_autoware_motion_velocity_obstacle_stop_module",
    srcs = [
        "test/test_decision_helpers.cpp",
        "test/test_obstacle_stop_module_outside_check.cpp",
        "test/test_parameters.cpp",
        "test/test_path_length_buffer.cpp",
        "test/test_planning_factor.cpp",
        "test/test_types.cpp",
        "test/test_utils.cpp",
    ],
    copts = COPTS,
    cxxopts = AUTOWARE_CXXOPTS,
    data = [
        ":ament_index",
        "@@//bazel/config:cyclonedds.xml",
        "@autoware_test_utils//:ament_index",
    ],
    dynamic_deps = [":test_dynamic_deps"],
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    deps = [
        ":autoware_motion_velocity_obstacle_stop_module_library",
        ":test_headers",
        "@rosdistro//cc:googletest",
    ] + TEST_DEPENDENCIES.values() + THIRD_PARTY,
)
