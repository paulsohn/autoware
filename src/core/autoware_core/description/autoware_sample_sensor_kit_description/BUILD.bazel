load("@rosdistro//ament:defs.bzl", "ament_package")

package(default_visibility = ["//visibility:public"])

# No code: share/autoware_sample_sensor_kit_description/{urdf,config,sensor} (INSTALL_TO_SHARE). Its xacro files
# use velodyne_description at run time (xacro itself is not wired up yet).
ament_package(
    name = "ament_package",
    data = glob([
        "config/**",
        "sensor/**",
        "urdf/**",
    ]),
    package_xml = "package.xml",
    deps = [
        "@rosdistro//:ament_package",
        "@velodyne_description//:ament_package",
        "@xacro//:ament_package",
    ],
)

# The installed package doubles as the runtime ament index of this package in tests (data = [":ament_index"]).
alias(
    name = "ament_index",
    actual = ":ament_package",
)
