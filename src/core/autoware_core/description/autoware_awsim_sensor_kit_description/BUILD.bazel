load("@rosdistro//ament:defs.bzl", "ament_index")

package(default_visibility = ["//visibility:public"])

# No code: share/autoware_awsim_sensor_kit_description/{urdf,config} (INSTALL_TO_SHARE). Its xacro files use the
# sample sensor kit and velodyne_description at run time (xacro itself is not wired up yet).
ament_index(
    name = "ament_index",
    data = glob([
        "config/**",
        "urdf/**",
    ]),
    package_xml = "package.xml",
    deps = [
        "@autoware_sample_sensor_kit_description//:ament_index",
        "@velodyne_description//:ament_index",
    ],
)
