load("@rosdistro//ament:defs.bzl", "ament_index")

package(default_visibility = ["//visibility:public"])

# No code: share/autoware_core_control/{config,launch} (INSTALL_TO_SHARE); the launch files start the packages below.
ament_index(
    name = "ament_index",
    data = glob([
        "config/**",
        "launch/**",
    ]),
    package_xml = "package.xml",
    deps = [
        "@autoware_command_gate//:ament_index",
        "@autoware_simple_pure_pursuit//:ament_index",
    ],
)
