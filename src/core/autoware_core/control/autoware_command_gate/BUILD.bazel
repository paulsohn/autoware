load("@autoware_cmake//:defs.bzl", "AUTOWARE_CXXOPTS", "AUTOWARE_DEFINES", "autoware_copts")
load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

DEPENDENCIES = {
    "@autoware_adapi_specs//:autoware_adapi_specs": "@autoware_adapi_specs//:autoware_adapi_specs_library",
    "@autoware_adapi_v1_msgs//:cc_shared": "@autoware_adapi_v1_msgs//:cc",
    "@autoware_common_msgs//:cc_shared": "@autoware_common_msgs//:cc",
    "@autoware_component_interface_specs//:autoware_component_interface_specs": "@autoware_component_interface_specs//:autoware_component_interface_specs_library",
    "@autoware_component_interface_utils//:autoware_component_interface_utils": "@autoware_component_interface_utils//:autoware_component_interface_utils_library",
    "@autoware_system_msgs//:cc_shared": "@autoware_system_msgs//:cc",
    "@autoware_vehicle_msgs//:cc_shared": "@autoware_vehicle_msgs//:cc",
    "@builtin_interfaces//:cc_shared": "@builtin_interfaces//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
}

# Component library (CMake name autoware_command_gate_node); src/ is a PUBLIC include directory in CMake.
cc_library(
    name = "autoware_command_gate_node_library",
    srcs = [
        "src/autoware_command_gate.cpp",
        "src/command_gate_mode_builder.cpp",
    ],
    hdrs = ["src/command_gate_mode_builder.hpp"],
    copts = autoware_copts(),
    cxxopts = AUTOWARE_CXXOPTS,
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    includes = ["src"],
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "autoware_command_gate_node",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":autoware_command_gate_node_library"],
    deps = [":autoware_command_gate_node_library"],
)

rclcpp_components_register_node(
    name = "autoware_command_gate_exe",
    component = ":autoware_command_gate_node",
    data = ["@@//bazel/config:cyclonedds.xml"],
    node_name = "autoware_command_gate_exe",
    plugin = "autoware::control::command_gate::AutowareCommandGateNode",
)

# share/autoware_command_gate/launch (INSTALL_TO_SHARE).
ament_package(
    name = "ament_package",
    components = [":autoware_command_gate_exe_record"],
    data = glob(["launch/**"]),
    executables = [":autoware_command_gate_exe"],
    libraries = [":autoware_command_gate_node"],
    package_xml = "package.xml",
    deps = [
        "@autoware_adapi_specs//:ament_package",
        "@autoware_adapi_v1_msgs//:ament_package",
        "@autoware_common_msgs//:ament_package",
        "@autoware_component_interface_specs//:ament_package",
        "@autoware_component_interface_utils//:ament_package",
        "@autoware_system_msgs//:ament_package",
        "@autoware_vehicle_msgs//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rosdistro//:ament_package",
    ],
)

# The installed package doubles as the runtime ament index of this package in tests (data = [":ament_index"]).
alias(
    name = "ament_index",
    actual = ":ament_package",
)

TEST_DEPENDENCIES = {
    "@class_loader//:class_loader": "@class_loader//:class_loader_library",
    # rclcpp_components::ComponentManager (CMake: rclcpp_components exports it in the same package).
    "@rclcpp_components//:component_manager": "@rclcpp_components//:component_manager_library",
}

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [":autoware_command_gate_node"] + TEST_DEPENDENCIES.keys(),
    visibility = ["//visibility:private"],
)

[cc_test(
    name = name,
    srcs = [src],
    copts = autoware_copts(),
    cxxopts = AUTOWARE_CXXOPTS,
    data = [
        ":ament_index",
        "@@//bazel/config:cyclonedds.xml",
    ],
    dynamic_deps = [":test_dynamic_deps"],
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
    deps = [":autoware_command_gate_node_library", gtest] + TEST_DEPENDENCIES.values(),
) for name, src, gtest in [
    ("test_command_gate_mode_builder", "test/unit/test_command_gate_mode_builder.cpp", "@rosdistro//cc:googletest"),
    ("test_ros_integration", "test/integration/test_ros_integration.cpp", "@googletest//:gtest"),
]]
