load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_command_gate",
    srcs = glob(["src/*.cpp"]),
    hdrs = glob(["src/*.hpp"]),
    includes = ["src"],
    deps = [
        "@autoware_adapi_specs",
        "@autoware_adapi_v1_msgs//:cc",
        "@autoware_common_msgs//:cc",
        "@autoware_component_interface_specs",
        "@autoware_component_interface_utils",
        "@autoware_system_msgs//:cc",
        "@autoware_vehicle_msgs//:cc",
        "@builtin_interfaces//:cc",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_adapi_specs//:runtime_dynamic_deps",
        "@autoware_component_interface_utils//:runtime_dynamic_deps",
        "@autoware_common_msgs//:cc_shared",
        "@autoware_system_msgs//:cc_shared",
        "@autoware_vehicle_msgs//:cc_shared",
        "@builtin_interfaces//:cc_shared",
        "@rclcpp_components//:rclcpp_components",
    ],
)

cc_shared_library(
    name = "autoware_command_gate_component",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":autoware_command_gate"],
)

rclcpp_components_register_node(
    name = "autoware_command_gate_exe",
    component = ":autoware_command_gate_component",
    node_name = "autoware_command_gate",
    plugin = "autoware::control::command_gate::AutowareCommandGateNode",
)

register_ament_files(
    name = "node_executables",
    files = [":autoware_command_gate_exe"],
    prefix = "lib/autoware_command_gate",
    strip_prefix = "*",
)

ament_index(
    components = [":autoware_command_gate_exe_record"],
    data = glob([
        "launch/*",
    ]) + [":node_executables"],
    package_xml = "package.xml",
)

cc_test(
    name = "test_command_gate_mode_builder",
    timeout = "long",
    srcs = ["test/unit/test_command_gate_mode_builder.cpp"],
    data = [":ament_index"],
    dynamic_deps = [":runtime_dynamic_deps"],
    env = {"ROS_DOMAIN_ID": "60"},
    deps = [
        ":autoware_command_gate",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "test_ros_integration",
    timeout = "long",
    srcs = ["test/integration/test_ros_integration.cpp"],
    data = [":ament_index"],
    dynamic_deps = [
        ":runtime_dynamic_deps",
        "@class_loader//:class_loader",
        "@rclcpp_components//:component_manager",
    ],
    env = {"ROS_DOMAIN_ID": "60"},
    deps = [
        ":autoware_command_gate",
        "@class_loader//:class_loader_library",
        "@googletest//:gtest",
        "@rclcpp_components//:component_manager_library",
    ],
)
