load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_simple_pure_pursuit",
    srcs = glob(["src/*.cpp"]),
    hdrs = glob(["src/*.hpp"]),
    includes = ["src"],
    deps = [
        "@autoware_control_msgs//:cc",
        "@autoware_motion_utils",
        "@autoware_planning_msgs//:cc",
        "@autoware_utils_rclcpp",
        "@autoware_vehicle_info_utils",
        "@nav_msgs//:cc",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
        "@tf2//:tf2_library",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_control_msgs//:cc_shared",
        "@autoware_planning_msgs//:cc_shared",
        "@autoware_motion_utils//:runtime_dynamic_deps",
        "@nav_msgs//:cc_shared",
        "@rclcpp_components//:rclcpp_components",
        "@tf2//:tf2",
    ],
)

cc_shared_library(
    name = "autoware_simple_pure_pursuit_component",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":autoware_simple_pure_pursuit"],
)

rclcpp_components_register_node(
    name = "autoware_simple_pure_pursuit_exe",
    component = ":autoware_simple_pure_pursuit_component",
    node_name = "autoware_simple_pure_pursuit",
    plugin = "autoware::control::simple_pure_pursuit::SimplePurePursuitNode",
)

register_ament_files(
    name = "node_executables",
    files = [":autoware_simple_pure_pursuit_exe"],
    prefix = "lib/autoware_simple_pure_pursuit",
    strip_prefix = "*",
)

ament_index(
    components = [":autoware_simple_pure_pursuit_exe_record"],
    data = glob([
        "config/*",
        "launch/*",
    ]) + [":node_executables"],
    package_xml = "package.xml",
)

cc_test(
    name = "autoware_simple_pure_pursuit_test",
    timeout = "long",
    srcs = ["test/test_simple_pure_pursuit.cpp"],
    data = [
        ":ament_index",
        "@autoware_test_utils//:ament_index",
    ],
    dynamic_deps = [
        ":runtime_dynamic_deps",
        "@autoware_test_utils//:runtime_dynamic_deps",
        "@ament_index_cpp//:ament_index_cpp",
    ],
    env = {"ROS_DOMAIN_ID": "60"},
    deps = [
        ":autoware_simple_pure_pursuit",
        "@ament_index_cpp//:ament_index_cpp_library",
        "@autoware_test_utils",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "test_simple_pure_pursuit_integration",
    timeout = "long",
    srcs = ["test/test_simple_pure_pursuit_integration.cpp"],
    data = [
        ":ament_index",
        "@autoware_test_utils//:ament_index",
    ],
    dynamic_deps = [
        ":runtime_dynamic_deps",
        "@autoware_test_utils//:runtime_dynamic_deps",
        "@ament_index_cpp//:ament_index_cpp",
    ],
    env = {"ROS_DOMAIN_ID": "60"},
    deps = [
        ":autoware_simple_pure_pursuit",
        "@ament_index_cpp//:ament_index_cpp_library",
        "@autoware_test_utils",
        "@googletest//:gtest",
    ],
)
