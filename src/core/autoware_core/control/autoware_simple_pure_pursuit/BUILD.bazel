load("@autoware_cmake//:defs.bzl", "AUTOWARE_CXXOPTS", "AUTOWARE_DEFINES", "autoware_copts")
load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

DEPENDENCIES = {
    "@autoware_control_msgs//:cc_shared": "@autoware_control_msgs//:cc",
    "@autoware_motion_utils//:autoware_motion_utils": "@autoware_motion_utils//:autoware_motion_utils_library",
    "@autoware_planning_msgs//:cc_shared": "@autoware_planning_msgs//:cc",
    "@autoware_test_utils//:autoware_test_utils": "@autoware_test_utils//:autoware_test_utils_library",
    "@autoware_utils_rclcpp//:autoware_utils_rclcpp": "@autoware_utils_rclcpp//:autoware_utils_rclcpp_library",
    "@autoware_vehicle_info_utils//:autoware_vehicle_info_utils": "@autoware_vehicle_info_utils//:autoware_vehicle_info_utils_library",
    "@nav_msgs//:cc_shared": "@nav_msgs//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@tf2//:tf2": "@tf2//:tf2_library",
}

# autoware_test_utils is a regular dependency, so in CMake its PUBLIC -Wno-deprecated-declarations reaches every
# target here.
COPTS = autoware_copts() + ["-Wno-deprecated-declarations"]

# Component library (CMake name autoware_simple_pure_pursuit_lib, DIRECTORY src).
cc_library(
    name = "autoware_simple_pure_pursuit_lib_library",
    srcs = glob(["src/*.cpp"]),
    hdrs = glob(["src/*.hpp"]),
    deps = DEPENDENCIES.values(),
    copts = COPTS,
    cxxopts = AUTOWARE_CXXOPTS,
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
)

cc_shared_library(
    name = "autoware_simple_pure_pursuit_lib",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":autoware_simple_pure_pursuit_lib_library"],
    deps = [":autoware_simple_pure_pursuit_lib_library"],
)

rclcpp_components_register_node(
    name = "autoware_simple_pure_pursuit_exe",
    component = ":autoware_simple_pure_pursuit_lib",
    data = ["@@//bazel/config:cyclonedds.xml"],
    node_name = "autoware_simple_pure_pursuit_exe",
    plugin = "autoware::control::simple_pure_pursuit::SimplePurePursuitNode",
)

# share/autoware_simple_pure_pursuit/{launch,config} (INSTALL_TO_SHARE).
ament_package(
    name = "ament_package",
    components = [":autoware_simple_pure_pursuit_exe_record"],
    data = glob([
        "config/**",
        "launch/**",
    ]),
    executables = [":autoware_simple_pure_pursuit_exe"],
    libraries = [":autoware_simple_pure_pursuit_lib"],
    package_xml = "package.xml",
    deps = [
        "@autoware_control_msgs//:ament_package",
        "@autoware_motion_utils//:ament_package",
        "@autoware_planning_msgs//:ament_package",
        "@autoware_test_utils//:ament_package",
        "@autoware_utils_rclcpp//:ament_package",
        "@autoware_vehicle_info_utils//:ament_package",
        "@nav_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rosdistro//:ament_package",
        "@tf2//:ament_package",
    ],
)

# The installed package doubles as the runtime ament index of this package in tests (data = [":ament_index"]).
alias(
    name = "ament_index",
    actual = ":ament_package",
)

# target_include_directories(<test> PRIVATE src)
cc_library(
    name = "src_headers",
    testonly = True,
    hdrs = glob(["src/*.hpp"]),
    includes = ["src"],
    visibility = ["//visibility:private"],
)

TEST_DEPENDENCIES = {
    "@ament_index_cpp//:ament_index_cpp": "@ament_index_cpp//:ament_index_cpp_library",
    "@builtin_interfaces//:cc_shared": "@builtin_interfaces//:cc",
}

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [":autoware_simple_pure_pursuit_lib"] + TEST_DEPENDENCIES.keys(),
    visibility = ["//visibility:private"],
)

[cc_test(
    name = name,
    srcs = [src],
    data = [
        ":ament_index",
        "@@//bazel/config:cyclonedds.xml",
        "@autoware_test_utils//:ament_index",
    ],
    dynamic_deps = [":test_dynamic_deps"],
    deps = [
        ":autoware_simple_pure_pursuit_lib_library",
        ":src_headers",
        gtest,
    ] + TEST_DEPENDENCIES.values(),
    copts = COPTS,
    cxxopts = AUTOWARE_CXXOPTS,
    local_defines = ros_local_defines() + AUTOWARE_DEFINES,
) for name, src, gtest in [
    ("autoware_simple_pure_pursuit_test", "test/test_simple_pure_pursuit.cpp", "@rosdistro//cc:googletest"),
    ("test_simple_pure_pursuit_integration", "test/test_simple_pure_pursuit_integration.cpp", "@googletest//:gtest"),
]]
