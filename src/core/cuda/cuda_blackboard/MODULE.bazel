module(name = "cuda_blackboard")

bazel_dep(name = "agnocast_cie_thread_configurator", version = "0.0.0")
bazel_dep(name = "autoware_agnocast_wrapper", version = "0.0.0")
bazel_dep(name = "cv_bridge", version = "0.0.0")
bazel_dep(name = "negotiated", version = "0.0.0")
bazel_dep(name = "negotiated_interfaces", version = "0.0.0")
bazel_dep(name = "rclcpp", version = "0.0.0")
bazel_dep(name = "rclcpp_components", version = "0.0.0")
bazel_dep(name = "sensor_msgs", version = "0.0.0")
bazel_dep(name = "std_msgs", version = "0.0.0")
bazel_dep(name = "rosdistro", version = "0.0.0")
bazel_dep(name = "rules_cc", version = "0.2.26.rcr.0")
bazel_dep(name = "rules_cuda", version = "0.3.0.rcr.0")

# The toolkit is configured by the root module (bazel/cuda.MODULE.bazel); this only makes @cuda visible.
cuda = use_extension("@rules_cuda//cuda:extensions.bzl", "toolchain")
use_repo(cuda, "cuda")
