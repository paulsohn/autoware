    name = "negotiated_sub_example1_library",
    srcs = ["src/negotiated_sub_example1.cpp"],
    hdrs = ["src/example_type_info.hpp"],
    copts = [
        "-Wall",
        "-Wextra",
        "-Wpedantic",
    ],
    deps = [
        "@negotiated",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
        "@std_msgs//:cc",
    ],
)

cc_shared_library(
    name = "negotiated_sub_example1_component",
    dynamic_deps = [":runtime_dynamic_deps"],
    shared_lib_name = "libnegotiated_sub_example1_node.so",
    deps = [":negotiated_sub_example1_library"],
)

