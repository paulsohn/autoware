--- a/autoware/agnocast_wrapper/publisher.hpp
+++ b/autoware/agnocast_wrapper/publisher.hpp
@@ -27,6 +27,7 @@

 #include <cstddef>
 #include <cstdint>
+#include <cstdlib>
 #include <memory>
 #include <string>
 #include <utility>
@@ -125,6 +126,19 @@
 {
   typename rclcpp::Publisher<MessageT>::SharedPtr publisher_{nullptr};

+  std::atomic<bool> warmup_{true};
+  struct LoanedOutput : message_interface<MessageT, OwnershipType::Unique>
+  {
+    typename rclcpp::Publisher<MessageT>::SharedPtr publisher;
+    rclcpp::LoanedMessage<MessageT> loan;
+    explicit LoanedOutput(typename rclcpp::Publisher<MessageT>::SharedPtr owner)
+    : publisher(std::move(owner)), loan(publisher->borrow_loaned_message()) {}
+    MessageT & as_ref() const noexcept override { return loan.get(); }
+    MessageT * as_ptr() const noexcept override { return &loan.get(); }
+    agnocast::ipc_shared_ptr<MessageT> move_agnocast_ptr() && noexcept override { return {}; }
+    std::unique_ptr<MessageT> move_ros2_ptr() && noexcept override { return {}; }
+  };
+
 public:
   explicit ROS2Publisher(
     rclcpp::Node * node, const std::string & topic_name, const rclcpp::QoS & qos,
@@ -137,6 +151,12 @@

   AUTOWARE_MESSAGE_UNIQUE_PTR(MessageT) allocate_output_message_unique() override
   {
+    if (std::getenv("AGNOCAST_RMW_HOST_LOAN") && publisher_->can_loan_messages() &&
+        !std::getenv("BENCH_PAYLOAD_SCOPE") && !warmup_.exchange(false, std::memory_order_relaxed)) {
+      AUTOWARE_MESSAGE_UNIQUE_PTR(MessageT) output;
+      output.ptr_ = std::make_unique<LoanedOutput>(publisher_);
+      return output;
+    }
     return AUTOWARE_MESSAGE_UNIQUE_PTR(MessageT){std::make_unique<MessageT>()};
   }

@@ -147,5 +167,18 @@

   void publish(AUTOWARE_MESSAGE_UNIQUE_PTR(MessageT) && message) override
   {
+    if (std::getenv("BENCH_PAYLOAD_SCOPE") && publisher_->can_loan_messages()) {
+      auto loan = publisher_->borrow_loaned_message();
+      loan.get() = std::move(*message);
+      publisher_->publish(std::move(loan));
+      message = {};
+      return;
+    }
+    if (auto * output = dynamic_cast<LoanedOutput *>(message.ptr_.get())) {
+      if (output->publisher != publisher_) throw std::invalid_argument("loan belongs to another publisher");
+      publisher_->publish(std::move(output->loan));
+      message.ptr_.reset();
+      return;
+    }
     publisher_->publish(std::move(message).move_ros2_ptr());
   }
