load("@rules_python//python:defs.bzl", "py_test")
load(":bazel/glog.bzl", "glog_library", "test_source_root")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

exports_files(["COPYING"])

glog_library()

cc_library(
    name = "test_support",
    testonly = True,
    hdrs = glob(["src/**/*.h"]) + [":config_h"],
    includes = ["src", "glog_internal"],
    defines = [
        "GLOG_BAZEL_BUILD",
        "GOOGLE_NAMESPACE=google",
        "GLOG_CUSTOM_PREFIX_SUPPORT",
        "HAVE_LIB_GFLAGS",
        "HAVE_LIB_GTEST",
        "HAVE_LIB_GMOCK",
        "HAVE_STDINT_H",
        "HAVE_STRING_H",
        "HAVE_UNISTD_H",
        "HAVE_GLOB_H",
        "HAVE_PTHREAD",
        "HAVE_RWLOCK",
        "HAVE_UNWIND_H",
        "HAVE__UNWIND_BACKTRACE",
    ],
    deps = [":glog", "@googletest//:gtest"],
)

[cc_test(
    name = "test_" + name,
    srcs = ["src/" + name + "_unittest.cc"],
    data = glob(["src/*.out", "src/*.err", "src/*.txt"]),
    # Allocation-hook death checks require the test new-expressions to execute.
    copts = ["-fno-omit-frame-pointer", "-O0"],
    local_defines = ['TEST_SRC_DIR=\\\"' + test_source_root() + '\\\"'],
    deps = [":test_support"],
) for name in [
    "logging", "logging_custom_prefix", "stl_logging", "symbolize", "demangle",
    "stacktrace", "utilities", "signalhandler", "mock-log",
    "cleanup_immediately", "cleanup_with_absolute_prefix", "cleanup_with_relative_prefix",
]]

py_test(
    name = "test_cleanup_driver",
    timeout = "moderate",
    srcs = ["bazel/test_cleanup.py"],
    args = ["$(rlocationpath :test_" + name + ")" for name in ["cleanup_immediately", "cleanup_with_absolute_prefix", "cleanup_with_relative_prefix"]],
    data = [":test_" + name for name in ["cleanup_immediately", "cleanup_with_absolute_prefix", "cleanup_with_relative_prefix"]],
    main = "bazel/test_cleanup.py",
    deps = ["@rules_python//python/runfiles"],
)

py_test(
    name = "test_signal_driver",
    srcs = ["bazel/test_signals.py"],
    args = ["$(rlocationpath :test_signalhandler)", "$(rlocationpath :src/signalhandler_unittest.sh)"],
    data = [":test_signalhandler", "src/signalhandler_unittest.sh"],
    main = "bazel/test_signals.py",
    deps = ["@rules_python//python/runfiles"],
)
