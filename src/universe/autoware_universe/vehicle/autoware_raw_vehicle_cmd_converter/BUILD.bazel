load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@autoware_agnocast_wrapper//:defs.bzl", "autoware_agnocast_node")
load("@pip_ros//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_raw_vehicle_cmd_converter",
    srcs = glob(["src/**/*.cpp"], exclude = ["src/node.cpp"]),
    hdrs = glob(["include/**/*.hpp"]),
    includes = ["include", "src"],
    deps = [
        "@autoware_adapi_v1_msgs//:cc",
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper_library",
        "@autoware_control_msgs//:cc",
        "@autoware_internal_debug_msgs//:cc",
        "@autoware_interpolation",
        "@autoware_utils",
        "@autoware_vehicle_msgs//:cc",
        "@geometry_msgs//:cc",
        "@nav_msgs//:cc",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
        "@tier4_vehicle_msgs//:cc",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_adapi_v1_msgs//:cc_shared",
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper",
        "@autoware_control_msgs//:cc_shared",
        "@autoware_internal_debug_msgs//:cc_shared",
        "@autoware_vehicle_msgs//:cc_shared",
        "@geometry_msgs//:cc_shared",
        "@logging_demo//:cc_shared",
        "@nav_msgs//:cc_shared",
        "@rclcpp//:rclcpp",
        "@rclcpp_components//:rclcpp_components",
        "@tier4_vehicle_msgs//:cc_shared",
    ],
)

cc_library(name = "node_library", srcs = ["src/node.cpp"], deps = [":autoware_raw_vehicle_cmd_converter"])

cc_shared_library(
    name = "autoware_raw_vehicle_cmd_converter_component",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":node_library"],
)

autoware_agnocast_node(
    name = "autoware_raw_vehicle_cmd_converter_node",
    package_name = "autoware_raw_vehicle_cmd_converter",
    component = ":autoware_raw_vehicle_cmd_converter_component",
    plugin = "autoware::raw_vehicle_cmd_converter::RawVehicleCommandConverterNode",
    agnocast_only = False,
)

py_binary(
    name = "plot_accel_brake_map.py",
    srcs = ["scripts/plot_accel_brake_map.py"],
    main = "scripts/plot_accel_brake_map.py",
    deps = ["@ament_index_python", requirement("matplotlib"), requirement("numpy")],
)

register_ament_files(
    name = "node_executables",
    files = [":autoware_raw_vehicle_cmd_converter_node", ":plot_accel_brake_map.py"],
    prefix = "lib/autoware_raw_vehicle_cmd_converter",
    strip_prefix = "*",
)

ament_index(
    package_xml = "package.xml",
    data = glob(["config/**", "launch/**", "data/**", "test/**/*.csv"]) + [":autoware_raw_vehicle_cmd_converter_node_plugin", ":node_executables"],
    components = [":autoware_raw_vehicle_cmd_converter_node_components"],
)

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [
        ":runtime_dynamic_deps",
        "@ament_index_cpp//:ament_index_cpp",
    ],
)

cc_test(
    name = "test_autoware_raw_vehicle_cmd_converter",
    timeout = "long",
    srcs = glob(["test/**/*.cpp"]),
    data = [
        ":ament_index",
    ],
    dynamic_deps = [":test_dynamic_deps"],
    env = {"ENABLE_AGNOCAST": "0", "LD_LIBRARY_PATH": "lib", "ROS_DOMAIN_ID": "95"},
    deps = [
        ":node_library",
        "@ament_index_cpp//:ament_index_cpp_library",
        "@googletest//:gtest_main",
    ],
)
