load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@autoware_agnocast_wrapper//:defs.bzl", "autoware_agnocast_node")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_external_cmd_converter",
    srcs = glob(["src/**/*.cpp"]),
    hdrs = glob(["include/**/*.hpp"]),
    includes = ["include", "src"],
    deps = [
        "@autoware_adapi_v1_msgs//:cc",
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper_library",
        "@autoware_control_msgs//:cc",
        "@autoware_raw_vehicle_cmd_converter",
        "@autoware_utils",
        "@autoware_vehicle_msgs//:cc",
        "@diagnostic_msgs//:cc",
        "@diagnostic_updater//:diagnostic_updater_library",
        "@geometry_msgs//:cc",
        "@nav_msgs//:cc",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
        "@std_msgs//:cc",
        "@tier4_control_msgs//:cc",
        "@tier4_system_msgs//:cc",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_adapi_v1_msgs//:cc_shared",
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper",
        "@autoware_control_msgs//:cc_shared",
        "@autoware_raw_vehicle_cmd_converter//:runtime_dynamic_deps",
        "@autoware_vehicle_msgs//:cc_shared",
        "@diagnostic_msgs//:cc_shared",
        "@diagnostic_updater//:diagnostic_updater",
        "@geometry_msgs//:cc_shared",
        "@nav_msgs//:cc_shared",
        "@rclcpp//:rclcpp",
        "@rclcpp_components//:rclcpp_components",
        "@std_msgs//:cc_shared",
        "@tier4_control_msgs//:cc_shared",
        "@tier4_system_msgs//:cc_shared",
    ],
)

cc_shared_library(
    name = "autoware_external_cmd_converter_component",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":autoware_external_cmd_converter"],
)

autoware_agnocast_node(
    name = "external_cmd_converter_node",
    package_name = "autoware_external_cmd_converter",
    component = ":autoware_external_cmd_converter_component",
    plugin = "autoware::external_cmd_converter::ExternalCmdConverterNode",
    agnocast_only = True,
)

register_ament_files(
    name = "node_executables",
    files = [":external_cmd_converter_node"],
    prefix = "lib/autoware_external_cmd_converter",
    strip_prefix = "*",
)

ament_index(
    package_xml = "package.xml",
    data = glob(["config/**", "launch/**"]) + [":external_cmd_converter_node_plugin", ":node_executables"],
    components = [":external_cmd_converter_node_components"],
)

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [
        ":runtime_dynamic_deps",
        "@ament_index_cpp//:ament_index_cpp",
        "@autoware_test_utils//:runtime_dynamic_deps",
    ],
)

cc_test(
    name = "test_autoware_external_cmd_converter",
    timeout = "long",
    srcs = glob(["tests/**/*.cpp"]),
    data = [
        ":ament_index",
        "@autoware_raw_vehicle_cmd_converter//:ament_index",
        "@autoware_test_utils//:ament_index",
    ],
    dynamic_deps = [":test_dynamic_deps"],
    env = {"ENABLE_AGNOCAST": "0", "LD_LIBRARY_PATH": "lib", "ROS_DOMAIN_ID": "95"},
    deps = [
        ":autoware_external_cmd_converter",
        "@ament_index_cpp//:ament_index_cpp_library",
        "@autoware_test_utils",
        "@googletest//:gtest_main",
    ],
)
