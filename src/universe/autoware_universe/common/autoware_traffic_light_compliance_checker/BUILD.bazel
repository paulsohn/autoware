load("@rosdistro//ament:defs.bzl", "ament_index")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_traffic_light_compliance_checker",
    srcs = ["src/traffic_light_compliance_checker.cpp", "src/traffic_light_status_tracker.cpp", "src/utils.cpp"],
    hdrs = ["include/autoware/traffic_light_compliance_checker/structs.hpp", "include/autoware/traffic_light_compliance_checker/traffic_light_compliance_checker.hpp", "include/autoware/traffic_light_compliance_checker/traffic_light_status_tracker.hpp", "include/autoware/traffic_light_compliance_checker/utils.hpp"],
    strip_include_prefix = "include",
    deps = ["@autoware_interpolation", "@autoware_lanelet2_extension//:autoware_lanelet2_extension_lib_library", "@autoware_lanelet2_utils", "@autoware_motion_utils", "@autoware_perception_msgs//:cc", "@autoware_planning_msgs//:cc", "@autoware_traffic_light_utils", "@autoware_vehicle_info_utils", "@lanelet2_core//:lanelet2_core_library", "@rclcpp//:rclcpp_library", "@rosdistro//cc:tl_expected", "@rosdistro//cc:boost.geometry"],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = ["@autoware_lanelet2_extension//:autoware_lanelet2_extension_lib", "@autoware_lanelet2_utils//:runtime_dynamic_deps", "@autoware_motion_utils//:runtime_dynamic_deps", "@autoware_perception_msgs//:cc_shared", "@autoware_traffic_light_utils//:runtime_dynamic_deps", "@lanelet2_core//:lanelet2_core"],
)

ament_index(
    package_xml = "package.xml",
)

cc_test(
    name = "test_autoware_traffic_light_compliance_checker",
    srcs = ["test/test_compliance_checker.cpp", "test/test_status_tracker.cpp"],
    deps = [":autoware_traffic_light_compliance_checker", "@googletest//:gtest_main"],
    dynamic_deps = [":runtime_dynamic_deps"],
)
