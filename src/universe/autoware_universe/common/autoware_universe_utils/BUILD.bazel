load("@rosdistro//ament:defs.bzl", "ament_index")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
package(default_visibility = ["//visibility:public"])
cc_library(
    name = "autoware_universe_utils",
    srcs = glob(["src/**/*.cpp"]),
    hdrs = glob(["include/**/*.hpp"]),
    strip_include_prefix = "include",
    deps = [
        "@autoware_internal_debug_msgs//:cc",
        "@autoware_internal_msgs//:cc",
        "@autoware_internal_planning_msgs//:cc",
        "@autoware_perception_msgs//:cc",
        "@autoware_planning_msgs//:cc",
        "@autoware_utils",
        "@autoware_utils_geometry",
        "@autoware_vehicle_info_utils",
        "@autoware_vehicle_msgs//:cc",
        "@builtin_interfaces//:cc",
        "@diagnostic_msgs//:cc",
        "@geometry_msgs//:cc",
        "@logging_demo//:cc",
        "@nav_msgs//:cc",
        "@pcl_conversions//:pcl_conversions_library",
        "@pcl_ros//:pcl_ros_tf_library",
        "@rclcpp//:rclcpp_library",
        "@rosdistro//cc:boost.geometry",
        "@rosdistro//cc:boost.polygon",
        "@rosdistro//cc:eigen",
        "@rosdistro//cc:fmt",
        "@rosdistro//cc:pcl_common",
        "@tf2//:tf2_library",
        "@tf2_eigen//:tf2_eigen_library",
        "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
        "@tf2_ros//:tf2_ros_library",
        "@tier4_debug_msgs//:cc",
        "@tier4_planning_msgs//:cc",
        "@unique_identifier_msgs//:cc",
        "@visualization_msgs//:cc",
    ],
)
collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_internal_debug_msgs//:cc_shared",
        "@autoware_internal_msgs//:cc_shared",
        "@autoware_internal_planning_msgs//:cc_shared",
        "@autoware_perception_msgs//:cc_shared",
        "@autoware_planning_msgs//:cc_shared",
        "@autoware_vehicle_msgs//:cc_shared",
        "@builtin_interfaces//:cc_shared",
        "@diagnostic_msgs//:cc_shared",
        "@geometry_msgs//:cc_shared",
        "@logging_demo//:cc_shared",
        "@nav_msgs//:cc_shared",
        "@pcl_conversions//:pcl_conversions",
        "@pcl_ros//:pcl_ros_tf",
        "@rclcpp//:rclcpp",
        "@tf2//:tf2",
        "@tf2_eigen//:tf2_eigen",
        "@tf2_geometry_msgs//:tf2_geometry_msgs",
        "@tf2_ros//:tf2_ros",
        "@tier4_debug_msgs//:cc_shared",
        "@tier4_planning_msgs//:cc_shared",
        "@unique_identifier_msgs//:cc_shared",
        "@visualization_msgs//:cc_shared",
    ],
)
ament_index(package_xml = "package.xml")
cc_test(
    name = "test_autoware_universe_utils",
    timeout = "long",
    srcs = glob(["test/**/*.cpp"]),
    dynamic_deps = [":runtime_dynamic_deps"],
    env = {"ENABLE_AGNOCAST": "0", "LD_LIBRARY_PATH": "lib", "ROS_DOMAIN_ID": "85"},
    deps = [":autoware_universe_utils", "@googletest//:gtest"],
)
