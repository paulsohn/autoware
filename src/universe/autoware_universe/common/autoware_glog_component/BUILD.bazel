load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_glog_component_library",
    srcs = ["src/glog_component.cpp"],
    hdrs = glob(["include/**/*.hpp"]),
    strip_include_prefix = "include",
    deps = [
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
        "@rosdistro//cc:glog_library",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = ["@rclcpp_components//:rclcpp_components", "@rosdistro//cc:glog"],
)

cc_shared_library(
    name = "autoware_glog_component",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":autoware_glog_component_library"],
)

rclcpp_components_register_node(
    name = "autoware_glog_component_node",
    component = ":autoware_glog_component",
    node_name = "autoware_glog_component_node",
    plugin = "autoware::glog_component::GlogComponent",
)

register_ament_files(
    name = "executables",
    files = [":autoware_glog_component_node"],
    prefix = "lib/autoware_glog_component",
    strip_prefix = "*",
)

ament_index(
    package_xml = "package.xml",
    components = [":autoware_glog_component_node_record"],
    data = [":executables"],
)
