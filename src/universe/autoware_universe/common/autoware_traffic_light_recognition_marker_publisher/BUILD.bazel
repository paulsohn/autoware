load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_traffic_light_recognition_marker_publisher_library",
    srcs = ["src/traffic_light_recognition_marker_publisher.cpp"],
    hdrs = ["src/traffic_light_recognition_marker_publisher.hpp"],
    includes = ["src"],
    deps = ["@autoware_lanelet2_extension//:autoware_lanelet2_extension_lib_library", "@autoware_lanelet2_utils", "@autoware_map_msgs//:cc", "@autoware_perception_msgs//:cc", "@geometry_msgs//:cc", "@rclcpp_components//:rclcpp_components_library", "@std_msgs//:cc", "@visualization_msgs//:cc"],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = ["@autoware_lanelet2_extension//:autoware_lanelet2_extension_lib", "@autoware_lanelet2_utils//:runtime_dynamic_deps", "@autoware_map_msgs//:cc_shared", "@autoware_perception_msgs//:cc_shared", "@geometry_msgs//:cc_shared", "@rclcpp_components//:rclcpp_components", "@std_msgs//:cc_shared", "@visualization_msgs//:cc_shared"],
)

cc_shared_library(
    name = "autoware_traffic_light_recognition_marker_publisher",
    shared_lib_name = "libautoware_traffic_light_recognition_marker_publisher.so",
    deps = [":autoware_traffic_light_recognition_marker_publisher_library"],
    dynamic_deps = [":runtime_dynamic_deps"],
)

rclcpp_components_register_node(
    name = "autoware_traffic_light_recognition_marker_publisher_node",
    node_name = "autoware_traffic_light_recognition_marker_publisher_node",
    component = ":autoware_traffic_light_recognition_marker_publisher",
    plugin = "autoware::traffic_light_recognition_marker_publisher::TrafficLightRecognitionMarkerPublisher",
)

register_ament_files(
    name = "executables",
    files = [":autoware_traffic_light_recognition_marker_publisher_node"],
    prefix = "lib/autoware_traffic_light_recognition_marker_publisher",
    strip_prefix = "*",
)

ament_index(
    package_xml = "package.xml",
    libraries = [":autoware_traffic_light_recognition_marker_publisher"],
    components = [":autoware_traffic_light_recognition_marker_publisher_node_record"],
    data = glob(["launch/**"]) + [":executables"],
)
