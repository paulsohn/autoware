load("@autoware_agnocast_wrapper//:defs.bzl", "autoware_agnocast_node")
load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_map_tf_generator",
    srcs = glob(["src/*.cpp"]),
    hdrs = ["src/uniform_random.hpp"],
    includes = ["src"],
    deps = [
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper_library",
        "@autoware_lanelet2_utils",
        "@autoware_map_msgs//:cc",
        "@geometry_msgs//:cc",
        "@lanelet2_core//:lanelet2_core_library",
        "@pcl_conversions//:pcl_conversions_library",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
        "@rosdistro//cc:pcl_common",
        "@sensor_msgs//:cc",
        "@tf2//:tf2_library",
        "@tf2_ros//:tf2_ros_library",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper",
        "@autoware_lanelet2_utils//:runtime_dynamic_deps",
        "@autoware_map_msgs//:cc_shared",
        "@geometry_msgs//:cc_shared",
        "@lanelet2_core//:lanelet2_core",
        "@pcl_conversions//:pcl_conversions",
        "@rclcpp//:rclcpp",
        "@rclcpp_components//:rclcpp_components",
        "@sensor_msgs//:cc_shared",
        "@tf2//:tf2",
        "@tf2_ros//:tf2_ros",
    ],
)

cc_shared_library(
    name = "map_tf_component",
    shared_lib_name = "libautoware_map_tf_generator_component.so",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":autoware_map_tf_generator"],
)

rclcpp_components_register_node(
    name = "autoware_pcd_map_tf_generator",
    node_name = "autoware_pcd_map_tf_generator",
    plugin = "autoware::map_tf_generator::PcdMapTFGeneratorNode",
    component = ":map_tf_component",
)

autoware_agnocast_node(
    name = "autoware_vector_map_tf_generator",
    package_name = "autoware_map_tf_generator",
    plugin = "autoware::map_tf_generator::VectorMapTFGeneratorNode",
    component = ":map_tf_component",
    agnocast_only = True,
)

register_ament_files(
    name = "executables",
    files = [":autoware_pcd_map_tf_generator", ":autoware_vector_map_tf_generator"],
    prefix = "lib/autoware_map_tf_generator",
    strip_prefix = "*",
)

ament_index(
    package_xml = "package.xml",
    deps = ["@autoware_agnocast_wrapper//:ament_package"],
    data = glob(["config/**", "launch/**"]) + [":executables", ":autoware_vector_map_tf_generator_plugin"],
    components = [":autoware_pcd_map_tf_generator_record", ":autoware_vector_map_tf_generator_components"],
)

cc_test(
    name = "test_uniform_random",
    srcs = ["test/test_uniform_random.cpp"],
    deps = [":autoware_map_tf_generator", "@googletest//:gtest_main"],
    dynamic_deps = [":runtime_dynamic_deps"],
    env = {"ENABLE_AGNOCAST": "0", "LD_LIBRARY_PATH": "lib"},
)
