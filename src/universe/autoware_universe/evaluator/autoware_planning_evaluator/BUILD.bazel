load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@autoware_agnocast_wrapper//:defs.bzl", "autoware_agnocast_node")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_planning_evaluator",
    srcs = glob(["src/**/*.cpp"]),
    hdrs = glob(["include/**/*.hpp"]),
    includes = ["src", "include"],
    deps = [
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper_library",
        "@autoware_internal_debug_msgs//:cc",
        "@autoware_internal_planning_msgs//:cc",
        "@autoware_lanelet2_utils",
        "@autoware_map_msgs//:cc",
        "@autoware_motion_utils",
        "@autoware_perception_msgs//:cc",
        "@autoware_planning_factor_interface",
        "@autoware_planning_msgs//:cc",
        "@autoware_route_handler",
        "@autoware_utils",
        "@autoware_vehicle_info_utils",
        "@autoware_vehicle_msgs//:cc",
        "@diagnostic_msgs//:cc",
        "@geometry_msgs//:cc",
        "@lanelet2_core//:lanelet2_core_library",
        "@nav_msgs//:cc",
        "@pluginlib//:pluginlib_library",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
        "@rosdistro//cc:boost.geometry",
        "@rosdistro//cc:eigen",
        "@rosdistro//cc:nlohmann_json",
        "@rosdistro//cc:pcl_common",
        "@tf2//:tf2_library",
        "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
        "@tf2_ros//:tf2_ros_library",
        "@tier4_metric_msgs//:cc",
        "@unique_identifier_msgs//:cc",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper",
        "@autoware_internal_debug_msgs//:cc_shared",
        "@autoware_internal_planning_msgs//:cc_shared",
        "@autoware_lanelet2_utils//:runtime_dynamic_deps",
        "@autoware_map_msgs//:cc_shared",
        "@autoware_motion_utils//:runtime_dynamic_deps",
        "@autoware_perception_msgs//:cc_shared",
        "@autoware_planning_factor_interface//:runtime_dynamic_deps",
        "@autoware_planning_msgs//:cc_shared",
        "@autoware_route_handler//:runtime_dynamic_deps",
        "@autoware_vehicle_msgs//:cc_shared",
        "@diagnostic_msgs//:cc_shared",
        "@geometry_msgs//:cc_shared",
        "@lanelet2_core//:lanelet2_core",
        "@logging_demo//:cc_shared",
        "@nav_msgs//:cc_shared",
        "@pluginlib//:pluginlib",
        "@rclcpp//:rclcpp",
        "@rclcpp_components//:rclcpp_components",
        "@tf2//:tf2",
        "@tf2_geometry_msgs//:tf2_geometry_msgs",
        "@tf2_ros//:tf2_ros",
        "@tier4_metric_msgs//:cc_shared",
        "@unique_identifier_msgs//:cc_shared",
    ],
)

cc_shared_library(
    name = "autoware_planning_evaluator_component",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":autoware_planning_evaluator"],
)

autoware_agnocast_node(
    name = "planning_evaluator",
    package_name = "autoware_planning_evaluator",
    component = ":autoware_planning_evaluator_component",
    plugin = "planning_diagnostics::PlanningEvaluatorNode",
)

rclcpp_components_register_node(
    name = "motion_evaluator",
    node_name = "motion_evaluator",
    component = ":autoware_planning_evaluator_component",
    plugin = "planning_diagnostics::MotionEvaluatorNode",
)

register_ament_files(
    name = "node_executables",
    files = [":planning_evaluator", ":motion_evaluator"],
    prefix = "lib/autoware_planning_evaluator",
    strip_prefix = "*",
)

ament_index(
    components = [":planning_evaluator_components", ":motion_evaluator_record"],
    data = glob(["config/**", "launch/**"]) + [":node_executables", ":planning_evaluator_plugin"],
    package_xml = "package.xml",
)

cc_test(
    name = "test_planning_evaluator",
    timeout = "long",
    srcs = ["test/test_planning_evaluator_node.cpp"],
    data = [":ament_index", "@autoware_test_utils//:ament_index"],
    dynamic_deps = [":runtime_dynamic_deps"],
    env = {"ENABLE_AGNOCAST": "0", "LD_LIBRARY_PATH": "lib", "ROS_DOMAIN_ID": "89"},
    deps = [":autoware_planning_evaluator", "@ament_index_cpp//:ament_index_cpp_library", "@googletest//:gtest_main"],
)
