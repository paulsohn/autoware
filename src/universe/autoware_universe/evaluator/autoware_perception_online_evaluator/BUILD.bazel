load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@autoware_agnocast_wrapper//:defs.bzl", "autoware_agnocast_node")
load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_perception_online_evaluator",
    srcs = glob(["src/**/*.cpp"]),
    hdrs = glob(["include/**/*.hpp"]),
    includes = ["include", "src"],
    deps = [
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper_library",
        "@autoware_internal_debug_msgs//:cc",
        "@autoware_motion_utils",
        "@autoware_object_recognition_utils",
        "@autoware_perception_msgs//:cc",
        "@autoware_utils",
        "@autoware_vehicle_info_utils",
        "@geometry_msgs//:cc",
        "@lanelet2_core//:lanelet2_core_library",
        "@nav_msgs//:cc",
        "@pluginlib//:pluginlib_library",
        "@rcl_interfaces//:cc",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
        "@rosdistro//cc:boost.geometry",
        "@rosdistro//cc:eigen",
        "@rosdistro//cc:fmt",
        "@std_msgs//:cc",
        "@tf2//:tf2_library",
        "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
        "@tf2_msgs//:cc",
        "@tf2_ros//:tf2_ros_library",
        "@tier4_metric_msgs//:cc",
        "@unique_identifier_msgs//:cc",
        "@visualization_msgs//:cc",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper",
        "@autoware_internal_debug_msgs//:cc_shared",
        "@autoware_motion_utils//:runtime_dynamic_deps",
        "@autoware_object_recognition_utils//:runtime_dynamic_deps",
        "@autoware_perception_msgs//:cc_shared",
        "@geometry_msgs//:cc_shared",
        "@lanelet2_core//:lanelet2_core",
        "@nav_msgs//:cc_shared",
        "@pluginlib//:pluginlib",
        "@rcl_interfaces//:cc_shared",
        "@rclcpp//:rclcpp",
        "@rclcpp_components//:rclcpp_components",
        "@std_msgs//:cc_shared",
        "@tf2//:tf2",
        "@tf2_geometry_msgs//:tf2_geometry_msgs",
        "@tf2_msgs//:cc_shared",
        "@tf2_ros//:tf2_ros",
        "@tier4_metric_msgs//:cc_shared",
        "@unique_identifier_msgs//:cc_shared",
        "@visualization_msgs//:cc_shared",
    ],
)

cc_shared_library(
    name = "autoware_perception_online_evaluator_component",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":autoware_perception_online_evaluator"],
)

rclcpp_components_register_node(
    name = "autoware_perception_online_evaluator_node",
    node_name = "autoware_perception_online_evaluator_node",
    component = ":autoware_perception_online_evaluator_component",
    plugin = "autoware::perception_diagnostics::PerceptionOnlineEvaluatorNode",
)

autoware_agnocast_node(
    name = "autoware_perception_analytics_publisher_node",
    package_name = "autoware_perception_online_evaluator",
    component = ":autoware_perception_online_evaluator_component",
    plugin = "autoware::perception_diagnostics::PerceptionAnalyticsPublisherNode",
    agnocast_only = True,
)

register_ament_files(
    name = "node_executables",
    files = [":autoware_perception_online_evaluator_node", ":autoware_perception_analytics_publisher_node"],
    prefix = "lib/autoware_perception_online_evaluator",
    strip_prefix = "*",
)

ament_index(
    package_xml = "package.xml",
    data = glob(["launch/**", "param/**"]) + [":autoware_perception_analytics_publisher_node_plugin", ":node_executables"],
    components = [":autoware_perception_online_evaluator_node_record", ":autoware_perception_analytics_publisher_node_components"],
)

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [
        ":runtime_dynamic_deps",
        "@ament_index_cpp//:ament_index_cpp",
    ],
)

cc_test(
    name = "test_autoware_perception_online_evaluator",
    timeout = "long",
    srcs = glob(["test/**/*.cpp"]),
    data = [
        ":ament_index",
    ],
    dynamic_deps = [":test_dynamic_deps"],
    env = {"ENABLE_AGNOCAST": "0", "LD_LIBRARY_PATH": "lib", "ROS_DOMAIN_ID": "95"},
    deps = [
        ":autoware_perception_online_evaluator",
        "@ament_index_cpp//:ament_index_cpp_library",
        "@googletest//:gtest_main",
    ],
)
