load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_radar_scan_to_pointcloud2_library",
    srcs = glob(["src/*.cpp"]),
    hdrs = glob(["src/*.hpp"]),
    includes = ["src"],
    deps = [
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
        "@radar_msgs//:cc",
        "@sensor_msgs//:cc",
        "@pcl_conversions//:pcl_conversions_library",
        "@rosdistro//cc:pcl_common",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@rclcpp_components//:rclcpp_components",
        "@radar_msgs//:cc_shared",
        "@sensor_msgs//:cc_shared",
        "@pcl_conversions//:pcl_conversions",
    ],
)

cc_shared_library(
    name = "autoware_radar_scan_to_pointcloud2_component",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":autoware_radar_scan_to_pointcloud2_library"],
)

rclcpp_components_register_node(
    name = "radar_scan_to_pointcloud2_node",
    component = ":autoware_radar_scan_to_pointcloud2_component",
    node_name = "radar_scan_to_pointcloud2_node",
    plugin = "autoware::radar_scan_to_pointcloud2::RadarScanToPointcloud2Node",
)

register_ament_files(
    name = "executables",
    files = [":radar_scan_to_pointcloud2_node"],
    prefix = "lib/autoware_radar_scan_to_pointcloud2",
    strip_prefix = "*",
)

ament_index(
    package_xml = "package.xml",
    components = [":radar_scan_to_pointcloud2_node_record"],
    data = glob(["config/**", "launch/**"]) + [":executables"],
)
