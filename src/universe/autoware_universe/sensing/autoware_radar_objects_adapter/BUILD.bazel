load("@autoware_agnocast_wrapper//:defs.bzl", "autoware_agnocast_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_radar_objects_adapter_library",
    srcs = glob(["src/*.cpp"]),
    hdrs = glob(["src/*.hpp"]),
    includes = ["src"],
    deps = [
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper_library",
        "@autoware_perception_msgs//:cc",
        "@autoware_sensing_msgs//:cc",
        "@autoware_utils_geometry",
        "@rosdistro//cc:tl_expected",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@rclcpp_components//:rclcpp_components",
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper",
        "@autoware_perception_msgs//:cc_shared",
        "@autoware_sensing_msgs//:cc_shared",
        "@autoware_utils_geometry//:test_dynamic_deps",
    ],
)

cc_shared_library(
    name = "autoware_radar_objects_adapter_component",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":autoware_radar_objects_adapter_library"],
)

autoware_agnocast_node(
    name = "radar_objects_adapter_node",
    package_name = "autoware_radar_objects_adapter",
    component = ":autoware_radar_objects_adapter_component",
    plugin = "autoware::radar_objects_adapter::RadarObjectsAdapterNode",
)

register_ament_files(
    name = "executables",
    files = [":radar_objects_adapter_node"],
    prefix = "lib/autoware_radar_objects_adapter",
    strip_prefix = "*",
)

ament_index(
    package_xml = "package.xml",
    components = [":radar_objects_adapter_node_components"],
    data = glob(["config/**", "launch/**"]) + [":executables"] + [":radar_objects_adapter_node_plugin"],
)

cc_test(
    name = "test_adapter",
    srcs = ["test/test_radar_objects_adapter.cpp"],
    dynamic_deps = [":autoware_radar_objects_adapter_component", ":runtime_dynamic_deps"],
    deps = [":autoware_radar_objects_adapter_library", "@googletest//:gtest_main"],
    tags = ["no-sandbox", "no-remote"],
)

cc_test(
    name = "test_node",
    srcs = ["test/test_radar_objects_adapter_node.cpp"],
    dynamic_deps = [":autoware_radar_objects_adapter_component", ":runtime_dynamic_deps"],
    deps = [":autoware_radar_objects_adapter_library", "@googletest//:gtest_main"],
    tags = ["no-sandbox", "no-remote"],
)
