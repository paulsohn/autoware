load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_radar_threshold_filter_library",
    srcs = glob(["src/*.cpp"]),
    hdrs = glob(["src/*.hpp"]),
    includes = ["src"],
    deps = [
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
        "@radar_msgs//:cc",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@rclcpp_components//:rclcpp_components",
        "@radar_msgs//:cc_shared",
    ],
)

cc_shared_library(
    name = "autoware_radar_threshold_filter_component",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":autoware_radar_threshold_filter_library"],
)

rclcpp_components_register_node(
    name = "radar_threshold_filter_node",
    component = ":autoware_radar_threshold_filter_component",
    node_name = "radar_threshold_filter_node",
    plugin = "autoware::radar_threshold_filter::RadarThresholdFilterNode",
)

register_ament_files(
    name = "executables",
    files = [":radar_threshold_filter_node"],
    prefix = "lib/autoware_radar_threshold_filter",
    strip_prefix = "*",
)

ament_index(
    package_xml = "package.xml",
    components = [":radar_threshold_filter_node_record"],
    data = glob(["config/**", "launch/**"]) + [":executables"],
)

cc_test(
    name = "test_filter",
    srcs = ["test/test_threshold_filter.cpp", "test/radar_threshold_filter/test_radar_threshold_filter.cpp"],
    dynamic_deps = [":autoware_radar_threshold_filter_component", ":runtime_dynamic_deps"],
    deps = [":autoware_radar_threshold_filter_library", "@googletest//:gtest"],
    tags = ["no-sandbox", "no-remote"],
)
