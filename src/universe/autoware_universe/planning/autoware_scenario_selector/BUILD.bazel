load("@autoware_agnocast_wrapper//:defs.bzl", "autoware_agnocast_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_scenario_selector",
    srcs = glob(["src/**/*.cpp"]),
    hdrs = glob(["include/**/*.hpp"]),
    includes = ["include", "src"],
    deps = [
        "@autoware_adapi_v1_msgs//:cc",
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper_library",
        "@autoware_internal_debug_msgs//:cc",
        "@autoware_internal_planning_msgs//:cc",
        "@autoware_lanelet2_extension//:autoware_lanelet2_extension_lib_library",
        "@autoware_map_msgs//:cc",
        "@autoware_planning_msgs//:cc",
        "@autoware_route_handler",
        "@autoware_utils",
        "@lanelet2_core//:lanelet2_core_library",
        "@lanelet2_routing//:lanelet2_routing_library",
        "@lanelet2_traffic_rules//:lanelet2_traffic_rules_library",
        "@geometry_msgs//:cc",
        "@std_msgs//:cc",
        "@nav_msgs//:cc",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
        "@rosdistro//cc:boost.geometry",
        "@rosdistro//cc:eigen",
        "@tf2//:tf2_library",
        "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
        "@tf2_ros//:tf2_ros_library",
        "@tier4_planning_msgs//:cc",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_adapi_v1_msgs//:cc_shared",
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper",
        "@autoware_internal_debug_msgs//:cc_shared",
        "@autoware_internal_planning_msgs//:cc_shared",
        "@autoware_lanelet2_extension//:autoware_lanelet2_extension_lib",
        "@autoware_map_msgs//:cc_shared",
        "@autoware_planning_msgs//:cc_shared",
        "@autoware_route_handler//:runtime_dynamic_deps",
        "@lanelet2_core//:lanelet2_core",
        "@lanelet2_routing//:lanelet2_routing",
        "@lanelet2_traffic_rules//:lanelet2_traffic_rules",
        "@geometry_msgs//:cc_shared",
        "@std_msgs//:cc_shared",
        "@nav_msgs//:cc_shared",
        "@rclcpp//:rclcpp",
        "@rclcpp_components//:rclcpp_components",
        "@tf2//:tf2",
        "@tf2_geometry_msgs//:tf2_geometry_msgs",
        "@tf2_ros//:tf2_ros",
        "@tier4_planning_msgs//:cc_shared",
    ],
)

cc_shared_library(
    name = "autoware_scenario_selector_component",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":autoware_scenario_selector"],
)

autoware_agnocast_node(
    agnocast_only = False,
    package_name = "autoware_scenario_selector",
    name = "autoware_scenario_selector_node",
    component = ":autoware_scenario_selector_component",
    plugin = "autoware::scenario_selector::ScenarioSelectorNode",
)

register_ament_files(
    name = "node_executables",
    files = [":autoware_scenario_selector_node"],
    prefix = "lib/autoware_scenario_selector",
    strip_prefix = "*",
)

ament_index(
    components = [":autoware_scenario_selector_node_components"],
    data = glob(["config/**", "launch/**"]) + [":node_executables", ":autoware_scenario_selector_node_plugin"],
    package_xml = "package.xml",
)

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [":runtime_dynamic_deps", "@autoware_planning_test_manager//:runtime_dynamic_deps", "@ament_index_cpp//:ament_index_cpp"],
)

cc_test(
    name = "test_autoware_scenario_selector",
    timeout = "long",
    srcs = glob(["test/**/*.cpp"]),
    data = [
        ":ament_index",
        "@autoware_test_utils//:ament_index",
        "@autoware_route_handler//:ament_index",
        "@autoware_lanelet2_utils//:ament_index",
        "@autoware_vehicle_info_utils//:ament_index",
    ],
    dynamic_deps = [":test_dynamic_deps"],
    env = {"ENABLE_AGNOCAST": "0", "LD_LIBRARY_PATH": "lib", "ROS_DOMAIN_ID": "78"},
    deps = [":autoware_scenario_selector", "@autoware_planning_test_manager", "@ament_index_cpp//:ament_index_cpp_library", "@googletest//:gtest_main"],
)
