load("@rosdistro//ament:defs.bzl", "ament_index")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_behavior_path_planner_common",
    srcs = glob(["src/**/*.cpp"]),
    hdrs = glob(["include/**/*.hpp"]),
    strip_include_prefix = "include",
    deps = [
        "@autoware_adapi_v1_msgs//:cc",
        "@autoware_deprecated_boundary_departure_checker",
        "@autoware_freespace_planning_algorithms",
        "@autoware_internal_debug_msgs//:cc",
        "@autoware_internal_planning_msgs//:cc",
        "@autoware_interpolation",
        "@autoware_lanelet2_extension//:autoware_lanelet2_extension_lib_library",
        "@autoware_lanelet2_utils",
        "@autoware_motion_utils",
        "@autoware_object_recognition_utils",
        "@autoware_objects_of_interest_marker_interface",
        "@autoware_perception_msgs//:cc",
        "@autoware_planning_factor_interface",
        "@autoware_planning_msgs//:cc",
        "@autoware_route_handler",
        "@autoware_rtc_interface",
        "@autoware_traffic_light_utils",
        "@autoware_utils",
        "@autoware_vehicle_info_utils",
        "@autoware_vehicle_msgs//:cc",
        "@geometry_msgs//:cc",
        "@lanelet2_core//:lanelet2_core_library",
        "@lanelet2_routing//:lanelet2_routing_library",
        "@nav_msgs//:cc",
        "@rclcpp//:rclcpp_library",
        "@rosdistro//cc:boost.geometry",
        "@rosdistro//cc:eigen",
        "@rosdistro//cc:magic_enum",
        "@rosdistro//cc:yaml-cpp_library",
        "@std_msgs//:cc",
        "@tf2//:tf2_library",
        "@tier4_planning_msgs//:cc",
        "@tier4_rtc_msgs//:cc",
        "@unique_identifier_msgs//:cc",
        "@visualization_msgs//:cc",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_adapi_v1_msgs//:cc_shared",
        "@autoware_deprecated_boundary_departure_checker//:runtime_dynamic_deps",
        "@autoware_freespace_planning_algorithms//:runtime_dynamic_deps",
        "@autoware_internal_debug_msgs//:cc_shared",
        "@autoware_internal_planning_msgs//:cc_shared",
        "@autoware_lanelet2_extension//:autoware_lanelet2_extension_lib",
        "@autoware_lanelet2_utils//:runtime_dynamic_deps",
        "@autoware_motion_utils//:runtime_dynamic_deps",
        "@autoware_object_recognition_utils//:runtime_dynamic_deps",
        "@autoware_objects_of_interest_marker_interface//:runtime_dynamic_deps",
        "@autoware_perception_msgs//:cc_shared",
        "@autoware_planning_factor_interface//:runtime_dynamic_deps",
        "@autoware_planning_msgs//:cc_shared",
        "@autoware_route_handler//:runtime_dynamic_deps",
        "@autoware_rtc_interface//:runtime_dynamic_deps",
        "@autoware_traffic_light_utils//:runtime_dynamic_deps",
        "@autoware_utils_debug//:runtime_dynamic_deps",
        "@autoware_vehicle_msgs//:cc_shared",
        "@geometry_msgs//:cc_shared",
        "@nav_msgs//:cc_shared",
        "@rclcpp//:rclcpp",
        "@std_msgs//:cc_shared",
        "@tf2//:tf2",
        "@tier4_planning_msgs//:cc_shared",
        "@tier4_rtc_msgs//:cc_shared",
        "@unique_identifier_msgs//:cc_shared",
        "@visualization_msgs//:cc_shared",
    ],
)

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [
        ":runtime_dynamic_deps",
        "@ament_index_cpp//:ament_index_cpp",
        "@autoware_test_utils//:runtime_dynamic_deps",
    ],
)

ament_index(
    data = glob(["test_data/**"]),
    package_xml = "package.xml",
)

cc_test(
    name = "test_autoware_behavior_path_planner_common_utilities",
    timeout = "long",
    srcs = [
        "test/test_path_utils.cpp",
        "test/test_traffic_light_utils.cpp",
        "test/test_utils.cpp",
    ],
    data = [
        ":ament_index",
        "@autoware_test_utils//:ament_index",
    ],
    dynamic_deps = [":test_dynamic_deps"],
    env = {
        "LD_LIBRARY_PATH": "lib",
        "ROS_DOMAIN_ID": "68",
    },
    deps = [
        ":autoware_behavior_path_planner_common",
        "@ament_index_cpp//:ament_index_cpp_library",
        "@autoware_test_utils",
        "@googletest//:gtest_main",
    ],
)

