load("@rosdistro//ament:defs.bzl", "ament_index")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_behavior_path_side_shift_module",
    srcs = glob(["src/*.cpp"]),
    hdrs = glob(["include/**/*.hpp"]),
    strip_include_prefix = "include",
    deps = [
        "@autoware_behavior_path_planner_common",
        "@autoware_internal_planning_msgs//:cc",
        "@autoware_motion_utils",
        "@autoware_planning_msgs//:cc",
        "@autoware_utils",
        "@geometry_msgs//:cc",
        "@lanelet2_core//:lanelet2_core_library",
        "@pluginlib//:pluginlib_library",
        "@rclcpp//:rclcpp_library",
        "@tf2//:tf2_library",
        "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
        "@tier4_planning_msgs//:cc",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_behavior_path_planner_common//:runtime_dynamic_deps",
        "@pluginlib//:pluginlib",
        "@tf2_geometry_msgs//:tf2_geometry_msgs",
    ],
)

cc_shared_library(
    name = "side_shift_plugin",
    dynamic_deps = [":runtime_dynamic_deps"],
    shared_lib_name = "libautoware_behavior_path_side_shift_module.so",
    deps = [":autoware_behavior_path_side_shift_module"],
)

ament_index(
    data = glob(["config/**"]),
    libraries = [":side_shift_plugin"],
    package_xml = "package.xml",
    plugin_categories = {"plugins.xml": "autoware_behavior_path_planner"},
)

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [
        ":runtime_dynamic_deps",
        "@autoware_behavior_path_planner//:test_dynamic_deps",
    ],
)

cc_test(
    name = "test_autoware_behavior_path_side_shift_module_node_interface",
    timeout = "long",
    srcs = ["test/test_behavior_path_planner_node_interface.cpp"],
    data = [
        ":ament_index",
        "@autoware_behavior_path_planner//:ament_index",
        "@autoware_behavior_path_planner_common//:ament_index",
        "@autoware_route_handler//:ament_index",
        "@autoware_test_utils//:ament_index",
    ],
    dynamic_deps = [":test_dynamic_deps"],
    env = {
        "LD_LIBRARY_PATH": "lib",
        "ROS_DOMAIN_ID": "71",
    },
    deps = [
        ":autoware_behavior_path_side_shift_module",
        "@autoware_behavior_path_planner//:test_utils",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "test_autoware_behavior_path_side_shift_module_utils",
    timeout = "long",
    srcs = ["test/test_side_shift_utils.cpp"],
    data = [
        ":ament_index",
        "@autoware_behavior_path_planner//:ament_index",
        "@autoware_behavior_path_planner_common//:ament_index",
        "@autoware_route_handler//:ament_index",
        "@autoware_test_utils//:ament_index",
    ],
    dynamic_deps = [":test_dynamic_deps"],
    env = {
        "LD_LIBRARY_PATH": "lib",
        "ROS_DOMAIN_ID": "71",
    },
    deps = [
        ":autoware_behavior_path_side_shift_module",
        "@autoware_behavior_path_planner//:test_utils",
        "@googletest//:gtest_main",
    ],
)
