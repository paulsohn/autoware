load("@rosdistro//ament:defs.bzl", "ament_index")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_behavior_path_external_request_lane_change_module",
    srcs = ["src/manager.cpp", "src/scene.cpp"],
    hdrs = ["src/manager.hpp", "src/scene.hpp"],
    includes = ["src"],
    deps = ["@autoware_behavior_path_lane_change_module", "@autoware_behavior_path_planner_common", "@autoware_motion_utils", "@autoware_rtc_interface", "@autoware_utils", "@pluginlib//:pluginlib_library", "@rclcpp//:rclcpp_library", "@visualization_msgs//:cc", "@rosdistro//cc:eigen", "@rosdistro//cc:boost.geometry"],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = ["@autoware_behavior_path_planner_common//:runtime_dynamic_deps", "@autoware_utils//:runtime_dynamic_deps", "@ament_index_cpp//:ament_index_cpp", "@pluginlib//:pluginlib", "@rclcpp//:rclcpp", "@visualization_msgs//:cc_shared", "@autoware_behavior_path_lane_change_module//:runtime_dynamic_deps"],
)

cc_shared_library(
    name = "external_request_lane_change_plugin",
    deps = [":autoware_behavior_path_external_request_lane_change_module"],
    dynamic_deps = [":runtime_dynamic_deps"],
    shared_lib_name = "libautoware_behavior_path_external_request_lane_change_module.so",
)

ament_index(
    package_xml = "package.xml",
    data = [],
    libraries = [":external_request_lane_change_plugin"],
    plugin_categories = {'plugins.xml': 'autoware_behavior_path_planner'},
)

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [":runtime_dynamic_deps", "@autoware_behavior_path_planner//:test_dynamic_deps"],
)

cc_test(
    name = "test_autoware_behavior_path_external_request_lane_change_module",
    timeout = "long",
    srcs = ["test/test_behavior_path_planner_node_interface.cpp"],
    deps = [":autoware_behavior_path_external_request_lane_change_module", "@autoware_behavior_path_planner//:test_utils", "@googletest//:gtest_main"],
    dynamic_deps = [":test_dynamic_deps"],
    data = [":ament_index", "@autoware_behavior_path_planner//:ament_index", "@autoware_behavior_path_planner_common//:ament_index", "@autoware_route_handler//:ament_index", "@autoware_test_utils//:ament_index", "@autoware_behavior_path_lane_change_module//:ament_index"],
    env = {'ENABLE_AGNOCAST': '0', 'LD_LIBRARY_PATH': 'lib', 'ROS_DOMAIN_ID': '74'},
)
