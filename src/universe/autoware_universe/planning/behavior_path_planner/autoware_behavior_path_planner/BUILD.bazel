load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_behavior_path_planner",
    srcs = [
        "src/behavior_path_planner_node.cpp",
        "src/planner_manager.cpp",
    ],
    hdrs = glob(["include/**/*.hpp"], exclude = ["include/autoware/behavior_path_planner/test_utils.hpp"]),
    strip_include_prefix = "include",
    deps = [
        "@ament_index_cpp//:ament_index_cpp_library",
        "@autoware_adapi_v1_msgs//:cc",
        "@autoware_behavior_path_planner_common",
        "@autoware_internal_debug_msgs//:cc",
        "@autoware_internal_planning_msgs//:cc",
        "@autoware_lanelet2_utils",
        "@autoware_map_msgs//:cc",
        "@autoware_motion_utils",
        "@autoware_perception_msgs//:cc",
        "@autoware_planning_factor_interface",
        "@autoware_planning_msgs//:cc",
        "@autoware_route_handler",
        "@autoware_utils",
        "@autoware_utils_diagnostics",
        "@autoware_vehicle_info_utils",
        "@autoware_vehicle_msgs//:cc",
        "@geometry_msgs//:cc",
        "@lanelet2_core//:lanelet2_core_library",
        "@nav_msgs//:cc",
        "@pluginlib//:pluginlib_library",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
        "@rosdistro//cc:boost.scope_exit",
        "@rosdistro//cc:magic_enum",
        "@tier4_planning_msgs//:cc",
        "@visualization_msgs//:cc",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@ament_index_cpp//:ament_index_cpp",
        "@autoware_behavior_path_planner_common//:runtime_dynamic_deps",
        "@logging_demo//:cc_shared",
        "@pluginlib//:pluginlib",
        "@rclcpp_components//:rclcpp_components",
        "@autoware_map_msgs//:cc_shared",
    ],
)

cc_library(
    name = "test_utils",
    testonly = True,
    srcs = ["src/test_utils.cpp"],
    hdrs = ["include/autoware/behavior_path_planner/test_utils.hpp"],
    includes = ["include"],
    deps = [
        ":autoware_behavior_path_planner",
        "@autoware_planning_test_manager",
        "@autoware_test_utils",
    ],
)

cc_shared_library(
    name = "planner_component",
    dynamic_deps = [":runtime_dynamic_deps"],
    shared_lib_name = "libautoware_behavior_path_planner_component.so",
    deps = [":autoware_behavior_path_planner"],
)

rclcpp_components_register_node(
    name = "autoware_behavior_path_planner_node",
    component = ":planner_component",
    node_name = "autoware_behavior_path_planner_node",
    plugin = "autoware::behavior_path_planner::BehaviorPathPlannerNode",
)

register_ament_files(
    name = "node_executables",
    files = [":autoware_behavior_path_planner_node"],
    prefix = "lib/autoware_behavior_path_planner",
    strip_prefix = "*",
)

ament_index(
    components = [":autoware_behavior_path_planner_node_record"],
    data = glob(["config/**", "launch/**"]) + [":node_executables"],
    package_xml = "package.xml",
)

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [
        ":runtime_dynamic_deps",
        "@autoware_planning_test_manager//:runtime_dynamic_deps",
        "@autoware_test_utils//:runtime_dynamic_deps",
    ],
)

cc_test(
    name = "test_autoware_behavior_path_planner_utilities",
    timeout = "long",
    srcs = [
        "test/input.cpp",
        "test/input.hpp",
        "test/test_utils.cpp",
    ],
    data = [
        ":ament_index",
        "@autoware_behavior_path_planner_common//:ament_index",
        "@autoware_route_handler//:ament_index",
        "@autoware_test_utils//:ament_index",
    ],
    dynamic_deps = [":test_dynamic_deps"],
    env = {
        "LD_LIBRARY_PATH": "lib",
        "ROS_DOMAIN_ID": "70",
    },
    deps = [
        ":autoware_behavior_path_planner",
        ":test_utils",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "test_autoware_behavior_path_planner_node_interface",
    timeout = "long",
    srcs = [
        "test/test_autoware_behavior_path_planner_node_interface.cpp",
    ],
    data = [
        ":ament_index",
        "@autoware_behavior_path_planner_common//:ament_index",
        "@autoware_route_handler//:ament_index",
        "@autoware_test_utils//:ament_index",
    ],
    dynamic_deps = [":test_dynamic_deps"],
    env = {
        "LD_LIBRARY_PATH": "lib",
        "ROS_DOMAIN_ID": "70",
    },
    deps = [
        ":autoware_behavior_path_planner",
        ":test_utils",
        "@googletest//:gtest_main",
    ],
)
