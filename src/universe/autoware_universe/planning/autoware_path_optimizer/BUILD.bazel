load("@acados//:codegen.bzl", "acados_codegen")
load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

load("@pip_ros//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_path_optimizer",
    srcs = glob(["src/**/*.cpp"], exclude = ["src/acados_mpc/src/acados_interface.cpp"]),
    hdrs = glob(["include/**/*.hpp"]),
    includes = ["include", "src"],
    deps = [
        ":acados_interface",
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper_library",
        "@autoware_internal_debug_msgs//:cc",
        "@autoware_interpolation",
        "@autoware_motion_utils",
        "@autoware_osqp_interface",
        "@autoware_planning_msgs//:cc",
        "@autoware_utils",
        "@autoware_utils_geometry",
        "@autoware_vehicle_info_utils",
        "@diagnostic_updater//:diagnostic_updater_library",
        "@geometry_msgs//:cc",
        "@nav_msgs//:cc",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
        "@rosdistro//cc:boost.geometry",
        "@rosdistro//cc:eigen",
        "@std_msgs//:cc",
        "@tf2_ros//:tf2_ros_library",
        "@visualization_msgs//:cc",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper",
        "@autoware_internal_debug_msgs//:cc_shared",
        "@autoware_motion_utils//:runtime_dynamic_deps",
        "@autoware_osqp_interface//:runtime_dynamic_deps",
        "@autoware_planning_msgs//:cc_shared",
        "@diagnostic_updater//:diagnostic_updater",
        "@geometry_msgs//:cc_shared",
        "@logging_demo//:cc_shared",
        "@nav_msgs//:cc_shared",
        "@rclcpp//:rclcpp",
        "@rclcpp_components//:rclcpp_components",
        "@std_msgs//:cc_shared",
        "@tf2_ros//:tf2_ros",
        "@visualization_msgs//:cc_shared",
    ],
)

cc_shared_library(
    name = "autoware_path_optimizer_component",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":autoware_path_optimizer"],
)

rclcpp_components_register_node(
    name = "path_optimizer_node",
    node_name = "path_optimizer_node",
    component = ":autoware_path_optimizer_component",
    plugin = "autoware::path_optimizer::PathOptimizer",
)

register_ament_files(
    name = "node_executables",
    files = [":path_optimizer_node", ":calculation_time_plotter.py"],
    prefix = "lib/autoware_path_optimizer",
    strip_prefix = "*",
)

ament_index(
    components = [":path_optimizer_node_record"],
    data = glob(["config/**", "launch/**", "rviz/**"]) + [":node_executables"],
    package_xml = "package.xml",
)

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [":runtime_dynamic_deps", "@autoware_planning_test_manager//:runtime_dynamic_deps", "@ament_index_cpp//:ament_index_cpp"],
)

cc_test(
    name = "test_autoware_path_optimizer",
    timeout = "long",
    srcs = glob(["test/**/*.cpp"]),
    data = [
        ":ament_index",
        "@autoware_test_utils//:ament_index",
        "@autoware_route_handler//:ament_index",
        "@autoware_lanelet2_utils//:ament_index",
        "@autoware_vehicle_info_utils//:ament_index",
    ],
    dynamic_deps = [":test_dynamic_deps"],
    env = {"ENABLE_AGNOCAST": "0", "LD_LIBRARY_PATH": "lib", "ROS_DOMAIN_ID": "78"},
    deps = [":autoware_path_optimizer", "@autoware_planning_test_manager", "@ament_index_cpp//:ament_index_cpp_library", "@googletest//:gtest_main"],
)

py_binary(
    name = "calculation_time_plotter.py",
    srcs = ["scripts/calculation_time_plotter.py"],
    main = "scripts/calculation_time_plotter.py",
    deps = ["@autoware_internal_debug_msgs//:py", "@rclpy", requirement("matplotlib")],
)

py_binary(
    name = "generate_mpc",
    srcs = glob(["src/acados_mpc/generators/*.py"]) + ["src/acados_mpc/utils/symbolic_cubic_spline.py"],
    main = "src/acados_mpc/generators/path_tracking_mpc_spatial.py",
    imports = ["src/acados_mpc"],
    precompile = "disabled",
    deps = ["@acados//:template"],
)
acados_codegen(
    name = "generated_mpc",
    generator = ":generate_mpc",
    outputs = [
        "c_generated_code/acados_solver_curvilinear_bicycle_model_spatial.c",
        "c_generated_code/acados_solver_curvilinear_bicycle_model_spatial.h",
        "c_generated_code/curvilinear_bicycle_model_spatial_constraints/curvilinear_bicycle_model_spatial_constr_h_fun.c",
        "c_generated_code/curvilinear_bicycle_model_spatial_constraints/curvilinear_bicycle_model_spatial_constr_h_fun_jac_uxt_zt.c",
        "c_generated_code/curvilinear_bicycle_model_spatial_constraints/curvilinear_bicycle_model_spatial_constraints.h",
        "c_generated_code/curvilinear_bicycle_model_spatial_model/curvilinear_bicycle_model_spatial_expl_ode_fun.c",
        "c_generated_code/curvilinear_bicycle_model_spatial_model/curvilinear_bicycle_model_spatial_expl_vde_adj.c",
        "c_generated_code/curvilinear_bicycle_model_spatial_model/curvilinear_bicycle_model_spatial_expl_vde_forw.c",
        "c_generated_code/curvilinear_bicycle_model_spatial_model/curvilinear_bicycle_model_spatial_model.h",
    ],
)
cc_library(
    name = "generated_mpc_library",
    srcs = [":generated_mpc"],
    includes = ["generated_mpc"],
    deps = ["@acados"],
)
cc_library(
    name = "acados_interface",
    srcs = ["src/acados_mpc/src/acados_interface.cpp"],
    hdrs = ["src/acados_mpc/include/acados_interface.hpp"],
    includes = ["src/acados_mpc/include"],
    deps = [":generated_mpc_library"],
)
