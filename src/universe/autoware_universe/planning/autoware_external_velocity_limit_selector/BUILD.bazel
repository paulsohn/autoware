load("@generate_parameter_library//:defs.bzl", "generate_parameter_library")
load("@launch_testing//:defs.bzl", "launch_test")
load("@pip_ros//:requirements.bzl", "requirement")
load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
package(default_visibility = ["//visibility:public"])

generate_parameter_library(
    name = "external_velocity_limit_selector_parameters",
    yaml_file = "param/external_velocity_limit_selector_parameters.yaml",
)
cc_library(
    name = "autoware_external_velocity_limit_selector",
    srcs = ["src/external_velocity_limit_selector_node.cpp"],
    hdrs = glob(["include/**/*.hpp"]),
    includes = ["include", "include/autoware_external_velocity_limit_selector"],
    deps = [
        ":external_velocity_limit_selector_parameters",
        "@autoware_internal_debug_msgs//:cc",
        "@autoware_internal_planning_msgs//:cc",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
    ],
)
collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_internal_debug_msgs//:cc_shared",
        "@autoware_internal_planning_msgs//:cc_shared",
        "@generate_parameter_library//:rclcpp_lifecycle",
        "@generate_parameter_library//:rsl",
        "@rclcpp//:rclcpp",
        "@rclcpp_components//:rclcpp_components",
    ],
)
cc_shared_library(
    name = "autoware_external_velocity_limit_selector_component",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":autoware_external_velocity_limit_selector"],
)
rclcpp_components_register_node(
    name = "external_velocity_limit_selector",
    node_name = "external_velocity_limit_selector",
    component = ":autoware_external_velocity_limit_selector_component",
    plugin = "autoware::external_velocity_limit_selector::ExternalVelocityLimitSelectorNode",
)
register_ament_files(
    name = "node_executables",
    files = [":external_velocity_limit_selector"],
    prefix = "lib/autoware_external_velocity_limit_selector",
    strip_prefix = "*",
)
ament_index(
    components = [":external_velocity_limit_selector_record"],
    data = glob(["config/**", "launch/**"]) + [":node_executables"],
    package_xml = "package.xml",
)
launch_test(
    name = "test_external_velocity_limit_selector_node_launch",
    src = "test/test_external_velocity_limit_selector_node_launch.py",
    timeout = "short",
    data = [":ament_index"],
    env = {"ENABLE_AGNOCAST": "0", "LD_LIBRARY_PATH": "lib", "ROS_DOMAIN_ID": "82"},
    precompile = "disabled",
    tags = ["no-remote", "no-sandbox"],
    deps = [
        "@ament_index_python",
        "@autoware_internal_planning_msgs//:py",
        "@launch",
        "@launch_ros",
        "@launch_testing",
        "@launch_xml",
        "@rcl_interfaces//:py",
        "@rclpy",
        requirement("pytest"),
    ],
)
