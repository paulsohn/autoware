load("@rosdistro//ament:defs.bzl", "ament_index")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test", "cc_binary")
package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_motion_velocity_obstacle_velocity_limiter_module",
    srcs = glob(["src/**/*.cpp"]),
    hdrs = glob(["src/**/*.hpp"]),
    includes = ["src"],
    deps = [
        "@autoware_grid_map_utils",
        "@autoware_internal_debug_msgs//:cc",
        "@autoware_internal_planning_msgs//:cc",
        "@autoware_motion_utils",
        "@autoware_motion_velocity_planner_common",
        "@autoware_perception_msgs//:cc",
        "@autoware_planning_factor_interface",
        "@autoware_planning_msgs//:cc",
        "@autoware_utils",
        "@autoware_utils_debug",
        "@autoware_vehicle_info_utils",
        "@grid_map//:grid_map_msgs_cc",
        "@grid_map//:grid_map_ros",
        "@lanelet2_core//:lanelet2_core_library",
        "@nav_msgs//:cc",
        "@pcl_ros//:pcl_ros_tf_library",
        "@pluginlib//:pluginlib_library",
        "@rclcpp//:rclcpp_library",
        "@rosdistro//cc:boost.geometry",
        "@rosdistro//cc:eigen",
        "@rosdistro//cc:pcl_common",
        "@sensor_msgs//:cc",
        "@tf2_eigen//:tf2_eigen_library",
        "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
        "@tf2_ros//:tf2_ros_library",
        "@unique_identifier_msgs//:cc",
        "@visualization_msgs//:cc",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_grid_map_utils//:runtime_dynamic_deps",
        "@autoware_internal_debug_msgs//:cc_shared",
        "@autoware_internal_planning_msgs//:cc_shared",
        "@autoware_motion_utils//:runtime_dynamic_deps",
        "@autoware_motion_velocity_planner_common//:runtime_dynamic_deps",
        "@autoware_perception_msgs//:cc_shared",
        "@autoware_planning_factor_interface//:runtime_dynamic_deps",
        "@autoware_planning_msgs//:cc_shared",
        "@autoware_utils_debug//:runtime_dynamic_deps",
        "@grid_map//:grid_map_msgs_cc_shared",
        "@grid_map//:grid_map_ros_runtime_dynamic_deps",
        "@lanelet2_core//:lanelet2_core",
        "@nav_msgs//:cc_shared",
        "@pcl_ros//:pcl_ros_tf",
        "@pluginlib//:pluginlib",
        "@rclcpp//:rclcpp",
        "@sensor_msgs//:cc_shared",
        "@tf2_eigen//:tf2_eigen",
        "@tf2_geometry_msgs//:tf2_geometry_msgs",
        "@tf2_ros//:tf2_ros",
        "@unique_identifier_msgs//:cc_shared",
        "@visualization_msgs//:cc_shared",
    ],
)

cc_shared_library(
    name = "obstacle_velocity_limiter_plugin",
    shared_lib_name = "libautoware_motion_velocity_obstacle_velocity_limiter_module.so",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":autoware_motion_velocity_obstacle_velocity_limiter_module"],
)

ament_index(
    data = glob(["config/**"]),
    libraries = [":obstacle_velocity_limiter_plugin"],
    package_xml = "package.xml",
    plugin_categories = {"plugins.xml": "autoware_motion_velocity_planner"},
)

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [":runtime_dynamic_deps", "@ament_index_cpp//:ament_index_cpp", "@autoware_test_utils//:runtime_dynamic_deps"],
)

cc_test(
    name = "test_autoware_motion_velocity_obstacle_velocity_limiter_module",
    timeout = "long",
    srcs = glob(["test/**/*.cpp"]),
    data = [":ament_index", "@autoware_test_utils//:ament_index"],
    dynamic_deps = [":test_dynamic_deps"],
    env = {"ENABLE_AGNOCAST": "0", "LD_LIBRARY_PATH": "lib", "ROS_DOMAIN_ID": "86"},
    deps = [":autoware_motion_velocity_obstacle_velocity_limiter_module", "@ament_index_cpp//:ament_index_cpp_library", "@autoware_test_utils", "@googletest//:gtest_main"],
)

cc_binary(name = "collision_benchmark", srcs = ["benchmarks/collision_checker_benchmark.cpp"], dynamic_deps = [":runtime_dynamic_deps"], deps = [":autoware_motion_velocity_obstacle_velocity_limiter_module"])
