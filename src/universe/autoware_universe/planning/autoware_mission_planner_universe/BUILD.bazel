load("@autoware_agnocast_wrapper//:defs.bzl", "autoware_agnocast_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "service_utils",
    srcs = ["src/mission_planner/service_utils.cpp"],
    hdrs = ["include/autoware/mission_planner_universe/service_utils.hpp"],
    strip_include_prefix = "include",
    deps = [
        "@autoware_common_msgs//:cc",
        "@autoware_utils",
    ],
)

cc_library(
    name = "autoware_mission_planner_universe",
    srcs = glob(
        ["src/**/*.cpp"],
        exclude = ["src/mission_planner/service_utils.cpp"],
    ),
    hdrs = glob(
        [
            "include/**/*.hpp",
            "src/**/*.hpp",
        ],
        exclude = ["include/autoware/mission_planner_universe/service_utils.hpp"],
    ),
    includes = [
        "include",
        "src",
    ],
    deps = [":service_utils"] + [
        "@autoware_adapi_v1_msgs//:cc",
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper_library",
        "@autoware_common_msgs//:cc",
        "@autoware_internal_debug_msgs//:cc",
        "@autoware_lanelet2_extension//:autoware_lanelet2_extension_lib_library",
        "@autoware_lanelet2_utils",
        "@autoware_map_msgs//:cc",
        "@autoware_motion_utils",
        "@autoware_planning_msgs//:cc",
        "@autoware_route_handler",
        "@autoware_utils",
        "@autoware_vehicle_info_utils",
        "@geometry_msgs//:cc",
        "@lanelet2_core//:lanelet2_core_library",
        "@lanelet2_routing//:lanelet2_routing_library",
        "@lanelet2_traffic_rules//:lanelet2_traffic_rules_library",
        "@nav_msgs//:cc",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
        "@rosdistro//cc:boost.geometry",
        "@rosdistro//cc:eigen",
        "@rosdistro//cc:fmt",
        "@std_msgs//:cc",
        "@tf2//:tf2_library",
        "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
        "@tf2_ros//:tf2_ros_library",
        "@tier4_planning_msgs//:cc",
        "@visualization_msgs//:cc",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@logging_demo//:cc_shared",
        "@autoware_adapi_v1_msgs//:cc_shared",
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper",
        "@autoware_common_msgs//:cc_shared",
        "@autoware_internal_debug_msgs//:cc_shared",
        "@autoware_lanelet2_extension//:autoware_lanelet2_extension_lib",
        "@autoware_lanelet2_utils//:runtime_dynamic_deps",
        "@autoware_map_msgs//:cc_shared",
        "@autoware_motion_utils//:runtime_dynamic_deps",
        "@autoware_planning_msgs//:cc_shared",
        "@autoware_route_handler//:runtime_dynamic_deps",
        "@geometry_msgs//:cc_shared",
        "@nav_msgs//:cc_shared",
        "@rclcpp//:rclcpp",
        "@rclcpp_components//:rclcpp_components",
        "@std_msgs//:cc_shared",
        "@tf2//:tf2",
        "@tf2_geometry_msgs//:tf2_geometry_msgs",
        "@tf2_ros//:tf2_ros",
        "@tier4_planning_msgs//:cc_shared",
        "@visualization_msgs//:cc_shared",
    ],
)

cc_shared_library(
    name = "autoware_mission_planner_universe_component",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":autoware_mission_planner_universe"],
)

autoware_agnocast_node(
    name = "mission_planner",
    package_name = "autoware_mission_planner_universe",
    component = ":autoware_mission_planner_universe_component",
    plugin = "autoware::mission_planner_universe::MissionPlanner",
    ros2_executor = "MultiThreadedExecutor",
)

autoware_agnocast_node(
    name = "route_selector",
    package_name = "autoware_mission_planner_universe",
    component = ":autoware_mission_planner_universe_component",
    plugin = "autoware::mission_planner_universe::RouteSelector",
    ros2_executor = "MultiThreadedExecutor",
)

autoware_agnocast_node(
    name = "goal_pose_visualizer",
    package_name = "autoware_mission_planner_universe",
    component = ":autoware_mission_planner_universe_component",
    plugin = "autoware::mission_planner_universe::GoalPoseVisualizer",
    ros2_executor = "SingleThreadedExecutor",
)

register_ament_files(
    name = "node_executables",
    files = [
        ":goal_pose_visualizer",
        ":mission_planner",
        ":route_selector",
    ],
    prefix = "lib/autoware_mission_planner_universe",
    strip_prefix = "*",
)

ament_index(
    components = [
        ":mission_planner_components",
        ":route_selector_components",
        ":goal_pose_visualizer_components",
    ],
    data = glob([
        "config/**",
        "launch/**",
    ]) + [
        ":goal_pose_visualizer_plugin",
        ":mission_planner_plugin",
        ":node_executables",
        ":route_selector_plugin",
    ],
    package_xml = "package.xml",
)

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [
        ":runtime_dynamic_deps",
        "@ament_index_cpp//:ament_index_cpp",
        "@autoware_test_utils//:runtime_dynamic_deps",
    ],
)

cc_test(
    name = "test_autoware_mission_planner_universe",
    timeout = "long",
    srcs = [
        "test/test_lanelet2_plugins_default_planner.cpp",
        "test/test_utility_functions.cpp",
    ],
    data = [
        ":ament_index",
        "@autoware_lanelet2_utils//:ament_index",
        "@autoware_route_handler//:ament_index",
        "@autoware_test_utils//:ament_index",
        "@autoware_vehicle_info_utils//:ament_index",
    ],
    dynamic_deps = [":test_dynamic_deps"],
    env = {"ROS_DOMAIN_ID": "90"},
    deps = [
        ":autoware_mission_planner_universe",
        "@ament_index_cpp//:ament_index_cpp_library",
        "@autoware_test_utils",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "test_autoware_mission_planner_universe_arrival_checker",
    timeout = "long",
    srcs = ["test/test_arrival_checker.cpp"],
    data = [
        ":ament_index",
        "@autoware_lanelet2_utils//:ament_index",
        "@autoware_route_handler//:ament_index",
        "@autoware_test_utils//:ament_index",
        "@autoware_vehicle_info_utils//:ament_index",
    ],
    dynamic_deps = [":test_dynamic_deps"],
    env = {"ROS_DOMAIN_ID": "90"},
    deps = [
        ":autoware_mission_planner_universe",
        "@ament_index_cpp//:ament_index_cpp_library",
        "@autoware_test_utils",
        "@googletest//:gtest",
    ],
)
