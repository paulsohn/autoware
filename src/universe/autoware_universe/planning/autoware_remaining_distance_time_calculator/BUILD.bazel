load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@generate_parameter_library//:defs.bzl", "generate_parameter_library")

package(default_visibility = ["//visibility:public"])

generate_parameter_library(name = "remaining_distance_time_calculator_parameters", yaml_file = "param/remaining_distance_time_calculator_parameters.yaml")

cc_library(
    name = "autoware_remaining_distance_time_calculator",
    srcs = glob(["src/**/*.cpp"]),
    hdrs = glob(["src/**/*.hpp"]),
    includes = ["src", "include/autoware_remaining_distance_time_calculator"],
    deps = [
        ":remaining_distance_time_calculator_parameters",
        "@autoware_internal_msgs//:cc",
        "@autoware_internal_planning_msgs//:cc",
        "@autoware_lanelet2_extension//:autoware_lanelet2_extension_lib_library",
        "@autoware_lanelet2_utils",
        "@autoware_map_msgs//:cc",
        "@autoware_motion_utils",
        "@autoware_planning_msgs//:cc",
        "@autoware_route_handler",
        "@autoware_utils",
        "@autoware_utils_debug",
        "@geometry_msgs//:cc",
        "@nav_msgs//:cc",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
        "@std_msgs//:cc",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_internal_msgs//:cc_shared",
        "@autoware_internal_planning_msgs//:cc_shared",
        "@autoware_lanelet2_extension//:autoware_lanelet2_extension_lib",
        "@autoware_lanelet2_utils//:runtime_dynamic_deps",
        "@autoware_map_msgs//:cc_shared",
        "@autoware_motion_utils//:runtime_dynamic_deps",
        "@autoware_planning_msgs//:cc_shared",
        "@autoware_route_handler//:runtime_dynamic_deps",
        "@autoware_utils_debug//:runtime_dynamic_deps",
        "@generate_parameter_library//:rclcpp_lifecycle",
        "@generate_parameter_library//:rsl",
        "@geometry_msgs//:cc_shared",
        "@nav_msgs//:cc_shared",
        "@rclcpp//:rclcpp",
        "@rclcpp_components//:rclcpp_components",
        "@std_msgs//:cc_shared",
    ],
)

cc_shared_library(
    name = "autoware_remaining_distance_time_calculator_component",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":autoware_remaining_distance_time_calculator"],
)

rclcpp_components_register_node(
    name = "autoware_remaining_distance_time_calculator_node",
    node_name = "autoware_remaining_distance_time_calculator_node",
    component = ":autoware_remaining_distance_time_calculator_component",
    plugin = "autoware::remaining_distance_time_calculator::RemainingDistanceTimeCalculatorNode",
)

register_ament_files(
    name = "node_executables",
    files = [":autoware_remaining_distance_time_calculator_node"],
    prefix = "lib/autoware_remaining_distance_time_calculator",
    strip_prefix = "*",
)

ament_index(
    components = [":autoware_remaining_distance_time_calculator_node_record"],
    data = glob(["config/**", "launch/**"]) + [":node_executables"],
    package_xml = "package.xml",
)
