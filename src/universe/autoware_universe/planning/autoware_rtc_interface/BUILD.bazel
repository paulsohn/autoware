load("@rosdistro//ament:defs.bzl", "ament_index")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_rtc_interface",
    srcs = glob(["src/**/*.cpp"]),
    hdrs = glob(["include/**/*.hpp"]),
    strip_include_prefix = "include",
    deps = [
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper_library",
        "@autoware_qos_utils",
        "@autoware_utils",
        "@rclcpp//:rclcpp_library",
        "@tier4_rtc_msgs//:cc",
        "@unique_identifier_msgs//:cc",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper",
        "@rclcpp//:rclcpp",
        "@tier4_rtc_msgs//:cc_shared",
        "@unique_identifier_msgs//:cc_shared",
    ],
)

ament_index(package_xml = "package.xml")

cc_test(
    name = "test_autoware_rtc_interface",
    srcs = ["test/test_rtc_interface.cpp"],
    data = [":ament_index"],
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [
        ":autoware_rtc_interface",
        "@googletest//:gtest_main",
    ],
)
