load("@autoware_agnocast_wrapper//:defs.bzl", "autoware_agnocast_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@generate_parameter_library//:defs.bzl", "generate_parameter_library")

package(default_visibility = ["//visibility:public"])

generate_parameter_library(
    name = "autoware_trajectory_selector_param",
    yaml_file = "param/parameter_struct.yaml",
)

cc_library(
    name = "autoware_trajectory_selector_library",
    srcs = ["src/trajectory_selector_node.cpp"],
    hdrs = ["include/autoware/trajectory_selector/trajectory_selector_node.hpp"],
    strip_include_prefix = "include",
    deps = [":autoware_trajectory_selector_param", "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper_library", "@autoware_internal_planning_msgs//:cc", "@autoware_lanelet2_utils", "@autoware_map_msgs//:cc", "@autoware_perception_msgs//:cc", "@autoware_planning_msgs//:cc", "@autoware_trajectory_adapter", "@autoware_trajectory_concatenator", "@autoware_trajectory_ranker", "@autoware_trajectory_validator", "@autoware_utils_debug", "@autoware_utils_rclcpp", "@autoware_vehicle_info_utils", "@autoware_vehicle_msgs//:cc", "@rclcpp_components//:rclcpp_components_library", "@rosdistro//cc:tl_expected"],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = ["@autoware_trajectory_ranker//:ranker", "@autoware_trajectory_ranker//:runtime_dynamic_deps", "@rclcpp_components//:rclcpp_components"],
)

cc_shared_library(
    name = "autoware_trajectory_selector",
    deps = [":autoware_trajectory_selector_library", "@autoware_trajectory_adapter", "@autoware_trajectory_concatenator"],
    dynamic_deps = [":runtime_dynamic_deps"],
)

autoware_agnocast_node(
    name = "autoware_trajectory_selector_node",
    package_name = "autoware_trajectory_selector",
    component = ":autoware_trajectory_selector",
    plugin = "autoware::trajectory_selector::TrajectorySelectorNode",
    agnocast_only = True,
)

register_ament_files(
    name = "node_executables",
    files = [":autoware_trajectory_selector_node"],
    prefix = "lib/autoware_trajectory_selector",
    strip_prefix = "*",
)

ament_index(
    package_xml = "package.xml",
    data = [":node_executables", ":autoware_trajectory_selector_node_plugin", "@autoware_trajectory_ranker//:ament_index", "@autoware_trajectory_validator//:ament_index", "launch/trajectory_selector.launch.xml"],
    components = [":autoware_trajectory_selector_node_components"],
)

cc_library(
    name = "dummy_plugin_library",
    testonly = True,
    srcs = ["test/dummy_plugin/dummy_validator_plugin.cpp"],
    deps = ["@autoware_trajectory_validator"],
)

cc_shared_library(
    name = "dummy_plugin",
    testonly = True,
    shared_lib_name = "libdummy_validator_plugin.so",
    deps = [":dummy_plugin_library"],
    dynamic_deps = [":runtime_dynamic_deps"],
)

ament_index(
    name = "dummy_plugin_index",
    testonly = True,
    package_xml = "package.xml",
    data = ["@autoware_trajectory_ranker//:ament_index", "@autoware_trajectory_validator//:ament_index"],
    libraries = [":dummy_plugin"],
    plugin_categories = {'test/dummy_plugin/dummy_plugins.xml': 'autoware_trajectory_validator'},
)

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [":runtime_dynamic_deps", "@autoware_test_utils//:runtime_dynamic_deps", "@ament_index_cpp//:ament_index_cpp", "@rosgraph_msgs//:cc_shared"],
)

cc_test(
    name = "test_trajectory_selector_node",
    timeout = "long",
    srcs = ["test/node/test_trajectory_selector_node.cpp"],
    deps = [":autoware_trajectory_selector_library", "@autoware_test_utils", "@ament_index_cpp//:ament_index_cpp_library", "@rosgraph_msgs//:cc", "@googletest//:gtest_main"],
    dynamic_deps = [":autoware_trajectory_selector", ":test_dynamic_deps"],
    data = [":dummy_plugin_index", "@autoware_test_utils//:ament_index"],
    env = {'ENABLE_AGNOCAST': '0'},
)
