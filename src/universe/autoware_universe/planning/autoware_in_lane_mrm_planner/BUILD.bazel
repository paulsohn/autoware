load("@autoware_agnocast_wrapper//:defs.bzl", "autoware_agnocast_node")
load("@generate_parameter_library//:defs.bzl", "generate_parameter_library")
load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("@pip_ros//:requirements.bzl", "requirement")

package(default_visibility = ["//visibility:public"])

generate_parameter_library(
    name = "in_lane_mrm_planner_parameters",
    yaml_file = "param/in_lane_mrm_planner_parameters.yaml",
)

cc_library(
    name = "autoware_in_lane_mrm_planner",
    srcs = glob(["src/*.cpp"]),
    hdrs = glob(["src/*.hpp"]),
    includes = ["src", "include/autoware_in_lane_mrm_planner"],
    deps = [
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper_library",
        "@autoware_control_msgs//:cc",
        "@autoware_internal_debug_msgs//:cc",
        "@autoware_internal_planning_msgs//:cc",
        "@autoware_lanelet2_extension//:autoware_lanelet2_extension_lib_library",
        "@autoware_map_msgs//:cc",
        "@autoware_motion_utils",
        "@autoware_path_smoother",
        "@autoware_perception_msgs//:cc",
        "@autoware_planning_factor_interface",
        "@autoware_planning_msgs//:cc",
        "@autoware_trajectory",
        "@autoware_utils",
        "@autoware_utils_debug",
        "@autoware_utils_geometry",
        "@autoware_vehicle_info_utils",
        "@autoware_vehicle_msgs//:cc",
        "@geometry_msgs//:cc",
        "@lanelet2_core//:lanelet2_core_library",
        "@lanelet2_routing//:lanelet2_routing_library",
        "@lanelet2_traffic_rules//:lanelet2_traffic_rules_library",
        "@nav_msgs//:cc",
        "@pcl_conversions//:pcl_conversions_library",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
        "@sensor_msgs//:cc",
        "@std_msgs//:cc",
        "@tf2//:tf2_library",
        "@tf2_eigen//:tf2_eigen_library",
        "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
        "@tf2_ros//:tf2_ros_library",
        "@tier4_system_msgs//:cc",
        "@unique_identifier_msgs//:cc",
        "@visualization_msgs//:cc",
        ":in_lane_mrm_planner_parameters",
        "@rosdistro//cc:boost.geometry",
        "@rosdistro//cc:eigen",
        "@rosdistro//cc:magic_enum",
        "@rosdistro//cc:range-v3",
        "@rosdistro//cc:opencv_library",
        "@rosdistro//cc:pcl_io",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper",
        "@autoware_utils//:runtime_dynamic_deps",
        "@autoware_motion_utils//:runtime_dynamic_deps",
        "@autoware_path_smoother//:runtime_dynamic_deps",
        "@autoware_lanelet2_extension//:autoware_lanelet2_extension_lib",
        "@autoware_trajectory//:runtime_dynamic_deps",
        "@generate_parameter_library//:rclcpp_lifecycle",
        "@generate_parameter_library//:rsl",
        "@rosdistro//cc:pcl",
        "@rosdistro//cc:opencv",
        "@lanelet2_core//:lanelet2_core",
        "@lanelet2_routing//:lanelet2_routing",
        "@lanelet2_traffic_rules//:lanelet2_traffic_rules",
        "@pcl_conversions//:pcl_conversions",
        "@rclcpp//:rclcpp",
        "@rclcpp_components//:rclcpp_components",
        "@tf2//:tf2",
        "@tf2_eigen//:tf2_eigen",
        "@tf2_geometry_msgs//:tf2_geometry_msgs",
        "@tf2_ros//:tf2_ros",
        "@autoware_control_msgs//:cc_shared",
        "@autoware_internal_debug_msgs//:cc_shared",
        "@autoware_internal_planning_msgs//:cc_shared",
        "@autoware_map_msgs//:cc_shared",
        "@autoware_perception_msgs//:cc_shared",
        "@autoware_planning_msgs//:cc_shared",
        "@autoware_vehicle_msgs//:cc_shared",
        "@geometry_msgs//:cc_shared",
        "@nav_msgs//:cc_shared",
        "@sensor_msgs//:cc_shared",
        "@std_msgs//:cc_shared",
        "@tier4_system_msgs//:cc_shared",
        "@unique_identifier_msgs//:cc_shared",
        "@visualization_msgs//:cc_shared",
    ],
)

cc_shared_library(
    name = "component",
    shared_lib_name = "libautoware_in_lane_mrm_planner_lib.so",
    deps = [":autoware_in_lane_mrm_planner"],
    dynamic_deps = [":runtime_dynamic_deps"],
)

autoware_agnocast_node(
    name = "autoware_in_lane_mrm_planner_node",
    component = ":component",
    plugin = "autoware::in_lane_mrm_planner::InLaneMrmPlannerNode",
    package_name = "autoware_in_lane_mrm_planner",
)

autoware_agnocast_node(
    name = "mrm_in_lane_stop_auxiliary_commands_node",
    component = ":component",
    plugin = "autoware::in_lane_mrm_planner::MrmInLaneStopAuxiliaryCommandsNode",
    package_name = "autoware_in_lane_mrm_planner",
)


py_library(
    name = "rosbag_common",
    srcs = ["scripts/in_lane_mrm_rosbag_common.py"],
    imports = ["scripts"],
    deps = ["@autoware_planning_msgs//:py", "@rclpy", "@rosbag2_py", "@rosidl_runtime_py"],
)

py_binary(
    name = "in_lane_mrm_planner_rosbag_record",
    srcs = ["scripts/in_lane_mrm_planner_rosbag_record.py"],
    main = "scripts/in_lane_mrm_planner_rosbag_record.py",
    deps = [":rosbag_common"],
    precompile = "disabled",
)

py_binary(
    name = "in_lane_mrm_planner_rosbag_analyzer",
    srcs = ["scripts/in_lane_mrm_planner_rosbag_analyzer.py"],
    main = "scripts/in_lane_mrm_planner_rosbag_analyzer.py",
    deps = [":rosbag_common", "@autoware_control_msgs//:py", "@autoware_internal_debug_msgs//:py", "@nav_msgs//:py", "@std_msgs//:py", requirement("matplotlib")],
    precompile = "disabled",
)

register_ament_files(
    name = "executables",
    files = [":autoware_in_lane_mrm_planner_node", ":mrm_in_lane_stop_auxiliary_commands_node", ":in_lane_mrm_planner_rosbag_record", ":in_lane_mrm_planner_rosbag_analyzer"],
    prefix = "lib/autoware_in_lane_mrm_planner",
    strip_prefix = "*",
)

ament_index(
    package_xml = "package.xml",
    libraries = [":component"],
    components = [":autoware_in_lane_mrm_planner_node_components", ":mrm_in_lane_stop_auxiliary_commands_node_components"],
    data = glob(["config/**", "launch/**", "schema/**"]) + [":executables", ":autoware_in_lane_mrm_planner_node_plugin", ":mrm_in_lane_stop_auxiliary_commands_node_plugin"],
)

cc_test(
    name = "test_autoware_in_lane_mrm_planner",
    timeout = "long",
    srcs = glob(["test/*.cpp"]),
    deps = [":autoware_in_lane_mrm_planner", "@googletest//:gtest_main"],
    dynamic_deps = [":runtime_dynamic_deps"],
    env = {"LD_LIBRARY_PATH": "lib", "ROS_DOMAIN_ID": "77"},
)
