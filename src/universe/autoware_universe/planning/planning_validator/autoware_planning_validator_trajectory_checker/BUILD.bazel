load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_planning_validator_trajectory_checker",
    srcs = glob(["src/**/*.cpp"]),
    hdrs = glob(["include/**/*.hpp"]),
    includes = ["include", "src"],
    deps = [
        "@angles",
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper_library",
        "@autoware_motion_utils",
        "@autoware_planning_validator",
        "@autoware_trajectory",
        "@autoware_utils",
        "@autoware_vehicle_info_utils",
        "@pluginlib//:pluginlib_library",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper",
        "@autoware_motion_utils//:runtime_dynamic_deps",
        "@autoware_planning_validator//:runtime_dynamic_deps",
        "@autoware_trajectory//:runtime_dynamic_deps",
        "@pluginlib//:pluginlib",
        "@rclcpp//:rclcpp",
        "@rclcpp_components//:rclcpp_components",
    ],
)

cc_shared_library(
    name = "trajectory_checker_plugin",
    shared_lib_name = "libautoware_planning_validator_trajectory_checker.so",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":autoware_planning_validator_trajectory_checker"],
)

ament_index(
    libraries = [":trajectory_checker_plugin"],
    data = glob(["config/**"]),
    plugin_categories = {"plugins.xml": "autoware_planning_validator"},
    package_xml = "package.xml",
)

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [":runtime_dynamic_deps", "@autoware_planning_validator_test_utils//:runtime_dynamic_deps", "@autoware_planning_test_manager//:runtime_dynamic_deps", "@ament_index_cpp//:ament_index_cpp"],
)
cc_test(
    name = "test_autoware_planning_validator_trajectory_checker",
    timeout = "long",
    srcs = glob(["test/**/*.cpp"]),
    data = [":ament_index", "@autoware_planning_validator//:ament_index", "@autoware_test_utils//:ament_index", "@autoware_route_handler//:ament_index", "@autoware_lanelet2_utils//:ament_index", "@autoware_vehicle_info_utils//:ament_index"],
    dynamic_deps = [":test_dynamic_deps"],
    env = {"ENABLE_AGNOCAST": "0", "LD_LIBRARY_PATH": "lib", "ROS_DOMAIN_ID": "90"},
    deps = [":autoware_planning_validator_trajectory_checker", "@autoware_planning_validator//:node_library", "@autoware_planning_validator_test_utils", "@autoware_planning_test_manager", "@ament_index_cpp//:ament_index_cpp_library", "@googletest//:gtest"],
)
