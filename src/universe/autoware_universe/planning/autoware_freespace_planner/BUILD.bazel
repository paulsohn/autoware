load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_freespace_planner",
    srcs = glob(["src/**/*.cpp"]),
    hdrs = glob(["include/**/*.hpp"]),
    includes = ["include"],
    deps = [
        "@ament_index_cpp//:ament_index_cpp_library",
        "@autoware_freespace_planning_algorithms",
        "@autoware_internal_debug_msgs//:cc",
        "@autoware_internal_planning_msgs//:cc",
        "@autoware_motion_utils",
        "@autoware_planning_msgs//:cc",
        "@autoware_route_handler",
        "@autoware_utils",
        "@autoware_vehicle_info_utils",
        "@geometry_msgs//:cc",
        "@nav_msgs//:cc",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
        "@rosdistro//cc:boost.geometry",
        "@rosdistro//cc:eigen",
        "@sensor_msgs//:cc",
        "@tf2//:tf2_library",
        "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
        "@tf2_ros//:tf2_ros_library",
        "@tier4_planning_msgs//:cc",
        "@visualization_msgs//:cc",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@ament_index_cpp//:ament_index_cpp",
        "@autoware_freespace_planning_algorithms//:runtime_dynamic_deps",
        "@autoware_internal_debug_msgs//:cc_shared",
        "@autoware_internal_planning_msgs//:cc_shared",
        "@autoware_motion_utils//:runtime_dynamic_deps",
        "@autoware_planning_msgs//:cc_shared",
        "@autoware_route_handler//:runtime_dynamic_deps",
        "@geometry_msgs//:cc_shared",
        "@nav_msgs//:cc_shared",
        "@logging_demo//:cc_shared",
        "@rclcpp//:rclcpp",
        "@rclcpp_components//:rclcpp_components",
        "@sensor_msgs//:cc_shared",
        "@tf2//:tf2",
        "@tf2_geometry_msgs//:tf2_geometry_msgs",
        "@tf2_ros//:tf2_ros",
        "@tier4_planning_msgs//:cc_shared",
        "@visualization_msgs//:cc_shared",
    ],
)

cc_shared_library(
    name = "autoware_freespace_planner_component",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":autoware_freespace_planner"],
)

rclcpp_components_register_node(
    name = "freespace_planner",
    node_name = "freespace_planner",
    plugin = "autoware::freespace_planner::FreespacePlannerNode",
    component = ":autoware_freespace_planner_component",
)

register_ament_files(
    name = "node_executables",
    files = [":freespace_planner"],
    prefix = "lib/autoware_freespace_planner",
    strip_prefix = "*",
)

ament_index(
    components = [":freespace_planner_record"],
    data = glob(["config/**", "launch/**"]) + [":node_executables"],
    package_xml = "package.xml",
)

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [":runtime_dynamic_deps", "@autoware_planning_test_manager//:runtime_dynamic_deps", "@autoware_test_utils//:runtime_dynamic_deps", "@ament_index_cpp//:ament_index_cpp"],
)

cc_test(
    name = "test_autoware_freespace_planner",
    timeout = "long",
    srcs = glob(["test/**/*.cpp"]),
    data = [":ament_index", "@autoware_test_utils//:ament_index", "@autoware_route_handler//:ament_index", "@autoware_lanelet2_utils//:ament_index", "@autoware_vehicle_info_utils//:ament_index"],
    dynamic_deps = [":test_dynamic_deps"],
    env = {"ENABLE_AGNOCAST": "0", "LD_LIBRARY_PATH": "lib", "ROS_DOMAIN_ID": "87"},
    deps = [":autoware_freespace_planner", "@autoware_planning_test_manager", "@autoware_test_utils", "@ament_index_cpp//:ament_index_cpp_library", "@googletest//:gtest_main"],
)
