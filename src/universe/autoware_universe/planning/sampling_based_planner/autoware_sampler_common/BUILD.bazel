load("@rosdistro//ament:defs.bzl", "ament_index")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_sampler_common",
    srcs = glob(["src/**/*.cpp"]),
    hdrs = glob(["include/**/*.hpp"]),
    strip_include_prefix = "include",
    deps = [
        "@autoware_interpolation",
        "@autoware_utils",
        "@geometry_msgs//:cc",
        "@rosdistro//cc:boost.geometry",
        "@rosdistro//cc:eigen",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_utils_debug//:runtime_dynamic_deps",
        "@autoware_utils_pcl//:runtime_dynamic_deps",
        "@geometry_msgs//:cc_shared",
        "@rclcpp//:rclcpp",
        "@tf2//:tf2",
        "@tf2_geometry_msgs//:tf2_geometry_msgs",
    ],
)

ament_index(package_xml = "package.xml")

cc_test(
    name = "test_sampler_common",
    srcs = ["test/test_structures.cpp", "test/test_transform.cpp"],
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":autoware_sampler_common", "@googletest//:gtest_main"],
)
