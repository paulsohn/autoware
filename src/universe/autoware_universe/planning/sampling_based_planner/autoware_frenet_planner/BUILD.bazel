load("@rosdistro//ament:defs.bzl", "ament_index")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_frenet_planner",
    srcs = glob(["src/**/*.cpp"]),
    hdrs = glob(["include/**/*.hpp"]),
    strip_include_prefix = "include",
    deps = [
        "@autoware_planning_msgs//:cc",
        "@autoware_sampler_common",
        "@autoware_utils",
        "@autoware_utils_math",
        "@rosdistro//cc:eigen",
        "@tf2//:tf2_library",
        "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_planning_msgs//:cc_shared",
        "@autoware_sampler_common//:runtime_dynamic_deps",
        "@tf2//:tf2",
        "@tf2_geometry_msgs//:tf2_geometry_msgs",
    ],
)

ament_index(package_xml = "package.xml")
