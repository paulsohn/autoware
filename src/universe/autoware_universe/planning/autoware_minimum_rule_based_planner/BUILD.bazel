load("@autoware_agnocast_wrapper//:defs.bzl", "autoware_agnocast_node")
load("@generate_parameter_library//:defs.bzl", "generate_parameter_library")
load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

generate_parameter_library(
    name = "minimum_rule_based_planner_parameters",
    yaml_file = "param/minimum_rule_based_planner_parameters.yaml",
)

_DEPENDENCIES = [
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper_library",
        "@autoware_internal_debug_msgs//:cc",
        "@autoware_internal_planning_msgs//:cc",
        "@autoware_lanelet2_extension//:autoware_lanelet2_extension_lib_library",
        "@autoware_map_msgs//:cc",
        "@autoware_motion_utils",
        "@autoware_obstacle_proximity_checker",
        "@autoware_perception_msgs//:cc",
        "@autoware_planning_factor_interface",
        "@autoware_planning_msgs//:cc",
        "@autoware_planning_test_manager",
        "@autoware_qp_interface",
        "@autoware_trajectory",
        "@autoware_trajectory_modifier//:utils_library",
        "@autoware_utils",
        "@autoware_utils_debug",
        "@autoware_utils_geometry",
        "@autoware_utils_math",
        "@autoware_utils_rclcpp",
        "@autoware_utils_system",
        "@autoware_utils_uuid",
        "@autoware_vehicle_info_utils",
        "@autoware_vehicle_msgs//:cc",
        "@autoware_velocity_smoother//:smoother",
        "@geometry_msgs//:cc",
        "@lanelet2_core//:lanelet2_core_library",
        "@lanelet2_routing//:lanelet2_routing_library",
        "@lanelet2_traffic_rules//:lanelet2_traffic_rules_library",
        "@nav_msgs//:cc",
        "@pcl_conversions//:pcl_conversions_library",
        "@pluginlib//:pluginlib_library",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
        "@sensor_msgs//:cc",
        "@std_msgs//:cc",
        "@tf2//:tf2_library",
        "@tf2_eigen//:tf2_eigen_library",
        "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
        "@tf2_ros//:tf2_ros_library",
        "@tier4_planning_msgs//:cc",
        "@unique_identifier_msgs//:cc",
        "@visualization_msgs//:cc",
        ":minimum_rule_based_planner_parameters",
        "@rosdistro//cc:eigen",
        "@rosdistro//cc:boost.geometry",
        "@rosdistro//cc:magic_enum",
        "@rosdistro//cc:opencv_library",
]

cc_library(
    name = "plugin_interface",
    hdrs = ["plugins/plugin_interface.hpp"],
    includes = ["plugins"],
    deps = _DEPENDENCIES,
)

cc_library(
    name = "autoware_minimum_rule_based_planner",
    srcs = ["src/minimum_rule_based_planner.cpp", "src/path_planner.cpp", "src/velocity_smoother.cpp"],
    hdrs = glob(["src/*.hpp"]),
    includes = ["src"],
    deps = [":plugin_interface"] + _DEPENDENCIES,
)

cc_library(
    name = "plugins_library",
    srcs = ["plugins/obstacle_stop.cpp", "plugins/surround_obstacle_stop.cpp"],
    hdrs = ["plugins/obstacle_stop.hpp", "plugins/surround_obstacle_stop.hpp"],
    deps = [":plugin_interface"] + _DEPENDENCIES,
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_trajectory_modifier//:utils",
        "@autoware_trajectory_modifier//:runtime_dynamic_deps",
        "@autoware_velocity_smoother//:runtime_dynamic_deps",
        "@autoware_lanelet2_extension//:autoware_lanelet2_extension_lib",
        "@rosdistro//cc:opencv",
        "@lanelet2_core//:lanelet2_core",
        "@lanelet2_routing//:lanelet2_routing",
        "@lanelet2_traffic_rules//:lanelet2_traffic_rules",
        "@pcl_conversions//:pcl_conversions",
        "@pluginlib//:pluginlib",
        "@rclcpp//:rclcpp",
        "@rclcpp_components//:rclcpp_components",
        "@tf2//:tf2",
        "@tf2_eigen//:tf2_eigen",
        "@tf2_geometry_msgs//:tf2_geometry_msgs",
        "@tf2_ros//:tf2_ros",
        "@autoware_internal_debug_msgs//:cc_shared",
        "@autoware_internal_planning_msgs//:cc_shared",
        "@autoware_map_msgs//:cc_shared",
        "@autoware_perception_msgs//:cc_shared",
        "@autoware_planning_msgs//:cc_shared",
        "@autoware_vehicle_msgs//:cc_shared",
        "@geometry_msgs//:cc_shared",
        "@nav_msgs//:cc_shared",
        "@sensor_msgs//:cc_shared",
        "@std_msgs//:cc_shared",
        "@tier4_planning_msgs//:cc_shared",
        "@unique_identifier_msgs//:cc_shared",
        "@visualization_msgs//:cc_shared",
    ],
)

cc_shared_library(
    name = "component",
    shared_lib_name = "libautoware_minimum_rule_based_planner_lib.so",
    deps = [":autoware_minimum_rule_based_planner"],
    dynamic_deps = [":runtime_dynamic_deps"],
)

cc_shared_library(
    name = "modifier_plugins",
    shared_lib_name = "libautoware_minimum_rule_based_planner_plugins.so",
    deps = [":plugins_library"],
    dynamic_deps = [":runtime_dynamic_deps"],
)

autoware_agnocast_node(
    name = "autoware_minimum_rule_based_planner_node",
    component = ":component",
    plugin = "autoware::minimum_rule_based_planner::MinimumRuleBasedPlannerNode",
    package_name = "autoware_minimum_rule_based_planner",
)

register_ament_files(
    name = "executables",
    files = [":autoware_minimum_rule_based_planner_node"],
    prefix = "lib/autoware_minimum_rule_based_planner",
    strip_prefix = "*",
)

ament_index(
    package_xml = "package.xml",
    deps = ["@autoware_trajectory_modifier//:ament_index", "@autoware_core_planning//:ament_index"],
    components = [":autoware_minimum_rule_based_planner_node_components"],
    libraries = [":modifier_plugins"],
    plugin_categories = {"plugins.xml": "autoware_minimum_rule_based_planner"},
    data = glob(["config/**", "launch/**"]) + [":executables", ":autoware_minimum_rule_based_planner_node_plugin"],
)

cc_test(
    name = "test_autoware_minimum_rule_based_planner",
    timeout = "long",
    srcs = glob(["test/*.cpp"]),
    deps = [":autoware_minimum_rule_based_planner", "@googletest//:gtest_main"],
    dynamic_deps = [":runtime_dynamic_deps"],
    env = {"LD_LIBRARY_PATH": "lib", "ROS_DOMAIN_ID": "79"},
)
