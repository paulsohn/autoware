collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@ament_index_cpp//:ament_index_cpp",
        "@autoware_grid_map_utils//:runtime_dynamic_deps",
        "@autoware_internal_debug_msgs//:cc_shared",
        "@autoware_internal_planning_msgs//:cc_shared",
        "@autoware_lanelet2_extension//:autoware_lanelet2_extension_lib",
        "@autoware_lanelet2_utils//:runtime_dynamic_deps",
        "@autoware_map_msgs//:cc_shared",
        "@autoware_perception_msgs//:cc_shared",
        "@generate_parameter_library//:rclcpp_lifecycle",
        "@generate_parameter_library//:rsl",
        "@geometry_msgs//:cc_shared",
        "@grid_map//:grid_map_msgs_cc_shared",
        "@grid_map//:grid_map_ros_runtime_dynamic_deps",
        "@lanelet2_core//:lanelet2_core",
        "@message_filters//:message_filters",
        "@nav_msgs//:cc_shared",
        "@pcl_conversions//:pcl_conversions",
        "@pcl_ros//:pcl_ros_tf",
        "@rclcpp//:rclcpp",
        "@rclcpp_components//:rclcpp_components",
        "@sensor_msgs//:cc_shared",
        "@tf2//:tf2",
        "@tf2_eigen//:tf2_eigen",
        "@tf2_geometry_msgs//:tf2_geometry_msgs",
        "@tf2_ros//:tf2_ros",
        "@tier4_planning_msgs//:cc_shared",
        "@visualization_msgs//:cc_shared",
    ],
)

cc_shared_library(
    name = "autoware_costmap_generator_component",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":autoware_costmap_generator"],
)

rclcpp_components_register_node(
    name = "costmap_generator",
    node_name = "costmap_generator",
    plugin = "autoware::costmap_generator::CostmapGenerator",
    component = ":autoware_costmap_generator_component",
)

register_ament_files(
    name = "node_executables",
    files = [":costmap_generator"],
    prefix = "lib/autoware_costmap_generator",
    strip_prefix = "*",
)

ament_index(
    components = [":costmap_generator_record"],
    data = glob(["config/**", "launch/**"]) + [":node_executables"],
    package_xml = "package.xml",
)

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [":runtime_dynamic_deps", "@autoware_planning_test_manager//:runtime_dynamic_deps", "@autoware_test_utils//:runtime_dynamic_deps", "@ament_index_cpp//:ament_index_cpp"],
)

cc_test(
    name = "test_costmap_generator_lib",
    timeout = "long",
    srcs = ["test/test_points_to_costmap.cpp", "test/test_objects_to_costmap.cpp", "test/test_object_map_utils.cpp"],
    data = [":ament_index", "@autoware_test_utils//:ament_index", "@autoware_route_handler//:ament_index", "@autoware_lanelet2_utils//:ament_index", "@autoware_vehicle_info_utils//:ament_index"],
    dynamic_deps = [":test_dynamic_deps"],
    env = {"ENABLE_AGNOCAST": "0", "LD_LIBRARY_PATH": "lib", "ROS_DOMAIN_ID": "87"},
    deps = [":costmap_generator_lib", "@autoware_planning_test_manager", "@autoware_test_utils", "@ament_index_cpp//:ament_index_cpp_library", "@googletest//:gtest_main"],
)

cc_test(
    name = "test_autoware_costmap_generator",
    timeout = "long",
    srcs = ["test/test_costmap_generator.cpp"],
    data = [":ament_index", "@autoware_test_utils//:ament_index", "@autoware_route_handler//:ament_index", "@autoware_lanelet2_utils//:ament_index", "@autoware_vehicle_info_utils//:ament_index"],
    dynamic_deps = [":test_dynamic_deps"],
    env = {"ENABLE_AGNOCAST": "0", "LD_LIBRARY_PATH": "lib", "ROS_DOMAIN_ID": "87"},
    deps = [":autoware_costmap_generator", "@autoware_planning_test_manager", "@autoware_test_utils", "@ament_index_cpp//:ament_index_cpp_library", "@googletest//:gtest_main"],
)
