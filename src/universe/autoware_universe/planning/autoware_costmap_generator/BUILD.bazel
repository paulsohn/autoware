cc_library(
    name = "autoware_costmap_generator",
    srcs = ["src/costmap_generator.cpp"],
    hdrs = ["include/autoware/costmap_generator/costmap_generator.hpp"],
    includes = ["include", "include/autoware_costmap_generator"],
