load("@rosdistro//ament:defs.bzl", "ament_index")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_behavior_velocity_occlusion_spot_module",
    srcs = glob(["src/**/*.cpp"]),
    hdrs = glob(["src/**/*.hpp"]),
    includes = ["src"],
    deps = [
        "@autoware_behavior_velocity_planner_common",
        "@autoware_grid_map_utils",
        "@autoware_internal_planning_msgs//:cc",
        "@autoware_interpolation",
        "@autoware_lanelet2_extension//:autoware_lanelet2_extension_lib_library",
        "@autoware_lanelet2_utils",
        "@autoware_motion_utils",
        "@autoware_perception_msgs//:cc",
        "@autoware_planning_msgs//:cc",
        "@autoware_route_handler",
        "@autoware_trajectory",
        "@autoware_utils",
        "@autoware_utils_geometry",
        "@autoware_vehicle_info_utils",
        "@geometry_msgs//:cc",
        "@grid_map//:grid_map_core",
        "@grid_map//:grid_map_ros",
        "@lanelet2_core//:lanelet2_core_library",
        "@lanelet2_routing//:lanelet2_routing_library",
        "@nav_msgs//:cc",
        "@pluginlib//:pluginlib_library",
        "@rclcpp//:rclcpp_library",
        "@rosdistro//cc:boost.geometry",
        "@rosdistro//cc:opencv_library",
        "@tf2//:tf2_library",
        "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
        "@visualization_msgs//:cc",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_behavior_velocity_planner_common//:runtime_dynamic_deps",
        "@autoware_grid_map_utils//:runtime_dynamic_deps",
        "@grid_map//:grid_map_ros_runtime_dynamic_deps",
        "@pluginlib//:pluginlib",
        "@rosdistro//cc:opencv",
    ],
)

cc_shared_library(
    name = "occlusion_spot_plugin",
    dynamic_deps = [":runtime_dynamic_deps"],
    shared_lib_name = "libautoware_behavior_velocity_occlusion_spot_module.so",
    deps = [":autoware_behavior_velocity_occlusion_spot_module"],
)

ament_index(
    data = glob(["config/**"]),
    libraries = [":occlusion_spot_plugin"],
    package_xml = "package.xml",
    plugin_categories = {"plugins.xml": "autoware_behavior_velocity_planner"},
)

cc_test(
    name = "test_autoware_behavior_velocity_occlusion_spot_module",
    timeout = "long",
    srcs = glob(["test/src/*.cpp", "test/src/*.hpp"]),
    dynamic_deps = [":runtime_dynamic_deps"],
    env = {"ENABLE_AGNOCAST": "0", "LD_LIBRARY_PATH": "lib"},
    deps = [
        ":autoware_behavior_velocity_occlusion_spot_module",
        "@googletest//:gtest_main",
    ],
)
