load("@generate_parameter_library//:defs.bzl", "generate_parameter_library")
load("@rosdistro//ament:defs.bzl", "ament_index")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

generate_parameter_library(
    name = "autoware_trajectory_concatenator_param",
    yaml_file = "param/parameter_struct.yaml",
)

cc_library(
    name = "autoware_trajectory_concatenator",
    srcs = ["src/detail/trajectory_concatenator.cpp"],
    hdrs = ["include/autoware/trajectory_concatenator/detail/trajectory_concatenator.hpp", "include/autoware/trajectory_concatenator/trajectory_concatenator_wrapper.hpp"],
    strip_include_prefix = "include",
    deps = ["@autoware_agnocast_wrapper//:autoware_agnocast_wrapper_library", "@autoware_internal_planning_msgs//:cc", "@autoware_planning_msgs//:cc", "@autoware_utils_debug", "@autoware_utils_rclcpp", "@autoware_utils_uuid", ":autoware_trajectory_concatenator_param"],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = ["@autoware_agnocast_wrapper//:autoware_agnocast_wrapper", "@autoware_internal_planning_msgs//:cc_shared", "@autoware_planning_msgs//:cc_shared", "@autoware_utils_debug//:runtime_dynamic_deps", "@generate_parameter_library//:rclcpp_lifecycle", "@generate_parameter_library//:rsl"],
)

ament_index(
    package_xml = "package.xml",
)
cc_test(
    name = "test_trajectory_concatenator",
    srcs = ["test/test_trajectory_concatenator.cpp"],
    deps = [":autoware_trajectory_concatenator", "@googletest//:gtest_main"],
    dynamic_deps = [":runtime_dynamic_deps"],
)

cc_test(
    name = "test_trajectory_concatenator_wrapper",
    srcs = ["test/test_trajectory_concatenator_wrapper.cpp"],
    deps = [":autoware_trajectory_concatenator", "@googletest//:gtest"],
    dynamic_deps = [":runtime_dynamic_deps"],
    env = {'ENABLE_AGNOCAST': '0'},
)

cc_library(
    name = "wrapper_test_source",
    testonly = True,
    textual_hdrs = ["test/test_trajectory_concatenator_wrapper.cpp"],
    includes = ["."],
    deps = [":autoware_trajectory_concatenator", "@googletest//:gtest"],
)
