cc_test(name = "test_dummy_traffic_light", srcs = ["test/test_dummy_traffic_light.cpp"], dynamic_deps = [":runtime_dynamic_deps"], env = {"LD_LIBRARY_PATH": "lib"}, deps = [":autoware_dummy_traffic_light_publisher", "@googletest//:gtest_main"])
