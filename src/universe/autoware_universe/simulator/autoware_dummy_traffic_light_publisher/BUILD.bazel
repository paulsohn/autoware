load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_binary", "cc_test")
load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
package(default_visibility = ["//visibility:public"])
cc_library(name = "autoware_dummy_traffic_light_publisher", srcs = glob(["src/*.cpp"], exclude = ["src/main.cpp"]), hdrs = glob(["src/*.hpp"]), includes = ["src"], deps = ["@autoware_lanelet2_extension//:autoware_lanelet2_extension_lib_library", "@autoware_lanelet2_utils", "@autoware_map_msgs//:cc", "@autoware_perception_msgs//:cc", "@rclcpp//:rclcpp_library"])
collect_transitive_dynamic_deps(name = "runtime_dynamic_deps", dynamic_deps = ["@autoware_lanelet2_extension//:autoware_lanelet2_extension_lib", "@autoware_lanelet2_utils//:runtime_dynamic_deps", "@autoware_map_msgs//:cc_shared", "@autoware_perception_msgs//:cc_shared", "@rclcpp//:rclcpp"])
cc_shared_library(name = "autoware_dummy_traffic_light_publisher_component", dynamic_deps = [":runtime_dynamic_deps"], deps = [":autoware_dummy_traffic_light_publisher"])
cc_binary(name = "autoware_dummy_traffic_light_publisher_node", srcs = ["src/main.cpp"], dynamic_deps = [":runtime_dynamic_deps", ":autoware_dummy_traffic_light_publisher_component"], deps = [":autoware_dummy_traffic_light_publisher"])
register_ament_files(name = "node_executables", files = [":autoware_dummy_traffic_light_publisher_node"], prefix = "lib/autoware_dummy_traffic_light_publisher", strip_prefix = "*")
