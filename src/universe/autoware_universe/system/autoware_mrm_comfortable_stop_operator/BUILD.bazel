load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@autoware_agnocast_wrapper//:defs.bzl", "autoware_agnocast_node")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_mrm_comfortable_stop_operator",
    srcs = glob(["src/**/*.cpp"]),
    hdrs = glob(["src/**/*.hpp"]),
    includes = ["src"],
    deps = [
        "@autoware_adapi_v1_msgs//:cc",
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper_library",
        "@autoware_internal_planning_msgs//:cc",
        "@autoware_utils",
        "@rcl_interfaces//:cc",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
        "@std_msgs//:cc",
        "@std_srvs//:cc",
        "@tier4_system_msgs//:cc",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_adapi_v1_msgs//:cc_shared",
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper",
        "@autoware_internal_planning_msgs//:cc_shared",
        "@rcl_interfaces//:cc_shared",
        "@rclcpp//:rclcpp",
        "@rclcpp_components//:rclcpp_components",
        "@std_msgs//:cc_shared",
        "@std_srvs//:cc_shared",
        "@tier4_system_msgs//:cc_shared",
    ],
)

cc_shared_library(
    name = "autoware_mrm_comfortable_stop_operator_component",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":autoware_mrm_comfortable_stop_operator"],
)

autoware_agnocast_node(
    name = "autoware_mrm_comfortable_stop_operator_node",
    package_name = "autoware_mrm_comfortable_stop_operator",
    component = ":autoware_mrm_comfortable_stop_operator_component",
    plugin = "autoware::mrm_comfortable_stop_operator::MrmComfortableStopOperator",
    agnocast_only = True,
)

register_ament_files(
    name = "node_executables",
    files = [":autoware_mrm_comfortable_stop_operator_node"],
    prefix = "lib/autoware_mrm_comfortable_stop_operator",
    strip_prefix = "*",
)

ament_index(
    package_xml = "package.xml",
    data = glob(["config/**", "launch/**"]) + [":autoware_mrm_comfortable_stop_operator_node_plugin", ":node_executables"],
    components = [":autoware_mrm_comfortable_stop_operator_node_components"],
)
