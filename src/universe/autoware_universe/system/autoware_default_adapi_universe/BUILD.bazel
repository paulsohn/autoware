py_binary(
    name = "web_server.py",
    srcs = ["script/web_server.py"],
    main = "script/web_server.py",
    deps = ["@autoware_adapi_version_msgs//:py", "@rclpy", requirement("flask")],
)

register_ament_files(
    name = "node_executables",
    files = [
        ":web_server.py",
        ":autoware_state_node",
        ":diagnostics_node",
        ":fail_safe_node",
        ":heartbeat_node",
        ":manual_control_node",
        ":motion_node",
        ":mrm_request_node",
        ":operation_mode_node",
        ":perception_node",
        ":planning_node",
        ":vehicle_command_node",
        ":vehicle_door_node",
        ":vehicle_info_node",
        ":vehicle_metrics_node",
        ":vehicle_status_node",
    ],
    prefix = "lib/autoware_default_adapi_universe",
    strip_prefix = "*",
)

ament_index(
    package_xml = "package.xml",
    deps = [
        "@autoware_default_adapi//:ament_index",
        "@autoware_agnocast_wrapper//:ament_package",
        "@autoware_global_parameter_loader//:ament_index",
        "@rclcpp_components//:ament_package",
    ],
    data = glob(["config/**", "launch/**"]) + [
        ":autoware_state_node_plugin",
        ":diagnostics_node_plugin",
        ":fail_safe_node_plugin",
        ":heartbeat_node_plugin",
        ":manual_control_node_plugin",
        ":motion_node_plugin",
        ":mrm_request_node_plugin",
        ":operation_mode_node_plugin",
        ":perception_node_plugin",
        ":planning_node_plugin",
        ":vehicle_command_node_plugin",
        ":vehicle_door_node_plugin",
        ":vehicle_info_node_plugin",
        ":vehicle_metrics_node_plugin",
        ":vehicle_status_node_plugin",
        ":node_executables",
    ],
    components = [
        ":autoware_state_node_components",
        ":diagnostics_node_components",
        ":fail_safe_node_components",
        ":heartbeat_node_components",
        ":manual_control_node_components",
