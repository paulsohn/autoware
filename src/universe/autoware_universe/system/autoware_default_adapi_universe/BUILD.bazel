load("@pip_adapi//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary")
load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@autoware_agnocast_wrapper//:defs.bzl", "autoware_agnocast_node")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_default_adapi_universe",
    srcs = glob(["src/**/*.cpp"]),
    hdrs = glob(["src/**/*.hpp"]),
    includes = ["src"],
    deps = [
        "@autoware_adapi_specs",
        "@autoware_adapi_v1_msgs//:cc",
        "@autoware_adapi_version_msgs//:cc",
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper_library",
        "@autoware_component_interface_specs",
        "@autoware_component_interface_specs_universe",
        "@autoware_component_interface_utils",
        "@autoware_geography_utils",
        "@autoware_internal_planning_msgs//:cc",
        "@autoware_motion_utils",
        "@autoware_perception_msgs//:cc",
        "@autoware_planning_msgs//:cc",
        "@autoware_system_msgs//:cc",
        "@autoware_utils_diagnostics",
        "@autoware_utils_rclcpp",
        "@autoware_vehicle_info_utils",
        "@autoware_vehicle_msgs//:cc",
        "@builtin_interfaces//:cc",
        "@diagnostic_msgs//:cc",
        "@diagnostic_updater//:diagnostic_updater_library",
        "@geographic_msgs//:cc",
        "@geometry_msgs//:cc",
        "@nav_msgs//:cc",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
        "@shape_msgs//:cc",
        "@std_srvs//:cc",
        "@tier4_system_msgs//:cc",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_adapi_specs//:runtime_dynamic_deps",
        "@autoware_adapi_v1_msgs//:cc_shared",
        "@autoware_adapi_version_msgs//:cc_shared",
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper",
        "@autoware_component_interface_specs//:runtime_dynamic_deps",
        "@autoware_component_interface_specs_universe//:runtime_dynamic_deps",
        "@autoware_component_interface_utils//:runtime_dynamic_deps",
        "@autoware_geography_utils//:runtime_dynamic_deps",
        "@autoware_internal_planning_msgs//:cc_shared",
        "@autoware_motion_utils//:runtime_dynamic_deps",
        "@autoware_perception_msgs//:cc_shared",
        "@autoware_planning_msgs//:cc_shared",
        "@autoware_system_msgs//:cc_shared",
        "@autoware_vehicle_msgs//:cc_shared",
        "@builtin_interfaces//:cc_shared",
        "@diagnostic_msgs//:cc_shared",
        "@diagnostic_updater//:diagnostic_updater",
        "@geographic_msgs//:cc_shared",
        "@geometry_msgs//:cc_shared",
        "@nav_msgs//:cc_shared",
        "@rclcpp//:rclcpp",
        "@rclcpp_components//:rclcpp_components",
        "@shape_msgs//:cc_shared",
        "@std_srvs//:cc_shared",
        "@tier4_system_msgs//:cc_shared",
    ],
)

cc_shared_library(
    name = "autoware_default_adapi_universe_component",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":autoware_default_adapi_universe"],
)

autoware_agnocast_node(
    name = "autoware_state_node",
    package_name = "autoware_default_adapi_universe",
    component = ":autoware_default_adapi_universe_component",
    plugin = "autoware::default_adapi::AutowareStateNode",
    agnocast_only = True,
    ros2_executor = "MultiThreadedExecutor",
)

