load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_duplicated_node_checker",
    srcs = glob(["src/**/*.cpp"]),
    hdrs = glob(["include/**/*.hpp"]),
    includes = ["include", "src"],
    deps = [
        "@diagnostic_msgs//:cc",
        "@diagnostic_updater//:diagnostic_updater_library",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@diagnostic_msgs//:cc_shared",
        "@diagnostic_updater//:diagnostic_updater",
        "@rclcpp//:rclcpp",
        "@rclcpp_components//:rclcpp_components",
    ],
)

cc_shared_library(
    name = "autoware_duplicated_node_checker_component",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":autoware_duplicated_node_checker"],
)

rclcpp_components_register_node(
    name = "autoware_duplicated_node_checker_node",
    node_name = "autoware_duplicated_node_checker_node",
    component = ":autoware_duplicated_node_checker_component",
    plugin = "autoware::duplicated_node_checker::DuplicatedNodeChecker",
)

register_ament_files(
    name = "node_executables",
    files = [":autoware_duplicated_node_checker_node"],
    prefix = "lib/autoware_duplicated_node_checker",
    strip_prefix = "*",
)

ament_index(
    package_xml = "package.xml",
    data = glob(["config/**", "launch/**"]) + [":node_executables"],
    components = [":autoware_duplicated_node_checker_node_record"],
)
