load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@autoware_agnocast_wrapper//:defs.bzl", "autoware_agnocast_node")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_topic_state_monitor",
    srcs = glob(["src/**/*.cpp"]),
    hdrs = glob(["src/**/*.hpp"]),
    includes = ["src"],
    deps = [
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper_library",
        "@diagnostic_msgs//:cc",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
        "@tf2_msgs//:cc",
        "@rcl_interfaces//:cc",
        "@diagnostic_updater//:diagnostic_updater_library",
        "@ament_index_cpp//:ament_index_cpp_library",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper",
        "@diagnostic_msgs//:cc_shared",
        "@rclcpp//:rclcpp",
        "@rclcpp_components//:rclcpp_components",
        "@tf2_msgs//:cc_shared",
        "@rcl_interfaces//:cc_shared",
        "@diagnostic_updater//:diagnostic_updater",
        "@ament_index_cpp//:ament_index_cpp",
    ],
)

cc_shared_library(
    name = "autoware_topic_state_monitor_component",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":autoware_topic_state_monitor"],
)

autoware_agnocast_node(
    name = "autoware_topic_state_monitor_node",
    package_name = "autoware_topic_state_monitor",
    component = ":autoware_topic_state_monitor_component",
    plugin = "autoware::topic_state_monitor::TopicStateMonitorNode",
    agnocast_only = True,
)

register_ament_files(
    name = "node_executables",
    files = [":autoware_topic_state_monitor_node"],
    prefix = "lib/autoware_topic_state_monitor",
    strip_prefix = "*",
)

ament_index(
    package_xml = "package.xml",
    data = glob(["launch/**"]) + [":autoware_topic_state_monitor_node_plugin", ":node_executables"],
    deps = ["@autoware_agnocast_wrapper//:ament_package"],
    components = [":autoware_topic_state_monitor_node_components"],
)
