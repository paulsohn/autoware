load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@autoware_agnocast_wrapper//:defs.bzl", "autoware_agnocast_node")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_pipeline_latency_monitor",
    srcs = glob(["src/**/*.cpp"]),
    hdrs = glob(["src/**/*.hpp"]),
    includes = ["src"],
    deps = [
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper_library",
        "@autoware_control_msgs//:cc",
        "@autoware_internal_debug_msgs//:cc",
        "@autoware_planning_msgs//:cc",
        "@autoware_planning_validator//:cc",
        "@autoware_utils_debug",
        "@diagnostic_msgs//:cc",
        "@diagnostic_updater//:diagnostic_updater_library",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
        "@std_msgs//:cc",
        "@tier4_debug_msgs//:cc",
        "@tier4_metric_msgs//:cc",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper",
        "@autoware_control_msgs//:cc_shared",
        "@autoware_internal_debug_msgs//:cc_shared",
        "@autoware_planning_msgs//:cc_shared",
        "@autoware_planning_validator//:cc_shared",
        "@autoware_utils_debug//:runtime_dynamic_deps",
        "@diagnostic_msgs//:cc_shared",
        "@diagnostic_updater//:diagnostic_updater",
        "@rclcpp//:rclcpp",
        "@rclcpp_components//:rclcpp_components",
        "@std_msgs//:cc_shared",
        "@tier4_debug_msgs//:cc_shared",
        "@tier4_metric_msgs//:cc_shared",
    ],
)

cc_shared_library(
    name = "autoware_pipeline_latency_monitor_component",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":autoware_pipeline_latency_monitor"],
)

autoware_agnocast_node(
    name = "autoware_pipeline_latency_monitor_node",
    package_name = "autoware_pipeline_latency_monitor",
    component = ":autoware_pipeline_latency_monitor_component",
    plugin = "autoware::system::pipeline_latency_monitor::PipelineLatencyMonitorNode",
    agnocast_only = True,
)

register_ament_files(
    name = "node_executables",
    files = [":autoware_pipeline_latency_monitor_node"],
    prefix = "lib/autoware_pipeline_latency_monitor",
    strip_prefix = "*",
)

ament_index(
    package_xml = "package.xml",
    data = glob(["config/**", "launch/**"]) + [":autoware_pipeline_latency_monitor_node_plugin", ":node_executables"],
    components = [":autoware_pipeline_latency_monitor_node_components"],
)
