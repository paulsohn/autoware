load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@autoware_agnocast_wrapper//:defs.bzl", "autoware_agnocast_node")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_processing_time_checker",
    srcs = glob(["src/**/*.cpp"]),
    hdrs = glob(["src/**/*.hpp"]),
    includes = ["src"],
    deps = [
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper_library",
        "@autoware_internal_debug_msgs//:cc",
        "@autoware_utils",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
        "@rosdistro//cc:nlohmann_json",
        "@tier4_metric_msgs//:cc",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper",
        "@autoware_internal_debug_msgs//:cc_shared",
        "@rclcpp//:rclcpp",
        "@rclcpp_components//:rclcpp_components",
        "@tier4_metric_msgs//:cc_shared",
    ],
)

cc_shared_library(
    name = "autoware_processing_time_checker_component",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":autoware_processing_time_checker"],
)

autoware_agnocast_node(
    name = "processing_time_checker_node",
    package_name = "autoware_processing_time_checker",
    component = ":autoware_processing_time_checker_component",
    plugin = "autoware::processing_time_checker::ProcessingTimeChecker",
    agnocast_only = True,
)

register_ament_files(
    name = "node_executables",
    files = [":processing_time_checker_node"],
    prefix = "lib/autoware_processing_time_checker",
    strip_prefix = "*",
)

ament_index(
    package_xml = "package.xml",
    data = glob(["config/**", "launch/**"]) + [":processing_time_checker_node_plugin", ":node_executables"],
    components = [":processing_time_checker_node_components"],
)
