load("@qt//:qt.bzl", "qt_cc_library", "qt_cc_shared_library")
load("@rosdistro//ament:defs.bzl", "ament_index")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")

package(default_visibility = ["//visibility:public"])

qt_cc_library(
    name = "tier4_state_rviz_plugin_library",
    moc_hdrs = [
        "src/include/autoware_state_panel.hpp",
        "src/include/custom_button.hpp",
        "src/include/custom_container.hpp",
        "src/include/custom_icon_label.hpp",
        "src/include/custom_label.hpp",
        "src/include/custom_segmented_button.hpp",
        "src/include/custom_segmented_button_item.hpp",
        "src/include/custom_slider.hpp",
        "src/include/custom_toggle_switch.hpp",
        "src/include/velocity_steering_factors_panel.hpp",
    ],
    srcs = glob(["src/**/*.cpp"]),
    hdrs = glob(["include/**/*.hpp", "src/**/*.hpp"], allow_empty = True),
    includes = ["src"],
    defines = ["PLUGINLIB__DISABLE_BOOST_FUNCTIONS", "QT_NO_KEYWORDS"],
    deps = [
        "@ament_index_cpp//:ament_index_cpp_library",
        "@autoware_adapi_v1_msgs//:cc",
        "@autoware_internal_planning_msgs//:cc",
        "@autoware_motion_utils",
        "@autoware_vehicle_msgs//:cc",
        "@diagnostic_msgs//:cc",
        "@geometry_msgs//:cc",
        "@nav_msgs//:cc",
        "@pluginlib//:pluginlib_library",
        "@qtbase//:widgets",
        "@rclcpp//:rclcpp_library",
        "@rosdistro//cc:OgreMain_library",
        "@rosdistro//cc:OgreOverlay_library",
        "@rosdistro//cc:boost.geometry",
        "@rosdistro//cc:eigen",
        "@rviz_common//:rviz_common_library",
        "@tier4_control_msgs//:cc",
        "@tier4_external_api_msgs//:cc",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@ament_index_cpp//:ament_index_cpp",
        "@autoware_adapi_v1_msgs//:cc_shared",
        "@autoware_internal_planning_msgs//:cc_shared",
        "@autoware_motion_utils//:runtime_dynamic_deps",
        "@autoware_vehicle_msgs//:cc_shared",
        "@diagnostic_msgs//:cc_shared",
        "@geometry_msgs//:cc_shared",
        "@nav_msgs//:cc_shared",
        "@pluginlib//:pluginlib",
        "@rclcpp//:rclcpp",
        "@rosdistro//cc:OgreMain",
        "@rosdistro//cc:OgreOverlay",
        "@rviz_common//:rviz_common",
        "@tier4_control_msgs//:cc_shared",
        "@tier4_external_api_msgs//:cc_shared",
    ],
)

qt_cc_shared_library(
    name = "tier4_state_rviz_plugin",
    shared_lib_name = "libtier4_state_rviz_plugin.so",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":tier4_state_rviz_plugin_library"],
)

ament_index(
    package_xml = "package.xml",
    data = glob(["icons/**", "images/**", "plugins/**"]),
    libraries = [":tier4_state_rviz_plugin"],
    deps = ["@rviz_common//:ament_index"],
    plugin_categories = {"plugins/plugin_description.xml": "rviz_common"},
)
