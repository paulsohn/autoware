load("@autoware_agnocast_wrapper//:defs.bzl", "autoware_agnocast_node")
load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_pose_instability_detector_library",
    srcs = ["src/pose_instability_detector.cpp"],
    hdrs = ["include/autoware/pose_instability_detector/pose_instability_detector.hpp"],
    includes = ["include"],
    deps = ["@autoware_agnocast_wrapper//:autoware_agnocast_wrapper_library", "@autoware_utils_geometry", "@diagnostic_msgs//:cc", "@geometry_msgs//:cc", "@nav_msgs//:cc", "@rclcpp_components//:rclcpp_components_library", "@tf2_geometry_msgs//:tf2_geometry_msgs_library"],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = ["@autoware_agnocast_wrapper", "@diagnostic_msgs//:cc_shared", "@geometry_msgs//:cc_shared", "@nav_msgs//:cc_shared", "@rclcpp_components//:rclcpp_components", "@tf2_geometry_msgs//:tf2_geometry_msgs"],
)

cc_shared_library(
    name = "autoware_pose_instability_detector",
    shared_lib_name = "libautoware_pose_instability_detector.so",
    deps = [":autoware_pose_instability_detector_library"],
    dynamic_deps = [":runtime_dynamic_deps"],
)

autoware_agnocast_node(
    name = "autoware_pose_instability_detector_node",
    component = ":autoware_pose_instability_detector",
    plugin = "autoware::pose_instability_detector::PoseInstabilityDetector",
    package_name = "autoware_pose_instability_detector",
)

register_ament_files(
    name = "executables",
    files = [":autoware_pose_instability_detector_node"],
    prefix = "lib/autoware_pose_instability_detector",
    strip_prefix = "*",
)

ament_index(
    package_xml = "package.xml",
    libraries = [":autoware_pose_instability_detector"],
    components = [":autoware_pose_instability_detector_node_components"],
    data = glob(["launch/**", "config/**"]) + [":executables", ":autoware_pose_instability_detector_node_plugin"],
)

cc_test(
    name = "test_autoware_pose_instability_detector",
    srcs = ["test/test.cpp", "test/test_message_helper_node.hpp"],
    deps = [":autoware_pose_instability_detector_library", "@ament_index_cpp//:ament_index_cpp_library", "@rcl_yaml_param_parser//:rcl_yaml_param_parser_library", "@googletest//:gtest"],
    dynamic_deps = [":runtime_dynamic_deps", "@ament_index_cpp//:ament_index_cpp", "@rcl_yaml_param_parser//:rcl_yaml_param_parser"],
    data = [":ament_index"],
    tags = ["no-sandbox", "no-remote"],
)
