load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_pose_estimator_arbiter_library",
    srcs = ["src/pose_estimator_arbiter_core.cpp", "src/switch_rule/enable_all_rule.cpp"],
    hdrs = ["src/pose_estimator_arbiter.hpp", "src/pose_estimator_type.hpp", "src/shared_data.hpp", "src/stopper/base_stopper.hpp", "src/stopper/stopper_artag.hpp", "src/stopper/stopper_eagleye.hpp", "src/stopper/stopper_lidar_marker.hpp", "src/stopper/stopper_ndt.hpp", "src/stopper/stopper_yabloc.hpp", "src/switch_rule/base_switch_rule.hpp", "src/switch_rule/enable_all_rule.hpp"],
    includes = ["src"],
    deps = ["@autoware_adapi_v1_msgs//:cc", "@autoware_lanelet2_utils", "@autoware_map_msgs//:cc", "@autoware_qos_utils", "@autoware_utils_logging", "@autoware_utils_rclcpp", "@diagnostic_msgs//:cc", "@geometry_msgs//:cc", "@pcl_conversions//:pcl_conversions_library", "@rclcpp_components//:rclcpp_components_library", "@sensor_msgs//:cc", "@std_msgs//:cc", "@std_srvs//:cc", "@visualization_msgs//:cc", "@rosdistro//cc:magic_enum", "@rosdistro//cc:pcl_common"],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = ["@autoware_adapi_v1_msgs//:cc_shared", "@autoware_lanelet2_utils//:runtime_dynamic_deps", "@autoware_map_msgs//:cc_shared", "@diagnostic_msgs//:cc_shared", "@geometry_msgs//:cc_shared", "@logging_demo//:cc_shared", "@pcl_conversions//:pcl_conversions", "@rclcpp_components//:rclcpp_components", "@rcutils//:rcutils", "@sensor_msgs//:cc_shared", "@std_msgs//:cc_shared", "@std_srvs//:cc_shared", "@visualization_msgs//:cc_shared", "@rosdistro//cc:pcl"],
)

cc_shared_library(
    name = "autoware_pose_estimator_arbiter",
    shared_lib_name = "libautoware_pose_estimator_arbiter.so",
    deps = [":autoware_pose_estimator_arbiter_library"],
    dynamic_deps = [":runtime_dynamic_deps"],
)

rclcpp_components_register_node(
    name = "autoware_pose_estimator_arbiter_node",
    component = ":autoware_pose_estimator_arbiter",
    plugin = "autoware::pose_estimator_arbiter::PoseEstimatorArbiter",
    node_name = "autoware_pose_estimator_arbiter_node",
    executor = "MultiThreadedExecutor",
)

register_ament_files(
    name = "executables",
    files = [":autoware_pose_estimator_arbiter_node"],
    prefix = "lib/autoware_pose_estimator_arbiter",
    strip_prefix = "*",
)

ament_index(
    package_xml = "package.xml",
    libraries = [":autoware_pose_estimator_arbiter", ":example_rule"],
    components = [":autoware_pose_estimator_arbiter_node_record"],
    data = glob(["launch/**"]) + [":executables"],
)
cc_library(
    name = "example_rule_library",
    srcs = ["example_rule/src/rule_helper/pcd_occupancy.cpp", "example_rule/src/rule_helper/pose_estimator_area.cpp", "example_rule/src/switch_rule/pcd_map_based_rule.cpp", "example_rule/src/switch_rule/vector_map_based_rule.cpp"],
    hdrs = ["example_rule/src/rule_helper/grid_key.hpp", "example_rule/src/rule_helper/pcd_occupancy.hpp", "example_rule/src/rule_helper/pose_estimator_area.hpp", "example_rule/src/switch_rule/pcd_map_based_rule.hpp", "example_rule/src/switch_rule/vector_map_based_rule.hpp"],
    includes = ["example_rule/src"],
    deps = [":autoware_pose_estimator_arbiter_library", "@rosdistro//cc:boost.geometry"],
)

cc_shared_library(
    name = "example_rule",
    shared_lib_name = "libexample_rule.so",
    deps = [":example_rule_library"],
    dynamic_deps = [":runtime_dynamic_deps", ":autoware_pose_estimator_arbiter"],
)

cc_test(
    name = "test_shared_data",
    srcs = ["test/test_shared_data.cpp"],
    deps = [":autoware_pose_estimator_arbiter_library", "@googletest//:gtest_main"],
    dynamic_deps = [":runtime_dynamic_deps"],
    tags = ["no-sandbox", "no-remote"],
)

cc_test(
    name = "test_rule_helper",
    srcs = ["example_rule/test/test_rule_helper.cpp"],
    deps = [":example_rule_library", "@googletest//:gtest_main"],
    dynamic_deps = [":runtime_dynamic_deps"],
    tags = ["no-sandbox", "no-remote"],
)

cc_test(
    name = "test_vector_map_based_rule",
    srcs = ["example_rule/test/test_vector_map_based_rule.cpp"],
    deps = [":example_rule_library", "@googletest//:gtest_main"],
    dynamic_deps = [":runtime_dynamic_deps"],
    tags = ["no-sandbox", "no-remote"],
)

cc_test(
    name = "test_pcd_map_based_rule",
    srcs = ["example_rule/test/test_pcd_map_based_rule.cpp"],
    deps = [":example_rule_library", "@googletest//:gtest_main"],
    dynamic_deps = [":runtime_dynamic_deps"],
    tags = ["no-sandbox", "no-remote"],
)


exports_files(["test/test_pose_estimator_arbiter.py"])
