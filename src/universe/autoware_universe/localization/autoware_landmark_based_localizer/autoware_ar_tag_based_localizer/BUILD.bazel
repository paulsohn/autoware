load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_ar_tag_based_localizer_library",
    srcs = ["src/ar_tag_based_localizer.cpp"],
    hdrs = ["src/ar_tag_based_localizer.hpp"],
    includes = ["src"],
    deps = ["@aruco//:aruco_library", "@autoware_landmark_manager//:autoware_landmark_manager_library", "@autoware_localization_util", "@autoware_utils_geometry", "@cv_bridge//:cv_bridge_library", "@diagnostic_msgs//:cc", "@rclcpp_components//:rclcpp_components_library", "@sensor_msgs//:cc", "@tf2_eigen//:tf2_eigen_library", "@tf2_geometry_msgs//:tf2_geometry_msgs_library", "@tf2_ros//:tf2_ros_library", "@visualization_msgs//:cc", "@rosdistro//cc:opencv_library"],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = ["@aruco//:aruco", "@autoware_landmark_manager", "@autoware_landmark_manager//:runtime_dynamic_deps", "@cv_bridge//:cv_bridge", "@diagnostic_msgs//:cc_shared", "@rclcpp_components//:rclcpp_components", "@sensor_msgs//:cc_shared", "@tf2_eigen//:tf2_eigen", "@tf2_geometry_msgs//:tf2_geometry_msgs", "@tf2_ros//:tf2_ros", "@visualization_msgs//:cc_shared", "@rosdistro//cc:opencv"],
)

cc_shared_library(
    name = "autoware_ar_tag_based_localizer",
    shared_lib_name = "libautoware_ar_tag_based_localizer.so",
    deps = [":autoware_ar_tag_based_localizer_library"],
    dynamic_deps = [":runtime_dynamic_deps"],
)

rclcpp_components_register_node(
    name = "autoware_ar_tag_based_localizer_node",
    component = ":autoware_ar_tag_based_localizer",
    plugin = "ArTagBasedLocalizer",
    node_name = "autoware_ar_tag_based_localizer_node",
)

register_ament_files(
    name = "executables",
    files = [":autoware_ar_tag_based_localizer_node"],
    prefix = "lib/autoware_ar_tag_based_localizer",
    strip_prefix = "*",
)

ament_index(
    package_xml = "package.xml",
    libraries = [":autoware_ar_tag_based_localizer"],
    components = [":autoware_ar_tag_based_localizer_node_record"],
    data = glob(["launch/**", "config/**"]) + [":executables"],
)

cc_test(
    name = "test_autoware_ar_tag_based_localizer",
    srcs = ["test/test.cpp"],
    deps = [":autoware_ar_tag_based_localizer_library", "@ament_index_cpp//:ament_index_cpp_library", "@rcl_yaml_param_parser//:rcl_yaml_param_parser_library", "@googletest//:gtest"],
    dynamic_deps = [":runtime_dynamic_deps", "@ament_index_cpp//:ament_index_cpp", "@rcl_yaml_param_parser//:rcl_yaml_param_parser"],
    data = [":ament_index"],
    tags = ["no-sandbox", "no-remote"],
)
