load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_landmark_manager_library",
    srcs = ["src/landmark_manager.cpp"],
    hdrs = ["include/autoware/landmark_manager/landmark_manager.hpp"],
    includes = ["include", "src"],
    deps = ["@autoware_lanelet2_extension//:autoware_lanelet2_extension_lib_library", "@autoware_localization_util", "@autoware_map_msgs//:cc", "@autoware_utils_geometry", "@geometry_msgs//:cc", "@rclcpp//:rclcpp_library", "@tf2_eigen//:tf2_eigen_library", "@visualization_msgs//:cc"],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = ["@autoware_lanelet2_extension//:autoware_lanelet2_extension_lib", "@autoware_utils//:runtime_dynamic_deps", "@autoware_map_msgs//:cc_shared", "@geometry_msgs//:cc_shared", "@rclcpp//:rclcpp", "@tf2_eigen//:tf2_eigen", "@visualization_msgs//:cc_shared"],
)

cc_shared_library(
    name = "autoware_landmark_manager",
    shared_lib_name = "liblandmark_manager.so",
    deps = [":autoware_landmark_manager_library"],
    dynamic_deps = [":runtime_dynamic_deps"],
)

ament_index(
    package_xml = "package.xml",
    libraries = [":autoware_landmark_manager"],
    data = [],
)
