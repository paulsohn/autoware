load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_cuda//cuda:defs.bzl", "cuda_library")
load("@tensorrt//:defs.bzl", "tensorrt_cc_binary")

package(default_visibility = ["//visibility:public"])

_GPU_HEADERS = ["include/autoware/lidar_frnet/point_type.hpp", "include/autoware/lidar_frnet/utils.hpp", "include/autoware/lidar_frnet/preprocess_kernel.hpp", "include/autoware/lidar_frnet/postprocess_kernel.hpp"]

cuda_library(
    name = "kernels",
    srcs = glob(["lib/**/*.cu"]),
    hdrs = _GPU_HEADERS,
    includes = ["include"],
    copts = ["-std=c++17", "--expt-relaxed-constexpr", "--extended-lambda", "-diag-suppress=1675"],
    deps = ["@autoware_cuda_utils", "@cuda//:libcudacxx"],
)

cc_shared_library(
    name = "autoware_lidar_frnet_cuda_lib",
    shared_lib_name = "libautoware_lidar_frnet_cuda_lib.so",
    deps = [":kernels"],
)

cc_library(
    name = "library",
    srcs = ["lib/lidar_frnet.cpp"],
    hdrs = glob(["include/**/*.hpp"], exclude = _GPU_HEADERS + ["include/autoware/lidar_frnet/lidar_frnet_node.hpp"]),
    includes = ["include"],
    deps = [":kernels", "@autoware_cuda_utils", "@autoware_point_types", "@autoware_tensorrt_common//:autoware_tensorrt_common_library", "@autoware_utils", "@cuda_blackboard", "@geometry_msgs//:cc", "@sensor_msgs//:cc", "@visualization_msgs//:cc"],
)

collect_transitive_dynamic_deps(
    name = "sdk_dynamic_deps",
    dynamic_deps = ["@autoware_internal_debug_msgs//:cc_shared", "@autoware_tensorrt_common", "@autoware_utils//:runtime_dynamic_deps", "@cuda_blackboard//:cuda_blackboard_shared", "@cuda_blackboard//:runtime_dynamic_deps", "@diagnostic_updater//:diagnostic_updater", "@geometry_msgs//:cc_shared", "@rclcpp_components//:rclcpp_components", "@sensor_msgs//:cc_shared", "@tf2_eigen//:tf2_eigen", "@tf2_ros//:tf2_ros", "@visualization_msgs//:cc_shared", "@rosdistro//cc:pcl"],
)

cc_shared_library(
    name = "autoware_lidar_frnet_lib",
    shared_lib_name = "libautoware_lidar_frnet_lib.so",
    deps = [":library"],
    dynamic_deps = [":autoware_lidar_frnet_cuda_lib", ":sdk_dynamic_deps"],
)

cc_library(
    name = "node_library",
    srcs = ["src/lidar_frnet_node.cpp"],
    hdrs = ["include/autoware/lidar_frnet/lidar_frnet_node.hpp"],
    includes = ["include"],
    deps = [":library", "@autoware_internal_debug_msgs//:cc", "@diagnostic_updater//:diagnostic_updater_library", "@rclcpp_components//:rclcpp_components_library", "@tf2_eigen//:tf2_eigen_library", "@tf2_ros//:tf2_ros_library"],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [":autoware_lidar_frnet_cuda_lib", ":autoware_lidar_frnet_lib", ":sdk_dynamic_deps"],
)

cc_shared_library(
    name = "autoware_lidar_frnet_component",
    shared_lib_name = "libautoware_lidar_frnet_component.so",
    deps = [":node_library"],
    dynamic_deps = [":runtime_dynamic_deps"],
)

rclcpp_components_register_node(
    name = "frnet_native",
    node_name = "autoware_lidar_frnet_node",
    component = ":autoware_lidar_frnet_component",
    plugin = "autoware::lidar_frnet::LidarFRNetNode",
)

tensorrt_cc_binary(
    name = "autoware_lidar_frnet_node",
    srcs = [":frnet_native_main.cpp"],
    deps = ["@rclcpp_components//:rclcpp_components_library"],
    dynamic_deps = [":autoware_lidar_frnet_component", ":runtime_dynamic_deps"],
)

register_ament_files(
    name = "executables",
    files = [":autoware_lidar_frnet_node"],
    prefix = "lib/autoware_lidar_frnet",
    strip_prefix = "*",
)

ament_index(
    package_xml = "package.xml",
    libraries = [":autoware_lidar_frnet_cuda_lib", ":autoware_lidar_frnet_lib", ":autoware_lidar_frnet_component"],
    components = [":frnet_native_record"],
    data = glob(["config/**", "launch/**"]) + [":executables"],
    deps = ["@autoware_lidar_frnet_models//:ament_index"],
)

exports_files(["launch/lidar_frnet.launch.xml", "config/frnet.param.yaml", "package.xml"])
