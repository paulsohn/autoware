load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_elevation_map_loader_library",
    srcs = ["src/elevation_map_loader_node.cpp"],
    hdrs = ["src/elevation_map_loader_node.hpp"],
    includes = ["src"],
    deps = [
        "@autoware_grid_map_utils",
        "@autoware_lanelet2_extension//:autoware_lanelet2_extension_lib_library",
        "@autoware_lanelet2_utils",
        "@autoware_map_msgs//:cc",
        "@autoware_qos_utils",
        "@autoware_utils",
        "@filters//:filter_chain",
        "@grid_map//:grid_map_pcl",
        "@grid_map//:grid_map_ros",
        "@grid_map//:grid_map_cv",
        "@pcl_conversions//:pcl_conversions_library",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
        "@rosbag2_storage_sqlite3//:rosbag2_storage_sqlite3_library",
        "@sensor_msgs//:cc",
        "@tier4_external_api_msgs//:cc",
        "@rosdistro//cc:pcl_io",
        "@rosdistro//cc:pcl_filters",
        "@rosdistro//cc:boost.iostreams",
        "@rosdistro//cc:opencv_library",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_grid_map_utils//:runtime_dynamic_deps",
        "@autoware_lanelet2_utils//:runtime_dynamic_deps",
        "@autoware_map_msgs//:cc_shared",
        "@autoware_utils//:runtime_dynamic_deps",
        "@grid_map//:grid_map_pcl_runtime_dynamic_deps",
        "@grid_map//:grid_map_cv_runtime_dynamic_deps",
        "@pcl_conversions//:pcl_conversions",
        "@rclcpp_components//:rclcpp_components",
        "@rosbag2_storage_sqlite3//:rosbag2_storage_sqlite3",
        "@sensor_msgs//:cc_shared",
        "@tier4_external_api_msgs//:cc_shared",
        "@rosdistro//cc:boost.iostreams_shared",
    ],
)

cc_shared_library(
    name = "autoware_elevation_map_loader",
    shared_lib_name = "libautoware_elevation_map_loader.so",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":autoware_elevation_map_loader_library"],
)

rclcpp_components_register_node(
    name = "elevation_map_loader_node",
    node_name = "elevation_map_loader_node",
    component = ":autoware_elevation_map_loader",
    plugin = "autoware::elevation_map_loader::ElevationMapLoaderNode",
)

register_ament_files(
    name = "executables",
    files = [":elevation_map_loader_node"],
    prefix = "lib/autoware_elevation_map_loader",
    strip_prefix = "*",
)

ament_index(
    package_xml = "package.xml",
    components = [":elevation_map_loader_node_record"],
    data = glob(["config/**", "launch/**", "data/**"]) + [":executables"],
    deps = ["@grid_map//:grid_map_pcl_index", "@rosbag2_storage_sqlite3//:ament_index"],
    libraries = [":autoware_elevation_map_loader"],
)

exports_files(glob(["config/*.yaml"]))
