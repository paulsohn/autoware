load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_cuda//cuda:defs.bzl", "cuda_library")
load("@tensorrt//:defs.bzl", "tensorrt_cc_binary")

package(default_visibility = ["//visibility:public"])

_GPU_HEADERS = glob([
    "include/**/bevfusion_config.hpp",
    "include/**/utils.hpp",
    "include/**/preprocess/point_type.hpp",
    "include/**/preprocess/preprocess_kernel.hpp",
    "include/**/postprocess/*.hpp",
    "include/**/camera/camera_preprocess.hpp",
])

cuda_library(
    name = "kernels",
    srcs = glob(
        ["lib/**/*.cu"],
        exclude = ["lib/preprocess/preprocess_kernel.cu"],
    ),
    hdrs = _GPU_HEADERS,
    copts = [
        "-std=c++17",
        "--expt-relaxed-constexpr",
        "--extended-lambda",
        "-diag-suppress=1675",
    ],
    includes = ["include"],
    deps = [
        ":voxelization",
        "@autoware_cuda_utils",
        "@cuda//:cuda_runtime",
        "@cuda//:libcudacxx",
    ],
)

cuda_library(
    name = "voxelization",
    srcs = ["lib/preprocess/preprocess_kernel.cu"],
    hdrs = _GPU_HEADERS,
    copts = [
        "-std=c++17",
        "-Xcompiler=-fvisibility-inlines-hidden",
        "--expt-relaxed-constexpr",
        "--extended-lambda",
        "-include",
        "spconv/point2voxel_compat.hpp",
    ],
    includes = ["include"],
    deps = [
        "@autoware_cuda_utils",
        "@spconv//:point2voxel_compat",
    ],
)

cc_shared_library(
    name = "autoware_bevfusion_cuda_lib",
    dynamic_deps = ["@spconv//:point2voxel_bridge"],
    shared_lib_name = "libautoware_bevfusion_cuda_lib.so",
    deps = [
        ":kernels",
        ":voxelization",
    ],
)

cc_library(
    name = "library",
    srcs = glob(["lib/**/*.cpp"]),
    hdrs = glob(
        ["include/**/*.hpp"],
        exclude = _GPU_HEADERS + ["include/autoware/bevfusion/bevfusion_node.hpp"],
    ),
    copts = [
        "-Wno-deprecated-declarations",
        "-fvisibility-inlines-hidden",
    ],
    includes = ["include"],
    deps = [
        ":kernels",
        "@autoware_object_recognition_utils",
        "@autoware_perception_msgs//:cc",
        "@autoware_point_types",
        "@autoware_tensorrt_common//:autoware_tensorrt_common_library",
        "@autoware_utils_debug",
        "@autoware_utils_diagnostics",
        "@autoware_utils_geometry",
        "@autoware_utils_math",
        "@autoware_utils_system",
        "@cuda_blackboard",
        "@pcl_conversions//:pcl_conversions_library",
        "@pcl_ros//:pcl_ros_tf_library",
        "@rosdistro//cc:opencv_library",
        "@rosdistro//cc:pcl_common",
        "@tf2_eigen//:tf2_eigen_library",
        "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
        "@tf2_ros//:tf2_ros_library",
        "@tf2_sensor_msgs//:tf2_sensor_msgs_library",
    ],
)

collect_transitive_dynamic_deps(
    name = "sdk_dynamic_deps",
    dynamic_deps = [
        "@autoware_internal_debug_msgs//:cc_shared",
        "@autoware_object_recognition_utils//:runtime_dynamic_deps",
        "@autoware_perception_msgs//:cc_shared",
        "@autoware_tensorrt_common",
        "@autoware_utils_debug//:runtime_dynamic_deps",
        "@cuda_blackboard//:cuda_blackboard_shared",
        "@cuda_blackboard//:runtime_dynamic_deps",
        "@diagnostic_updater//:diagnostic_updater",
        "@pcl_conversions//:pcl_conversions",
        "@pcl_ros//:pcl_ros_tf",
        "@perception_utils",
        "@perception_utils//:runtime_dynamic_deps",
        "@rclcpp_components//:rclcpp_components",
        "@tf2_eigen//:tf2_eigen",
        "@tf2_geometry_msgs//:tf2_geometry_msgs",
        "@tf2_ros//:tf2_ros",
        "@tf2_sensor_msgs//:tf2_sensor_msgs",
        "@rosdistro//cc:pcl",
        "@rosdistro//cc:opencv",
    ],
)

cc_shared_library(
    name = "autoware_bevfusion_lib",
    dynamic_deps = [
        ":autoware_bevfusion_cuda_lib",
        ":sdk_dynamic_deps",
    ],
    shared_lib_name = "libautoware_bevfusion_lib.so",
    deps = [":library"],
)

cc_library(
    name = "node_library",
    srcs = glob(["src/*.cpp"]),
    hdrs = ["include/autoware/bevfusion/bevfusion_node.hpp"],
    copts = ["-fvisibility-inlines-hidden"],
    includes = ["include"],
    deps = [
        ":library",
        "@autoware_internal_debug_msgs//:cc",
        "@diagnostic_updater//:diagnostic_updater_library",
        "@image_transport//:image_transport_library",
        "@perception_utils//:perception_utils_library",
        "@rclcpp_components//:rclcpp_components_library",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        ":autoware_bevfusion_cuda_lib",
        ":autoware_bevfusion_lib",
        ":sdk_dynamic_deps",
        "@image_transport//:image_transport",
        "@image_transport//:transitive_dynamic_deps",
    ],
)

cc_shared_library(
    name = "autoware_bevfusion_component",
    dynamic_deps = [":runtime_dynamic_deps"],
    shared_lib_name = "libautoware_bevfusion_component.so",
    deps = [":node_library"],
)

rclcpp_components_register_node(
    name = "bevfusion_native",
    component = ":autoware_bevfusion_component",
    node_name = "autoware_bevfusion_node",
    plugin = "autoware::bevfusion::BEVFusionNode",
)

tensorrt_cc_binary(
    name = "autoware_bevfusion_node",
    srcs = [":bevfusion_native_main.cpp"],
    data = ["@autoware_tensorrt_plugins//:plugins"],
    dynamic_deps = [
        ":autoware_bevfusion_component",
        ":runtime_dynamic_deps",
    ],
    libstdcxx_runtime = "@spconv//:gnu_runtime",
    runtime_libraries = ["@spconv//:runtime_library"],
    deps = ["@rclcpp_components//:rclcpp_components_library"],
)

register_ament_files(
    name = "executables",
    files = [":autoware_bevfusion_node"],
    prefix = "lib/autoware_bevfusion",
    strip_prefix = "*",
)

ament_index(
    components = [":bevfusion_native_record"],
    data = glob([
        "config/**",
        "launch/**",
    ]) + [":executables"],
    libraries = [
        ":autoware_bevfusion_cuda_lib",
        ":autoware_bevfusion_lib",
        ":autoware_bevfusion_component",
    ],
    package_xml = "package.xml",
    deps = [
        "@autoware_bevfusion_models//:ament_index",
        "@autoware_tensorrt_plugins//:ament_index",
        "@image_transport//:ament_index_plugin",
    ],
)

exports_files(glob([
    "launch/*",
    "config/*",
]) + ["package.xml"])
