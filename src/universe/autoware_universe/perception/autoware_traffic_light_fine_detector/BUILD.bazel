load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@tensorrt//:defs.bzl", "tensorrt_cc_binary")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "fine_detector_library",
    srcs = ["src/traffic_light_fine_detector_node.cpp", "src/traffic_light_fine_detector_process.cpp"],
    hdrs = ["src/traffic_light_fine_detector_node.hpp", "src/traffic_light_fine_detector_process.hpp"],
    includes = ["src"],
    deps = ["@autoware_internal_debug_msgs//:cc", "@autoware_tensorrt_yolox//:autoware_tensorrt_yolox_library", "@cv_bridge//:cv_bridge_library", "@image_transport//:image_transport_library", "@message_filters//:message_filters_library", "@rclcpp_components//:rclcpp_components_library", "@rosdistro//cc:opencv_library", "@tier4_perception_msgs//:cc"],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = ["@autoware_internal_debug_msgs//:cc_shared", "@autoware_tensorrt_yolox", "@autoware_tensorrt_yolox//:gpu_preprocess", "@autoware_tensorrt_yolox//:runtime_dynamic_deps", "@cv_bridge//:cv_bridge", "@image_transport//:image_transport", "@message_filters//:message_filters", "@rclcpp_components//:rclcpp_components", "@sensor_msgs//:cc_shared", "@tier4_perception_msgs//:cc_shared", "@rosdistro//cc:opencv"],
)

cc_shared_library(
    name = "autoware_traffic_light_fine_detector",
    shared_lib_name = "libautoware_traffic_light_fine_detector.so",
    deps = [":fine_detector_library"],
    dynamic_deps = [":runtime_dynamic_deps"],
)

rclcpp_components_register_node(
    name = "traffic_light_fine_detector_native",
    node_name = "traffic_light_fine_detector_node",
    component = ":autoware_traffic_light_fine_detector",
    plugin = "autoware::traffic_light::TrafficLightFineDetectorNode",
)

tensorrt_cc_binary(
    name = "traffic_light_fine_detector_node",
    srcs = [":traffic_light_fine_detector_native_main.cpp"],
    deps = ["@rclcpp_components//:rclcpp_components_library"],
    dynamic_deps = [":autoware_traffic_light_fine_detector", ":runtime_dynamic_deps"],
)

register_ament_files(
    name = "executables",
    files = [":traffic_light_fine_detector_node"],
    prefix = "lib/autoware_traffic_light_fine_detector",
    strip_prefix = "*",
)

ament_index(
    package_xml = "package.xml",
    libraries = [":autoware_traffic_light_fine_detector"],
    components = [":traffic_light_fine_detector_native_record"],
    data = glob(["config/**", "launch/**"]) + [":executables", "@image_transport//:ament_index_plugin"],
    deps = ["@autoware_traffic_light_fine_detector_models//:ament_index"],
)

cc_test(
    name = "test_utils",
    srcs = ["test/test_utils.cpp"],
    deps = [":fine_detector_library", "@googletest//:gtest"],
    dynamic_deps = [":autoware_traffic_light_fine_detector", ":runtime_dynamic_deps"],
    data = [":ament_index"],
    tags = ["no-sandbox", "no-remote"],
)

exports_files(["launch/traffic_light_fine_detector.launch.xml"])
