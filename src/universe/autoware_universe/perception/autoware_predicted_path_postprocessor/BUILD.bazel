load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_predicted_path_postprocessor_library",
    srcs = glob(["src/**/*.cpp"]),
    hdrs = glob(["include/**/*.hpp"]),
    includes = ["include"],
    deps = [
        "@ament_index_cpp//:ament_index_cpp_library",
        "@autoware_internal_debug_msgs//:cc",
        "@autoware_interpolation",
        "@autoware_lanelet2_utils",
        "@autoware_map_msgs//:cc",
        "@autoware_perception_msgs//:cc",
        "@autoware_utils_debug",
        "@autoware_utils_geometry",
        "@autoware_utils_system",
        "@geometric_shapes//:geometric_shapes_library",
        "@lanelet2_core//:lanelet2_core_library",
        "@lanelet2_routing//:lanelet2_routing_library",
        "@lanelet2_traffic_rules//:lanelet2_traffic_rules_library",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
        "@tf2_eigen//:tf2_eigen_library",
        "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
        "@unique_identifier_msgs//:cc",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@ament_index_cpp//:ament_index_cpp",
        "@autoware_internal_debug_msgs//:cc_shared",
        "@autoware_lanelet2_utils//:runtime_dynamic_deps",
        "@autoware_map_msgs//:cc_shared",
        "@autoware_perception_msgs//:cc_shared",
        "@autoware_utils_debug//:runtime_dynamic_deps",
        "@geometric_shapes//:geometric_shapes",
        "@lanelet2_core//:lanelet2_core",
        "@lanelet2_routing//:lanelet2_routing",
        "@lanelet2_traffic_rules//:lanelet2_traffic_rules",
        "@rclcpp_components//:rclcpp_components",
        "@tf2_eigen//:tf2_eigen",
        "@tf2_geometry_msgs//:tf2_geometry_msgs",
        "@unique_identifier_msgs//:cc_shared",
    ],
)

cc_shared_library(
    name = "autoware_predicted_path_postprocessor",
    shared_lib_name = "libautoware_predicted_path_postprocessor.so",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":autoware_predicted_path_postprocessor_library"],
)

rclcpp_components_register_node(
    name = "autoware_predicted_path_postprocessor_exe",
    node_name = "autoware_predicted_path_postprocessor",
    component = ":autoware_predicted_path_postprocessor",
    plugin = "autoware::predicted_path_postprocessor::PredictedPathPostprocessorNode",
)

register_ament_files(
    name = "executables",
    files = [":autoware_predicted_path_postprocessor_exe"],
    prefix = "lib/autoware_predicted_path_postprocessor",
    strip_prefix = "*",
)

ament_index(
    package_xml = "package.xml",
    components = [":autoware_predicted_path_postprocessor_exe_record"],
    data = glob(["config/**", "launch/**"]) + [":executables"],
    libraries = [":autoware_predicted_path_postprocessor"],
)

cc_test(
    name = "test_autoware_predicted_path_postprocessor",
    srcs = glob(["test/*.cpp"]),
    data = [":ament_index"],
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":autoware_predicted_path_postprocessor_library", "@googletest//:gtest_main"],
    tags = ["no-sandbox", "no-remote"],
)

exports_files(glob(["config/*.yaml"]))
