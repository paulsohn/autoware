module(
    name = "autoware_tensorrt_classifier",
    version = "0.53.0",
)

bazel_dep(name = "autoware_cuda_utils", version = "0.0.0")
bazel_dep(name = "autoware_tensorrt_common", version = "0.0.0")
bazel_dep(name = "rclcpp", version = "0.0.0")
bazel_dep(name = "rosdistro", version = "0.0.0")
bazel_dep(name = "rules_cc", version = "0.2.26.rcr.0")
bazel_dep(name = "rules_cuda", version = "0.4.0")
bazel_dep(name = "tensorrt", version = "0.0.0")
bazel_dep(name = "llvm", version = "0.8.25.rcr.0")

llvm = use_extension("@llvm//extensions:llvm.bzl", "llvm")
use_repo(llvm, "llvm-project")

cuda = use_extension("@rules_cuda//cuda:extensions.bzl", "toolchain")
use_repo(cuda, "cuda")
