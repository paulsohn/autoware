load("@autoware_agnocast_wrapper//:defs.bzl", "autoware_agnocast_node")
load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "utils",
    srcs = ["lib/utils/utils.cpp"],
    hdrs = glob(["include/**/*.hpp"]),
    includes = ["include"],
    deps = ["@autoware_perception_msgs//:cc"],
)

cc_shared_library(
    name = "utils_shared",
    shared_lib_name = "libautoware_detected_object_validation_utils.so",
    deps = [":utils"],
    dynamic_deps = ["@autoware_perception_msgs//:cc_shared"],
)

cc_library(
    name = "headers",
    hdrs = glob(["src/**/*.hpp"]),
    includes = ["src"],
    deps = [
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper_library",
        "@autoware_lanelet2_utils",
        "@autoware_map_msgs//:cc",
        "@autoware_object_recognition_utils",
        "@autoware_perception_msgs//:cc",
        "@autoware_utils",
        "@geometry_msgs//:cc",
        "@message_filters//:message_filters_library",
        "@nav_msgs//:cc",
        "@pcl_conversions//:pcl_conversions_library",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
        "@sensor_msgs//:cc",
        "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
        "@tf2_ros//:tf2_ros_library",
        "@visualization_msgs//:cc",
        "@rosdistro//cc:opencv_library",
        "@rosdistro//cc:pcl_common",
        "@rosdistro//cc:pcl_filters",
        "@rosdistro//cc:pcl_kdtree",
        "@rosdistro//cc:pcl_search",
        "@rosdistro//cc:pcl_segmentation",
        ":utils",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        ":utils_shared",
        "@autoware_agnocast_wrapper",
        "@autoware_lanelet2_utils//:runtime_dynamic_deps",
        "@autoware_map_msgs//:cc_shared",
        "@autoware_object_recognition_utils//:runtime_dynamic_deps",
        "@autoware_utils//:runtime_dynamic_deps",
        "@geometry_msgs//:cc_shared",
        "@message_filters//:message_filters",
        "@nav_msgs//:cc_shared",
        "@pcl_conversions//:pcl_conversions",
        "@rclcpp_components//:rclcpp_components",
        "@sensor_msgs//:cc_shared",
        "@tf2_geometry_msgs//:tf2_geometry_msgs",
        "@tf2_ros//:tf2_ros",
        "@visualization_msgs//:cc_shared",
        "@rosdistro//cc:opencv",
        "@rosdistro//cc:pcl",
    ],
)

cc_library(
    name = "occupancy_grid_based_validator_library",
    srcs = ["src/occupancy_grid_map/occupancy_grid_map_validator.cpp"],
    deps = [":headers"],
)

cc_shared_library(
    name = "occupancy_grid_based_validator",
    shared_lib_name = "libautoware_detected_object_validation_occupancy_grid_based_validator.so",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":occupancy_grid_based_validator_library"],
)

cc_library(
    name = "obstacle_pointcloud_based_validator_library",
    srcs = ["src/obstacle_pointcloud/obstacle_pointcloud_validator.cpp"],
    deps = [":headers"],
)

cc_shared_library(
    name = "obstacle_pointcloud_based_validator",
    shared_lib_name = "libautoware_detected_object_validation_obstacle_pointcloud_based_validator.so",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":obstacle_pointcloud_based_validator_library"],
)

cc_library(
    name = "object_lanelet_filter_library",
    srcs = ["src/lanelet_filter/debug.cpp", "src/lanelet_filter/lanelet_filter_base.cpp", "src/lanelet_filter/detected_object_lanelet_filter.cpp", "src/lanelet_filter/tracked_object_lanelet_filter.cpp"],
    deps = [":headers"],
)

cc_shared_library(
    name = "object_lanelet_filter",
    shared_lib_name = "libautoware_detected_object_validation_object_lanelet_filter.so",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":object_lanelet_filter_library"],
)

cc_library(
    name = "object_position_filter_library",
    srcs = ["src/position_filter/position_filter.cpp"],
    deps = [":headers"],
)

cc_shared_library(
    name = "object_position_filter",
    shared_lib_name = "libautoware_detected_object_validation_object_position_filter.so",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":object_position_filter_library"],
)

rclcpp_components_register_node(
    name = "occupancy_grid_based_validator_node",
    component = ":occupancy_grid_based_validator",
    plugin = "autoware::detected_object_validation::occupancy_grid_map::OccupancyGridBasedValidator",
    node_name = "occupancy_grid_based_validator_node",
)
autoware_agnocast_node(
    name = "obstacle_pointcloud_based_validator_node",
    component = ":obstacle_pointcloud_based_validator",
    plugin = "autoware::detected_object_validation::obstacle_pointcloud::ObstaclePointCloudBasedValidator",
    package_name = "autoware_detected_object_validation",
    agnocast_only = False,
)
autoware_agnocast_node(
    name = "object_lanelet_filter_node",
    component = ":object_lanelet_filter",
    plugin = "autoware::detected_object_validation::lanelet_filter::DetectedObjectLaneletFilterNode",
    package_name = "autoware_detected_object_validation",
)
autoware_agnocast_node(
    name = "tracked_object_lanelet_filter_node",
    component = ":object_lanelet_filter",
    plugin = "autoware::detected_object_validation::lanelet_filter::TrackedObjectLaneletFilterNode",
    package_name = "autoware_detected_object_validation",
)
rclcpp_components_register_node(
    name = "object_position_filter_node",
    component = ":object_position_filter",
    plugin = "autoware::detected_object_validation::position_filter::ObjectPositionFilterNode",
    node_name = "object_position_filter_node",
)

register_ament_files(
    name = "executables",
    files = [":occupancy_grid_based_validator_node", ":obstacle_pointcloud_based_validator_node", ":object_lanelet_filter_node", ":tracked_object_lanelet_filter_node", ":object_position_filter_node"],
    prefix = "lib/autoware_detected_object_validation",
    strip_prefix = "*",
)

ament_index(
    package_xml = "package.xml",
    components = [":occupancy_grid_based_validator_node_record", ":obstacle_pointcloud_based_validator_node_components", ":object_lanelet_filter_node_components", ":tracked_object_lanelet_filter_node_components", ":object_position_filter_node_record"],
    libraries = [":utils_shared", ":occupancy_grid_based_validator", ":obstacle_pointcloud_based_validator", ":object_lanelet_filter", ":object_position_filter"],
    data = glob(["config/**", "launch/**"]) + [":executables", ":obstacle_pointcloud_based_validator_node_plugin", ":object_lanelet_filter_node_plugin", ":tracked_object_lanelet_filter_node_plugin"],
)

cc_test(
    name = "detection_object_validation_tests",
    srcs = ["test/test_utils.cpp", "test/object_position_filter/test_object_position_filter.cpp"] + glob(["test/*.hpp"]),
    data = [":ament_index"],
    dynamic_deps = [":runtime_dynamic_deps", "@autoware_test_utils//:runtime_dynamic_deps"],
    deps = [":object_position_filter_library", "@autoware_test_utils", "@googletest//:gtest_main"],
    tags = ["no-sandbox", "no-remote"],
)

cc_test(
    name = "object_lanelet_filter_tests",
    srcs = ["test/test_utils.cpp", "test/lanelet_filter/test_lanelet_filter.cpp"] + glob(["test/*.hpp"]),
    data = [":ament_index"],
    dynamic_deps = [":runtime_dynamic_deps", "@autoware_test_utils//:runtime_dynamic_deps"],
    deps = [":object_lanelet_filter_library", "@autoware_test_utils", "@googletest//:gtest_main"],
    tags = ["no-sandbox", "no-remote"],
)

cc_library(
    name = "test_fixtures",
    testonly = True,
    hdrs = ["test/test_lanelet_utils.hpp"],
    includes = ["test"],
    deps = ["@autoware_lanelet2_utils"],
)

exports_files(glob(["config/*.yaml"]))
