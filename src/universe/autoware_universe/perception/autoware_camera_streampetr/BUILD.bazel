load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_cuda//cuda:defs.bzl", "cuda_library")
load("@tensorrt//:defs.bzl", "tensorrt_cc_binary")

package(default_visibility = ["//visibility:public"])

_GPU_HEADERS = glob([
    "include/**/utils.hpp",
    "include/**/cuda_utils.hpp",
    "include/**/postprocess/*.hpp",
    "include/**/network/preprocess.hpp",
    "include/**/network/memory.cuh",
    "include/**/network/camera_ego_mask.hpp",
])

cuda_library(
    name = "kernels",
    srcs = glob(["lib/**/*.cu"]),
    hdrs = _GPU_HEADERS,
    copts = [
        "-std=c++17",
        "--expt-relaxed-constexpr",
        "--extended-lambda",
    ],
    includes = ["include"],
    deps = [
        "@autoware_cuda_utils",
        "@cuda//:cuda_runtime",
        "@cuda//:libcudacxx",
        "@tensorrt",
    ],
)

cc_shared_library(
    name = "autoware_camera_streampetr_cuda_lib",
    shared_lib_name = "libautoware_camera_streampetr_cuda_lib.so",
    deps = [":kernels"],
)

cc_library(
    name = "library",
    srcs = glob(["lib/**/*.cpp"]),
    hdrs = glob(
        ["include/**/*.hpp"],
        exclude = _GPU_HEADERS + ["include/autoware/camera_streampetr/node.hpp"],
    ),
    copts = ["-Wno-deprecated-declarations"],
    includes = ["include"],
    deps = [
        ":kernels",
        "@autoware_object_recognition_utils",
        "@autoware_perception_msgs//:cc",
        "@autoware_tensorrt_common//:autoware_tensorrt_common_library",
        "@autoware_utils",
        "@cv_bridge//:cv_bridge_library",
        "@eigen",
        "@geometry_msgs//:cc",
        "@nav_msgs//:cc",
        "@perception_utils//:perception_utils_library",
        "@rclcpp_components//:rclcpp_components_library",
        "@rosdistro//cc:opencv_library",
        "@rosdistro//cc:yaml-cpp_library",
        "@sensor_msgs//:cc",
        "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
        "@tf2_msgs//:cc",
        "@tf2_ros//:tf2_ros_library",
    ],
)

collect_transitive_dynamic_deps(
    name = "sdk_dynamic_deps",
    dynamic_deps = [
        "@autoware_internal_debug_msgs//:cc_shared",
        "@autoware_object_recognition_utils//:runtime_dynamic_deps",
        "@autoware_perception_msgs//:cc_shared",
        "@autoware_tensorrt_common",
        "@autoware_utils//:runtime_dynamic_deps",
        "@cv_bridge//:cv_bridge",
        "@cv_bridge//:transitive_dynamic_deps",
        "@geometry_msgs//:cc_shared",
        "@nav_msgs//:cc_shared",
        "@perception_utils",
        "@perception_utils//:runtime_dynamic_deps",
        "@rclcpp_components//:rclcpp_components",
        "@sensor_msgs//:cc_shared",
        "@tf2_geometry_msgs//:tf2_geometry_msgs",
        "@tf2_msgs//:cc_shared",
        "@tf2_ros//:tf2_ros",
        "@rosdistro//cc:opencv",
        "@rosdistro//cc:yaml-cpp",
    ],
)

cc_shared_library(
    name = "autoware_camera_streampetr_lib",
    dynamic_deps = [
        ":autoware_camera_streampetr_cuda_lib",
        ":sdk_dynamic_deps",
    ],
    shared_lib_name = "libautoware_camera_streampetr_lib.so",
    deps = [":library"],
)

cc_library(
    name = "node_library",
    srcs = ["src/node.cpp"],
    hdrs = ["include/autoware/camera_streampetr/node.hpp"],
    includes = ["include"],
    deps = [
        ":library",
        "@autoware_internal_debug_msgs//:cc",
        "@diagnostic_msgs//:cc",
        "@diagnostic_updater//:diagnostic_updater_library",
        "@geometry_msgs//:cc",
        "@image_transport//:image_transport_library",
        "@nav_msgs//:cc",
        "@perception_utils//:perception_utils_library",
        "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
        "@tf2_msgs//:cc",
        "@tf2_ros//:tf2_ros_library",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        ":autoware_camera_streampetr_cuda_lib",
        ":autoware_camera_streampetr_lib",
        ":sdk_dynamic_deps",
        "@diagnostic_msgs//:cc_shared",
        "@diagnostic_updater//:diagnostic_updater",
        "@geometry_msgs//:cc_shared",
        "@image_transport//:image_transport",
        "@image_transport//:transitive_dynamic_deps",
        "@nav_msgs//:cc_shared",
        "@tf2_geometry_msgs//:tf2_geometry_msgs",
        "@tf2_msgs//:cc_shared",
        "@tf2_ros//:tf2_ros",
    ],
)

cc_shared_library(
    name = "autoware_camera_streampetr_component",
    dynamic_deps = [":runtime_dynamic_deps"],
    shared_lib_name = "libautoware_camera_streampetr_component.so",
    deps = [":node_library"],
)

rclcpp_components_register_node(
    name = "streampetr_native",
    component = ":autoware_camera_streampetr_component",
    executor = "MultiThreadedExecutor",
    node_name = "autoware_camera_streampetr_node",
    plugin = "autoware::camera_streampetr::StreamPetrNode",
)

tensorrt_cc_binary(
    name = "autoware_camera_streampetr_node",
    srcs = [":streampetr_native_main.cpp"],
    dynamic_deps = [
        ":autoware_camera_streampetr_component",
        ":runtime_dynamic_deps",
    ],
    deps = ["@rclcpp_components//:rclcpp_components_library"],
)

register_ament_files(
    name = "executables",
    files = [":autoware_camera_streampetr_node"],
    prefix = "lib/autoware_camera_streampetr",
    strip_prefix = "*",
)

ament_index(
    components = [":streampetr_native_record"],
    data = glob([
        "config/**",
        "launch/**",
    ]) + [":executables"],
    libraries = [
        ":autoware_camera_streampetr_cuda_lib",
        ":autoware_camera_streampetr_lib",
        ":autoware_camera_streampetr_component",
    ],
    package_xml = "package.xml",
    deps = [
        "@autoware_camera_streampetr_models//:ament_index",
        "@image_transport//:ament_index_plugin",
    ],
)

exports_files(glob([
    "launch/*",
    "config/*",
]) + ["package.xml"])
