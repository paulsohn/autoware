load("@autoware_agnocast_wrapper//:defs.bzl", "autoware_agnocast_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_simple_object_merger_library",
    srcs = glob(["src/*.cpp"]),
    hdrs = glob(["include/**/*.hpp"]),
    strip_include_prefix = "include",
    deps = [
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper_library",
        "@autoware_perception_msgs//:cc",
        "@autoware_utils",
        "@geometry_msgs//:cc",
        "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@rclcpp_components//:rclcpp_components",
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper",
        "@autoware_perception_msgs//:cc_shared",
        "@autoware_utils//:runtime_dynamic_deps",
        "@geometry_msgs//:cc_shared",
        "@tf2_geometry_msgs//:tf2_geometry_msgs",
    ],
)

cc_shared_library(
    name = "autoware_simple_object_merger_component",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":autoware_simple_object_merger_library"],
)

autoware_agnocast_node(
    name = "simple_object_merger_node",
    package_name = "autoware_simple_object_merger",
    component = ":autoware_simple_object_merger_component",
    plugin = "autoware::simple_object_merger::SimpleDetectedObjectMergerNode",
)

autoware_agnocast_node(
    name = "simple_tracked_object_merger_node",
    package_name = "autoware_simple_object_merger",
    component = ":autoware_simple_object_merger_component",
    plugin = "autoware::simple_object_merger::SimpleTrackedObjectMergerNode",
)

register_ament_files(
    name = "executables",
    files = [":simple_object_merger_node", ":simple_tracked_object_merger_node"],
    prefix = "lib/autoware_simple_object_merger",
    strip_prefix = "*",
)

ament_index(
    package_xml = "package.xml",
    components = [":simple_object_merger_node_components", ":simple_tracked_object_merger_node_components"],
    data = glob(["config/**", "launch/**"]) + [":executables"] + [":simple_object_merger_node_plugin", ":simple_tracked_object_merger_node_plugin"],
)

cc_test(
    name = "test_node",
    srcs = ["test/test_node.cpp"],
    data = [":ament_index"],
    dynamic_deps = [":runtime_dynamic_deps", "@autoware_test_utils//:runtime_dynamic_deps"],
    deps = [":autoware_simple_object_merger_library", "@autoware_test_utils", "@googletest//:gtest_main"],
    tags = ["no-sandbox", "no-remote"],
)
