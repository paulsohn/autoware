load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "prime_synchronizer",
    hdrs = ["include/perception_utils/prime_synchronizer.hpp"],
    strip_include_prefix = "include",
    deps = [
        "@rclcpp//:rclcpp_library",
        "@std_msgs//:cc",
    ],
)

cc_library(
    name = "perception_utils_library",
    srcs = [
        "src/detection_class_remapper.cpp",
        "src/iou_bev_nms.cpp",
    ],
    hdrs = glob(
        ["include/**/*.hpp"],
        exclude = [
            "include/perception_utils/prime_synchronizer.hpp",
            "include/perception_utils/run_length_encoder.hpp",
        ],
    ),
    strip_include_prefix = "include",
    deps = [
        ":prime_synchronizer",
        ":run_length_encoder_library",
        "@autoware_object_recognition_utils",
        "@autoware_perception_msgs//:cc",
        "@autoware_utils_geometry",
        "@rclcpp//:rclcpp_library",
        "@rosdistro//cc:opencv_library",
        "@std_msgs//:cc",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_utils_debug//:runtime_dynamic_deps",
        "@diagnostic_updater//:diagnostic_updater",
        "@autoware_internal_planning_msgs//:cc_shared",
        "@autoware_planning_msgs//:cc_shared",
        ":run_length_encoder",
        "@rosdistro//cc:opencv",
        "@autoware_object_recognition_utils//:runtime_dynamic_deps",
        "@autoware_perception_msgs//:cc_shared",
        "@rclcpp//:rclcpp",
        "@std_msgs//:cc_shared",
        "@visualization_msgs//:cc_shared",
    ],
)

cc_shared_library(
    name = "perception_utils",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [
        ":perception_utils_library",
        "@autoware_object_recognition_utils",
        "@autoware_interpolation",
        "@autoware_utils_geometry",
        "@autoware_utils_math",
        "@autoware_utils_debug",
        "@autoware_utils_diagnostics",
        "@autoware_utils_system",
        "@autoware_utils_visualization",
    ],
)

cc_test(
    name = "test_iou_bev_nms",
    srcs = [
        "test/detection_test_utils.hpp",
        "test/test_iou_bev_nms.cpp",
    ],
    dynamic_deps = [
        ":perception_utils",
        ":runtime_dynamic_deps",
    ],
    env = {"ENABLE_AGNOCAST": "0"},
    deps = [
        ":perception_utils_library",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "test_detection_class_remapper",
    srcs = [
        "test/detection_test_utils.hpp",
        "test/test_detection_class_remapper.cpp",
    ],
    dynamic_deps = [
        ":perception_utils",
        ":runtime_dynamic_deps",
    ],
    env = {"ENABLE_AGNOCAST": "0"},
    deps = [
        ":perception_utils_library",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "test_utils",
    srcs = [
        "test/detection_test_utils.hpp",
        "test/test_utils.cpp",
    ],
    dynamic_deps = [
        ":perception_utils",
        ":runtime_dynamic_deps",
    ],
    env = {"ENABLE_AGNOCAST": "0"},
    deps = [
        ":perception_utils_library",
        "@googletest//:gtest",
    ],
)

cc_library(
    name = "run_length_encoder_library",
    srcs = ["src/run_length_encoder.cpp"],
    hdrs = ["include/perception_utils/run_length_encoder.hpp"],
    strip_include_prefix = "include",
    deps = ["@rosdistro//cc:opencv_library"],
)

cc_shared_library(
    name = "run_length_encoder",
    dynamic_deps = ["@rosdistro//cc:opencv"],
    deps = [":run_length_encoder_library"],
)
