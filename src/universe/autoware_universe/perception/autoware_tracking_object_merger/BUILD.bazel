load("@autoware_agnocast_wrapper//:defs.bzl", "autoware_agnocast_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_tracking_object_merger_library",
    srcs = [
        "src/association/data_association.cpp",
        "src/association/solver/mu_successive_shortest_path_wrapper.cpp",
        "src/decorative_tracker_merger_node.cpp",
        "src/utils/utils.cpp",
        "src/utils/tracker_state.cpp",
    ],
    hdrs = glob(["include/**/*.hpp"]),
    includes = ["include"],
    # Keep strict diagnostics in this component, not in dependency SDK headers.
    copts = [
        "-Wall",
        "-Wextra",
        "-Wpedantic",
        "-Werror",
        "-Wconversion",
        "--system-header-prefix=Eigen/",
        "--system-header-prefix=boost/",
        "--system-header-prefix=pcl/",
        "--system-header-prefix=mussp/",
        "--system-header-prefix=tf2/",
        "--system-header-prefix=tf2_ros/",
        "--system-header-prefix=rosidl_runtime_cpp/",
        "--system-header-prefix=autoware/agnocast_wrapper/",
        "--system-header-prefix=autoware/point_types/",
        "--system-header-prefix=autoware_utils_diagnostics/",
        "-Wno-unknown-warning-option",
        "-Wno-nonportable-include-path",
    ],
    deps = [
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper_library",
        "@autoware_object_recognition_utils",
        "@autoware_perception_msgs//:cc",
        "@autoware_utils_geometry",
        "@autoware_utils_math",
        "@autoware_utils_system",
        "@std_msgs//:cc",
        "@unique_identifier_msgs//:cc",
        "@autoware_utils_debug",
        "@autoware_utils_diagnostics",
        "@geometry_msgs//:cc",
        "@mussp",
        "@rosdistro//cc:eigen",
        "@tf2//:tf2_library",
        "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
        "@tf2_ros//:tf2_ros_library",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_agnocast_wrapper",
        "@autoware_object_recognition_utils//:runtime_dynamic_deps",
        "@autoware_perception_msgs//:cc_shared",
        "@rclcpp_components//:rclcpp_components",
        "@tf2_ros//:tf2_ros",
        "@autoware_utils_debug//:runtime_dynamic_deps",
        "@geometry_msgs//:cc_shared",
        "@mussp//:runtime_dynamic_deps",
        "@std_msgs//:cc_shared",
        "@unique_identifier_msgs//:cc_shared",
        "@tf2_geometry_msgs//:tf2_geometry_msgs",
    ],
)

cc_shared_library(
    name = "autoware_tracking_object_merger",
    shared_lib_name = "libautoware_tracking_object_merger.so",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":autoware_tracking_object_merger_library"],
)

autoware_agnocast_node(
    name = "decorative_tracker_merger_node",
    component = ":autoware_tracking_object_merger",
    package_name = "autoware_tracking_object_merger",
    plugin = "autoware::tracking_object_merger::DecorativeTrackerMergerNode",
)

register_ament_files(
    name = "executables",
    files = [":decorative_tracker_merger_node"],
    prefix = "lib/autoware_tracking_object_merger",
    strip_prefix = "*",
)

ament_index(
    package_xml = "package.xml",
    components = [":decorative_tracker_merger_node_components"],
    data = glob(["config/**", "launch/**"]) + [":executables", ":decorative_tracker_merger_node_plugin"],
    libraries = [":autoware_tracking_object_merger"],
)

exports_files(glob(["config/*.yaml"]))
