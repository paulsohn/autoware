cc_test(
    name = "test_voxel_distance_based_compare_map_filter",
    srcs = ["test/test_voxel_distance_based_compare_map_filter.cpp"],
    data = [":ament_index"],
    dynamic_deps = [":runtime_dynamic_deps", "@autoware_test_utils//:runtime_dynamic_deps"],
