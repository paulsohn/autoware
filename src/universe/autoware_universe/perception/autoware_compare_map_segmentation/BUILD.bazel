load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_compare_map_segmentation_library",
    srcs = [
        "lib/voxel_grid_map_loader.cpp",
        "src/distance_based_compare_map_filter/node.cpp",
        "src/voxel_based_approximate_compare_map_filter/node.cpp",
        "src/voxel_based_compare_map_filter/node.cpp",
        "src/voxel_distance_based_compare_map_filter/node.cpp",
        "src/compare_elevation_map_filter/node.cpp",
        "src/lanelet_elevation_filter/node.cpp",
        "src/lanelet_elevation_filter/lanelet_elevation_filter.cpp",
        "src/lanelet_elevation_filter/grid_processor.cpp",
    ],
    hdrs = glob(["include/**/*.hpp", "src/**/*.hpp"]),
    includes = ["include", "src"],
    deps = [
        "@ament_index_cpp//:ament_index_cpp_library",
        "@autoware_internal_debug_msgs//:cc",
        "@autoware_lanelet2_utils",
        "@autoware_map_msgs//:cc",
        "@autoware_point_types",
        "@autoware_pointcloud_preprocessor//:pointcloud_preprocessor_filter_base",
        "@autoware_qos_utils",
        "@autoware_utils",
        "@diagnostic_msgs//:cc",
        "@diagnostic_updater//:diagnostic_updater_library",
        "@geometry_msgs//:cc",
        "@grid_map//:grid_map_pcl",
        "@grid_map//:grid_map_ros",
        "@grid_map//:grid_map_cv",
        "@lanelet2_core//:lanelet2_core_library",
        "@lanelet2_projection//:lanelet2_projection_library",
        "@lanelet2_routing//:lanelet2_routing_library",
        "@nav_msgs//:cc",
        "@pcl_conversions//:pcl_conversions_library",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
        "@rcutils//:rcutils_library",
        "@sensor_msgs//:cc",
        "@std_msgs//:cc",
        "@tf2//:tf2_library",
        "@tf2_ros//:tf2_ros_library",
        "@tf2_sensor_msgs//:tf2_sensor_msgs_library",
        "@visualization_msgs//:cc",
        "@rosdistro//cc:pcl_common",
        "@rosdistro//cc:pcl_filters",
        "@rosdistro//cc:pcl_io",
        "@rosdistro//cc:pcl_kdtree",
        "@rosdistro//cc:pcl_search",
        "@rosdistro//cc:pcl_segmentation",
        "@rosdistro//cc:opencv_library",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@ament_index_cpp//:ament_index_cpp",
        "@autoware_internal_debug_msgs//:cc_shared",
        "@autoware_lanelet2_utils//:runtime_dynamic_deps",
        "@autoware_map_msgs//:cc_shared",
        "@autoware_pointcloud_preprocessor//:filter_base_runtime_dynamic_deps",
        "@diagnostic_msgs//:cc_shared",
        "@diagnostic_updater//:diagnostic_updater",
        "@geometry_msgs//:cc_shared",
        "@grid_map//:grid_map_pcl_runtime_dynamic_deps",
        "@grid_map//:grid_map_cv_runtime_dynamic_deps",
        "@lanelet2_core//:lanelet2_core",
        "@lanelet2_projection//:lanelet2_projection",
        "@lanelet2_routing//:lanelet2_routing",
        "@nav_msgs//:cc_shared",
        "@rclcpp_components//:rclcpp_components",
        "@sensor_msgs//:cc_shared",
        "@std_msgs//:cc_shared",
        "@tf2_ros//:tf2_ros",
        "@tf2_sensor_msgs//:tf2_sensor_msgs",
        "@visualization_msgs//:cc_shared",
    ],
)

cc_shared_library(
    name = "autoware_compare_map_segmentation",
    shared_lib_name = "libautoware_compare_map_segmentation.so",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":autoware_compare_map_segmentation_library"],
)

rclcpp_components_register_node(
    name = "distance_based_compare_map_filter_node",
    node_name = "distance_based_compare_map_filter",
    component = ":autoware_compare_map_segmentation",
    plugin = "autoware::compare_map_segmentation::DistanceBasedCompareMapFilterComponent",
)

rclcpp_components_register_node(
    name = "voxel_based_approximate_compare_map_filter_node",
    node_name = "voxel_based_approximate_compare_map_filter",
    component = ":autoware_compare_map_segmentation",
    plugin = "autoware::compare_map_segmentation::VoxelBasedApproximateCompareMapFilterComponent",
)

rclcpp_components_register_node(
    name = "voxel_based_compare_map_filter_node",
    node_name = "voxel_based_compare_map_filter",
    component = ":autoware_compare_map_segmentation",
    plugin = "autoware::compare_map_segmentation::VoxelBasedCompareMapFilterComponent",
)

rclcpp_components_register_node(
    name = "voxel_distance_based_compare_map_filter_node",
    node_name = "voxel_distance_based_compare_map_filter",
    component = ":autoware_compare_map_segmentation",
    plugin = "autoware::compare_map_segmentation::VoxelDistanceBasedCompareMapFilterComponent",
)

rclcpp_components_register_node(
    name = "compare_elevation_map_filter_node",
    node_name = "compare_elevation_map_filter",
    component = ":autoware_compare_map_segmentation",
    plugin = "autoware::compare_map_segmentation::CompareElevationMapFilterComponent",
)

rclcpp_components_register_node(
    name = "lanelet_elevation_filter_node",
    node_name = "lanelet_elevation_filter",
    component = ":autoware_compare_map_segmentation",
    plugin = "autoware::compare_map_segmentation::LaneletElevationFilterComponent",
)

register_ament_files(
    name = "executables",
    files = [":distance_based_compare_map_filter_node", ":voxel_based_approximate_compare_map_filter_node", ":voxel_based_compare_map_filter_node", ":voxel_distance_based_compare_map_filter_node", ":compare_elevation_map_filter_node", ":lanelet_elevation_filter_node"],
    prefix = "lib/autoware_compare_map_segmentation",
    strip_prefix = "*",
)

ament_index(
    package_xml = "package.xml",
    components = [":distance_based_compare_map_filter_node_record", ":voxel_based_approximate_compare_map_filter_node_record", ":voxel_based_compare_map_filter_node_record", ":voxel_distance_based_compare_map_filter_node_record", ":compare_elevation_map_filter_node_record", ":lanelet_elevation_filter_node_record"],
    data = glob(["config/**", "launch/**", "data/**"]) + [":executables"],
    libraries = [":autoware_compare_map_segmentation"],
)

cc_test(
    name = "test_voxel_based_compare_map_filter",
    srcs = ["test/test_voxel_based_compare_map_filter.cpp"],
    data = [":ament_index"],
    dynamic_deps = [":runtime_dynamic_deps", "@autoware_test_utils//:runtime_dynamic_deps"],
    deps = [":autoware_compare_map_segmentation_library", "@autoware_test_utils", "@point_cloud_msg_wrapper", "@googletest//:gtest_main"],
    tags = ["no-sandbox", "no-remote"],
)

