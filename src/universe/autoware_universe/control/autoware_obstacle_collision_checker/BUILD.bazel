load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_obstacle_collision_checker",
    srcs = glob(["src/**/*.cpp"]),
    hdrs = glob(["include/**/*.hpp"]),
    includes = ["include", "src"],
    deps = [
        "@autoware_planning_msgs//:cc",
        "@autoware_utils",
        "@autoware_vehicle_info_utils",
        "@diagnostic_updater//:diagnostic_updater_library",
        "@geometry_msgs//:cc",
        "@nav_msgs//:cc",
        "@pcl_conversions//:pcl_conversions_library",
        "@pcl_ros//:pcl_ros_tf_library",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
        "@sensor_msgs//:cc",
        "@std_msgs//:cc",
        "@tf2//:tf2_library",
        "@tf2_eigen//:tf2_eigen_library",
        "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
        "@tf2_ros//:tf2_ros_library",
        "@visualization_msgs//:cc",
        "@rosdistro//cc:boost.geometry",
        "@rosdistro//cc:eigen",
        "@rosdistro//cc:pcl_common",
        "@rosdistro//cc:pcl_filters",
        "@rosdistro//cc:pcl_kdtree",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_planning_msgs//:cc_shared",
        "@autoware_utils//:runtime_dynamic_deps",
        "@diagnostic_updater//:diagnostic_updater",
        "@geometry_msgs//:cc_shared",
        "@nav_msgs//:cc_shared",
        "@pcl_conversions//:pcl_conversions",
        "@pcl_ros//:pcl_ros_tf",
        "@rclcpp//:rclcpp",
        "@rclcpp_components//:rclcpp_components",
        "@sensor_msgs//:cc_shared",
        "@std_msgs//:cc_shared",
        "@tf2//:tf2",
        "@tf2_eigen//:tf2_eigen",
        "@tf2_geometry_msgs//:tf2_geometry_msgs",
        "@tf2_ros//:tf2_ros",
        "@visualization_msgs//:cc_shared",
        "@rosdistro//cc:pcl",
    ],
)

cc_shared_library(
    name = "component",
    shared_lib_name = "libobstacle_collision_checker.so",
    deps = [":autoware_obstacle_collision_checker"],
    dynamic_deps = [":runtime_dynamic_deps"],
)

rclcpp_components_register_node(
    name = "obstacle_collision_checker_node",
    component = ":component",
    node_name = "obstacle_collision_checker_node",
    plugin = "autoware::obstacle_collision_checker::ObstacleCollisionCheckerNode",
)

register_ament_files(
    name = "executables",
    files = [":obstacle_collision_checker_node"],
    prefix = "lib/autoware_obstacle_collision_checker",
    strip_prefix = "*",
)

ament_index(
    package_xml = "package.xml",
    components = [":obstacle_collision_checker_node_record"],
    data = glob(["config/**", "launch/**"]) + [":executables"],
)

cc_library(
    name = "test_implementation",
    testonly = True,
    textual_hdrs = ["src/obstacle_collision_checker.cpp"],
    deps = [":autoware_obstacle_collision_checker"],
)

cc_test(
    name = "test_autoware_obstacle_collision_checker",
    timeout = "long",
    srcs = glob(["test/*.cpp"]),
    deps = [":test_implementation", "@googletest//:gtest_main"],
    dynamic_deps = [":runtime_dynamic_deps"],
    env = {"LD_LIBRARY_PATH": "lib", "ROS_DOMAIN_ID": "80"},
)
