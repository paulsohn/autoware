load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosidl_default_generators//:defs.bzl", "default_generators")

package(default_visibility = ["//visibility:public"])

default_generators(deps = ["//msg:OperationModeTransitionManagerDebug"], dependencies = ["@builtin_interfaces"])

cc_library(
    name = "autoware_operation_mode_transition_manager",
    srcs = glob(["src/**/*.cpp"]),
    hdrs = glob(["src/**/*.hpp"]),
    includes = ["src"],
    deps = [
        ":cc",
        "@autoware_component_interface_specs_universe",
        "@autoware_component_interface_utils",
        "@autoware_control_msgs//:cc",
        "@autoware_motion_utils",
        "@autoware_system_msgs//:cc",
        "@autoware_utils",
        "@autoware_utils_rclcpp",
        "@autoware_vehicle_info_utils",
        "@autoware_vehicle_msgs//:cc",
        "@diagnostic_msgs//:cc",
        "@geometry_msgs//:cc",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
        "@std_srvs//:cc",
        "@tier4_control_msgs//:cc",
        "@tier4_system_msgs//:cc",
        "@tier4_vehicle_msgs//:cc",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        ":cc_shared",
        "@autoware_component_interface_specs_universe//:runtime_dynamic_deps",
        "@autoware_component_interface_utils//:runtime_dynamic_deps",
        "@autoware_control_msgs//:cc_shared",
        "@autoware_motion_utils//:runtime_dynamic_deps",
        "@autoware_system_msgs//:cc_shared",
        "@autoware_vehicle_msgs//:cc_shared",
        "@diagnostic_msgs//:cc_shared",
        "@geometry_msgs//:cc_shared",
        "@rclcpp//:rclcpp",
        "@rclcpp_components//:rclcpp_components",
        "@std_srvs//:cc_shared",
        "@tier4_control_msgs//:cc_shared",
        "@tier4_system_msgs//:cc_shared",
        "@tier4_vehicle_msgs//:cc_shared",
    ],
)

cc_shared_library(
    name = "autoware_operation_mode_transition_manager_component",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":autoware_operation_mode_transition_manager"],
)

rclcpp_components_register_node(
    name = "autoware_operation_mode_transition_manager_exe",
    node_name = "autoware_operation_mode_transition_manager_exe",
    component = ":autoware_operation_mode_transition_manager_component",
    plugin = "autoware::operation_mode_transition_manager::OperationModeTransitionManager",
)

rclcpp_components_register_node(
    name = "autonomous_mode_transition_flag_node",
    node_name = "autonomous_mode_transition_flag_node",
    component = ":autoware_operation_mode_transition_manager_component",
    plugin = "autoware::operation_mode_transition_manager::AutonomousModeTransitionFlagNode",
)

register_ament_files(
    name = "node_executables",
    files = [":autoware_operation_mode_transition_manager_exe", ":autonomous_mode_transition_flag_node"],
    prefix = "lib/autoware_operation_mode_transition_manager",
    strip_prefix = "*",
)

ament_index(
    package_xml = "package.xml",
    data = glob(["config/**", "launch/**"]) + [":node_executables", ":idl"],
    components = [":autoware_operation_mode_transition_manager_exe_record", ":autonomous_mode_transition_flag_node_record"],
    libraries = [":cc_shared", ":py"],
)
