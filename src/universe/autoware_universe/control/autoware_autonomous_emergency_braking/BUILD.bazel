load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@autoware_agnocast_wrapper//:defs.bzl", "autoware_agnocast_node")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_autonomous_emergency_braking_library",
    srcs = glob(["src/**/*.cpp"]),
    hdrs = glob(["include/**/*.hpp"]),
    includes = ["include", "src"],
    deps = [
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper_library",
        "@autoware_control_msgs//:cc",
        "@autoware_internal_debug_msgs//:cc",
        "@autoware_motion_utils",
        "@autoware_perception_msgs//:cc",
        "@autoware_planning_msgs//:cc",
        "@autoware_system_msgs//:cc",
        "@autoware_utils",
        "@autoware_vehicle_info_utils",
        "@autoware_vehicle_msgs//:cc",
        "@diagnostic_updater//:diagnostic_updater_library",
        "@geometry_msgs//:cc",
        "@nav_msgs//:cc",
        "@pcl_conversions//:pcl_conversions_library",
        "@pcl_ros//:pcl_ros_tf_library",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
        "@rosdistro//cc:boost.lexical_cast",
        "@rosdistro//cc:fmt",
        "@rosdistro//cc:pcl_filters",
        "@rosdistro//cc:pcl_registration",
        "@rosdistro//cc:pcl_segmentation",
        "@rosdistro//cc:pcl_surface",
        "@sensor_msgs//:cc",
        "@std_msgs//:cc",
        "@tf2//:tf2_library",
        "@tf2_eigen//:tf2_eigen_library",
        "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
        "@tf2_ros//:tf2_ros_library",
        "@tier4_debug_msgs//:cc",
        "@tier4_metric_msgs//:cc",
        "@visualization_msgs//:cc",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper",
        "@autoware_control_msgs//:cc_shared",
        "@autoware_internal_debug_msgs//:cc_shared",
        "@autoware_motion_utils//:runtime_dynamic_deps",
        "@autoware_perception_msgs//:cc_shared",
        "@autoware_planning_msgs//:cc_shared",
        "@autoware_system_msgs//:cc_shared",
        "@autoware_vehicle_msgs//:cc_shared",
        "@diagnostic_updater//:diagnostic_updater",
        "@geometry_msgs//:cc_shared",
        "@nav_msgs//:cc_shared",
        "@pcl_conversions//:pcl_conversions",
        "@pcl_ros//:pcl_ros_tf",
        "@rclcpp//:rclcpp",
        "@rclcpp_components//:rclcpp_components",
        "@sensor_msgs//:cc_shared",
        "@std_msgs//:cc_shared",
        "@tf2//:tf2",
        "@tf2_eigen//:tf2_eigen",
        "@tf2_geometry_msgs//:tf2_geometry_msgs",
        "@tf2_ros//:tf2_ros",
        "@tier4_debug_msgs//:cc_shared",
        "@tier4_metric_msgs//:cc_shared",
        "@visualization_msgs//:cc_shared",
    ],
)

cc_shared_library(
    name = "autoware_autonomous_emergency_braking_component",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":autoware_autonomous_emergency_braking_library"],
)

autoware_agnocast_node(
    name = "autoware_autonomous_emergency_braking",
    package_name = "autoware_autonomous_emergency_braking",
    component = ":autoware_autonomous_emergency_braking_component",
    plugin = "autoware::motion::control::autonomous_emergency_braking::AEB",
    agnocast_only = True,
)

register_ament_files(
    name = "node_executables",
    files = [":autoware_autonomous_emergency_braking"],
    prefix = "lib/autoware_autonomous_emergency_braking",
    strip_prefix = "*",
)

ament_index(
    package_xml = "package.xml",
    data = glob(["config/**", "launch/**"]) + [":autoware_autonomous_emergency_braking_plugin", ":node_executables"],
    components = [":autoware_autonomous_emergency_braking_components"],
)

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [
        ":runtime_dynamic_deps",
        "@ament_index_cpp//:ament_index_cpp",
        "@autoware_test_utils//:runtime_dynamic_deps",
    ],
)

cc_test(
    name = "test_autoware_autonomous_emergency_braking",
    timeout = "long",
    srcs = glob(["test/**/*.cpp", "test/**/*.hpp"]),
    data = [
        ":ament_index",
        "@autoware_test_utils//:ament_index",
        "@autoware_vehicle_info_utils//:ament_index",
    ],
    dynamic_deps = [":test_dynamic_deps"],
    env = {"ENABLE_AGNOCAST": "0", "LD_LIBRARY_PATH": "lib", "ROS_DOMAIN_ID": "95"},
    deps = [
        ":autoware_autonomous_emergency_braking_library",
        "@ament_index_cpp//:ament_index_cpp_library",
        "@autoware_test_utils",
        "@googletest//:gtest_main",
    ],
)
