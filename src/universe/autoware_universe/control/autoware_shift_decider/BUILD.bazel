load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@autoware_agnocast_wrapper//:defs.bzl", "autoware_agnocast_node")
load("@generate_parameter_library//:defs.bzl", "generate_parameter_library")

package(default_visibility = ["//visibility:public"])

generate_parameter_library(name = "shift_decider_parameters", yaml_file = "param/shift_decider_parameters.yaml")

cc_library(
    name = "autoware_shift_decider_library",
    srcs = glob(["src/**/*.cpp"]),
    hdrs = glob(["include/**/*.hpp"]),
    includes = ["include", "src", "include/autoware_shift_decider"],
    deps = [
        ":shift_decider_parameters",
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper_library",
        "@autoware_control_msgs//:cc",
        "@autoware_system_msgs//:cc",
        "@autoware_utils",
        "@autoware_vehicle_msgs//:cc",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper",
        "@autoware_control_msgs//:cc_shared",
        "@autoware_system_msgs//:cc_shared",
        "@autoware_vehicle_msgs//:cc_shared",
        "@generate_parameter_library//:rclcpp_lifecycle",
        "@generate_parameter_library//:rsl",
        "@rclcpp//:rclcpp",
        "@rclcpp_components//:rclcpp_components",
    ],
)

cc_shared_library(
    name = "autoware_shift_decider_component",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":autoware_shift_decider_library"],
)

autoware_agnocast_node(
    name = "autoware_shift_decider",
    package_name = "autoware_shift_decider",
    component = ":autoware_shift_decider_component",
    plugin = "autoware::shift_decider::ShiftDecider",
    agnocast_only = True,
)

register_ament_files(
    name = "node_executables",
    files = [":autoware_shift_decider"],
    prefix = "lib/autoware_shift_decider",
    strip_prefix = "*",
)

ament_index(
    package_xml = "package.xml",
    data = glob(["config/**", "launch/**"]) + [":autoware_shift_decider_plugin", ":node_executables"],
    components = [":autoware_shift_decider_components"],
)
