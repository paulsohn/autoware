load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@autoware_agnocast_wrapper//:defs.bzl", "autoware_agnocast_node")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "autoware_lane_departure_checker",
    srcs = glob(["src/**/*.cpp"]),
    hdrs = glob(["include/**/*.hpp"]),
    includes = ["include", "src"],
    deps = [
        "@autoware_adapi_v1_msgs//:cc",
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper_library",
        "@autoware_deprecated_boundary_departure_checker",
        "@autoware_internal_debug_msgs//:cc",
        "@autoware_lanelet2_extension//:autoware_lanelet2_extension_lib_library",
        "@autoware_lanelet2_utils",
        "@autoware_map_msgs//:cc",
        "@autoware_motion_utils",
        "@autoware_planning_msgs//:cc",
        "@autoware_utils",
        "@autoware_vehicle_info_utils",
        "@autoware_vehicle_msgs//:cc",
        "@diagnostic_updater//:diagnostic_updater_library",
        "@geometry_msgs//:cc",
        "@nav_msgs//:cc",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
        "@rosdistro//cc:boost.geometry",
        "@rosdistro//cc:boost.lexical_cast",
        "@rosdistro//cc:eigen",
        "@rosdistro//cc:fmt",
        "@tf2//:tf2_library",
        "@tf2_eigen//:tf2_eigen_library",
        "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
        "@tf2_ros//:tf2_ros_library",
    ],
)

collect_transitive_dynamic_deps(
    name = "runtime_dynamic_deps",
    dynamic_deps = [
        "@autoware_adapi_v1_msgs//:cc_shared",
        "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper",
        "@autoware_deprecated_boundary_departure_checker//:runtime_dynamic_deps",
        "@autoware_internal_debug_msgs//:cc_shared",
        "@autoware_lanelet2_extension//:autoware_lanelet2_extension_lib",
        "@autoware_lanelet2_utils//:runtime_dynamic_deps",
        "@autoware_map_msgs//:cc_shared",
        "@autoware_motion_utils//:runtime_dynamic_deps",
        "@autoware_planning_msgs//:cc_shared",
        "@autoware_vehicle_msgs//:cc_shared",
        "@diagnostic_updater//:diagnostic_updater",
        "@geometry_msgs//:cc_shared",
        "@nav_msgs//:cc_shared",
        "@rclcpp//:rclcpp",
        "@rclcpp_components//:rclcpp_components",
        "@tf2//:tf2",
        "@tf2_eigen//:tf2_eigen",
        "@tf2_geometry_msgs//:tf2_geometry_msgs",
        "@tf2_ros//:tf2_ros",
    ],
)

cc_shared_library(
    name = "autoware_lane_departure_checker_component",
    dynamic_deps = [":runtime_dynamic_deps"],
    deps = [":autoware_lane_departure_checker"],
)

autoware_agnocast_node(
    name = "lane_departure_checker_node",
    package_name = "autoware_lane_departure_checker",
    component = ":autoware_lane_departure_checker_component",
    plugin = "autoware::lane_departure_checker::LaneDepartureCheckerNode",
    agnocast_only = True,
)

register_ament_files(
    name = "node_executables",
    files = [":lane_departure_checker_node"],
    prefix = "lib/autoware_lane_departure_checker",
    strip_prefix = "*",
)

ament_index(
    package_xml = "package.xml",
    data = glob(["config/**", "launch/**"]) + [":lane_departure_checker_node_plugin", ":node_executables"],
    components = [":lane_departure_checker_node_components"],
)
