load("@rosdistro//ament:defs.bzl", "ament_package")

package(default_visibility = ["//visibility:public"])

# Deliberate differences from CMakeLists.txt (checked by bazel/tools/cmake_parity):
# cmake-diff env-hook:env-hooks/velodyne_description.dsv.in: adds share/ to GAZEBO_MODEL_PATH; Gazebo is not used.

# No code: share/velodyne_description/... Not ported: the env hook that adds share/ to GAZEBO_MODEL_PATH (Gazebo only).
ament_package(
    name = "ament_package",
    data = glob(["launch/**", "meshes/**", "rviz/**", "urdf/**", "world/**"]),
    package_xml = "package.xml",
    deps = [
        "@rosdistro//:ament_package",
        "@urdf//:ament_package",
        "@xacro//:ament_package",
    ],
)

# The installed package doubles as the runtime ament index of this package in tests (data = [":ament_index"]).
alias(
    name = "ament_index",
    actual = ":ament_package",
)
