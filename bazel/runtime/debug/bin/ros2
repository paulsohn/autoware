set -eu

bundle=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
source "$bundle/setup.bash"
export RUNFILES_DIR="$bundle/planning_simulator_debug.runfiles"
if [[ "${0##*/}" == python3 ]]; then
  exec "$bundle/planning_simulator_debug" --python "$@"
fi
exec "$bundle/planning_simulator_debug" "$@"
