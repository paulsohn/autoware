load(":defs.bzl", "executable_template")
load(":cyclonedds.bzl", "PLANNING_SIMULATOR_CYCLONEDDS_URI")
load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("//third_party/runtime:defs.bzl", "runtime_libraries")

package(default_visibility = ["//visibility:public"])

exports_files(["run"])

runtime_libraries(
    name = "native_runtime",
    libraries = [
        "//third_party/graphics_runtime:runtime",
        "@rosdistro//cc:zlib",
    ],
    sonames = {"libzlib_shared.so": ["libz.so.1"]},
)

launch_ros_binary(
    name = "core_headless",
    src = "@autoware_core//:launch/autoware_core.launch.xml",
    data = [
        ":native_runtime",
        "@autoware_core//:ament_index",
        "@autoware_sample_sensor_kit_description//:ament_index",
        "@autoware_sample_vehicle_description//:ament_index",
        "@graphics_runtime//:copyrights",
    ],
    precompile = "disabled",
    deps = ["@autoware_agnocast_wrapper//:python"],
)

# Caller-owned UI composition for the original simulator RViz configuration.
filegroup(
    name = "planning_simulator_rviz",
    srcs = [
        "//third_party/rviz2:runtime",
        "@autoware_localization_rviz_plugin//:ament_index",
        "@autoware_mission_details_overlay_rviz_plugin//:ament_index",
        "@autoware_overlay_rviz_plugin//:ament_index",
        "@autoware_perception_rviz_plugin//:ament_index",
        "@autoware_planning_rviz_plugin//:ament_index",
        "@autoware_polar_grid//:ament_index",
        "@autoware_string_stamped_rviz_plugin//:ament_index",
        "@tier4_adapi_rviz_plugin//:ament_index",
        "@tier4_control_mode_rviz_plugin//:ament_index",
        "@tier4_datetime_rviz_plugin//:ament_index",
        "@tier4_dummy_object_rviz_plugin//:ament_index",
        "@tier4_planning_factor_rviz_plugin//:ament_index",
        "@tier4_state_rviz_plugin//:ament_index",
        "@tier4_vehicle_rviz_plugin//:ament_index",
    ],
)

# Original Universe entrypoint; callers select rviz:=false for the headless profile.
launch_ros_binary(
    name = "planning_simulator",
    src = "@autoware_launch//:launch/planning_simulator.launch.xml",
    data = [
        ":native_runtime",
        ":planning_simulator_rviz",
        "@autoware_launch//:ament_index",
        "@sample_vehicle_description//:ament_index",
        "@sample_vehicle_launch//:ament_index",
        "@sample_sensor_kit_description//:ament_index",
        "@sample_sensor_kit_launch//:ament_index",
    ],
    env = {"ENABLE_AGNOCAST": "0", "CYCLONEDDS_URI": PLANNING_SIMULATOR_CYCLONEDDS_URI},
    precompile = "disabled",
    deps = ["@autoware_agnocast_wrapper//:python", "@launch_yaml"],
)

executable_template(
    name = "planning_simulator_launcher",
    out = "run_simulator",
    substitutions = {"@CYCLONEDDS_URI@": PLANNING_SIMULATOR_CYCLONEDDS_URI},
    template = "run_simulator.sh.in",
)
