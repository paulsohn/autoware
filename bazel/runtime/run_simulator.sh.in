#!/bin/bash
# Copyright 2026 Taeseung Sohn
# SPDX-License-Identifier: Apache-2.0
set -eu

bundle=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
export PATH=/usr/bin:/bin
export OMP_NUM_THREADS=1
export CYCLONEDDS_URI='@CYCLONEDDS_URI@'
source "$bundle/simulator_setup.bash"
export RUNFILES_DIR="$bundle/planning_simulator.runfiles"

exec "$bundle/planning_simulator" \
  "$AMENT_PREFIX_PATH/share/autoware_launch/launch/planning_simulator.launch.xml" \
  rviz:=false "$@"
