load("//bazel:expensive.bzl", "EXPENSIVE_TARGET_COMPATIBILITY")
load("//bazel/runtime:cyclonedds.bzl", "PLANNING_SIMULATOR_CYCLONEDDS_URI")
load("@launch_testing//:defs.bzl", "launch_test")
load("@pip_ros//:requirements.bzl", "requirement")

_RUNTIME_DATA = [
    "@autoware_launch//:ament_index",
    "@sample_vehicle_description//:ament_index",
    "@sample_vehicle_launch//:ament_index",
    "@sample_sensor_kit_description//:ament_index",
    "@sample_sensor_kit_launch//:ament_index",
]

_TEST_DEPS = [
    "@ament_index_python",
    "@autoware_adapi_version_msgs//:py",
    "@autoware_map_msgs//:py",
    "@composition_interfaces//:py",
    "@launch",
    "@launch_ros",
    "@launch_testing",
    "@launch_xml",
    "@launch_yaml",
    "@nav_msgs//:py",
    "@rcl_interfaces//:py",
    "@rclpy",
    "@sensor_msgs//:py",
    "@std_msgs//:py",
    "@tier4_system_msgs//:py",
    requirement("pytest"),
    requirement("pyyaml"),
]

[
    launch_test(
        name = mode + "_launch_test",
        target_compatible_with = EXPENSIVE_TARGET_COMPATIBILITY,
        timeout = "long",
        src = "test_launch.py",
        data = _RUNTIME_DATA,
        env = {
            "ENABLE_AGNOCAST": "0",
            "LD_LIBRARY_PATH": "lib",
            "ROS_DOMAIN_ID": "106",
            "UNIVERSE_LAUNCH_MODE": mode,
        } | ({"CYCLONEDDS_URI": PLANNING_SIMULATOR_CYCLONEDDS_URI} if mode == "full" else {}),
        precompile = "disabled",
        tags = ["no-remote", "no-sandbox"],
        deps = _TEST_DEPS,
    )
    for mode in ["map", "vehicle", "api", "simulator", "system", "control", "planning", "full"]
]

launch_test(
    name = "lane_driving_test",
    target_compatible_with = EXPENSIVE_TARGET_COMPATIBILITY,
    visibility = ["//bazel/tests:__pkg__"],
    timeout = "long",
    src = "test_drive.py",
    data = _RUNTIME_DATA + [
        "test_launch.py",
        "//bazel/tests/planning_simulator_resources:scenario.yaml",
    ],
    env = {
        "ENABLE_AGNOCAST": "0",
        "LD_LIBRARY_PATH": "lib",
        "ROS_DOMAIN_ID": "110",
        "UNIVERSE_LAUNCH_MODE": "full",
        "CYCLONEDDS_URI": PLANNING_SIMULATOR_CYCLONEDDS_URI,
    },
    precompile = "disabled",
    tags = ["no-remote", "no-sandbox"],
    deps = _TEST_DEPS + [
        "@autoware_adapi_v1_msgs//:py",
        "@autoware_planning_msgs//:py",
        "@geometry_msgs//:py",
        "@rules_python//python/runfiles",
    ],
)
