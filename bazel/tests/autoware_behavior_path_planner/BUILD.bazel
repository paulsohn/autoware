load("@rules_python//python:defs.bzl", "py_test")

_SCENES = [
    "static_obstacle_avoidance",
    "avoidance_by_lane_change",
    "lane_change",
    "goal_planner",
    "start_planner",
    "side_shift",
    "bidirectional_traffic",
]

[
    py_test(
        name = "selected_scenes_runtime_test" if len(modules) > 1 else (
            "runtime_test" if modules[0] == "side_shift" else modules[0] + "_runtime_test"
        ),
        srcs = ["test_runtime.py"],
        args = [
            "$(rootpath @autoware_behavior_path_planner//:autoware_behavior_path_planner_node)",
            ",".join(modules),
        ],
        data = [
            "@autoware_behavior_path_planner//:ament_index",
            "@autoware_behavior_path_planner//:autoware_behavior_path_planner_node",
            "@autoware_test_utils//:ament_index",
        ] + [
            "@autoware_behavior_path_" + module + "_module//:ament_index"
            for module in _SCENES
            if module in modules or (
                "avoidance_by_lane_change" in modules and module in ["lane_change", "static_obstacle_avoidance"]
            )
        ],
        env = {
            "ENABLE_AGNOCAST": "0",
            "LD_LIBRARY_PATH": "lib",
        },
        main = "test_runtime.py",
        precompile = "disabled",
        tags = [
            "no-remote",
            "no-sandbox",
        ],
        deps = [
            "@ament_index_python",
            "@rcl_interfaces//:py",
            "@rclpy",
        ],
    )
    for modules in [[module] for module in _SCENES] + [_SCENES]
]
