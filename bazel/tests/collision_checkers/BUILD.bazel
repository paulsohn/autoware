load("@rules_python//python:defs.bzl", "py_test")

py_test(
    name = "obstacle_runtime_test",
    timeout = "long",
    srcs = ["test_runtime.py"],
    main = "test_runtime.py",
    args = ["$(rootpath @autoware_obstacle_collision_checker//:obstacle_collision_checker_node)", "autoware_obstacle_collision_checker"],
    data = ["@autoware_obstacle_collision_checker//:obstacle_collision_checker_node", "@autoware_obstacle_collision_checker//:ament_index", "@autoware_test_utils//:ament_index"],
    deps = ["@ament_index_python", "@rclpy", "@autoware_planning_msgs//:py", "@autoware_perception_msgs//:py", "@diagnostic_msgs//:py", "@geometry_msgs//:py", "@sensor_msgs//:py", "@nav_msgs//:py", "@tf2_msgs//:py", "@tier4_control_msgs//:py"],
    env = {"LD_LIBRARY_PATH": "lib", "ROS_DOMAIN_ID": "80"},
    tags = ["no-sandbox", "no-remote"],
    precompile = "disabled",
)

