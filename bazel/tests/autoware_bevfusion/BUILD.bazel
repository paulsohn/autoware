load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@pip_ros//:requirements.bzl", "requirement")
load("@rules_cc//cc:defs.bzl", "cc_test")
load("@rules_python//python:defs.bzl", "py_test")

cc_test(
    name = "gpu_test",
    srcs = ["test_gpu.cpp"],
    copts = ["-fvisibility-inlines-hidden"],
    data = ["@spconv//:runtime_library"],
    dynamic_deps = ["@autoware_bevfusion//:autoware_bevfusion_cuda_lib"],
    tags = [
        "no-remote",
        "no-sandbox",
        "requires-gpu",
    ],
    deps = [
        "@autoware_bevfusion//:kernels",
        "@googletest//:gtest_main",
    ],
)

launch_ros_binary(
    name = "launch_probe",
    testonly = True,
    src = "@autoware_bevfusion//:launch/bevfusion.launch.xml",
    data = ["@autoware_bevfusion//:ament_index"],
    precompile = "disabled",
)

py_test(
    name = "runtime_test",
    timeout = "long",
    srcs = ["test_runtime.py"],
    args = ["$(rootpath :launch_probe)"],
    data = [
        ":launch_probe",
        "@autoware_bevfusion//:ament_index",
    ],
    env = {
        "ENABLE_AGNOCAST": "0",
        "LD_LIBRARY_PATH": "lib",
        "ROS_DOMAIN_ID": "106",
    },
    main = "test_runtime.py",
    precompile = "disabled",
    tags = [
        "no-remote",
        "no-sandbox",
        "requires-gpu",
    ],
    deps = [
        "@ament_index_python",
        "@autoware_internal_debug_msgs//:py",
        "@autoware_perception_msgs//:py",
        "@launch",
        "@launch_ros",
        "@launch_xml",
        "@rclpy",
        "@sensor_msgs//:py",
        requirement("pyyaml"),
    ],
)
