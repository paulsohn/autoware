load("@rules_python//python:defs.bzl", "py_test")

[
    py_test(
        name = name + "_runtime_test",
        srcs = ["test_runtime.py"],
        main = "test_runtime.py",
        args = [package, executable, config, library],
        data = ["@" + package + "//:ament_index", "@autoware_test_utils//:ament_index"],
        env = {"ENABLE_AGNOCAST": "0", "LD_LIBRARY_PATH": "lib", "ROS_DOMAIN_ID": "98"},
        precompile = "disabled",
        tags = ["no-remote", "no-sandbox"],
        deps = ["@ament_index_python", "@rcl_interfaces//:py", "@rclpy"] + (
            ["@sensor_msgs//:py"] if package == "pointcloud_to_laserscan" else []
        ) + (
            ["@autoware_perception_msgs//:py"] if package == "autoware_dummy_traffic_light_publisher" else []
        ),
    )
    for name, package, executable, config, library in [
        ("cloud_scan", "pointcloud_to_laserscan", "pointcloud_to_laserscan_node", "-", "libpointcloud_to_laserscan_component.so"),
        ("scan_cloud", "pointcloud_to_laserscan", "laserscan_to_pointcloud_node", "-", "liblaserscan_to_pointcloud_component.so"),
        ("cloud_publisher", "pointcloud_to_laserscan", "dummy_pointcloud_publisher", "-", "librclcpp.so"),
        ("tracker", "autoware_multi_object_tracker", "multi_object_tracker_node", "config/multi_object_tracker_node.param.yaml", "libautoware_multi_object_tracker_component.so"),
        ("prediction", "autoware_map_based_prediction", "map_based_prediction", "config/map_based_prediction.param.yaml", "libautoware_map_based_prediction_component.so"),
        ("analytics", "autoware_perception_online_evaluator", "autoware_perception_analytics_publisher_node", "param/perception_analytics_publisher.defaults.yaml", "libautoware_perception_online_evaluator_component.so"),
        ("evaluator", "autoware_perception_online_evaluator", "autoware_perception_online_evaluator_node", "param/perception_online_evaluator.defaults.yaml", "libautoware_perception_online_evaluator_component.so"),
        ("traffic", "autoware_dummy_traffic_light_publisher", "autoware_dummy_traffic_light_publisher_node", "config/dummy_traffic_light_publisher.param.yaml", "libautoware_dummy_traffic_light_publisher_component.so"),
    ]
]
