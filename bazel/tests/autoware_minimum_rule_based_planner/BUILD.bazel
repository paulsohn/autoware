load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_test")

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = ["@autoware_minimum_rule_based_planner//:runtime_dynamic_deps", "@autoware_test_utils//:runtime_dynamic_deps", "@class_loader//:class_loader"],
)

cc_test(
    name = "transport_test",
    timeout = "long",
    srcs = ["test_transport.cpp"],
    args = ["$(rootpath @autoware_minimum_rule_based_planner//:component)"],
    data = ["@autoware_minimum_rule_based_planner//:component", "@autoware_minimum_rule_based_planner//:ament_index", "@autoware_test_utils//:ament_index", "@agnocast_heaphook"],
    deps = ["@autoware_minimum_rule_based_planner//:plugin_interface", "@pluginlib//:pluginlib_library", "@autoware_agnocast_wrapper//:autoware_agnocast_wrapper_library", "@autoware_test_utils", "@class_loader//:class_loader_library", "@rclcpp_components//:rclcpp_components_library", "@autoware_perception_msgs//:cc", "@autoware_internal_planning_msgs//:cc", "@autoware_planning_msgs//:cc", "@geometry_msgs//:cc", "@googletest//:gtest"],
    dynamic_deps = [":test_dynamic_deps"],
    env = {"LD_LIBRARY_PATH": "lib", "ROS_DOMAIN_ID": "79"},
    tags = ["no-sandbox", "no-remote"],
)
