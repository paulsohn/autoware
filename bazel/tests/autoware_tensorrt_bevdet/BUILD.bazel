load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@pip_ros//:requirements.bzl", "requirement")
load("@rules_cc//cc:defs.bzl", "cc_test")
load("@rules_python//python:defs.bzl", "py_test")

cc_test(
    name = "helpers_test",
    srcs = ["test_helpers.cpp"],
    dynamic_deps = [
        "@autoware_tensorrt_bevdet//:autoware_tensorrt_bevdet_component",
        "@autoware_tensorrt_bevdet//:runtime_dynamic_deps",
    ],
    tags = [
        "no-remote",
        "no-sandbox",
        "requires-gpu",
    ],
    deps = [
        "@autoware_cuda_utils",
        "@autoware_tensorrt_bevdet//:library",
        "@googletest//:gtest_main",
    ],
)

launch_ros_binary(
    name = "launch_probe",
    testonly = True,
    src = "@autoware_tensorrt_bevdet//:launch/tensorrt_bevdet.launch.xml",
    data = ["@autoware_tensorrt_bevdet//:ament_index"],
    precompile = "disabled",
)

py_test(
    name = "runtime_test",
    timeout = "long",
    srcs = ["test_runtime.py"],
    args = ["$(rootpath :launch_probe)"],
    data = [
        ":launch_probe",
        "@autoware_tensorrt_bevdet//:ament_index",
    ],
    env = {
        "ENABLE_AGNOCAST": "0",
        "LD_LIBRARY_PATH": "lib",
        "RMW_IMPLEMENTATION": "rmw_cyclonedds_cpp",
        "ROS_DOMAIN_ID": "108",
    },
    main = "test_runtime.py",
    precompile = "disabled",
    tags = [
        "no-remote",
        "no-sandbox",
        "requires-gpu",
    ],
    deps = [
        "@ament_index_python",
        "@autoware_perception_msgs//:py",
        "@geometry_msgs//:py",
        "@launch",
        "@launch_ros",
        "@launch_xml",
        "@rclpy",
        "@sensor_msgs//:py",
        "@tf2_msgs//:py",
        "@visualization_msgs//:py",
        requirement("pyyaml"),
    ],
)
