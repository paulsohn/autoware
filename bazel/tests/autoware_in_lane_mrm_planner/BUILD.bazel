load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_test")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = ["@autoware_in_lane_mrm_planner//:runtime_dynamic_deps", "@autoware_test_utils//:runtime_dynamic_deps", "@class_loader//:class_loader"],
)

cc_test(
    name = "transport_test",
    timeout = "long",
    srcs = ["test_transport.cpp"],
    args = ["$(rootpath @autoware_in_lane_mrm_planner//:component)"],
    data = ["@autoware_in_lane_mrm_planner//:component", "@autoware_in_lane_mrm_planner//:ament_index", "@autoware_test_utils//:ament_index", "@agnocast_heaphook"],
    deps = ["@autoware_agnocast_wrapper//:autoware_agnocast_wrapper_library", "@autoware_test_utils", "@class_loader//:class_loader_library", "@rclcpp_components//:rclcpp_components_library", "@geometry_msgs//:cc", "@autoware_perception_msgs//:cc", "@autoware_internal_debug_msgs//:cc", "@autoware_vehicle_msgs//:cc", "@tier4_system_msgs//:cc", "@googletest//:gtest"],
    dynamic_deps = [":test_dynamic_deps"],
    env = {"LD_LIBRARY_PATH": "lib", "ROS_DOMAIN_ID": "77"},
    tags = ["no-sandbox", "no-remote"],
)


py_binary(
    name = "ros2",
    testonly = True,
    srcs = ["ros2.py"],
    main = "ros2.py",
    deps = ["@ros2cli", "@ros2bag"],
    precompile = "disabled",
)

py_test(
    name = "rosbag_tools_test",
    timeout = "long",
    srcs = ["test_rosbag_tools.py"],
    main = "test_rosbag_tools.py",
    args = ["$(rootpath @autoware_in_lane_mrm_planner//:in_lane_mrm_planner_rosbag_record)", "$(rootpath @autoware_in_lane_mrm_planner//:in_lane_mrm_planner_rosbag_analyzer)", "$(rootpath :ros2)"],
    data = ["@autoware_in_lane_mrm_planner//:ament_index", "@autoware_in_lane_mrm_planner//:in_lane_mrm_planner_rosbag_record", "@autoware_in_lane_mrm_planner//:in_lane_mrm_planner_rosbag_analyzer", ":ros2"],
    deps = ["@autoware_planning_msgs//:py", "@nav_msgs//:py", "@rclpy"],
    env = {"LD_LIBRARY_PATH": "lib", "ROS_DOMAIN_ID": "78", "MPLBACKEND": "Agg"},
    tags = ["no-sandbox", "no-remote"],
    precompile = "disabled",
)
