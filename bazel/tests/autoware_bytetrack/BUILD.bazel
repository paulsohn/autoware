load("@rules_cc//cc:defs.bzl", "cc_test")
load("@rules_python//python:defs.bzl", "py_test")

cc_test(
    name = "tracker_test",
    srcs = ["test_tracker.cpp"],
    deps = ["@autoware_bytetrack//:bytetrack_library", "@googletest//:gtest_main"],
    dynamic_deps = ["@autoware_bytetrack//:autoware_bytetrack", "@autoware_bytetrack//:autoware_bytetrack_lib", "@autoware_bytetrack//:sdk_dynamic_deps"],
    data = ["@autoware_bytetrack//:ament_index"],
    env = {"LD_LIBRARY_PATH": "lib"},
    tags = ["no-sandbox", "no-remote"],
)

py_test(
    name = "runtime_test",
    srcs = ["test_runtime.py"],
    main = "test_runtime.py",
    deps = ["@ament_index_python", "@autoware_perception_msgs//:py", "@rclpy", "@sensor_msgs//:py", "@tier4_perception_msgs//:py"],
    data = ["@autoware_bytetrack//:ament_index"],
    env = {"LD_LIBRARY_PATH": "lib", "QT_QPA_PLATFORM": "offscreen", "ROS_DOMAIN_ID": "88"},
    precompile = "disabled",
    tags = ["no-sandbox", "no-remote"],
    timeout = "long",
)
