set -eu

suite=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
runfiles="$suite/core_system_headless_launch_test.runfiles"
prefix="$runfiles/_main"
launcher=$(realpath -- "${1:?usage: runtime/verify /path/to/application/run}")
shift

unset AMENT_PREFIX_PATH COLCON_PREFIX_PATH CMAKE_PREFIX_PATH PYTHONPATH PYTHONHOME
unset LD_LIBRARY_PATH LD_PRELOAD RUNFILES_DIR RUNFILES_MANIFEST_FILE JAVA_RUNFILES
export PATH=/usr/bin:/bin
export RUNFILES_DIR="$runfiles"
export AMENT_PREFIX_PATH="$prefix"
export LD_LIBRARY_PATH="$prefix/lib"
export PYTHONNOUSERSITE=1
export CORE_SYSTEM_BUNDLE_LAUNCHER="$launcher"
export ENABLE_AGNOCAST=0 RMW_IMPLEMENTATION=rmw_cyclonedds_cpp ROS_DISTRO=lyrical
export ROS_DOMAIN_ID=86 OMP_NUM_THREADS=1
export TEST_TMPDIR="${TEST_TMPDIR:?set TEST_TMPDIR to a writable state directory}"

exec "$suite/core_system_headless_launch_test" \
  "$prefix/bazel/tests/core_system/test_launch.py" "$@"
