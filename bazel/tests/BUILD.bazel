package(default_visibility = ["//visibility:public"])

DEPS = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@std_msgs//:cc_shared": "@std_msgs//:cc",
}

collect_transitive_dynamic_deps(
    name = "dynamic_deps",
    dynamic_deps = DEPS.keys(),
)

cc_binary(
    name = "talker",
    srcs = ["talker.cc"],
    dynamic_deps = [":dynamic_deps"],
    deps = DEPS.values(),
)

cc_binary(
    name = "listener",
    srcs = ["listener.cc"],
    dynamic_deps = [":dynamic_deps"],
    deps = DEPS.values(),
)

