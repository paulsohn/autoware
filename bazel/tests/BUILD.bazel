# Product-owned runtime composition; component definitions have no root labels.
[
    py_test(
        name = "vehicle_velocity_converter_" + backend + "_test",
        srcs = ["autoware_vehicle_velocity_converter/test_standalone.py"],
        args = [
            "$(rootpath @autoware_vehicle_velocity_converter//:autoware_vehicle_velocity_converter_node)",
            "$(rootpath @autoware_vehicle_velocity_converter//:config/vehicle_velocity_converter.param.yaml)",
        ],
        data = [
            "//bazel/agnocast:runtime_index",
            "@agnocast_heaphook",
            "@autoware_vehicle_velocity_converter//:ament_index",
            "@autoware_vehicle_velocity_converter//:autoware_vehicle_velocity_converter_node",
            "@autoware_vehicle_velocity_converter//:config/vehicle_velocity_converter.param.yaml",
        ],
        env = {
            "AGNOCAST_TEST_NO_PRELOAD": "1",
            "AUTOWARE_TEST_AGNOCAST": enabled,
        },
        main = "autoware_vehicle_velocity_converter/test_standalone.py",
        precompile = "disabled",
        tags = [
            "no-remote",
            "no-sandbox",
        ] + (["requires-agnocast-kmod"] if enabled == "1" else []),
        deps = [
            "@autoware_vehicle_msgs//:py",
            "@geometry_msgs//:py",
            "@rclpy",
        ],
    )
    for backend, enabled in [
        ("rclcpp", "0"),
        ("agnocast", "1"),
    ]
]

