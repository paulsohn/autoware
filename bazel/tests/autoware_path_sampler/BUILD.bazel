load("@rules_cc//cc:defs.bzl", "cc_test")
load("@rules_python//python:defs.bzl", "py_test")

cc_test(
    name = "path_generation_test",
    srcs = ["test_generation.cpp"],
    deps = ["@autoware_path_sampler//:path_generation", "@googletest//:gtest_main"],
    dynamic_deps = ["@autoware_path_sampler//:runtime_dynamic_deps"],
    env = {"LD_LIBRARY_PATH": "lib"},
)

py_test(
    name = "runtime_test",
    timeout = "long",
    srcs = ["test_runtime.py"],
    main = "test_runtime.py",
    args = ["$(rootpath @autoware_path_sampler//:path_sampler_exe)"],
    data = ["@autoware_path_sampler//:path_sampler_exe", "@autoware_path_sampler//:ament_index", "@autoware_test_utils//:ament_index"],
    deps = ["@ament_index_python", "@autoware_perception_msgs//:py", "@autoware_planning_msgs//:py", "@geometry_msgs//:py", "@nav_msgs//:py", "@rcl_interfaces//:py", "@rclpy"],
    env = {"LD_LIBRARY_PATH": "lib"},
    tags = ["no-remote", "no-sandbox"],
    precompile = "disabled",
)

cc_test(
    name = "node_interpolation_test",
    srcs = ["test_interpolation.cpp"],
    data = ["@autoware_path_sampler//:ament_index", "@autoware_test_utils//:ament_index"],
    deps = ["@autoware_path_sampler", "@autoware_test_utils", "@ament_index_cpp//:ament_index_cpp_library", "@googletest//:gtest"],
    dynamic_deps = ["@autoware_path_sampler//:runtime_dynamic_deps"],
    env = {"LD_LIBRARY_PATH": "lib", "ROS_DOMAIN_ID": "75"},
)
