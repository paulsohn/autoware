load("@rules_python//python:defs.bzl", "py_test")

[
    py_test(
        name = name + "_runtime_test",
        srcs = ["test_runtime.py"],
        main = "test_runtime.py",
        args = [package, executable, config],
        data = ["@" + package + "//:ament_index"],
        env = {"ENABLE_AGNOCAST": "0", "LD_LIBRARY_PATH": "lib", "ROS_DOMAIN_ID": "101"},
        precompile = "disabled",
        tags = ["no-remote", "no-sandbox"],
        deps = [
            "@ament_index_python",
            "@autoware_control_msgs//:py",
            "@autoware_internal_debug_msgs//:py",
            "@tier4_metric_msgs//:py",
            "@autoware_system_msgs//:py",
            "@autoware_internal_planning_msgs//:py",
            "@diagnostic_msgs//:py",
            "@rcl_interfaces//:py",
            "@rclpy",
            "@tier4_system_msgs//:py",
        ],
    )
    for name, package, executable, config in [
        ("component_state", "autoware_component_state_monitor", "component_state_monitor_node", "-"),
        ("duplicate", "autoware_duplicated_node_checker", "autoware_duplicated_node_checker_node", "duplicated_node_checker.param.yaml"),
        ("processing", "autoware_processing_time_checker", "processing_time_checker_node", "processing_time_checker.param.yaml"),
        ("latency", "autoware_pipeline_latency_monitor", "autoware_pipeline_latency_monitor_node", "pipeline_latency_monitor.param.yaml"),
        ("comfortable_stop", "autoware_mrm_comfortable_stop_operator", "autoware_mrm_comfortable_stop_operator_node", "mrm_comfortable_stop_operator.param.yaml"),
        ("emergency_stop", "autoware_mrm_emergency_stop_operator", "autoware_mrm_emergency_stop_operator_node", "mrm_emergency_stop_operator.param.yaml"),
        ("mrm_handler", "autoware_mrm_handler", "autoware_mrm_handler_node", "mrm_handler.param.yaml"),
        ("aggregator", "autoware_diagnostic_graph_aggregator", "aggregator_node", "default.param.yaml"),
        ("mode_converter", "autoware_diagnostic_graph_aggregator", "converter_node", "converter.param.yaml"),
        ("tree", "autoware_diagnostic_graph_aggregator", "tree", "-"),
        ("dump", "autoware_diagnostic_graph_utils", "dump_node", "-"),
        ("graph_converter", "autoware_diagnostic_graph_utils", "converter_node", "-"),
        ("logging", "autoware_diagnostic_graph_utils", "logging_node", "-"),
    ]
]
