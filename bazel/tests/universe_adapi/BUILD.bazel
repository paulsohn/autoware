load("@launch_testing//:defs.bzl", "launch_test")
load("@pip_ros//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_test")

launch_test(
    name = "launch_test",
    src = "test_launch.py",
    data = [
        "@autoware_default_adapi_universe//:ament_index",
        "@sample_vehicle_description//:ament_index",
    ],
    env = {"ENABLE_AGNOCAST": "0", "ROS_DOMAIN_ID": "102", "LD_LIBRARY_PATH": "lib"},
    precompile = "disabled",
    tags = ["no-remote", "no-sandbox"],
    deps = [
        "@ament_index_python",
        "@autoware_adapi_v1_msgs//:py",
        "@autoware_adapi_version_msgs//:py",
        "@launch",
        "@launch_ros",
        "@launch_testing",
        "@launch_xml",
        "@rcl_interfaces//:py",
        "@rclpy",
        requirement("pytest"),
    ],
)

py_test(
    name = "standalone_runtime_test",
    srcs = ["test_standalone.py"],
    main = "test_standalone.py",
    data = [
        "@autoware_default_adapi_universe//:ament_index",
        "@sample_vehicle_description//:ament_index",
    ],
    env = {"ENABLE_AGNOCAST": "0", "ROS_DOMAIN_ID": "103", "LD_LIBRARY_PATH": "lib"},
    precompile = "disabled",
    tags = ["no-remote", "no-sandbox"],
    deps = [
        "@ament_index_python",
        "@launch",
        "@launch_ros",
        "@rcl_interfaces//:py",
        "@rclpy",
        requirement("pyyaml"),
    ],
