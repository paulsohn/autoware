        "$(rootpath @autoware_control_command_gate//:control_command_gate_node)",
        "$(rootpath @agnocast_heaphook)",
    ],
    data = [
        "@autoware_control_command_gate//:ament_index",
        "@autoware_control_command_gate//:control_command_gate_node",
        "@autoware_test_utils//:ament_index",
        "@agnocast_heaphook",
    ],
    deps = [
        "@ament_index_python",
        "@autoware_control_msgs//:py",
        "@autoware_vehicle_msgs//:py",
        "@diagnostic_msgs//:py",
        "@geometry_msgs//:py",
        "@nav_msgs//:py",
        "@rclpy",
        "@tier4_control_msgs//:py",
        "@tier4_external_api_msgs//:py",
