    tags = ["no-sandbox", "no-remote"],
)

cc_test(
    name = "gate_filter_test",
    srcs = ["test_gate_filter.cpp"],
    deps = ["@autoware_control_command_gate", "@googletest//:gtest_main"],
    dynamic_deps = ["@autoware_control_command_gate//:runtime_dynamic_deps"],
    env = {"LD_LIBRARY_PATH": "lib"},
)

