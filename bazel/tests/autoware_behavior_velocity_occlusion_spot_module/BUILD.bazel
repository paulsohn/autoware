load("@rules_python//python:defs.bzl", "py_test")

[
    py_test(
        name = mode + "_" + profile + "_test",
        srcs = ["//bazel/tests/behavior_velocity_planner:test_runtime.py"],
        args = [
            "$(rootpath @autoware_behavior_velocity_planner//:" + executable + ")",
            enabled,
            ",".join(["occlusion_spot"] + companions),
        ],
        data = [
            "@autoware_behavior_velocity_planner//:" + executable,
            "@autoware_behavior_velocity_planner//:ament_index",
            "@autoware_behavior_velocity_planner_common//:ament_index",
            "@autoware_behavior_velocity_occlusion_spot_module//:ament_index",
            "@autoware_test_utils//:ament_index",
            "@autoware_velocity_smoother//:ament_index",
        ] + ["@autoware_behavior_velocity_" + scene + "_module//:ament_index" for scene in companions],
        env = {"ENABLE_AGNOCAST": "0", "LD_LIBRARY_PATH": "lib"},
        main = "//bazel/tests/behavior_velocity_planner:test_runtime.py",
        precompile = "disabled",
        tags = ["no-remote", "no-sandbox"],
        deps = [
            "@ament_index_python",
            "@autoware_internal_planning_msgs//:py",
            "@rcl_interfaces//:py",
            "@rclpy",
        ],
    )
    for mode, executable, enabled in [
        ("standard", "autoware_behavior_velocity_planner_node", "0"),
        ("experimental", "experimental_autoware_behavior_velocity_planner_node", "1"),
    ]
    for profile, companions in [
        ("runtime", []),
        ("composition", ["walkway"] if mode == "standard" else ["no_drivable_lane", "speed_bump", "template", "walkway"]),
    ]
]
