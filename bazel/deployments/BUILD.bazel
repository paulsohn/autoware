load("//bazel:expensive.bzl", "EXPENSIVE_TARGET_COMPATIBILITY")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_img//img:image.bzl", "image_manifest")
load("@rules_img//img:layer.bzl", "image_layer", "layer_from_tar")
load("@rules_img//img:load.bzl", "image_load")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

package(default_visibility = ["//visibility:public"])

exports_files(["deployments.MODULE.bazel"])

cc_binary(
    name = "demo_prerequisite",
    srcs = ["services/prerequisite.c"],
)

pkg_tar(
    name = "core_bundle",
    target_compatible_with = EXPENSIVE_TARGET_COMPATIBILITY,
    srcs = [
        "//bazel/runtime:run",
        "//bazel/runtime:core_headless",
        "//bazel/runtime:core_setup",
    ],
    allow_duplicates_with_different_content = False,
    compression_level = 1,
    extension = "tar.gz",
    include_runfiles = True,
    preserve_mode = True,
    stamp = 0,
    strip_prefix = "/bazel/runtime",
)

pkg_tar(
    name = "planning_simulator_bundle",
    target_compatible_with = EXPENSIVE_TARGET_COMPATIBILITY,
    srcs = [
        "//bazel/runtime:planning_simulator_launcher",
        "//bazel/runtime:planning_simulator",
        "//bazel/runtime:planning_simulator_setup",
    ],
    allow_duplicates_with_different_content = False,
    compression_level = 1,
    extension = "tar.gz",
    include_runfiles = True,
    preserve_mode = True,
    stamp = 0,
    strip_prefix = "/bazel/runtime",
)

pkg_tar(
    name = "planning_simulator_debug_bundle",
    target_compatible_with = EXPENSIVE_TARGET_COMPATIBILITY,
    srcs = ["//bazel/runtime:planning_simulator_debug"],
    files = {
        "//bazel/runtime:planning_simulator_debug_setup": "setup.bash",
        "//bazel/runtime:debug/bin/ros2": "bin/ros2",
    },
    allow_duplicates_with_different_content = False,
    compression_level = 1,
    extension = "tar.gz",
    include_runfiles = True,
    preserve_mode = True,
    stamp = 0,
    strip_prefix = "/bazel/runtime",
    symlinks = {"install.bash": "setup.bash", "bin/python3": "ros2"},
)

# Add only the image install prefix to the existing native distribution.
pkg_tar(
    name = "core_payload",
    allow_duplicates_with_different_content = False,
    compression_level = 1,
    extension = "tar.gz",
    package_dir = "opt/autoware",
    preserve_mode = True,
    stamp = 0,
    deps = [":core_bundle"],
)

pkg_tar(
    name = "service_support",
    srcs = ["services/core"],
    package_dir = "usr/lib/autoware-services",
    preserve_mode = True,
    strip_prefix = "services",
)

image_layer(
    name = "prerequisite_layer",
    srcs = {"/usr/lib/autoware-services/demo_prerequisite": ":demo_prerequisite"},
    estargz = "disabled",
    include_runfiles = True,
)

pkg_tar(
    name = "s6_services",
    srcs = glob(["s6/**"]),
    extension = "tar.gz",
    preserve_mode = True,
    strip_prefix = "s6",
    deps = [":service_support"],
)

layer_from_tar(
    name = "s6_services_layer",
    src = ":s6_services",
    estargz = "disabled",
)

layer_from_tar(
    name = "core_layer",
    src = ":core_payload",
    compress = "gzip",
    estargz = "disabled",
)

image_manifest(
    name = "core",
    base = "@ubuntu_runtime",
    cmd = [],
    entrypoint = ["/opt/autoware/run"],
    env = {
        "HOME": "/tmp",
        "LOGNAME": "autoware",
    },
    layers = [":core_layer"],
    stop_signal = "SIGINT",
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    user = "1000:1000",
    working_dir = "/",
)

filegroup(
    name = "core_oci",
    srcs = [":core"],
    output_group = "oci_tarball",
)

image_load(
    name = "core_load",
    daemon = "docker",
    image = ":core",
    strategy = "eager",
    tag = "docker.io/library/autoware-core:bazel",
)

filegroup(
    name = "core_docker_archive",
    srcs = [":core_load"],
    output_group = "tarball",
)

image_manifest(
    name = "core_s6",
    base = ":core",
    cmd = [],
    entrypoint = ["/init"],
    env = {
        "S6_READ_ONLY_ROOT": "1",
        "S6_BEHAVIOUR_IF_STAGE2_FAILS": "2",
        "S6_CMD_WAIT_FOR_SERVICES_MAXTIME": "60000",
        "ROS_DOMAIN_ID": "86",
    },
    layers = [
        "//third_party/s6:layer",
        ":prerequisite_layer",
        ":s6_services_layer",
    ],
    stop_signal = "SIGTERM",
    user = "1000:1000",
)

image_load(
    name = "core_s6_load",
    daemon = "docker",
    image = ":core_s6",
    strategy = "eager",
    tag = "docker.io/library/autoware-core:s6",
)

filegroup(
    name = "core_s6_docker_archive",
    srcs = [":core_s6_load"],
    output_group = "tarball",
)

pkg_tar(
    name = "systemd_services",
    srcs = glob(["systemd/**"]),
    extension = "tar.gz",
    preserve_mode = True,
    strip_prefix = "systemd",
    deps = [":service_support"],
)

layer_from_tar(
    name = "systemd_services_layer",
    src = ":systemd_services",
    estargz = "disabled",
)

image_manifest(
    name = "core_systemd",
    base = ":core",
    cmd = [],
    entrypoint = ["/usr/lib/autoware-services/init"],
    env = {
        "container": "docker",
        "ROS_DOMAIN_ID": "86",
    },
    layers = [
        "//third_party/systemd:layer",
        ":prerequisite_layer",
        ":systemd_services_layer",
    ],
    stop_signal = "SIGRTMIN+3",
    user = "0:0",
)

image_load(
    name = "core_systemd_load",
    daemon = "docker",
    image = ":core_systemd",
    strategy = "eager",
    tag = "docker.io/library/autoware-core:systemd",
)

filegroup(
    name = "core_systemd_docker_archive",
    srcs = [":core_systemd_load"],
    output_group = "tarball",
)

pkg_tar(
    name = "planning_simulator_payload",
    allow_duplicates_with_different_content = False,
    compression_level = 1,
    extension = "tar.gz",
    package_dir = "opt/autoware",
    preserve_mode = True,
    stamp = 0,
    deps = [":planning_simulator_bundle"],
)

layer_from_tar(
    name = "planning_simulator_layer",
    src = ":planning_simulator_payload",
    compress = "gzip",
    estargz = "disabled",
)

image_manifest(
    name = "planning_simulator",
    base = "@ubuntu_runtime",
    cmd = [],
    entrypoint = ["/opt/autoware/run_simulator"],
    env = {"HOME": "/tmp", "LOGNAME": "autoware"},
    layers = [":planning_simulator_layer"],
    stop_signal = "SIGINT",
    target_compatible_with = ["@platforms//cpu:x86_64", "@platforms//os:linux"],
    user = "1000:1000",
    working_dir = "/",
)

filegroup(
    name = "planning_simulator_oci",
    srcs = [":planning_simulator"],
    output_group = "oci_tarball",
)

image_load(
    name = "planning_simulator_load",
    daemon = "docker",
    image = ":planning_simulator",
    strategy = "eager",
    tag = "docker.io/library/autoware-planning-simulator:bazel",
)

filegroup(
    name = "planning_simulator_docker_archive",
    srcs = [":planning_simulator_load"],
    output_group = "tarball",
)
