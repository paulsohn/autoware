package(default_visibility = ["//visibility:public"])

exports_files(["BUILD.debs.tpl"])

# TensorRT for the target CPU: headers + libnvinfer, libnvinfer_plugin, libnvonnxparser (TENSORRT_LIBRARIES in
# Autoware's tensorrt_cmake_module).
alias(
    name = "tensorrt",
    actual = select({
        "@platforms//cpu:aarch64": "@tensorrt_aarch64//:tensorrt",
        "@platforms//cpu:x86_64": "@tensorrt_x86_64//:tensorrt",
    }),
)


alias(
    name = "runtime_libs",
    actual = select({
        "@platforms//cpu:aarch64": "@tensorrt_aarch64//:runtime_libs",
        "@platforms//cpu:x86_64": "@tensorrt_x86_64//:runtime_libs",
    }),
)
