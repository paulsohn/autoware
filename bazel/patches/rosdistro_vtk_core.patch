+        "@vtk//:IOImage",
+        "@vtk//:IOLegacy",
+        "@vtk//:IOPLY",
+        "@vtk//:ImagingCore",
+    ],
+)
+
+cc_shared_library(
+    name = "vtk_core",
     dynamic_deps = [
         ":libjpeg",
         ":libpng",
