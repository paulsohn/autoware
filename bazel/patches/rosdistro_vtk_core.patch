Split VTK and PCL so that headless code needs neither Qt nor the system OpenGL loader: libvtk_core.so (the
non-rendering modules PCL uses) under libpcl.so; libvtk.so (rendering, Qt) and libpcl_visualization_shared.so
(visualization, people, outofcore) on top. Pairs with pcl_io_surface_vtk_modules.patch.
--- a/cc/BUILD.bazel
+++ b/cc/BUILD.bazel
@@ -200,19 +200,22 @@
         "@pcl//:segmentation",
         "@pcl//:surface",
         "@pcl//:tracking",
-    ] + select({
-        # pcl::visualization (and people/outofcore, which build on it) need
-        # VTK's OpenGL rendering stack, which the staged VTK only provides on
-        # Linux. Leaving them out elsewhere keeps the rest of PCL -- and every
-        # package depending on @rosdistro//cc:pcl, e.g. pcl_ros,
-        # pcl_conversions -- buildable and testable on macOS.
-        "@platforms//os:linux": [
-            "@pcl//:outofcore",
-            "@pcl//:people",
-            "@pcl//:visualization",
-        ],
-        "//conditions:default": [],
-    }),
+    ],
+)
+
+# pcl::visualization (and people/outofcore, which build on it) need VTK's
+# OpenGL rendering stack (Qt, the system OpenGL loader), which the staged VTK
+# only provides on Linux. They are a separate library so that libpcl.so, and
+# every headless node linking it, needs neither.
+cc_library(
+    name = "pcl_visualization_library",
+    target_compatible_with = ["@platforms//os:linux"],
+    deps = [
+        ":pcl_library",
+        "@pcl//:outofcore",
+        "@pcl//:people",
+        "@pcl//:visualization",
+    ],
 )
 
