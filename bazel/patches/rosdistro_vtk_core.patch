@@ -227,7 +230,7 @@
         ":lz4",
         ":lz4_hc",
         ":qhull_r_shared",
-        ":vtk",
+        ":vtk_core",
         ":zlib",
     ],
     exports_filter = [
@@ -236,6 +239,17 @@
         "@pcl//:__subpackages__",
     ],
     deps = [":pcl_library"],
+)
+
+cc_shared_library(
+    name = "pcl_visualization_shared",
+    dynamic_deps = [
+        ":pcl",
+        ":vtk",
+    ],
+    exports_filter = ["@pcl//:__subpackages__"],
+    target_compatible_with = ["@platforms//os:linux"],
+    deps = [":pcl_visualization_library"],
 )
 
