load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_test")

DEPS = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@std_msgs//:cc_shared": "@std_msgs//:cc",
}

collect_transitive_dynamic_deps(
    name = "dynamic_deps",
    dynamic_deps = DEPS.keys(),
)

cc_binary(
    name = "talker",
    srcs = ["talker.cc"],
    dynamic_deps = [":dynamic_deps"],
    deps = DEPS.values(),
)

cc_binary(
    name = "listener",
    srcs = ["listener.cc"],
    dynamic_deps = [":dynamic_deps"],
    deps = DEPS.values(),
)

AUTOWARE_COMMON_MSGS = {
    "@autoware_common_msgs//:cc_shared": "@autoware_common_msgs//:cc",
}

collect_transitive_dynamic_deps(
    name = "autoware_common_msgs_dynamic_deps",
    dynamic_deps = AUTOWARE_COMMON_MSGS.keys(),
)

cc_test(
    name = "autoware_common_msgs_test",
    srcs = ["autoware_common_msgs_test.cc"],
    dynamic_deps = [":autoware_common_msgs_dynamic_deps"],
    deps = AUTOWARE_COMMON_MSGS.values(),
)
