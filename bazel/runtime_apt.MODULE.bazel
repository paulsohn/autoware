# System libraries the runtime image adds to its ubuntu:24.04 base, as pinned Ubuntu packages
# (docs/bazel/PLAN.md, "Environments"). Only what Bazel-built code dlopens/links from the system and the RCR does not
# ship: the OpenGL loader (glvnd), which PyPI Qt, and through PCL -> VTK -> Qt even headless nodes, link against.
# Transitive dependencies are listed by hand (include_transitive = False) so the base's libc6 etc. are not replaced.
# The resolved versions and sha256s are recorded in MODULE.bazel.lock (module extension facts).
apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.sources_list(
    # shortcut: amd64 only; snapshot.ubuntu.com/ubuntu-ports answers 401, find the arm64 snapshot URL for Thor (P5).
    architectures = ["amd64"],
    components = ["main"],
    suites = [
        "noble",
        "noble-security",
        "noble-updates",
    ],
    types = ["deb"],
    # Same day as the ubuntu base digest.
    uris = ["https://snapshot.ubuntu.com/ubuntu/20261109T000000Z"],
)
apt.install(
    dependency_set = "runtime_apt",
    include_transitive = False,
    packages = [
        "libbsd0",
        "libegl1",
        "libgl1",
        "libglvnd0",
        "libglx0",
        "libopengl0",
        "libx11-6",
        "libx11-data",
        "libxau6",
        "libxcb1",
        "libxdmcp6",
    ],
    suites = [
        "noble",
        "noble-security",
        "noble-updates",
    ],
)
use_repo(apt, "runtime_apt")
