load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_test")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load(":plugins.bzl", "agnocast_bridge_plugins", "bridge_template_test")

package(default_visibility = ["//visibility:public"])

bridge_template_test(name = "template_tests")

agnocast_bridge_plugins(
    name = "plugins",
    interface_set = "//bazel/interfaces:all_interfaces",
    deps = [
        "@agnocast_cie_config_msgs//:cc",
        "@autoware_common_msgs//:cc",
        "@autoware_control_msgs//:cc",
        "@autoware_internal_planning_msgs//:cc",
        "@autoware_localization_msgs//:cc",
        "@autoware_map_msgs//:cc",
        "@autoware_perception_msgs//:cc",
        "@autoware_planning_msgs//:cc",
        "@autoware_sensing_msgs//:cc",
        "@autoware_simulation_msgs//:cc",
        "@autoware_system_msgs//:cc",
        "@autoware_v2x_msgs//:cc",
        "@autoware_vehicle_msgs//:cc",
        "@std_msgs//:cc",
        "@std_srvs//:cc",
    ],
    dynamic_deps = [
        "@agnocast_cie_config_msgs//:cc_shared",
        "@autoware_common_msgs//:cc_shared",
        "@autoware_control_msgs//:cc_shared",
        "@autoware_internal_planning_msgs//:cc_shared",
        "@autoware_localization_msgs//:cc_shared",
        "@autoware_map_msgs//:cc_shared",
        "@autoware_perception_msgs//:cc_shared",
        "@autoware_planning_msgs//:cc_shared",
        "@autoware_sensing_msgs//:cc_shared",
        "@autoware_simulation_msgs//:cc_shared",
        "@autoware_system_msgs//:cc_shared",
        "@autoware_v2x_msgs//:cc_shared",
        "@autoware_vehicle_msgs//:cc_shared",
        "@std_msgs//:cc_shared",
        "@std_srvs//:cc_shared",
    ],
)

collect_transitive_dynamic_deps(
    name = "bridge_test_dynamic_deps",
    dynamic_deps = [
        "@agnocastlib//:agnocast",
        "@autoware_common_msgs//:cc_shared",
        "@rclcpp//:rclcpp",
        "@std_msgs//:cc_shared",
        "@std_srvs//:cc_shared",
    ],
)

cc_test(
    name = "bridge_plugins_test",
    srcs = ["bridge_plugins_test.cpp"],
    args = ["$(rootpath :plugins)"],
    data = [":plugins"],
    dynamic_deps = [":bridge_test_dynamic_deps"],
    tags = ["requires-agnocast-kmod"],
    deps = [
        "@agnocastlib//:agnocast_library",
        "@autoware_common_msgs//:cc",
        "@googletest//:gtest",
        "@rclcpp//:rclcpp_library",
        "@std_msgs//:cc",
        "@std_srvs//:cc",
    ],
)

sh_binary(
    name = "with_heaphook",
    srcs = ["with_heaphook.sh"],
    data = [
        "@bazel_tools//tools/bash/runfiles",
    ],
)
