module(name = "autoware_bazel")

# Bazel rule and toolchain modules used directly by this workspace.
bazel_dep(name = "llvm", version = "0.8.25.rcr.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.26.rcr.0")

# The core Lyrical release supplies rclcpp, rcutils, std_msgs and their
# transitive ROS dependencies. Direct 0.0.0 deps expose the versions selected
# by ros_core.
bazel_dep(name = "ros_core", version = "lyrical.2026-10-05.rcr.0")
bazel_dep(name = "rclcpp", version = "0.0.0")
bazel_dep(name = "rcutils", version = "0.0.0")
bazel_dep(name = "std_msgs", version = "0.0.0")

# ROS packages outside ros_core need an explicit concrete release selection.
bazel_dep(name = "diagnostic_msgs", version = "5.9.3-1.rcr.0")
bazel_dep(name = "diagnostic_updater", version = "4.4.7-1.rcr.2")
bazel_dep(name = "geographic_msgs", version = "1.0.6-3.rcr.2")
bazel_dep(name = "logging_demo", version = "0.37.9-1.rcr.0")
bazel_dep(name = "unique_identifier_msgs", version = "2.8.1-3.rcr.2")
bazel_dep(name = "visualization_msgs", version = "5.9.3-1.rcr.0")

# Local Autoware package modules. The concrete versions identify their RCR
# counterparts; local_path_override selects the source snapshots by default.
bazel_dep(name = "autoware_utils_math", version = "1.11.0-3.rcr.2")
local_path_override(
    module_name = "autoware_utils_math",
    path = "src/core/autoware_utils/autoware_utils_math",
)

bazel_dep(name = "autoware_utils_diagnostics", version = "1.11.0-3.rcr.2")
local_path_override(
    module_name = "autoware_utils_diagnostics",
    path = "src/core/autoware_utils/autoware_utils_diagnostics",
)

bazel_dep(name = "autoware_utils_logging", version = "1.11.0-3.rcr.2")
