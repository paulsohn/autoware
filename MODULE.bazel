# No Lyrical RCR release exists for this package yet. The local module is the
# only selected source, so its dependency version remains intentionally local.
bazel_dep(name = "autoware_simulation_msgs", version = "0.0.0")
local_path_override(
    module_name = "autoware_simulation_msgs",
    path = "src/core/autoware_msgs/autoware_simulation_msgs",
)

# Use the latest published patch of the matching rosdistro snapshot.
bazel_dep(name = "rosdistro", version = "lyrical.2026-10-05.rcr.3")

register_toolchains("@llvm//toolchain:all")

llvm = use_extension("@llvm//extensions:llvm.bzl", "llvm")
llvm.version(llvm_version = "21.1.8")
llvm.configure(targets = ["X86"])
use_repo(llvm, "llvm-project")
