# Transitive-only module overrides.
# Keep the existing solver API separate from RCR's OSQP 1.x consumers.
# shortcut: current consumers link only 0.6; revisit before mixing both ABIs in one process.
multiple_version_override(
    module_name = "osqp",
    versions = [
        "0.6.3.bcr.3",
        "1.0.0.bcr.3",
    ],
)

register_toolchains("@llvm//toolchain:all")

llvm = use_extension("@llvm//extensions:llvm.bzl", "llvm")
llvm.version(llvm_version = "21.1.8")
llvm.configure(targets = ["X86"])
use_repo(llvm, "llvm-project")

pip_ros = use_extension("@rosdistro//python:defs.bzl", "pip_ros")
use_repo(pip_ros, "pip_ros")

# Conda archives. GNU runtime ABI required by pinned manylinux numerical wheels.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "python_libstdcxx_linux_x86_64",
    build_file_content = """exports_files(["lib/libstdc++.so.6.0.30"])
filegroup(name = "runtime", srcs = glob(["lib/libstdc++.so*"]), visibility = ["//visibility:public"])
""",
    sha256 = "0289e6a7b9a5249161a3967909e12dcfb4ab4475cdede984635d3fb65c606f08",
    urls = ["https://conda.anaconda.org/conda-forge/linux-64/libstdcxx-ng-12.2.0-h46fd767_19.tar.bz2"],
)

http_archive(
    name = "python_libgcc_linux_x86_64",
    build_file_content = """exports_files(["lib/libgcc_s.so.1"])
filegroup(name = "runtime", srcs = glob(["lib/libgcc_s.so*"]), visibility = ["//visibility:public"])
""",
    sha256 = "f3899c26824cee023f1e360bd0859b0e149e2b3e8b1668bc6dd04bfc70dcd659",
    urls = ["https://conda.anaconda.org/conda-forge/linux-64/libgcc-ng-12.2.0-h65d4601_19.tar.bz2"],
)

