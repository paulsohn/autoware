module(name = "autoware")

# Toolchains and rules. Versions follow the RCR examples workspace
# (openrobotics/ros-central-registry examples/MODULE.bazel @ b3bbf458).
bazel_dep(name = "llvm", version = "0.8.25.rcr.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "protobuf", version = "36.2")
bazel_dep(name = "rules_cc", version = "0.2.26.rcr.0")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_python", version = "2.4.1")
bazel_dep(name = "rules_rs", version = "0.1.0")

# ROS 2 Lyrical from the RCR. Packages are pinned by the `ros` release module, which pins the
# whole distribution (ros_core and the variants miss e.g. geographic_msgs, pcl_ros, lanelet2);
# 0.0.0 lets MVS pick the version that release selects.
bazel_dep(name = "ros", version = "lyrical.2026-10-05.rcr.0")
bazel_dep(name = "rclcpp", version = "0.0.0")
bazel_dep(name = "rosdistro", version = "0.0.0")
single_version_override(
    module_name = "rosdistro",
    patch_strip = 1,
    patches = [
        "//bazel/patches:rosdistro_python_extensions.patch",
        "//bazel/patches:rosdistro_entry_points.patch",
        "//bazel/patches:rosdistro_vtk_core.patch",
        "//bazel/patches:rosdistro_hermetic_python_genrules.patch",
    ],
    version = "lyrical.2026-10-05.rcr.0",
)

# Headless PCL: io/surface depend on VTK's non-rendering modules only (with rosdistro_vtk_core.patch), so nodes that link
# PCL need neither Qt nor the system OpenGL loader (docs/bazel/JOURNAL.md, "VTK split").
single_version_override(
    module_name = "pcl",
    patch_strip = 1,
    patches = ["//bazel/patches:pcl_io_surface_vtk_modules.patch"],
)
bazel_dep(name = "std_msgs", version = "0.0.0")
# The ros2 command-line tools for the runtime image (ros2 launch/topic/node/...); //images:autoware_underlay.
bazel_dep(name = "ros2cli_common_extensions", version = "0.0.0")
bazel_dep(name = "ros2action", version = "0.0.0")
bazel_dep(name = "ros2component", version = "0.0.0")
bazel_dep(name = "ros2launch", version = "0.0.0")
bazel_dep(name = "ros2lifecycle", version = "0.0.0")
bazel_dep(name = "ros2node", version = "0.0.0")
bazel_dep(name = "ros2param", version = "0.0.0")
bazel_dep(name = "ros2run", version = "0.0.0")
bazel_dep(name = "ros2service", version = "0.0.0")

# Their RCR overlays lack the egg-info entry_points.txt that registers the command (ros2topic's has it).
single_version_override(
    module_name = "ros2action",
    patch_strip = 1,
    patches = ["//bazel/patches:ros2action_entry_points.patch"],
)
single_version_override(
    module_name = "ros2component",
    patch_strip = 1,
    patches = ["//bazel/patches:ros2component_entry_points.patch"],
)
single_version_override(
    module_name = "ros2launch",
    patch_strip = 1,
    patches = ["//bazel/patches:ros2launch_entry_points.patch"],
)
single_version_override(
    module_name = "ros2lifecycle",
    patch_strip = 1,
    patches = ["//bazel/patches:ros2lifecycle_entry_points.patch"],
)
single_version_override(
    module_name = "ros2node",
    patch_strip = 1,
    patches = ["//bazel/patches:ros2node_entry_points.patch"],
)
single_version_override(
    module_name = "ros2param",
    patch_strip = 1,
    patches = ["//bazel/patches:ros2param_entry_points.patch"],
)
single_version_override(
    module_name = "ros2run",
    patch_strip = 1,
    patches = ["//bazel/patches:ros2run_entry_points.patch"],
)
single_version_override(
    module_name = "ros2service",
    patch_strip = 1,
    patches = ["//bazel/patches:ros2service_entry_points.patch"],
)

register_toolchains("@llvm//toolchain:all")

llvm = use_extension("@llvm//extensions:llvm.bzl", "llvm")
llvm.version(llvm_version = "21.1.8")
llvm.configure(targets = ["AArch64", "X86"])
use_repo(llvm, "llvm-project")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(is_default = True, python_version = "3.12")

rs_toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
rs_toolchains.toolchain(edition = "2021", version = "1.93.0")
use_repo(rs_toolchains, "default_rust_toolchains")

register_toolchains("@default_rust_toolchains//...")

# Autoware ROS packages: one local module per package (see "Package conventions" in
# docs/bazel/PLAN.md). Generated by bazel/tools/gen_build.
include("//bazel:autoware_packages.MODULE.bazel")

# The P4 demo package (headless planning simulation of autoware_core), and its map: sample-map-planning, the
# planning-simulator map of Autoware's demo artifacts (ansible/roles/demo_artifacts, same sha256).
bazel_dep(name = "autoware_bazel_demo")
local_path_override(module_name = "autoware_bazel_demo", path = "bazel/demo")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "sample_map_planning",
    build_file_content = """exports_files(glob(["**"]))

filegroup(
    name = "files",
    srcs = glob(["**"], exclude = ["BUILD.bazel", "REPO.bazel"]),
    visibility = ["//visibility:public"],
)
""",
    sha256 = "5536fce7bb8db7688fdf94ec004118b898637ad0d5b6175108b10989dd6e93b9",
    strip_prefix = "sample-map-planning",
    url = "https://autoware-files.s3.us-west-2.amazonaws.com/maps/demos/sample-map-planning.zip",
)

# CUDA: hermetic toolkit from NVIDIA's redist archives (versions in bazel/cuda.MODULE.bazel).
bazel_dep(name = "rules_cuda", version = "0.3.0.rcr.0")
single_version_override(
    module_name = "rules_cuda",
    patch_strip = 1,
    patches = [
        "//bazel/patches:rules_cuda_sm110.patch",
        "//bazel/patches:rules_cuda_component_patches_repositories.patch",
        "//bazel/patches:rules_cuda_component_patches_extension.patch",
        "//bazel/patches:rules_cuda_culibos_linkable.patch",
        "//bazel/patches:rules_cuda_nvcc_keep_dir.patch",
    ],
    version = "0.3.0.rcr.0",
)

include("//bazel:cuda.MODULE.bazel")

bazel_dep(name = "tensorrt")
local_path_override(module_name = "tensorrt", path = "bazel/third_party/tensorrt")

# OSQP: the RCR's osqp_vendor is OSQP 1.0; autoware_osqp_interface and autoware_qp_interface use the 0.6 API.
# Both versions coexist; Autoware modules ask for 0.6.3, the RCR for 1.0.0. See docs/bazel/PLAN.md.
bazel_dep(name = "openmp")
local_path_override(module_name = "openmp", path = "bazel/third_party/openmp")

bazel_dep(name = "osqp_0_6")
local_path_override(module_name = "osqp_0_6", path = "bazel/third_party/osqp_0_6")

multiple_version_override(
    module_name = "osqp",
    versions = [
        "0.6.3.bcr.3",
        "1.0.0.bcr.3",
    ],
)

# Runtime image base (docs/bazel/PLAN.md, "Environments"): the same ubuntu:24.04 index digest as images/dev.Dockerfile.
oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "ubuntu",
    digest = "sha256:fe81560990fae86dc4743202b2cb4d3df98d0bcf949173cecef15ce1127ef852",
    image = "index.docker.io/library/ubuntu",
    platforms = [
        "linux/amd64",
        "linux/arm64/v8",
    ],
)
use_repo(oci, "ubuntu", "ubuntu_linux_amd64", "ubuntu_linux_arm64_v8")
