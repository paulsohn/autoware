load("@rosdistro//ament:defs.bzl", "ament_index", "register_ament_files")

package(default_visibility = ["//visibility:public"])

exports_files(["archive.BUILD.bazel"])

register_ament_files(
    name = "planning_map_files",
    files = [
        "@map_data//:lanelet2_map.osm",
        "@map_data//:map_config.yaml",
        "@map_data//:map_projector_info.yaml",
        "@map_data//:pointcloud_map.pcd",
    ],
    prefix = "share/autoware_map_asset",
    strip_prefix = "*",
)

ament_index(
    data = [":planning_map_files"],
    package_xml = "package.xml",
)
