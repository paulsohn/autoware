load("@rules_python//python:defs.bzl", "py_library", "py_test")
load(":python.bzl", "runtime_python")

exports_files(["defs.bzl", "python.bzl"])

py_library(
    name = "test_message",
    testonly = True,
    srcs = ["testdata/runtime_message.py"],
    imports = ["testdata"],
)

filegroup(
