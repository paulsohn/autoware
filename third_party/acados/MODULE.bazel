# The CasADi wheel and renderer need a GNU runtime independent of the host install.
http_archive(
    name = "acados_libstdcxx",
    build_file_content = "filegroup(name = \"runtime\", srcs = glob([\"lib/libstdc++.so*\"]), visibility = [\"//visibility:public\"])\n",
    sha256 = "0289e6a7b9a5249161a3967909e12dcfb4ab4475cdede984635d3fb65c606f08",
    urls = ["https://conda.anaconda.org/conda-forge/linux-64/libstdcxx-ng-12.2.0-h46fd767_19.tar.bz2"],
)
