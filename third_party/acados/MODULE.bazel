module(name = "acados", version = "0.0.0")

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_cc", version = "0.2.26.rcr.0")
bazel_dep(name = "rules_python", version = "2.4.5")
bazel_dep(name = "rosdistro", version = "0.0.0")

pip_ros = use_extension("@rosdistro//python:defs.bzl", "pip_ros")
use_repo(pip_ros, "pip_ros")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_archive(
    name = "acados_source",
    type = "tar.gz",
    build_file = "//:BUILD.sdk.bazel",
    sha256 = "8abc06c55d7b5aaa353e09fae2072fe062892b2d8ce0ea23c1f5d9b965b4f488",
    strip_prefix = "acados-7e1d1152c1babd6ea04af1c9d73444fe8381057b",
    urls = ["https://codeload.github.com/acados/acados/tar.gz/7e1d1152c1babd6ea04af1c9d73444fe8381057b"],
)

