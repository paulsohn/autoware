    name = "catch_source",
    type = "tar.gz",
    sha256 = "681f755f744b0f11f63530dfd2cd6505871355d1eaf8794c05fc30d65191c306",
    strip_prefix = "Catch2-f3da715b4a4d075ea2f03b5908b360c64bff8cb0",
