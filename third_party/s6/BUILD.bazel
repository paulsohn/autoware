load("@rules_img//img:layer.bzl", "layer_from_tar")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

package(default_visibility = ["//visibility:public"])

exports_files(["s6.MODULE.bazel"])

pkg_tar(
    name = "runtime",
    allow_duplicates_with_different_content = False,
    extension = "tar.gz",
    preserve_mode = True,
    stamp = 0,
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = [
        "@s6_overlay_noarch//file",
        "@s6_overlay_x86_64//file",
    ],
)

layer_from_tar(
    name = "layer",
    src = ":runtime",
    estargz = "disabled",
)
