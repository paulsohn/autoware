# CUDA inputs are selected by the product root from third_party/; component modules only use @cuda.
cuda = use_extension("@rules_cuda//cuda:extensions.bzl", "toolchain")
cuda.redist_json(
    name = "cuda_redist",
    components = [
        "cccl",
        "cublas",
        "crt",
        "cudart",
        "curand",
        "nvcc",
        "nvrtc",
        "nvvm",
    ],
    platforms = ["linux-x86_64"],
    sha256 = "89d93e6de640d47eb43c63437fe1be426ed21dd58cc79933a29acbca33c6eeb8",
    version = "13.2.2",
)
cuda.toolkit(name = "cuda")
use_repo(cuda, "cuda")

# Replace only the affected pinned component through Bazel's repository override.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "cuda_crt_compat",
    add_prefix = "crt",
    build_file = "//third_party/cuda:BUILD.crt.bazel",
    patch_args = ["-p1"],
    patches = [
        "//third_party/cuda:patches/cuda_crt_libcpp21_h.patch",
        "//third_party/cuda:patches/cuda_crt_libcpp21_hpp.patch",
    ],
    sha256 = "174ad29ab90c9301bd25f32f935345e65f19fbb0f39c15788daae25b0e924892",
    strip_prefix = "cuda_crt-linux-x86_64-13.2.86-archive",
    urls = ["https://developer.download.nvidia.com/compute/cuda/redist/cuda_crt/linux-x86_64/cuda_crt-linux-x86_64-13.2.86-archive.tar.xz"],
)

override_repo(
    cuda,
    cuda_crt_linux_x86_64_13_2_2 = "cuda_crt_compat",
)
