module(
    name = "spconv",
    version = "0.0.0",
)

bazel_dep(name = "llvm", version = "0.8.25.rcr.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "with_cfg.bzl", version = "0.12.0")
bazel_dep(name = "rules_cc", version = "0.2.26.rcr.0")
bazel_dep(name = "rules_cuda", version = "0.4.0")

cuda = use_extension("@rules_cuda//cuda:extensions.bzl", "toolchain")
use_repo(cuda, "cuda")

sdk = use_extension("//:repositories.bzl", "sdk")
use_repo(sdk, "spconv_artifacts")
