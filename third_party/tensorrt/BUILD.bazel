load(":defs.bzl", "tensorrt_cc_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "BUILD.sdk.bazel",
    "test_runner.py",
])

alias(
    name = "tensorrt",
    actual = "@tensorrt_artifacts//:tensorrt",
)

filegroup(
    name = "runtime_libs",
    srcs = [
        "@tensorrt_artifacts//:runtime_libs",
        "@tensorrt_libgcc//:lib/libgcc_s.so.1",
        "@tensorrt_libstdcxx//:lib/libstdc++.so.6",
        "@tensorrt_libstdcxx//:lib/libstdc++.so.6.0.30",
    ],
)

tensorrt_cc_test(
    name = "runtime_abi_test",
    srcs = ["test_rtti.cpp"],
    deps = [
        ":tensorrt",
        "@cuda//:cuda_runtime",
        "@googletest//:gtest_main",
    ],
)
