# Linux subset of the .bazelrc the RCR CI generates (BAZELRC_TEMPLATE in
# openrobotics/ros-central-registry tools/ci/setup_workspace.py @ b3bbf458).
# Not examples/.bazelrc: it lacks the per-file C++ standard exceptions below.

## COMMON
# Lets 0.0.0 RCR deps resolve to the version the ros_core release selects.
common --check_direct_dependencies=off
common --registry=https://bazel.ros.org --registry=https://bcr.bazel.build

# Intrinsic's read-only cache for RCR modules: much faster cold builds.
common --remote_cache=https://storage.googleapis.com/intrinsic-opensource-buildcache
common --remote_upload_local_results=false
common --remote_cache_compression=true

# Local caches, shared across checkouts and mounted into containers.
common --disk_cache=~/.cache/bazel-disk
common --repository_cache=~/.cache/bazel-repo

common --test_env=ROS_DISTRO=lyrical
common --test_env=ROS_HOME=.ros
common --test_env=RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
common --test_env=LD_LIBRARY_PATH=lib
common --test_env=TMPDIR=/tmp
common --test_env=QT_QPA_PLATFORM=offscreen
common --run_env=ROS_DISTRO=lyrical
common --run_env=ROS_HOME=.ros
common --run_env=RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
# Same CycloneDDS config as the legacy docker images (docker/files/cyclonedds.xml).
# Runfiles-relative (cwd of bazel run/test): targets need data = ["//bazel/config:cyclonedds.xml"].
common --run_env=CYCLONEDDS_URI=file://bazel/config/cyclonedds.xml
common --test_env=CYCLONEDDS_URI=file://bazel/config/cyclonedds.xml
common --run_env=LD_LIBRARY_PATH=lib
common --run_env=TMPDIR=/tmp
common --run_env=QT_QPA_PLATFORM=xcb
# Plain `bazel` works from a shell that sourced a ROS distro (e.g. the host's Jazzy). Build actions are isolated by
# --incompatible_strict_action_env and `bazel test` passes only --test_env, but `bazel run` passes the shell's
# environment through, which would point ament_index and Python at /opt/ros:
# - binaries get --run_env; "=NAME" removes the variable;
# - tests started with `bazel run` get --test_env and ignore removals, so set an empty value instead
#   (ament_index_cpp and CPython treat empty as unset).
common --run_env==AMENT_PREFIX_PATH --test_env=AMENT_PREFIX_PATH=
common --run_env==PYTHONPATH --test_env=PYTHONPATH=
common --run_env==CMAKE_PREFIX_PATH
common --run_env==COLCON_PREFIX_PATH
# Agnocast is always compiled in; ENABLE_AGNOCAST switches it at run time (default on, needs the agnocast kernel module).
# --config=no-agnocast runs nodes and tests on the plain ROS 2 executor, e.g. on machines without the module.
common --run_env=ENABLE_AGNOCAST=1
common --test_env=ENABLE_AGNOCAST=1
common:no-agnocast --run_env=ENABLE_AGNOCAST=0
common:no-agnocast --test_env=ENABLE_AGNOCAST=0
# Tests that need /dev/agnocast (CMake label requires_kernel_module) cannot run there.
test:no-agnocast --test_tag_filters=-requires_kernel_module
common --test_env=DISPLAY
common --test_env=XAUTHORITY
common --test_env=WAYLAND_DISPLAY

common --incompatible_default_to_explicit_init_py
# Keeps the host environment (e.g. a sourced /opt/ros/jazzy) out of build actions.
common --incompatible_strict_action_env
common --noexperimental_collect_system_network_usage

# Upstream Qt produces only false positives under -Wthread-safety.
common --per_file_copt=external/qt[^/]*[+]/.*@-Wno-thread-safety-analysis
common --host_per_file_copt=external/qt[^/]*[+]/.*@-Wno-thread-safety-analysis

## BUILD
build --@llvm//config:fastbuild_optimization_mode=O1
build --remote_download_outputs=all
build --define=TMPDIR=/tmp
build --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
build --repo_env=PIP_CONFIG_FILE=/dev/null
build --@protobuf//bazel/toolchains:prefer_prebuilt_protoc
build --@llvm//config:experimental_stub_libgcc_s=True
# RCR builds everything as C++23; never set -std per target.
build --cxxopt=-std=c++23
build --host_cxxopt=-std=c++23
# Upstream code that cannot compile as C++23 (reasons documented in setup_workspace.py).
build --per_file_copt=external/.*fastdds.*@-std=c++17
build --host_per_file_copt=external/.*fastdds.*@-std=c++17
build --per_file_copt=external/.*popf.*@-std=c++17
build --host_per_file_copt=external/.*popf.*@-std=c++17
build --per_file_copt=external/.*gz-sim.*@-std=c++20
build --host_per_file_copt=external/.*gz-sim.*@-std=c++20
# Same locale and tool PATH for actions on any host or container.
common --action_env=LC_CTYPE=C.UTF-8
common --host_action_env=LC_CTYPE=C.UTF-8
common --action_env=PATH=/bin:/usr/bin:/usr/local/bin
common --host_action_env=PATH=/bin:/usr/bin:/usr/local/bin
# Link CycloneDDS directly instead of the dynamic RMW loader. The loader's ament_index
# pulls @rosdistro//:ament_package, which bundles every third-party library of the distro
# (Ogre, OpenCV, Qt, all pip packages): 89k vs 19k targets for a talker.
# --config=rmw_dynamic restores runtime switching via RMW_IMPLEMENTATION.
build --@rosdistro//:rmw=rmw_cyclonedds_cpp
build:rmw_dynamic --@rosdistro//:rmw=dynamic
build --platforms=//bazel/platforms:linux
build --extra_execution_platforms=//bazel/platforms:linux

## TEST
test --sandbox_default_allow_network=false
test --test_env=ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
test --run_under=@rosdistro//python:run_test_isolated

# Personal overrides (not committed).
try-import %workspace%/user.bazelrc

# CUDA (toolkit versions: bazel/cuda.MODULE.bazel; PLAN.md "CUDA").
# GPU code for Autoware's CMake list for CUDA >= 12.8: Turing, Ampere, Orin, Ada, Thor (sm_110), Blackwell
# (sm_120), plus compute_120 PTX for newer GPUs.
common --@rules_cuda//cuda:archs=compute_75:sm_75;compute_86:sm_86;compute_87:sm_87;compute_89:sm_89;compute_110:sm_110;compute_120:compute_120,sm_120
# nvcc's host compiler is the hermetic clang 21 with libc++, like all other C++ here. CUDA 13.0 accepts clang < 21
# and refuses libc++ on x86 (allowed on SBSA); both checks have documented overrides.
common --@rules_cuda//cuda:compiler=clang
common --repo_env=CUDA_COMPILER_USE_CC_TOOLCHAIN=true
# CUDA 13's headers refuse libc++ on x86 (a policy check; with clang there is no nvcc/EDG front end).
common --@rules_cuda//cuda:copts=-D_ALLOW_UNSUPPORTED_LIBCPP
# clang 23 makes C's -Wincompatible-pointer-types an error; OSQP passes long long* (c_int) as int64_t* (long*),
# the same 64-bit type on LP64.
build --per_file_copt=external/osqp.*@-Wno-error=incompatible-pointer-types
build --host_per_file_copt=external/osqp.*@-Wno-error=incompatible-pointer-types
